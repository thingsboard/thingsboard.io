---
import SeoMeta from '../components/SeoMeta.astro';
import { formatMarketingTitle } from '~/consts';
import { getSectionFromPath } from '~/util/path-utils';
import { getOgImageUrl } from '~/util/getOgImageUrl';

interface LegalPageMeta {
	title: string;
	description?: string;
	ogImage?: string;
	noIndex?: boolean;
}

/* `.astro` callers pass the meta as props; an `.mdx` page using `layout:` gets
   its frontmatter wrapped in `Astro.props.frontmatter` instead. */
type Props = LegalPageMeta & { frontmatter?: LegalPageMeta };

const { title, description, ogImage: ogImageProp, noIndex = false } = Astro.props.frontmatter ?? Astro.props;
/* Markdown documents carry their own opening date line and section headings;
   the hand-written HTML pages space those themselves. */
const isMarkdownPage = Boolean(Astro.props.frontmatter);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = formatMarketingTitle(title, getSectionFromPath(Astro.url.pathname));
const ogImage = ogImageProp ?? getOgImageUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<SeoMeta
			title={pageTitle}
			description={description}
			canonicalUrl={canonicalUrl}
			ogImage={ogImage}
			noIndex={noIndex}
		/>
		<link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body>
		{
			/* <main>, not a div: these pages do not route through Starlight, so nothing
		    else supplies the landmark. */
		}
		<main class:list={['legal-page', { 'legal-page--markdown': isMarkdownPage }]}>
			<slot />
		</main>
	</body>
</html>

<style lang="scss" is:global>
	@use '../styles/variables' as *;
	:root {
		--sl-main-pad: 0;
		--sl-line-height: 1.5;
		--color-text: #{$color-text-primary};
	}

	.legal-page {
		max-width: 860px;
		margin: 0 auto;
		padding: 60px 24px 80px;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		color: #212529;
		line-height: 1.7;
		font-size: 16px;
		text-align: justify;

		h1,
		h2 {
			font-weight: 600;
			line-height: 1.3;
			margin: 0 0 16px;
		}

		h1 {
			font-size: 1.5em;
			text-align: center;
		}

		h2 {
			font-size: 1.25em;
			margin-top: 32px;
		}

		p {
			@include body-text;
			margin: 0 0 8px;

			b {
				color: var(--color-text);
			}
		}

		a {
			color: #2a7dec;
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}

		ul {
			margin: 0 0 8px !important;
			padding-left: 24px !important;
			list-style: disc !important;

			li {
				margin-bottom: 4px;
				list-style: disc !important;
				color: #75767c !important;

				&::marker {
					color: #75767c !important;
				}
			}
		}

		.date {
			font-size: 0.8em;
			color: grey;
		}

		/*
		 * Everything below applies only to the Markdown documents. The
		 * hand-written HTML pages space and mark up their own content, so keeping
		 * these rules scoped leaves them rendering exactly as before.
		 */
		&.legal-page--markdown {
			/* No manual <br /> between sections here — the gap lives on the heading. */
			h2 {
				margin-top: 40px;
			}

			h2,
			h3,
			h4 {
				text-align: left;
			}

			h3,
			h4 {
				font-weight: 600;
				line-height: 1.3;
				margin: 0 0 16px;
			}

			h3 {
				font-size: 1.1em;
				margin-top: 28px;
			}

			h4 {
				font-size: 1em;
				margin-top: 20px;
			}

			/* The revision-date line each document opens with. */
			h1 + p {
				margin-bottom: 32px;
			}

			/* Markdown emits <strong>, not <b>. */
			strong {
				color: var(--color-text);
				font-weight: 600;
			}

			blockquote {
				margin: 16px 0;
				padding: 8px 16px;
				border-left: 3px solid #2a7dec;
				background: #f6f9fe;

				> :last-child {
					margin-bottom: 0;
				}
			}

			code {
				padding: 1px 4px;
				border-radius: 3px;
				background: #f1f3f5;
				font-size: 0.9em;
			}

			hr {
				margin: 32px 0;
				border: 0;
				border-top: 1px solid #dee2e6;
			}

			/* `display: block` lets the wide licensing tables scroll instead of
			   stretching the 860px column on narrow screens. */
			table {
				display: block;
				overflow-x: auto;
				width: 100%;
				margin: 0 0 16px;
				border-collapse: collapse;
				font-size: 0.95em;
				text-align: left;
			}

			th,
			td {
				padding: 8px 12px;
				border: 1px solid #dee2e6;
				text-align: left;
				vertical-align: top;
			}

			th {
				background: #f8f9fa;
				color: var(--color-text);
				font-weight: 600;
			}

			ol {
				margin: 0 0 8px !important;
				padding-left: 24px !important;
				list-style: decimal !important;

				li {
					margin-bottom: 4px;
					list-style: decimal !important;
					color: #75767c !important;

					&::marker {
						color: #75767c !important;
					}
				}
			}

			li > ul,
			li > ol {
				margin-top: 4px !important;
			}

			/* Label → value parameter block (the BUSL "Parameters" section): the
			   labels sit in their own column, as in the plain-text license file. */
			.license-parameters {
				display: grid;
				grid-template-columns: 200px 1fr;
				gap: 12px 24px;
				margin: 0 0 24px;

				@include media-down(md) {
					grid-template-columns: 1fr;
					gap: 4px;

					dd {
						margin-bottom: 12px;
					}
				}

				dt {
					@include body-text;
					color: var(--color-text);
					font-weight: 600;
				}

				dd {
					margin: 0;
				}
			}

			/* Clauses that carry their own "(a)" / "(i)" labels: no list marker,
			   the label hangs in the gutter so wrapped lines align with the text. */
			ol.license-clauses {
				margin: 0 0 12px !important;
				padding-left: 2.25em !important;

				li {
					@include body-text;
					color: $color-text-secondary !important;
					list-style: none !important;
					margin-bottom: 8px;
				}
			}

			.license-clause-label {
				display: inline-block;
				width: 2.25em;
				margin-left: -2.25em;
			}
		}
	}
</style>
