---
import ThanksPage from '@components/Landing/ThanksPage.astro';
import Card from '@components/ui/Card.astro';
import Mark from '@components/ui/Mark.astro';
import { CONTACT_US_SENT_KEY } from '@data/contact-form';
import { SENT_MAX_AGE_MS } from '@util/sent-form';

/**
 * The contact form's thank-you. The inline script offers "Edit and send again" from what the form kept in
 * session storage; without it (another tab, an hour later) the offer stays hidden.
 */

interface NextLink {
	icon: string;
	title: string;
	line: string;
	href: string;
	accent: 'brand' | 'neutral';
}

const NEXT: NextLink[] = [
	{
		icon: 'tabler:building-factory-2',
		title: 'Read case studies',
		line: 'How companies across industries use ThingsBoard.',
		href: '/case-studies/',
		accent: 'brand',
	},
	{
		icon: 'tabler:apps',
		title: 'Discover IoT Hub',
		line: 'Devices, widgets and solutions that work with ThingsBoard.',
		href: '/iot-hub/',
		accent: 'neutral',
	},
];
---

<ThanksPage
	metaTitle="Thank You | Contact Us"
	description="Thank you for getting in touch with ThingsBoard. We will respond as soon as possible."
	eyebrow="Message sent"
	title="Thank you for your message!"
	lede="We will respond as soon as possible. Have a great day!"
>
	<section slot="after" class="thanks-next print:hidden" aria-labelledby="thanks-next-title">
		<h2 class="thanks-next__title" id="thanks-next-title">
			While you wait
		</h2>
		<ul class="thanks-next__list">
			{NEXT.map((link) => (
				<Card as="li" href={link.href} title={link.title} class="thanks-next__card">
					<Mark slot="mark" size={48} icon={link.icon} fill="wash" accent={link.accent} />
					<p class="thanks-next__line">{link.line}</p>
				</Card>
			))}
		</ul>
	</section>

	{/* When a link set the topic, "Edit and send again" carries it too, so the form keeps the field hidden. */}
	<script slot="script" is:inline define:vars={{ KEY: CONTACT_US_SENT_KEY, MAX_AGE: SENT_MAX_AGE_MS }}>
		(() => {
			let sent;
			try {
				sent = JSON.parse(sessionStorage.getItem(KEY) || 'null');
			} catch {
				return;
			}
			if (!sent || typeof sent.at !== 'number' || Date.now() - sent.at > MAX_AGE) return;

			const part = (name) => document.querySelector(`[data-thanks="${name}"]`);

			if (typeof sent.email !== 'string' || !sent.email) return;
			const query = ['resend'];
			if (sent.order === true) query.push('pcorder');
			if (sent.linked === true && typeof sent.subject === 'string') {
				query.push(`subject=${encodeURIComponent(sent.subject)}`);
			}
			part('fix-link').href = `/contact-us/?${query.join('&')}`;
			part('fix').hidden = false;
		})();
	</script>
</ThanksPage>

<style lang="scss" is:global>
	@use '../styles/variables' as *;

	.thanks-next {
		width: 100%;
		margin-top: $spacing-16;

		@include media-down(md) {
			margin-top: $spacing-12;
		}
	}

	.thanks-next__title {
		@include type-card;
		margin-bottom: $spacing-5;
		color: var(--color-text);
		text-align: center;
	}

	.thanks-next__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-4;
		max-width: 820px;
		margin: 0 auto;
		padding: 0;
		list-style: none;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 620px;
		}
	}

	// The mark beside the title and its line, not above them.
	.thanks-next__card {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 2px 14px;

		.ui-mark {
			grid-row: span 2;
		}
	}

	.thanks-next__line {
		@include type-small;
		color: var(--color-text-secondary);
	}
</style>
