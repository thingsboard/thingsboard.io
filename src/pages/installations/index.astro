---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import SmartImage from '@components/SmartImage.astro';
import { externalLinkAttrs } from '@util/external-links';
import { installProducts } from '@data/installationsHub';
import { cloudRegionGtmId, cloudRegionHref } from '@util/cloud-regions';

// The drawing's longer side at 44/72 of the tile for the ThingsBoard logo, 50/72 for the other products, centred.
const iconFit = ({ icon, badgeFill }: (typeof installProducts)[number]) => {
	const [x, y, w, h] = icon.art;
	const k = (badgeFill ? 44 : 50) / 72 / Math.max(w, h);
	return `--icon-w: ${icon.view * k}; --icon-x: ${(icon.view / 2 - x - w / 2) * k}; --icon-y: ${(icon.view / 2 - y - h / 2) * k}`;
};
---

<BaseLayout
	headerVariant="solid-shadow"
	forceLightTheme
	title="Install ThingsBoard"
	description="Get ThingsBoard running: sign up for ThingsBoard Cloud in your region, or install ThingsBoard On-premises, Edge, Trendz and the IoT Gateway from their guides."
	ownsCloudSignupIds
>
	<div class="install">
		<header class="install__container install__intro">
			<h1 class="install__intro-title">Get ThingsBoard running</h1>
			<p class="install__intro-text">
				Pick where it runs. Cloud needs nothing installed; everything else has a guide for every way it installs.
			</p>
		</header>

		<nav class="install-nav print:hidden" aria-label="Products on this page">
			<ul>
				{installProducts.map((p) => (
					<li>
						<a href={`#${p.id}`} style={`--tab-accent: ${p.badgeFill ?? p.accent}`}>
							{p.nameHighlight ?? p.name}
						</a>
					</li>
				))}
			</ul>
		</nav>

		{installProducts.map((p) => {
			const [before, after] = p.nameHighlight ? p.name.split(p.nameHighlight) : [p.name, ''];
			const { aside } = p;
			return (
				<section
					id={p.id}
					aria-labelledby={`${p.id}-title`}
					class:list={['install__product', p.badgeFill && 'is-platform', p.regions && 'is-band']}
					style={{ '--accent': p.accent, '--badge-fill': p.badgeFill }}
				>
					<div class="install__container">
						<header class="install__head">
							<span class="install__mark" aria-hidden="true">
								<SmartImage
									src={p.icon.src}
									alt=""
									class="install__icon"
									style={iconFit(p)}
									width="96"
									height="96"
									loading="lazy"
								/>
							</span>
							<div>
								<p class="install__label">{p.label}</p>
								<h2 class="install__title" id={`${p.id}-title`}>
									{before}
									{p.nameHighlight && <span class="install__title-accent">{p.nameHighlight}</span>}
									{after}
								</h2>
							</div>
						</header>

						<div class="install__grid">
							<div>
								<p class="install__text">{p.description}</p>

								{p.regions && (
									<div class="install__regions">
										<p class="install__group-title">Try now</p>
										<ul>
											{p.regions.map((region) => {
												const signup = cloudRegionHref(region, 'signup');
												return (
													<li style={`--region-hue: ${region.hue}`}>
														<a
															class="install__region gtm_button"
															id={cloudRegionGtmId(region, 'signup')}
															href={signup}
															data-region={region.id}
															{...externalLinkAttrs(signup)}
														>
															<span class="install__region-globe">
																<Icon name="tabler:world" aria-hidden="true" />
															</span>
															<span class="install__region-name">
																<span>
																	{region.name}
																	<span class="install__region-tag" hidden>
																		Nearest to you
																	</span>
																</span>
																<small>{region.note}</small>
															</span>
															<span class="install__region-cta print:hidden">
																Sign up
																<span class="sr-only"> for ThingsBoard Cloud in {region.name}</span>
																<Icon name="tabler:chevron-right" aria-hidden="true" />
															</span>
														</a>
													</li>
												);
											})}
										</ul>
									</div>
								)}

								<div class="install__actions print:hidden">
									{p.primary && (
										<a class="install__button" href={p.primary.href}>
											{p.buttonIcon && <Icon name={p.buttonIcon} aria-hidden="true" />}
											{p.primary.label}
											<span class="sr-only"> — {p.name}</span>
										</a>
									)}
									{p.links.map((link) => (
										<a class="install__link" href={link.href}>
											{link.label}
											<span class="sr-only"> — {p.name}</span>
											<Icon name="tabler:chevron-right" aria-hidden="true" />
										</a>
									))}
								</div>
							</div>

							<div class="install__panel">
								{aside && (
									<div class="install__aside">
										<ul class="install__hosts" aria-label={`${aside.title} runs on`}>
											{aside.hosts.map((host) => (
												<li>
													<Icon name={host.icon} aria-hidden="true" />
													<span class="sr-only">{host.name}</span>
												</li>
											))}
										</ul>
										<h3 class="install__aside-title">
											<Icon name="tabler:cloud-lock" aria-hidden="true" />
											{aside.title}
										</h3>
										<p class="install__text">{aside.text}</p>
										<div class="install__actions print:hidden">
											{aside.links.map((link) => (
												<a class="install__link" href={link.href}>
													{link.label}
													<span class="sr-only"> — {aside.title}</span>
													<Icon name="tabler:chevron-right" aria-hidden="true" />
												</a>
											))}
										</div>
									</div>
								)}
								{p.options?.map((group) => (
									<div>
										<p class="install__group-title">{group.title}</p>
										<ul class="install__chips">
											{group.items.map((option) => (
												<li>
													<a class="install__chip" href={option.href}>
														<SmartImage src={option.logo} alt="" width="90" height="18" loading="lazy" />
														<span>
															{option.label}
															{option.note && <span class="install__chip-note"> {option.note}</span>}
														</span>
													</a>
												</li>
											))}
										</ul>
									</div>
								))}
							</div>
						</div>
					</div>
				</section>
			);
		})}
	</div>
</BaseLayout>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/print-mixins' as *;

	$install-nav-h: 48px;

	.install {
		padding-bottom: $spacing-20;
		background: var(--color-bg);
	}

	.install__container {
		max-width: $home-measure;
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	.install__intro {
		padding-block: $spacing-12;
		text-align: center;
	}

	.install__intro-title {
		@include section-title;

		margin: 0 0 $spacing-5;
		color: var(--color-text);
	}

	.install__intro-text {
		@include text-m;
		line-height: 24px;

		max-width: 65ch;
		margin: 0 auto;
	}

	// Sticky under the header; stuck, it takes the header's shadow (see the script).
	.install-nav {
		position: sticky;
		top: var(--sl-nav-height);
		z-index: 10;
		background: var(--color-bg);
		transition: box-shadow $transition-fast;

		&[data-stuck] {
			box-shadow: var(--shadow-header);
		}

		// Auto margins on the ends centre the row while it fits and let it scroll from its start when not.
		// Positioned, so the script's `offsetLeft` is measured within it.
		ul {
			position: relative;
			display: flex;
			gap: $spacing-6;
			height: $install-nav-h;
			margin: 0;
			padding: 0 $spacing-4;
			overflow-x: auto;
			list-style: none;
			scrollbar-width: none;

			@include media-down(md) {
				gap: $spacing-4;
			}
		}

		li {
			display: flex;
			flex: none;

			&:first-child {
				margin-inline-start: auto;
			}

			&:last-child {
				margin-inline-end: auto;
			}
		}

		a {
			position: relative;
			display: flex;
			align-items: center;
			font-size: $font-size-sm;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary);
			text-decoration: none;
			white-space: nowrap;
			transition: color $transition-fast;

			&::after {
				content: '';
				position: absolute;
				inset: auto 0 0;
				height: 3px;
				border-radius: 3px 3px 0 0;
				background: var(--tab-accent);
				transform: scaleX(0);
				transition: transform 0.2s ease;
			}

			&:hover,
			&[aria-current] {
				color: var(--color-text);
			}

			&[aria-current]::after {
				transform: scaleX(1);
			}

			&:focus-visible {
				outline: 2px solid var(--tab-accent);
				outline-offset: -2px;
				border-radius: $radius-sm;
			}
		}
	}

	:global(:root:has(.install-nav)) {
		scroll-padding-top: calc(var(--sl-nav-height) + #{$install-nav-h});

		@media (prefers-reduced-motion: no-preference) {
			scroll-behavior: smooth;
		}
	}

	:global(:root[data-install-nav-stuck] header.header) {
		box-shadow: none;
	}

	.install__product {
		padding-block: $spacing-10;

		& + & {
			border-top: 1px solid var(--color-border);
		}

		&.is-band {
			background: linear-gradient(
				150deg,
				color-mix(in srgb, var(--badge-fill) 22%, #fff),
				color-mix(in srgb, var(--badge-fill) 6%, #fff)
			);

			+ .install__product {
				border-top: 0;
			}
		}
	}

	.install__head {
		display: flex;
		align-items: center;
		gap: $spacing-5;
		margin-bottom: $spacing-5;

		@include media-down(sm) {
			gap: $spacing-3;
		}
	}

	.install__mark {
		--tile: 72px;

		display: grid;
		flex: none;
		place-items: center;
		width: var(--tile);
		height: var(--tile);
		border-radius: 32%;
		background: linear-gradient(155deg, #fff 35%, color-mix(in srgb, var(--accent) 5%, #fff));
		box-shadow: 0 6px 18px rgba(16, 24, 40, 0.08);

		@include media-down(lg) {
			--tile: 64px;
		}
	}

	.install__icon {
		width: calc(var(--tile) * var(--icon-w));
		height: auto;
		translate: calc(var(--tile) * var(--icon-x)) calc(var(--tile) * var(--icon-y));
	}

	.is-platform {
		.install__mark {
			background: var(--badge-fill)
				linear-gradient(155deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 55%, rgba(0, 0, 0, 0.06));
		}

		.install__icon {
			filter: brightness(0) invert(1);
		}
	}

	.install__label,
	.install__group-title {
		margin: 0 0 $spacing-3;
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		line-height: $line-height-tight;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.install__label {
		margin-bottom: $spacing-1;
	}

	.install__title {
		font-size: $font-size-3xl;
		font-weight: $font-weight-bold;
		line-height: $line-height-tight;
		margin: 0;
		color: var(--color-text);
	}

	// "On-premises" never breaks at its hyphen.
	.install__title-accent {
		color: var(--badge-fill);
		white-space: nowrap;
	}

	.install__grid {
		display: grid;
		grid-template-columns: minmax(0, 13fr) minmax(0, 10fr);
		gap: $spacing-8 $spacing-10;
		align-items: start;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.install__text {
		@include text-m;
		line-height: 24px;

		max-width: 46ch;
		margin: 0;
	}

	.install__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-3 $spacing-4;
		margin-top: $spacing-6;
	}

	.install__button {
		@include button-base;

		gap: $spacing-2;
		height: 44px;
		padding: 0 $spacing-4;
		font-weight: $font-weight-bold;
		line-height: 20px;
		border: 1px solid var(--color-border-light);
		border-radius: $radius-md;
		background: transparent;
		color: var(--color-text);

		:global(svg) {
			width: 20px;
			height: 20px;
		}

		&:hover {
			background-color: var(--color-bg-light);
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 3px;
		}

		.is-platform & {
			border-color: var(--badge-fill);
			background-color: var(--badge-fill);
			color: #fff;

			&:hover {
				background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
			}

			&:focus-visible {
				outline-color: var(--badge-fill);
			}
		}
	}

	.install__link {
		@include text-m;
		line-height: 24px;

		font-weight: $font-weight-medium;

		display: inline-flex;
		align-items: center;
		gap: $spacing-1;
		color: var(--color-brand);
		text-decoration: none;

		:global(svg) {
			width: 1.1em;
			height: 1.1em;
		}

		&:hover {
			text-decoration: underline;
		}
	}

	.install__regions {
		max-width: 480px;
		margin-top: $spacing-6;

		.install__group-title {
			color: var(--badge-fill);
		}

		ul {
			display: grid;
			gap: $spacing-3;
			margin: 0;
			padding: 0;
			list-style: none;
		}
	}

	.install__region {
		display: flex;
		align-items: center;
		gap: $spacing-3;
		padding: $spacing-3 $spacing-4;
		border-radius: $radius-lg;
		background: var(--color-bg-surface);
		box-shadow:
			0 1px 2px rgba(23, 24, 28, 0.06),
			0 6px 18px rgba(23, 24, 28, 0.06);
		color: var(--color-text);
		text-decoration: none;

		&:hover {
			box-shadow:
				0 1px 2px rgba(23, 24, 28, 0.08),
				0 10px 24px rgba(23, 24, 28, 0.1);
		}

		&:focus-visible {
			outline: 2px solid var(--badge-fill);
			outline-offset: 3px;
		}
	}

	.install__region-globe {
		display: grid;
		flex: none;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--region-hue) 14%, #fff);
		color: var(--region-hue);

		:global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	.install__region-name {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
		font-weight: $font-weight-bold;
		line-height: 1.3;

		small {
			@include text-s;
			line-height: 22px;

			font-weight: $font-weight-normal;
			color: var(--color-text-secondary);
		}
	}

	.install__region-tag {
		display: inline-flex;
		align-items: center;
		height: 22px;
		margin-left: $spacing-2;
		padding: 0 $spacing-2;
		border-radius: $radius-full;
		background: color-mix(in srgb, var(--color-brand) 10%, transparent);
		font-size: 12px;
		font-weight: $font-weight-medium;
		line-height: 1;
		color: var(--color-brand);
		vertical-align: middle;
		white-space: nowrap;

		&[hidden] {
			display: none;
		}
	}

	.install__region-cta {
		@include text-s;
		line-height: 22px;

		font-weight: $font-weight-medium;

		display: inline-flex;
		flex: none;
		align-items: center;
		gap: $spacing-1;
		color: var(--badge-fill);

		:global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	.install__panel {
		display: grid;
		gap: $spacing-5;
		padding: $spacing-5;
		border-radius: $radius-xl;
		background: var(--color-bg-surface);
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.06),
			0 18px 40px -18px rgba(16, 24, 40, 0.22);

		@include media-down(sm) {
			padding: $spacing-4;
		}
	}

	// AWS's mark is a wordmark, so it runs larger to match the glyphs' visual height.
	.install__hosts {
		display: flex;
		align-items: center;
		gap: $spacing-6;
		margin: 0 0 $spacing-5;
		padding: 0;
		list-style: none;
		color: var(--color-text-secondary);

		li {
			display: flex;
		}

		:global(svg) {
			width: 32px;
			height: 32px;
		}

		:global([data-icon='simple-icons:amazonwebservices']) {
			width: 48px;
			height: 48px;
			margin-block: -8px;
		}
	}

	.install__aside .install__actions {
		margin-top: $spacing-3;
	}

	.install__aside-title {
		@include text-m;
		line-height: 20px;

		font-weight: $font-weight-bold;

		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin: 0 0 $spacing-3;

		:global(svg) {
			flex: none;
			width: 24px;
			height: 24px;
			color: var(--badge-fill);
		}
	}

	.install__chips {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.install__chip {
		@include text-m;
		line-height: 24px;

		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		min-height: 40px;
		padding: $spacing-1 $spacing-4;
		border: 1px solid var(--color-border-light);
		border-radius: $radius-full;
		font-weight: $font-weight-medium;
		text-decoration: none;

		:global(img) {
			flex: none;
			width: auto;
			height: 20px;
		}

		&:hover {
			border-color: var(--color-text-secondary);
			background: var(--color-bg-light);
		}
	}

	.install__chip-note {
		color: var(--color-text-secondary);
		font-weight: $font-weight-normal;
	}

	@media print {
		.install {
			padding-bottom: 0;
		}

		.install__intro {
			padding-block: 0 $spacing-8;
		}

		.install__product {
			padding-block: $spacing-5;

			&.is-band {
				background: none;

				+ .install__product {
					border-top: 1px solid var(--color-border);
				}
			}
		}

		.install__head {
			break-inside: avoid;
			break-after: avoid;
		}

		.install__mark {
			--tile: 56px;

			box-shadow: none;
		}

		.is-platform .install__mark {
			@include print-exact;
		}

		.install__region,
		.install__panel {
			border: 1px solid var(--color-border);
			box-shadow: none;
		}

		.install__grid {
			display: block;
		}

		.install__regions,
		.install__panel {
			break-inside: avoid;
		}

		.install__panel {
			margin-top: $spacing-5;
		}
	}
</style>

<script>
	import { nearestCloudRegion, writeLastRegion, type CloudRegionId } from '@util/cloud-regions';

	const nearest = nearestCloudRegion();
	for (const card of document.querySelectorAll<HTMLElement>('.install__region')) {
		card.querySelector<HTMLElement>('.install__region-tag')!.hidden = card.dataset.region !== nearest;
		// The sign-in dialog offers the last region signed up in first, as its own cards do.
		card.addEventListener('click', () => writeLastRegion(card.dataset.region as CloudRegionId));
	}

	// The old tabbed page's addresses, which docs pages still link: `?product=thingsboard-cloud`, `#tab-thingsboard-pe`.
	// A Map, not an object: `?product=constructor` must not resolve to a prototype member.
	const LEGACY = new Map([
		['thingsboard-cloud', 'cloud'],
		['thingsboard-pe', 'on-premises'],
		['thingsboard-ce', 'on-premises'],
		['thingsboard-edge', 'edge'],
		['thingsboard-trendz', 'trendz'],
	]);
	const url = new URL(location.href);
	const legacy = LEGACY.get(url.searchParams.get('product') ?? '') ?? LEGACY.get(url.hash.replace('#tab-', ''));
	if (legacy) {
		url.searchParams.delete('product');
		url.hash = legacy;
		history.replaceState(null, '', url);
		document.getElementById(legacy)!.scrollIntoView({ behavior: 'instant' });
	}

	const root = document.documentElement;
	const nav = document.querySelector<HTMLElement>('.install-nav')!;
	const list = nav.querySelector('ul')!;
	const links = [...nav.querySelectorAll('a')];
	const sections = links.map((a) => document.getElementById(a.hash.slice(1))!);
	let current = -1;
	let frame = 0;

	const update = () => {
		frame = 0;
		const stuck = nav.getBoundingClientRect().top <= parseFloat(getComputedStyle(nav).top) + 0.5;
		nav.toggleAttribute('data-stuck', stuck);
		root.toggleAttribute('data-install-nav-stuck', stuck);

		// The section being read: the last whose top has passed a quarter of the view under the bars;
		// at the end of the page, the last one, however short.
		const pad = parseFloat(getComputedStyle(root).scrollPaddingTop);
		const line = pad + (innerHeight - pad) / 4;
		const next =
			scrollY + innerHeight >= root.scrollHeight - 2
				? sections.length - 1
				: sections.findLastIndex((s) => s.getBoundingClientRect().top <= line);
		if (next === current) return;
		current = next;
		links.forEach((a, i) =>
			i === current ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')
		);
		// On a phone the row scrolls sideways: keep the lit link in its middle.
		const lit = links[current];
		if (lit && list.scrollWidth > list.clientWidth) {
			list.scrollTo({ left: lit.offsetLeft - (list.clientWidth - lit.offsetWidth) / 2, behavior: 'smooth' });
		}
	};

	const schedule = () => {
		frame ||= requestAnimationFrame(update);
	};
	addEventListener('scroll', schedule, { passive: true });
	addEventListener('resize', schedule);
	update();
</script>
