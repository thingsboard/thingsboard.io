---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import SvgObject from '@components/SvgObject.astro';
---

<BaseLayout
	forceLightTheme
	title="ThingsBoard choose region"
	description="ThingsBoard is an IoT platform for device management, data collection, processing and visualization for your IoT projects"
	noIndex
	ownsCloudSignupIds
>
	<section class="intro">
		<h1>Where should we store your data?</h1>
		<div class="details">
			<p class="margin">Pick a cluster for localized performance and regulatory compliance.</p>
		</div>
		<div class="region-button-section">
			<Button
				href="https://thingsboard.cloud/signup"
				size="lg"
				class="region-button gtm_button"
				attrs={{ id: 'TryItNow_Cloud_NorthAmerica', 'data-region': 'north-america' }}
			>
				North America
			</Button>
			<Button
				href="https://eu.thingsboard.cloud/signup"
				size="lg"
				class="region-button gtm_button"
				attrs={{ id: 'TryItNow_Cloud_Europe', 'data-region': 'europe' }}
			>
				Europe
			</Button>
		</div>
	</section>

	<section class="map-container">
		<SvgObject id="map" src="/images/region-map.svg" width={1515} height={493} />
	</section>
</BaseLayout>

<script>
	// Looks the map up on each hover: after a restore the <object> is a new element.
	const regionOnMap = (region: string | undefined) => {
		const map = document.getElementById('map') as HTMLObjectElement | null;
		return region ? map?.contentDocument?.querySelector('.' + region) : null;
	};

	document.querySelectorAll<HTMLElement>('.region-button').forEach((button) => {
		button.addEventListener('mouseenter', () => {
			regionOnMap(button.dataset.region)?.classList.add('region-selected');
		});
		button.addEventListener('mouseleave', () => {
			regionOnMap(button.dataset.region)?.classList.remove('region-selected');
		});
	});
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.intro {
		padding: 40px 30px 55px;
		width: 830px;
		max-width: 100%;
		margin: 0 auto;
		text-align: center;

		@media (max-width: 1279px) {
			padding: 24px 12px 55px;
		}

		@media (max-width: 959px) {
			padding: 16px 24px 48px;
		}

		@media (max-width: 599px) {
			padding: 12px 16px 24px;
		}

		h1 {
			font-size: 48px;
			font-weight: 600;
			line-height: 54px;
			margin-bottom: 24px;

			@media (max-width: 599px) {
				font-size: 32px;
			}
		}

		.details {
			color: #707275;
			margin-bottom: 40px;

			@media (max-width: 599px) {
				margin-bottom: 24px;
			}

			p {
				font-size: 18px;
				line-height: 28px;
				letter-spacing: 0.027px;

				&.margin {
					margin-bottom: 1rem;
				}

				@media (max-width: 599px) {
					font-size: 16px;
					line-height: 24px;
				}
			}
		}

		.region-button-section {
			display: flex;
			gap: 24px;

			@media (max-width: 959px) {
				justify-content: center;
				align-items: center;
			}

			@media (max-width: 599px) {
				flex-direction: column;
			}

			.region-button {
				flex: 1;

				@media (max-width: 959px) {
					width: 200px;
					max-width: 200px;
				}
			}
		}
	}

	.map-container {
		margin-bottom: 55px;
		padding-left: 0;
		padding-right: 0;

		:global(.svg-object) {
			width: 90%;
			max-width: 1550px;
			margin: 0 auto;
		}

		@media (max-width: 959px) {
			padding-left: 24px;
			padding-right: 24px;

			:global(.svg-object) {
				width: 100%;
			}
		}

		@media (max-width: 599px) {
			margin-bottom: 40px;
			padding-left: 16px;
			padding-right: 16px;
		}
	}

	@media print {
		.intro .region-button-section .region-button {
			color: var(--color-text);
			background: none;
			border-color: transparent;
		}
	}
</style>
