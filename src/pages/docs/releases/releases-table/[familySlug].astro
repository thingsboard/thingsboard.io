
---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { RELEASE_FAMILIES, familySlug } from '~/models/releases-table';
import { docsAnnouncements } from '@data/docsAnnouncements';
import { Products } from '@models/site.models';
import { hasCommunityRelease } from '@models/community-cutoff';

export function getStaticPaths() {
	return RELEASE_FAMILIES.filter((f) => hasCommunityRelease(f.family)).map((f) => ({
		params: { familySlug: familySlug(f.family) },
		props: { family: f },
	}));
}

const { family: f } = Astro.props;
const slug = familySlug(f.family);

const title = `ThingsBoard v${f.family}.x Release Notes`;
const description = `ThingsBoard v${f.family}.x release notes — features, improvements, and bug fixes.`;

const allNotes = import.meta.glob<{
	default: any;
	getHeadings: () => { depth: number; slug: string; text: string }[];
}>('/src/content/_includes/docs/releases/*.mdx', { eager: true });
const notesModule = allNotes[`/src/content/_includes/docs/releases/${slug}.mdx`];
const NotesComponent = notesModule?.default;
const headings = notesModule?.getHeadings?.() ?? [];

const backUrl = '/docs/releases/releases-table/';

// This route renders through StarlightPage, whose synthetic entry id is not a
// content-collection id — so `routeData`'s twin lookup cannot resolve it and the
// per-product notice would be silently skipped. Opt in via page-level
// frontmatter: same announcement object (same id → shared dismissal state, and
// the same shared guide CTA every other announced page gets).
//
// The other CE route in this position, `installation/upgrade-instructions/`, is
// deliberately left out rather than overlooked: those pages are the sole entry
// in `selfCanonicalSegments` (upgrade steps genuinely differ per edition, so
// they are not consolidated to PE), and their notice is being decided with the
// rest of that tree. A new dynamic CE route needs this opt-in — nothing in the
// lint or slugcheck harness will flag its absence.
const ceAnnouncement = docsAnnouncements[Products.CE];
// Deep-cloned for the same reason `routeData` deep-clones it: the entry is a
// module-level singleton shared by every announced page, and a shallow copy would
// still hand out the same nested `cta`. Guarded, because cloning `undefined`
// would inject an empty banner once the announcement expires.
const announcement = ceAnnouncement && structuredClone(ceAnnouncement);

const frontmatter = { title, description, tableOfContents: true, ...(announcement && { announcement }) };
---

<StarlightPage {frontmatter} {headings}>
	<p class="print:hidden"><a href={backUrl}>&larr; Back to all releases</a></p>
	{NotesComponent && <NotesComponent />}
</StarlightPage>
