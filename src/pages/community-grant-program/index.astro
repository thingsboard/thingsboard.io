			gap: $spacing-6;
			list-style: none;
			padding: 0;
			margin: $spacing-6 0;

			// The rail, run through the centre of the 40px markers.
			&::before {
				content: '';
				position: absolute;
				left: 0;
				right: 0;
				top: 20px;
