---
import BaseLayout from '@layouts/BaseLayout.astro';
import DataTable from '@components/DataTable.astro';
import FaqSection from '@components/Pricing/FaqSection.astro';
import NButton from '@components/Landing/NButton.astro';
import AnnouncementDate from '@components/CommunityGrant/AnnouncementDate.astro';
import { Icon } from 'astro-icon/components';
import type { DataTableColumn } from '@models/data-table';
import { announcementDateHtml } from '@data/community-grant/announcement-date';
import { CONTACT, communityGrantFaq } from '@data/community-grant/faq';
import { SOURCE_AVAILABLE_FROM_VER } from '@data/versions';
import {
	LTS_4_2_EOL,
	LTS_4_2_EOL_ISO,
	REGISTRATION_CLOSES,
	REGISTRATION_CLOSES_ISO,
} from '@data/community-grant/key-dates';

// The guide for Community Edition users moving to the source-available
// releases. Linked from the notice on every announced CE docs page
// (`@data/docsAnnouncements`), the relicensing post and its FAQ, and the
// company history. Copy is marketing's; the announcement day it keeps
// referring to comes from `@data/versions` through <AnnouncementDate />.

// Registration happens in the License Portal; every "register" action goes there.
const LICENSE_PORTAL = 'https://license.thingsboard.io/';
// Registration starts inside the deployment, not in the Portal — the Portal is step four.
const REGISTER_GUIDE = '/docs/installation/register-community-grant/';

// `granted` is stated, not derived: the 100-device floor and the 1,000-device
// cap both bend the 10% rule, and the table exists to show where they bite.
//
// `note` marks a row the 10% rule alone does not explain. On the 30-device row
// the rule gives 10 extra devices; the other 60 come from the 100-device floor,
// so the Headroom column there reports the floor rather than the rule — say so
// in the cell, the way the FAQ's copy of this list writes "(minimum applies)".
const CAPACITY_ROWS: { devices: number; granted: number; note?: string }[] = [
	{ devices: 30, granted: 100, note: 'minimum' },
	{ devices: 104, granted: 124 },
	{ devices: 500, granted: 550 },
	{ devices: 3_268, granted: 3_598 },
	{ devices: 15_000, granted: 16_000 },
];

const CAPACITY_EXAMPLES = CAPACITY_ROWS.map(({ devices, granted, note }) => {
	const baseShare = Math.round((devices / granted) * 1000) / 10;
	return {
		devices,
		granted,
		note,
		headroom: granted - devices,
		baseShare,
		extraShare: Math.round((100 - baseShare) * 10) / 10,
	};
});

const CAPACITY_COLUMNS: DataTableColumn[] = [
	{ label: 'Your devices' },
	{ label: 'Headroom' },
	{ label: 'Granted' },
	{ label: 'Share of your grant', width: '38%' },
];

const OUTCOMES = [
	{
		situation: 'Small workshop',
		size: '30 devices',
		covers:
			'100 devices. The calculation gives 40, so the 100-device minimum applies instead — more than triple what you were running.',
	},
	{
		situation: 'Internal production system',
		size: '5,500 devices',
		covers: '6,050 devices: 5,500 existing plus 550 headroom.',
	},
	{
		situation: 'White-labeled deployment',
		size: '30,000 devices, branding already removed',
		covers: '31,000 devices — 30,000 plus the 1,000-device cap. Your branding stays exactly as it stood, at no charge.',
	},
	{
		situation: 'HA cluster',
		size: '3 production servers',
		covers: 'All 3 servers. There is no penalty for running a fault-tolerant setup.',
	},
];

const OUTCOME_COLUMNS: DataTableColumn[] = [
	{ label: 'Your situation', width: '16rem' },
	{ label: 'What your grant covers' },
];

const fmt = (n: number) => n.toLocaleString('en-US');
---

<BaseLayout
	headerVariant="solid-shadow"
	showSearch={true}
	showThemeToggle={true}
	title="Community Grant Program"
	description={`Keep your existing ThingsBoard Community Edition deployment running free forever at the scale you already use. Register by ${REGISTRATION_CLOSES}.`}
>
	<div class="cg-page">
		<section class="cg-hero">
			<h1>Community Grant Program</h1>
			<p class="cg-hero__lede">
				Keep running your existing ThingsBoard Community Edition deployment free forever, at the scale you already use
				today.
			</p>
			<NButton href={REGISTER_GUIDE} variant="filled" size="lg">
				Register your deployment
			</NButton>
			<p class="cg-hero__deadline">
				Registration closes {REGISTRATION_CLOSES}. After that date, a deployment can no longer receive a grant.
			</p>
		</section>

		<div class="cg-section cg-prose">
			<p>
				Nobody who runs ThingsBoard today will ever pay for what they already have. The Community Grant Program ensures
				that existing ThingsBoard Community Edition deployments can continue running free forever at the scale they
				already use today. Register your installation once and keep running at your current scale free of charge as you
				upgrade to ThingsBoard {SOURCE_AVAILABLE_FROM_VER} and future releases.
			</p>
			<p>
				With ThingsBoard {SOURCE_AVAILABLE_FROM_VER} we unified Community Edition and Professional Edition into a single
				platform. Community Edition was licensed under Apache 2.0; from {SOURCE_AVAILABLE_FROM_VER} onward the unified
				platform is licensed under the Business Source License 1.1. The full reasoning and what changes for existing
				users are in the <a href="/blog/one-thingsboard-source-available/">re-licensing announcement</a>.
			</p>
		</div>

		<section class="cg-section cg-prose" aria-labelledby="tldr-title">
			<div class="cg-tldr">
				<h2 id="tldr-title">TL;DR</h2>
				<ul role="list">
					{[
						`Everything you were already running on ${announcementDateHtml} stays free after registration in the Community Grant Program.`,
						'Your grant covers that device and server count, plus 10% headroom for devices — up to 1,000 extra.',
						'Advanced security comes free: fine-grained RBAC, SSO and OAuth2, and Secrets Storage — previously Professional Edition only.',
						'Need more features? Add the optional Professional Pack for white-labeling, integrations, the scheduler, reporting, and Help Desk support — one flat price, available only to Community Grant participants.',
						'No back payment, no penalties, no fees for past use. Ever.',
						`Registration is free and self-service, and it closes ${REGISTRATION_CLOSES}.`,
					].map((point) => (
						<li>
							<Icon name="tabler:check" aria-hidden="true" />
							<span set:html={point} />
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="cg-section cg-prose" id="who-can-register">
			<h2>Who can register</h2>
			<p>
				Have you already run a ThingsBoard Community Edition deployment in production before <AnnouncementDate />? You
				can apply.
			</p>
			<p>
				Register for the Community Grant Program — it is free, self-service, and usually takes under a minute. To
				register, your deployment must run the latest 4.3 LTS patch. Registration and verification run from inside the
				platform, and older versions cannot apply without updating first — follow the{' '}
				<a href="/docs/installation/upgrade-instructions/">Community Edition upgrade instructions</a> if you are not on
				it yet.
			</p>
			<p>A grant belongs to your organization and attaches to one deployment.</p>
			<p>
				A grant cannot be sold or transferred to another organization, but it does survive a merger, acquisition, or
				change of control.
			</p>
		</section>

		<section class="cg-section cg-prose" id="what-is-included">
			<h2>What your Community Grant includes</h2>
			<ul class="cg-list" role="list">
				<li>Your existing deployment at your registered scale, permanently, at no charge.</li>
				<li>
					Your device count on <AnnouncementDate /> plus 10% headroom, rounded up to the next 10. At least 10 extra
					devices, capped at 1,000, and never fewer than 100 devices in total.
				</li>
				<li>Your production server count as registered. No extra headroom — you keep exactly what you were running.</li>
				<li>Fine-grained RBAC, SSO and OAuth2, and Secrets Storage, at no charge.</li>
				<li>5M AI tokens for the platform's built-in AI features, included for faster solution improvement.</li>
				<li>
					ThingsBoard {SOURCE_AVAILABLE_FROM_VER} and every later release, free, while you stay within your granted
					capacity.
				</li>
				<li>
					If you had already removed ThingsBoard branding before <AnnouncementDate />, keep it exactly as it stood.
				</li>
				<li>Renewal not required. Your grant does not expire.</li>
			</ul>
		</section>

		<section class="cg-section cg-prose" id="capacity">
			<h2>How your capacity is calculated</h2>
			<p>
				Your grant is calculated once, at registration, from the deployment you were already running on{' '}
				<AnnouncementDate />.
			</p>

			<div class="cg-formula">
				<div class="cg-formula__box">
					<span class="cg-formula__label">Baseline</span>
					<span class="cg-formula__main">
						Your devices on <AnnouncementDate />
					</span>
					<span class="cg-formula__note">Read from your own deployment during registration.</span>
				</div>
				<span class="cg-formula__op">+</span>
				<div class="cg-formula__box">
					<span class="cg-formula__label">Headroom</span>
					<span class="cg-formula__main">10%, rounded up to the next 10</span>
					<span class="cg-formula__note">Never fewer than 10 devices. Never more than 1,000.</span>
				</div>
				<span class="cg-formula__op">=</span>
				<div class="cg-formula__box cg-formula__box--result">
					<span class="cg-formula__label">Your granted capacity</span>
					<span class="cg-formula__main">Yours, free, permanently</span>
					<span class="cg-formula__note">Minimum 100 devices, whatever your count.</span>
				</div>
			</div>

			<p class="cg-callout">
				<strong>A worked example.</strong> You run 3,268 devices. Ten percent of that is 326.8, which rounds up to 330.
				Your grant covers 3,598 devices — and you never pay for any of them.
			</p>

			<DataTable
				class="cg-table cg-table--capacity"
				caption="How the rules land at different sizes"
				captionVisible
				columns={CAPACITY_COLUMNS}
				scrollable
				scrollClass="cg-table-scroll"
			>
				{CAPACITY_EXAMPLES.map((row) => (
					<tr>
						<th scope="row">{fmt(row.devices)}</th>
						<td>
							{`+${fmt(row.headroom)}`}
							{row.note && <span class="cg-table__sub">({row.note})</span>}
						</td>
						<td>{fmt(row.granted)}</td>
						<td>
							<span class="cg-bar" aria-hidden="true">
								<span class="cg-bar__base" style={`width:${row.baseShare}%`} />
								<span class="cg-bar__extra" style={`width:${row.extraShare}%`} />
							</span>
							<span class="visually-hidden">
								{row.baseShare}% what you were already running, {row.extraShare}% free headroom
							</span>
						</td>
					</tr>
				))}
			</DataTable>
			<div class="cg-legend">
				<span>
					<i class="cg-legend__swatch cg-legend__swatch--base" aria-hidden="true"></i>What you were already running
				</span>
				<span>
					<i class="cg-legend__swatch cg-legend__swatch--extra" aria-hidden="true"></i>Free headroom on top
				</span>
			</div>

			<h3>How devices are counted</h3>
			<p>
				We count the individual units you monitor or control, not tags, data points, or platform records. A pump with
				five temperature sensors, five flow meters, three pressure sensors, a PLC, and a gateway is one device — all
				those readings describe the same machine. A fleet of 50 trucks is 50 devices. One gateway forwarding data from
				sensors in 100 rooms is 100 devices, one per monitored room. Gateways and other intermediaries are not counted
				for data they merely forward, and how you model things on the platform does not change the count.
			</p>

			<h3>What counts as a production server</h3>
			<p>
				One running ThingsBoard server process that serves your business. Run ThingsBoard on a single machine and that
				is one. Run three for high availability and that is three — all three are covered, with no penalty for your
				current setup. Registration reads this number from your deployment, so you do not need to work it out yourself.
			</p>

			<h3>Four deployments, four outcomes</h3>
			<DataTable
				class="cg-table cg-table--outcomes"
				caption="What the grant covers for four example deployments"
				columns={OUTCOME_COLUMNS}
			>
				{OUTCOMES.map((row) => (
					<tr>
						<th scope="row">
							<span class="cg-table__lead">{row.situation}</span>
							<span class="cg-table__sub">{row.size}</span>
						</th>
						<td>{row.covers}</td>
					</tr>
				))}
			</DataTable>

			<h3>If you outgrow your capacity</h3>
			<p>
				Nothing breaks when you reach your limit. Existing devices, data, and services keep running normally; new
				devices above your capacity are simply not added, and the platform shows a prompt to increase your licensed
				capacity.
			</p>
			<p>
				You can add devices yourself, at any time, straight from the License Portal. It is self-service, it takes effect
				immediately, and nothing about your running solution stops while you do it. Devices are sold individually at up
				to 1 USD each, and the price per device goes down as the volume grows. Everything your grant already covers
				stays free.
			</p>
		</section>

		<section class="cg-section cg-prose" id="professional-pack">
			<h2>Professional Pack</h2>
			<p>
				The Professional Pack is an optional add-on that lets you buy the features that were previously available only
				in Professional Edition, in a single one-time payment. You buy it once, only if you need it, and it is available
				exclusively to Community Grant participants.
			</p>
			<p>
				It is not time-limited: you can take it whenever the need appears, including after registration closes on
				{REGISTRATION_CLOSES}. It does not change your granted capacity — your device, production server, and Edge
				counts stay exactly as granted, and the guarantees attached to your grant stay intact.
			</p>
			<div class="cg-pack">
				<h3>What it unlocks</h3>
				<p class="cg-pack__price">2,999 USD, once, per deployment — whatever its size</p>
				<ul class="cg-list" role="list">
					<li>
						<strong>Integrations</strong> — connect third-party platforms, protocols, and clouds without building the
						bridge yourself
					</li>
					<li>
						<strong>Scheduler</strong> — run actions and jobs on a timetable
					</li>
					<li>
						<strong>Reporting</strong> — generate and deliver reports from your dashboards
					</li>
					<li>
						<strong>White-labeling features</strong> — manage branding from the interface, without modifying the source
						code
					</li>
					<li>
						<strong>Help Desk</strong> — our official support channel, included with the first year of maintenance
					</li>
				</ul>
			</div>
		</section>

		<section class="cg-section cg-prose" id="how-to-register">
			<h2>How registration works</h2>
			<p>
				Before you start, update your deployment to the latest 4.3 LTS patch. This step is required: registration runs
				from inside the platform and older versions cannot generate the report.
			</p>
			<p>
				Registration runs from inside your deployment: a read-only check produces one small encrypted report, you
				sign in to the{' '}
				<a href={LICENSE_PORTAL} target="_blank" rel="noopener noreferrer">
					License Portal
				</a>{' '}
				to accept the <a href="/legal/community-grant-license-agreement/">Community Grant License Agreement</a>, and your
				perpetual key is issued to your Portal account. Most deployments are verified automatically; larger ones may need
				a short review. The <a href={REGISTER_GUIDE}>step-by-step guide</a> walks through it.
			</p>
			<p>
				The report contains structural information only: entity counts, creation timestamps, table sizes, and your
				deployment's identifiers. It never includes telemetry values, device names, or dashboard contents, and you never
				upload your database.
			</p>
		</section>

		<section class="cg-section cg-prose" id="key-dates">
			<h2>Key dates</h2>
			<ol class="cg-timeline" role="list">
				<li class="cg-timeline__item">
					<span class="cg-timeline__marker" aria-hidden="true">
						<Icon name="tabler:speakerphone" />
					</span>
					<span class="cg-timeline__date">
						<AnnouncementDate />
					</span>
					<p>
						Registration opens. Your deployment size is measured against this date, so anything added later is not part
						of your grant.
					</p>
				</li>
				<li class="cg-timeline__item">
					<span class="cg-timeline__marker" aria-hidden="true">
						<Icon name="tabler:shield-off" />
					</span>
					<time class="cg-timeline__date" datetime={LTS_4_2_EOL_ISO}>
						{LTS_4_2_EOL}
					</time>
					<p>Community Edition 4.2 LTS stops receiving security updates.</p>
				</li>
				<li class="cg-timeline__item cg-timeline__item--last">
					<span class="cg-timeline__marker" aria-hidden="true">
						<Icon name="tabler:calendar-x" />
					</span>
					<time class="cg-timeline__date" datetime={REGISTRATION_CLOSES_ISO}>
						{REGISTRATION_CLOSES}
					</time>
					<p>
						Registration closes. Community Edition 4.3 LTS stops receiving security updates, and grandfathered branding
						rights can no longer be registered.
					</p>
				</li>
			</ol>
			<p>
				There is no advantage to waiting and none to rushing: your grant is calculated from <AnnouncementDate /> either
				way.
			</p>
		</section>

		<section class="cg-section" id="faq">
			<h2>Frequently asked questions</h2>
			<FaqSection contextId="community-grant" categories={communityGrantFaq} visibleCount={8} jsonLd />
		</section>

		<section class="cg-section cg-prose cg-closing" aria-labelledby="closing-title">
			<h2 id="closing-title">Register once. Keep your platform.</h2>
			<p>
				Free, self-service, and usually under a minute. If you operate a large deployment, an air-gapped one, or
				anything that does not fit the cases above, <a href={CONTACT}>contact us</a> and we will work it out with you.
			</p>
			<div class="cg-closing__actions">
				<NButton href={REGISTER_GUIDE} variant="filled" size="lg">
					Register your deployment
				</NButton>
				<NButton href={CONTACT} variant="outlined" size="lg">
					Contact us
				</NButton>
			</div>
		</section>
	</div>
</BaseLayout>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// The artwork has transparent rounded corners; the gradient repeats its edge colours to hide them.
	// Wide screens crop its dark top and bottom margins so it stays shorter than the hero below.
	// Global, nested under the page class: the two tables' shells are DataTable's,
	// so a scoped `th`/`td` rule would carry this page's hash and never match them.
	// Running text is styled through `.cg-prose` rather than bare element rules
	// because the FAQ section renders its own `p`/`h3` and must keep them.
	.cg-page {
		// The site's default content container (1080px with 20px gutters), as the
		// blog, use-case and case-study pages use.
		@include container;
		padding-bottom: $spacing-16;

		// The "free headroom" green: check marks, the bar's extra segment and the
		// result box. A cool emerald rather than the site's `--color-success`, whose
		// yellow-leaning green fights the brand indigo it sits next to here; the dark
		// theme lifts it a step, as the indigo itself is lifted there.
		--cg-green: #2fa37a;

		[data-theme='dark'] & {
			--cg-green: #41b48b;
		}

		// ── Hero ──
		.cg-hero {
			padding: $spacing-16 0 $spacing-12;
			border-bottom: 1px solid var(--color-border);

			h1 {
				@include page-title;
				color: var(--color-text);
				margin: 0 0 $spacing-5;
			}

			&__lede {
				@include text-overlay;
				font-weight: $font-weight-normal;
				color: var(--color-text-secondary);
				margin: 0 0 $spacing-8;
			}

			&__deadline {
				@include text-s;
				color: var(--color-text-muted);
				margin: $spacing-6 0 0;
			}
		}

		// ── Sections ──
		.cg-section {
			padding: $spacing-12 0;
			border-top: 1px solid var(--color-border);
			scroll-margin-top: calc(var(--sl-nav-height) + #{$spacing-6});

			> h2 {
				@include subsection-title;
				color: var(--color-text);
				margin: 0 0 $spacing-5;
			}
		}

		// The hero already draws the rule above the first section.
		.cg-hero + .cg-section {
			border-top: 0;
		}

		// ── Running text ──
		.cg-prose {
			p {
				@include text-m;
				color: var(--color-text-secondary);
				margin: 0 0 $spacing-4;
			}

			h3 {
				@include card-title-sm;
				color: var(--color-text);
				margin: $spacing-8 0 $spacing-3;
			}

			a:not(.n-button) {
				color: var(--color-primary);
				text-decoration: none;

				&:hover {
					text-decoration: underline;
				}
			}

			strong {
				color: var(--color-text);
				font-weight: $font-weight-semibold;
			}

			.cg-callout {
				padding: $spacing-3 $spacing-4;
				margin-bottom: $spacing-6;
				border-left: 3px solid var(--color-primary);
				border-radius: 0 $radius-md $radius-md 0;
				background: var(--color-bg-light);
			}

			.cg-pack__price {
				@include text-s;
				color: var(--color-text-muted);
				margin: 0 0 $spacing-4;
			}

			.cg-timeline p {
				@include text-s;
				color: var(--color-text-secondary);
				margin: 0;
			}
		}

		// Bulleted list — the accent dot is the list marker.
		.cg-list {
			list-style: none;
			padding: 0;
			margin: 0 0 $spacing-4;

			li {
				@include text-m;
				color: var(--color-text-secondary);
				position: relative;
				padding-left: $spacing-6;
				margin-bottom: $spacing-3;

				// Centred on the first line of 28px text.
				&::before {
					content: '';
					position: absolute;
					left: 0;
					top: 10px;
					width: 0.5rem;
					height: 0.5rem;
					border-radius: 50%;
					background: var(--color-primary);
				}
			}
		}

		// ── TL;DR panel ──
		.cg-tldr {
			padding: $spacing-8;
			border: 1px solid var(--color-border);
			border-radius: $radius-lg;
			background: var(--color-bg-light);

			h2 {
				@include card-title;
				color: var(--color-text);
				margin: 0 0 $spacing-5;
			}

			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			li {
				@include text-m;
				color: var(--color-text);
				display: grid;
				grid-template-columns: 1.25rem 1fr;
				gap: $spacing-3;
				margin-bottom: $spacing-3;

				&:last-child {
					margin-bottom: 0;
				}
			}

			svg {
				width: 1.25rem;
				height: 1.25rem;
				margin-top: 0.25rem;
				color: var(--cg-green);
			}
		}

		// ── Capacity formula ──
		.cg-formula {
			display: flex;
			flex-wrap: wrap;
			align-items: stretch;
			gap: $spacing-3;
			margin: $spacing-6 0 $spacing-5;

			@include media-down(md) {
				flex-direction: column;
			}

			&__box {
				flex: 1 1 12rem;
				display: flex;
				flex-direction: column;
				gap: $spacing-1;
				padding: $spacing-4 $spacing-5;
				border: 1px solid var(--color-border);
				border-radius: $radius-md;
				background: var(--color-bg-light);

				&--result {
					background: color-mix(in srgb, var(--cg-green) 10%, var(--color-bg-surface));
					border-color: color-mix(in srgb, var(--cg-green) 35%, transparent);
