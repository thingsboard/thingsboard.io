---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductHero from '@components/Landing/ProductHero.astro';
import BenefitGrid from '@components/Landing/BenefitGrid.astro';
import ProductComparisonTable from '@components/Landing/ProductComparisonTable.astro';
import ChoiceBand from '@components/Landing/ChoiceBand.astro';
import ClosingCta from '@components/Landing/ClosingCta.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';
import { ONPREM_COMPARISON_COLUMNS, onPremComparison } from '@data/onprem-comparison';
import { onPremFaq } from '@data/onprem-faq';
import { onPremBenefits, onPremChoice, onPremCtas, onPremHeroCaption } from '@data/onprem-page';

// The non-breaking hyphen (U+2011) keeps "On-premises" on one line. Headings only: in `<title>`
// or meta it would break a reader's search for the plain hyphen.
const NAME = 'ThingsBoard On\u2011premises';
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="On-premises IoT Platform"
	description="Deploy ThingsBoard on-premises or in your own cloud with full control of infrastructure, data location and compliance. Subscription or perpetual license."
>
	<ProductHero
		title={NAME}
		subtitle="Device management, data processing and visualization — the complete platform, running on infrastructure you choose, with full control of data location and compliance."
		buttons={[onPremCtas.install, onPremCtas.secondary]}
		caption={onPremHeroCaption}
	/>

	<BenefitGrid
		title={`Why ${NAME}`}
		subtitle="For teams who want the complete platform on infrastructure they choose, with their data where they decide."
		items={onPremBenefits}
	/>

	<ProductComparisonTable
		id="thingsboard-vs-custom-stack"
		title="ThingsBoard vs a custom IoT stack"
		subtitle="Ten years of a platform proven in thousands of production systems, against a stack you wire together and prove yourself."
		caption="ThingsBoard compared with a custom-assembled IoT stack across devices and data, what your users get, running it, and commercials and risk"
		labelHeading="Capability"
		columns={ONPREM_COMPARISON_COLUMNS}
		groups={onPremComparison}
	/>

	<ChoiceBand
		title={onPremChoice.title}
		lead={onPremChoice.lead}
		options={onPremChoice.options}
		note={onPremCtas.cloud}
	/>

	<ProductFaq title={`${NAME} FAQ`} contextId="onprem" categories={onPremFaq} />

	<ClosingCta
		tone="band"
		title="Ready to deploy ThingsBoard?"
		lead="Start on the Free plan and run it on your own hardware, or talk to our team about a perpetual license and offline operation."
		buttons={[onPremCtas.install, onPremCtas.secondary]}
		note={onPremCtas.legal}
	/>
</BaseLayout>

<style is:global lang="scss">
	@use '../../../styles/landing';
	@use '../../../styles/variables' as *;

	// The page's own tokens, read by the Landing components below. On `body` rather than a wrapper:
	// this block ships with this page only, and nothing in the site chrome reads them.
	body {
		--page-accent: #{$color-pe-dark};
		--page-hero-ground: #101a14;
		--page-hero-wash: #{rgba($color-pe-dark, 0.32)};
		// The accent is unreadable on the hero's dark ground; this is its light counterpart.
		--page-accent-light: #b4e7cd;
		// The accent all but vanishes at the wave field's low opacity.
		--page-wave: #{$color-pe-hover};
		// The accent passes AA as a fill under white but not as text; this ink is 5.74:1 on the table header.
		--page-accent-ink: #{$color-pe-link};
		--table-sticky-band: #e7f4ec;
		--page-band: #f1f8f4;
	}
</style>
