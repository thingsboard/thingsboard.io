---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductHero from '@components/Landing/ProductHero.astro';
import BenefitGrid from '@components/Landing/BenefitGrid.astro';
import ChoiceBand from '@components/Landing/ChoiceBand.astro';
import ClosingCta from '@components/Landing/ClosingCta.astro';
import ProductComparisonTable from '@components/Landing/ProductComparisonTable.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';
import { CLOUD_COMPARISON_COLUMNS, cloudComparison } from '@data/cloud-comparison';
import { paasFaq } from '@data/paas-faq';
import { paasBenefits, paasChoice, paasCtas, paasHeroCaption, paasOnPremises } from '@data/paas-page';
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="ThingsBoard Cloud"
	description="ThingsBoard Cloud — an IoT platform for device management, data processing, and visualization, with the infrastructure managed by our team."
>
	<ProductHero
		title="ThingsBoard Cloud"
		subtitle="Device management, data processing and visualization — fully managed by our team, on shared infrastructure or a dedicated private cluster."
		buttons={[paasCtas.primary, paasCtas.secondary]}
		caption={paasHeroCaption}
	/>

	<BenefitGrid
		title="Why ThingsBoard Cloud"
		subtitle="For teams who want the platform running today, with the infrastructure handled."
		items={paasBenefits}
	/>


	<ProductComparisonTable
		id="public-vs-private"
		title="Cloud vs Private Cloud"
		titleLead="ThingsBoard"
		subtitle="Where the two differ — infrastructure and scale, reliability and operations, compliance, and what each one costs."
		caption="ThingsBoard Cloud vs ThingsBoard Private Cloud compared across infrastructure and scale, reliability and operations, compliance, and commercials"
		columns={CLOUD_COMPARISON_COLUMNS}
		groups={cloudComparison}
	/>

	<ChoiceBand
		title={paasChoice.title}
		lead={paasChoice.lead}
		options={paasChoice.options}
		note={paasOnPremises}
	/>

	<ProductFaq title="ThingsBoard Cloud FAQ" contextId="paas-cloud" categories={paasFaq} />


	<ClosingCta
		tone="band"
		title="Ready to build on ThingsBoard Cloud?"
		lead="Start free on ThingsBoard Cloud in under five minutes, or talk to our team about a dedicated Private Cloud cluster."
		buttons={[paasCtas.primary, paasCtas.secondary]}
		note={paasCtas.privacy}
	/>
</BaseLayout>

<style is:global lang="scss">
	@use '../../../styles/landing';
	@use '../../../styles/variables' as *;

	// The page's own tokens, read by the Landing components below. On `body` rather than a wrapper:
	// this block ships with this page only, and nothing in the site chrome reads them.
	body {
		--page-accent: #{$color-brand};
		--page-hero-ground: #121425;
		--page-hero-wash: #{rgba($color-brand, 0.32)};
		// The accent is unreadable on the hero's dark ground; this is its light counterpart.
		--page-accent-light: #{$color-brand-dark};
		// The accent all but vanishes at the wave field's low opacity.
		--page-wave: #8b9bff;
		// On this page the accent reads as ink as well as a fill, so the table takes it as both.
		--page-accent-ink: #{$color-brand};
		--table-sticky-band: #eef0ff;
		--page-band: #f5f6ff;
	}


</style>
