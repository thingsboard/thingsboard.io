---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import MobileFeatureBlock from '@components/Landing/MobileFeatureBlock.astro';
import {
	MOBILE_APP_SERVICE,
	MOBILE_APP_SERVICE_NOT_INCLUDED,
	MOBILE_APP_SERVICE_SETUP,
	MOBILE_APP_SERVICE_SUBSCRIPTION,
	MOBILE_APP_SERVICE_WITHOUT_SUBSCRIPTION,
} from '@data/pricing/mobile-app-service';

const serviceCards = [
	{
		title: 'Setup',
		price: `$${MOBILE_APP_SERVICE.setupFeeUsd.toLocaleString('en-US')}`,
		period: 'one-time',
		items: MOBILE_APP_SERVICE_SETUP,
		note: `The first release typically takes ${MOBILE_APP_SERVICE.leadTime}.`,
	},
	{
		title: 'Subscription',
		price: `$${MOBILE_APP_SERVICE.monthlyUsd}`,
		period: 'per month',
		items: MOBILE_APP_SERVICE_SUBSCRIPTION,
	},
];
---

<BaseLayout
	search={false}
	forceLightTheme
	title="IoT Mobile Application builder"
	description="Open-source IoT Mobile Application builder powered by ThingsBoard and based on Flutter. Build your own IoT mobile app with minimum coding efforts."
>
	<div class="page-body">
		<div id="overflow">
			<section id="intro">
				<div class="intro-inner">
					<h1>IoT Mobile Application builder</h1>
					<h2 class="second">
						Best <a href="https://github.com/thingsboard/flutter_thingsboard_app">open-source</a> tool for IoT mobile app
						development with minimum coding efforts
					</h2>
					<h3 class="second">Powered by <a href="/">ThingsBoard IoT Platform</a>. Based on Flutter</h3>
				</div>
			</section>

			<section class="features">
				<div class="features-inner">
					<div class="features-top">
						<div class="background print:hidden" aria-hidden="true">
							<div class="main main1"></div>
							<div class="small1"></div>
							<div class="small2"></div>
							<div class="small3"></div>
						</div>

						<MobileFeatureBlock
							heading="Home screen with flexible navigation"
							description="Browse everything from home screen. Use Platform to configure dashboard icons, order and visibility."
							readMoreHref="/docs/mobile/pe/customize-dashboards/"
							readMoreSrOnlySuffix=" about flexible dashboard navigation"
							phoneBgSrc="/images/mobile/mobile-bg.svg"
							phoneSideSrc="/images/mobile/flexible-nav.svg"
							phoneSideAlt="Flexible navigation in ThingsBoard Mobile App"
							phoneSideClass="flexible"
							frameImageSrc="/src/assets/images/landings/mobile/browse-dashboards-frame.png"
							videoMp4="https://video.thingsboard.io/mobile/browse-dashboards.mp4"
							videoWebm="https://video.thingsboard.io/mobile/browse-dashboards.webm"
							priority={true}
						/>

						{
							/* The white-labeling and self-registration videos are recordings of the PE app,
							   hosted under video.thingsboard.io/mobile/pe/ — that path is the host's, not a leftover. */
						}
						<MobileFeatureBlock
							heading="White-labeling"
							description="Rebrand your mobile app interface with your company or product logo and color scheme using the white-labeling option (available from Pilot plan)."
							readMoreHref="/docs/mobile/pe/white-labeling/"
							readMoreSrOnlySuffix=" about white-labeling"
							phoneBgSrc="/images/mobile/mobile-bg.svg"
							phoneSideSrc="/images/mobile/white-labeling.svg"
							phoneSideAlt="White-labeling options in ThingsBoard Mobile App"
							phoneSideClass="w-label"
							frameImageSrc="/src/assets/images/landings/mobile/white-labeling-frame.png"
							videoMp4="https://video.thingsboard.io/mobile/pe/white-labeling.mp4"
							videoWebm="https://video.thingsboard.io/mobile/pe/white-labeling.webm"
							imageFirst={true}
							shadowRight={true}
							pointsRight={true}
							blockClass="vis"
						/>
					</div>
				</div>
			</section>

			<section class="features">
				<div class="features-inner">
					<div class="features-top">
						<div class="background print:hidden" aria-hidden="true">
							<div class="main main2"></div>
							<img src="/images/grid.svg" alt="Background grid pattern for ThingsBoard product page" />
							<div class="small4"></div>
							<div class="small5"></div>
						</div>

						<MobileFeatureBlock
							heading="Self-registration"
							description="Setup sign-up page for your customers using self-registration feature. Available from Pilot plan."
							readMoreHref="/docs/mobile/pe/self-registration/"
							readMoreSrOnlySuffix=" about self-registration"
							phoneBgSrc="/images/mobile/mobile-bg.svg"
							phoneSideSrc="/images/mobile/self-registration.svg"
							phoneSideAlt="Self-registration screen in ThingsBoard Mobile App"
							phoneSideClass="self-reg"
							frameImageSrc="/src/assets/images/landings/mobile/self-registration-frame.png"
							videoMp4="https://video.thingsboard.io/mobile/pe/self-registration.mp4"
							videoWebm="https://video.thingsboard.io/mobile/pe/self-registration.webm"
							dark={true}
						/>

						<MobileFeatureBlock
							heading="Simple and convenient alarms management"
							description="Manage alarms in one place. Navigate to related dashboards configurable from the Platform."
							readMoreHref="/docs/mobile/pe/alarm-dashboard/"
							readMoreSrOnlySuffix=" about alarms management"
							phoneBgSrc="/images/mobile/mobile-bg.svg"
							phoneSideSrc="/images/mobile/alarms-m.svg"
							phoneSideAlt="Alarms screen in ThingsBoard Mobile Application"
							phoneSideClass="alarms-m"
							frameImageSrc="/src/assets/images/landings/mobile/manage-alarms-frame.png"
							videoMp4="https://video.thingsboard.io/mobile/manage-alarms.mp4"
							videoWebm="https://video.thingsboard.io/mobile/manage-alarms.webm"
							imageFirst={true}
							shadowRight={true}
							pointsRight={true}
							blockClass="micro"
						/>
					</div>
				</div>
			</section>

			<section class="features">
				<div class="features-inner">
					<div class="features-top">
						<div class="background print:hidden" aria-hidden="true">
							<div class="main main3"></div>
							<div class="small6"></div>
							<div class="small7"></div>
							<div class="small8"></div>
						</div>

						<MobileFeatureBlock
							heading="Structured devices navigation"
							description="Browse devices grouped by their type and online status. On ThingsBoard, assign device specific dashboard and image."
							readMoreHref="/docs/mobile/pe/customize-devices/"
							readMoreSrOnlySuffix=" about structured device navigation"
							phoneBgSrc="/images/mobile/mobile-bg.svg"
							phoneSideSrc="/images/mobile/devices-nav.svg"
							phoneSideAlt="Devices navigation in ThingsBoard Mobile App"
							phoneSideClass="devices-nav"
							frameImageSrc="/src/assets/images/landings/mobile/navigate-devices-frame.png"
							videoMp4="https://video.thingsboard.io/mobile/navigate-devices.mp4"
							videoWebm="https://video.thingsboard.io/mobile/navigate-devices.webm"
						/>

						<MobileFeatureBlock
							heading="Rich set of mobile actions"
							description="Use mobile device to take photo, scan QR code, update location and more within dashboard. Extend the action with your own processing logic using ThingsBoard."
							readMoreHref="/docs/mobile/pe/mobile-actions/"
							readMoreSrOnlySuffix=" about mobile actions"
							phoneBgSrc="/images/mobile/mobile-bg.svg"
							phoneSideSrc="/images/mobile/mobile-act.svg"
							phoneSideAlt="Mobile action feature in ThingsBoard Mobile App"
							phoneSideClass="mobile-act"
							frameImageSrc="/src/assets/images/landings/mobile/mobile-actions-frame.png"
							videoMp4="https://video.thingsboard.io/mobile/mobile-actions.mp4"
							videoWebm="https://video.thingsboard.io/mobile/mobile-actions.webm"
							imageFirst={true}
							blockClass="micro"
						/>

						<div class="background bottom print:hidden" aria-hidden="true">
							<div class="bottom"></div>
							<div class="small9"></div>
						</div>
					</div>
				</div>
			</section>

			<section id="white-labeled-app-service" class="service" aria-labelledby="service-title">
				<div class="service-inner">
					<h2 id="service-title">Your branded app, built and maintained by our team</h2>
					<p class="service-lead">
						Don't want to build the app yourself? We build your branded ThingsBoard app, publish it to the App Store
						and Google Play under your own developer accounts, and keep it working as ThingsBoard, iOS and Android
						change.
					</p>

					<div class="service-cards">
						{
							serviceCards.map((card) => (
								<div class="service-card">
									<h3>{card.title}</h3>
									<p class="service-price">
										<span class="amount">{card.price}</span> <span class="period">{card.period}</span>
									</p>
									<ul>
										{card.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
									{card.note && <p class="service-note">{card.note}</p>}
								</div>
							))
						}
					</div>

					<div class="service-details">
						<div>
							<h3>Not included</h3>
							<ul>
								<li>
									Custom features and screens. Our <a href="/services/development-services/">Custom Development</a> team
									quotes them separately.
								</li>
								{MOBILE_APP_SERVICE_NOT_INCLUDED.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
						<div>
							<h3>Without a subscription</h3>
							<p>{MOBILE_APP_SERVICE_WITHOUT_SUBSCRIPTION}</p>
						</div>
						<div>
							<h3>Requirements</h3>
							<ul>
								<li>
									ThingsBoard {MOBILE_APP_SERVICE.minTbVersion} or later, with the mobile app configured in Mobile Center
								</li>
								<li>On ThingsBoard Cloud, a plan that includes white-labeling: Pilot or higher</li>
							</ul>
						</div>
					</div>

					<div class="service-actions print:hidden">
						<a id="Products_MobApp_Service_Contact" href="/contact-us/" class="service-button primary gtm_button">
							Contact us
						</a>
						<a href="/pricing/?product=thingsboard-cloud" class="service-button secondary">See pricing</a>
					</div>
				</div>
			</section>

			<section id="bottom" class="print:hidden">
				<div class="bottom-inner">
					<Button
						href="/docs/mobile/pe/getting-started/"
						size="xl"
						class="gtm_button"
						attrs={{ id: 'Products_MobApp_GetStart' }}
					>
						Getting started
					</Button>
				</div>
			</section>
		</div>
	</div>
</BaseLayout>

<style lang="scss" is:global>
	@use '../../../styles/landing';
	.read-more-link--default,
	.read-more-link--default .arrow {
		color: #1a6fd4;
	}
</style>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.page-body {
		width: 100%;
	}

	#overflow {
		overflow: hidden;
	}

	// ── Intro section ─────────────────────────────────────────────
	#intro {
		margin-bottom: 178px;
		padding-top: 120px;
		color: $color-dark;
		text-align: left;
		background: transparent;

		.intro-inner {
			max-width: 1400px;
			margin: 0 auto;
			padding: 0 1.25rem;
		}

		h1 {
			font-weight: 600;
			text-align: center;
			font-size: 32px;
			line-height: 52px;
			margin-bottom: 48px;
		}

		h2.second,
		h3.second {
			text-align: center;
			color: #5c6878;
			font-size: 20px;
			line-height: 1.5em;
			font-weight: normal;

			a {
				color: $color-primary;
				text-decoration: none;

				&:hover {
					text-decoration: underline;
				}
			}
		}
	}

	// ── Features sections ─────────────────────────────────────────
	.features {
		background: transparent;

		.features-inner {
			max-width: 1400px;
			margin: 0 auto;
			padding: 0 1.25rem;
		}
	}

	// ── Decorative background shapes ──────────────────────────────
	.background {
		position: absolute;
		left: 50%;

		&:not(.bottom) {
			top: 524px;
		}

		&.bottom {
			top: unset;
			bottom: 1617px;
		}

		img {
			position: absolute;
			top: -650px;
			left: 134px;
			box-shadow: none !important;
		}

		div {
			position: absolute;
			transform: skewY(-6deg);
			width: 436px;
			height: 90px;

			// Full-width band shared by the three sections; each mainN sets only its offset and fill.
			&.main {
				width: 2560px;
				height: 825px;
				left: -1280px;
			}

			// ── Section 1 ──
			&.main1 {
				top: -572px;
				background-color: $color-bg-light;
			}

			&.small1 {
				top: -542px;
				right: 524px;
				background-color: $color-primary;
			}

			&.small2 {
				top: -532px;
				right: 270px;
				border: 2px solid $color-primary-darker;
			}

			&.small3 {
				top: -686px;
				left: 524px;
				background-color: $color-primary-dark;
			}

			// ── Section 2 ──
			&.main2 {
				top: -576px;
				background-color: $color-bg-dark;
			}

			&.small4 {
				top: -742px;
				left: 867px;
				background-color: $color-primary;
			}

			&.small5 {
				top: 63px;
				right: 525px;
				border: 4px solid $color-primary;
			}

			// ── Section 3 ──
			&.main3 {
				top: -576px;
				background-color: $color-bg-light;
			}

			&.small6 {
				top: -537px;
				right: 804px;
				background-color: $color-primary-dark;
			}

			&.small7 {
				top: -714px;
				left: 566px;
				background-color: $color-primary;
			}

			&.small8 {
				top: -84px;
				left: 804px;
				border: 2px solid $color-primary-darker;
			}

			// ── Bottom ──
			&.bottom {
				bottom: -1780px;
				width: 2560px;
				height: 130px;
				left: -1280px;
				background-color: #262c28;
			}

			&.small9 {
				bottom: -1760px;
				left: 565px;
				background-color: $color-primary-dark;
			}
		}

		@media screen and (min-width: 1025px) {
			div.main {
				height: 625px;
			}
		}
	}

	// ── White-labeled app service ─────────────────────────────────
	.service {
		position: relative;
		margin-top: 200px;
		color: $color-dark;

		.service-inner {
			max-width: 1100px;
			margin: 0 auto;
			padding: 0 1.25rem;
		}

		h2 {
			@include section-title;
			text-align: center;
			margin-bottom: 16px;
		}

		.service-lead {
			@include text-m;
			max-width: 760px;
			margin: 0 auto 48px;
			text-align: center;
			color: #5c6878;
		}

		h3 {
			@include card-title;
			margin: 0 0 12px;
		}

		ul {
			margin: 0;
			padding-left: 1.25rem;

			li {
				@include text-s;
				margin-bottom: 8px;
			}
		}

		p {
			@include text-s;
			margin: 0;
		}

		a {
			color: $color-primary;
		}
	}

	.service-cards {
		display: grid;
		gap: 24px;
		grid-template-columns: 1fr;

		@include media-up(md) {
			grid-template-columns: 1fr 1fr;
		}
	}

	.service-card {
		padding: 32px;
		border: 1px solid #e3e8ef;
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 8px 24px rgba(13, 39, 67, 0.06);

		.service-price {
			margin-bottom: 20px;

			.amount {
				font-size: 32px;
				line-height: 40px;
				font-weight: 600;
				color: $color-primary;
			}

			.period {
				color: #5c6878;
			}
		}

		.service-note {
			margin-top: 16px;
			color: #5c6878;
		}
	}

	.service-details {
		display: grid;
		gap: 32px;
		grid-template-columns: 1fr;
		margin-top: 48px;

		@include media-up(md) {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.service-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 16px;
		margin-top: 48px;

		.service-button {
			display: inline-block;
			padding: 12px 40px;
			border-radius: 4px;
			font-size: 18px;
			text-decoration: none;
			transition: background-color 0.3s;

			&.primary {
				color: #fff;
				background-color: $color-primary;

				&:hover {
					background-color: $color-primary-hover;
				}
			}

			&.secondary {
				color: $color-primary;
				border: 1px solid $color-primary;

				&:hover {
					background-color: rgba(42, 125, 236, 0.06);
				}
			}
		}
	}

	// ── Bottom CTA section ────────────────────────────────────────
	#bottom {
		margin-top: 120px;
		padding: 82px 0 124px;
		text-align: center;
		background-color: #f9fbfe;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);

		.bottom-inner {
			max-width: 1400px;
			margin: 0 auto;
			padding: 0 1.25rem;
		}
	}

	.bottom-inner {
		--btn-px: 68px;

		@media (min-width: 1025px) {
			--btn-px: 128px;
		}
	}

	@media print {
		#intro {
			padding-top: 24px;
			margin-bottom: 40px;
		}
	}
</style>
