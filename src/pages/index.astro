---
import BaseLayout from '@layouts/BaseLayout.astro';
import CustomersLogo from '@components/Landing/CustomersLogo.astro';
import Hero from '@components/Landing/Hero.astro';
import IntroSection from '@components/Landing/IntroSection.astro';
import PlatformOverview from '@components/Landing/PlatformOverview.astro';
import FeaturesSection from '@components/Landing/FeaturesSection.astro';
import ClosingCta from '@components/Landing/ClosingCta.astro';
import CtaNote from '@components/Landing/CtaNote.astro';
import ProductsSection from '@components/Landing/ProductsSection.astro';
import EcosystemSection from '@components/Landing/EcosystemSection.astro';
import FeatureRow from '@components/Landing/FeatureRow.astro';
import DashboardShowcase from '@components/Landing/DashboardShowcase.astro';
import ConnectHub from '@components/Landing/ConnectHub.astro';
import SolutionFlow from '@components/Landing/SolutionFlow.astro';
import TwinCorridor from '@components/Landing/TwinCorridor.astro';
import NormalizeSeries from '@components/Landing/NormalizeSeries.astro';
import ScaleDuo from '@components/Landing/ScaleDuo.astro';
import AiSection from '@components/Landing/AiSection.astro';
import { HOME_ROWS } from '@data/home-rows';
import { homeClosingCtas, homeHeroCtas } from '@data/home-ctas';

// Under src/assets so Astro can generate the srcset widths.
const HERO_POSTER = '/src/assets/images/landings/hero/horizontal-slider-slides.webp';

// The feature rows; the media side and the tint alternate by position.
const ROWS = [
	{ copy: HOME_ROWS[0], Visual: ConnectHub, bleed: false },
	{ copy: HOME_ROWS[1], Visual: SolutionFlow },
	{ copy: HOME_ROWS[2], Visual: TwinCorridor },
	{ copy: HOME_ROWS[3], Visual: NormalizeSeries },
	{ copy: HOME_ROWS[4], Visual: ScaleDuo },
];
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="ThingsBoard - All-in-one IoT Platform"
	description="ThingsBoard is an all-in-one IoT platform that gives you everything you need to build, deploy, and scale IoT solutions."
	customTitle={true}
>
	<Hero
		poster={HERO_POSTER}
		title={['ThingsBoard', 'All-in-one IoT Platform']}
		subtitle="Device management, data collection, processing and visualization for your IoT solution"
		buttons={homeHeroCtas}
		video={{
			webm: '/videos/horizontal-slider-slides.webm',
			mp4: '/videos/horizontal-slider-slides.mp4',
		}}
	/>

	<CustomersLogo />

	<AiSection />

	<IntroSection>
		<PlatformOverview />
	</IntroSection>

	{ROWS.map(({ copy, Visual, bleed }, i) => (
		<FeatureRow {...copy} mediaFirst={i % 2 === 1} tinted={i % 2 === 0} bleed={bleed}>
			<Visual />
		</FeatureRow>
	))}

	<DashboardShowcase />

	<ProductsSection />

	<EcosystemSection />

	<FeaturesSection />

	<ClosingCta
		title="Ready to build your IoT solution with ThingsBoard?"
		lead="Start free in the cloud, install On-premises on your own infrastructure, or talk to our team about your specific use case."
		buttons={homeClosingCtas}
	>
		<CtaNote />
	</ClosingCta>
</BaseLayout>

<style is:global lang="scss">
	@use '../styles/landing';
	@use '../styles/variables' as *;
</style>
