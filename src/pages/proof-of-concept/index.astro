		grid-column: 1 / -1;
		height: 16px;
		background: linear-gradient(90deg, var(--color-border-light) 1px, transparent 1px) 0 0 / var(--cell)
			100% repeat-x;
		border-right: 1px solid var(--color-border-light);
	}

	.poc-timeline__track-bar {
		position: absolute;
		top: 2px;
		bottom: 2px;
		left: calc(var(--start) * var(--cell) + 3px);
		width: calc(var(--span) * var(--cell) - 4px);
		background: linear-gradient(
			90deg,
			rgba(var(--color-primary-rgb), 0) 0%,
			rgba(var(--color-primary-rgb), 0.24) 50%,
			rgba(var(--color-primary-rgb), 0) 100%
		);
	}

	.poc-deliverables {
		--poc-number-color: #b3c7ff;

		padding-top: $spacing-20;

		@include media-down(md) {
			padding-top: $spacing-10;
		}

		.poc-section-title {
			margin-bottom: $spacing-5;
		}
	}

	.poc-deliverables__intro {
		@include text-m;
		color: var(--color-text-secondary);
		text-align: center;
		max-width: 520px;
		margin: 0 auto $spacing-8;
	}

	.poc-deliverables__cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: $spacing-6;
		margin: 0;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.poc-deliverable {
		margin: 0;
		padding: $spacing-6;
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border-light);
		border-radius: 12px;
	}

	.poc-deliverable__number {
		display: block;
		font-size: $font-size-4xl;
		font-weight: $font-weight-medium;
		line-height: 1.2;
		color: var(--poc-number-color);
		margin-bottom: $spacing-3;
	}

	.poc-deliverable__title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-4;
	}

	.poc-deliverable__text {
		@include text-m;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.poc-section {
		padding-top: $spacing-20;

		@include media-down(md) {
			padding-top: $spacing-10;
		}
	}

	.poc-section-title--with-intro {
		margin-bottom: $spacing-5;
	}

	.poc-section-intro {
		@include text-m;
		color: var(--color-text-secondary);
		text-align: center;
		max-width: var(--intro-width, 684px);
		margin: 0 auto $spacing-10;

		@include media-down(md) {
			margin-bottom: $spacing-8;
		}
	}

	.poc-note {
		display: flex;
		align-items: center;
		gap: $spacing-5;
		margin-top: $spacing-6;
		padding: $spacing-6;
		background: linear-gradient(rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-primary-rgb), 0.05)),
			var(--color-bg-surface);
		border: 1px solid var(--sl-color-accent);
		border-radius: 12px;

		@include media-down(md) {
			flex-direction: column;
			align-items: flex-start;
			gap: $spacing-4;
		}
	}

	.poc-note__icon {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		color: var(--sl-color-accent);
		border: 1px solid currentColor;
		border-radius: $radius-md;
	}

	.poc-note__title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-3;
	}

	.poc-note__text {
		@include text-m;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.poc-checklist,
	.poc-dotlist {
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			@include text-m;
			display: flex;
			gap: $spacing-2;
			margin: 0;
			color: var(--color-text-secondary);

			@include media-down(md) {
				font-size: $font-size-sm;
				line-height: 24px;
			}
		}
	}

	.poc-checklist__icon,
	.poc-dotlist__icon {
		flex-shrink: 0;
		align-self: flex-start;
	}

	.poc-checklist__icon {
		margin: 8px 2px 0 3px;

		@include media-down(md) {
			margin-top: 6px;
		}
	}

	.poc-dotlist__icon {
		margin-top: 10px;

		@include media-down(md) {
			margin-top: 8px;
		}
	}

	.poc-cta-banner {
		margin-top: $spacing-20;
		padding: $spacing-12 $spacing-6;
		text-align: center;
		color: var(--color-white);
		background: rgb(var(--color-primary-rgb));
		border-radius: $radius-xl;

		@include media-down(md) {
			margin-top: $spacing-10;
			padding: $spacing-10 $spacing-5;
		}
	}

	.poc-cta-banner__title {
		@include subsection-title;
		color: inherit;
		margin: 0 0 $spacing-4;
	}

	.poc-cta-banner__text {
		@include text-table-cell;
		color: inherit;
		margin: 0 0 $spacing-5;
	}

	.poc-cta.poc-cta--light {
		--_btn-color: var(--color-border);
		--_btn-color-hover: var(--color-border-light);
		--_btn-color-contrast: var(--color-text);
		--_btn-shadow: none;

		min-width: 200px;
	}

	.poc-start__cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: $spacing-6;
		margin: 0;
		padding: $spacing-6 0 0;
		list-style: none;

		@include media-down(md) {
			grid-template-columns: 1fr;
			row-gap: $spacing-12;
		}
	}

	.poc-start-card {
		--glow: none;

		position: relative;
		margin: 0;
		padding: $spacing-10 $spacing-6 36px;
		background: var(--glow) no-repeat center bottom / 100% auto, var(--color-bg-surface);
		border: 1px solid var(--color-border-light);
		border-radius: 12px;

		@include media-down(md) {
			background-position: center bottom -16px, 0 0;
		}
	}

	.poc-start-card--blue {
		--glow: url('../../assets/images/proof-of-concept/start-glow-blue.svg');
	}

	.poc-start-card--yellow {
		--glow: url('../../assets/images/proof-of-concept/start-glow-yellow.svg');
	}

	.poc-start-card--purple {
		--glow: url('../../assets/images/proof-of-concept/start-glow-purple.svg');
	}

	.poc-start-card__number {
		position: absolute;
		top: -24px;
		left: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		transform: translateX(-50%);
		@include card-title-sm;
		color: var(--sl-color-accent);
		background: linear-gradient(rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-primary-rgb), 0.05)),
			var(--color-bg-surface);
		border: 1px solid var(--sl-color-accent);
		border-radius: $radius-lg;
	}

	.poc-start-card__title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-3;
	}

	.poc-start-card__text {
		@include text-m;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.poc-price {
		display: grid;
		grid-template-columns: 348px 1px minmax(0, 1fr);
		column-gap: $spacing-6;
		padding: $spacing-12;
		background: linear-gradient(rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-primary-rgb), 0.05)),
			var(--color-bg-surface);
		border: 1px solid var(--sl-color-accent);
		border-radius: $radius-xl;

		@include media-down(lg) {
			grid-template-columns: 1fr;
			row-gap: $spacing-6;
		}

		@include media-down(md) {
			padding: $spacing-6;
		}
	}

	.poc-price__label {
		@include text-table-cell;
		color: var(--color-text-secondary);
		margin: 0 0 $spacing-1;
	}

	.poc-price__amount {
		font-size: 48px;
		font-weight: $font-weight-semibold;
		line-height: 1.2;
		color: var(--color-text);
		margin: 0 0 $spacing-5;

		@include media-down(md) {
			font-size: 40px;
		}
	}

	.poc-price__highlights {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 0 0 $spacing-8;
		padding: 0;
		list-style: none;

		li {
			display: flex;
			align-items: center;
			gap: $spacing-2;
			margin: 0;
			font-size: $font-size-lg;
			line-height: 1.5;
			color: var(--color-text);

			@include media-down(md) {
				font-size: $font-size-sm;
			}

			&::before {
				content: '';
				flex-shrink: 0;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--sl-color-accent);
			}
		}
	}

	.poc-price__divider {
		background: var(--color-border-light);

		@include media-down(lg) {
			height: 1px;
		}
	}

	.poc-price__heading {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-4;
	}

	.poc-price__lists {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-2 $spacing-6;
		padding-bottom: $spacing-3;
		border-bottom: 1px solid var(--color-border-light);

		@include media-down(md) {
			grid-template-columns: 1fr;
			row-gap: $spacing-4;
		}
	}

	.poc-checklist--price {
		@include media-down(md) {
			gap: $spacing-4;
		}

		li {
			color: var(--color-text);
		}
	}

	.poc-price__star {
		color: var(--sl-color-accent);
	}

	.poc-price__footnote {
		@include text-s;
		color: var(--color-text-muted);
		margin: $spacing-3 0 0;
	}

	.poc-fit {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-6;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.poc-fit-card {
		padding: $spacing-8;
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border-light);
		border-left-width: 2px;
		border-radius: 12px;
	}

	.poc-fit-card--good {
		border-left-color: var(--color-success);
	}

	.poc-fit-card--other {
		border-left-color: var(--sl-color-accent);
	}

	.poc-fit-card__title {
		@include card-title-sm;
		color: var(--color-text);
		margin: 0 0 $spacing-4;
	}

	.poc-fit-card__button {
		margin-top: $spacing-6;
	}

	.poc-section-title.poc-scope__title {
		margin-bottom: $spacing-16;
	}

	.poc-scope {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: $spacing-6;
		margin: 0;
		padding: 0;
		list-style: none;

		@media (max-width: 1079px) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: $spacing-8;
		}

		@include media-down(md) {
			grid-template-columns: 1fr;
			row-gap: $spacing-6;
		}
	}

	.poc-stat {
		margin: 0;
	}

	.poc-stat__value {
		font-size: 40px;
		font-weight: $font-weight-semibold;
		line-height: 1.2;
		color: var(--sl-color-accent);
		margin: 0;
		padding-bottom: $spacing-2;
		border-bottom: 1px solid var(--sl-color-accent);
	}

	.poc-stat__text {
		@include text-m;
		color: var(--color-text-secondary);
		margin: $spacing-2 0 0;
	}

	.poc-testimonials {
		padding-top: 56px;

		@include media-down(md) {
			padding-top: $spacing-6;
		}
	}

	.poc-testimonials__title {
		@include card-title;
		color: var(--color-text);
		text-align: center;
		margin: 0 0 $spacing-8;
	}

	.poc-testimonials__cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-6;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.poc-testimonial {
		position: relative;
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: $spacing-6;
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border-light);
		border-radius: 12px;
	}

	.poc-testimonial__mark {
		position: absolute;
		top: $spacing-2;
		pointer-events: none;
		user-select: none;
	}

	.poc-testimonial--open .poc-testimonial__mark {
		left: 5px;
	}

	.poc-testimonial--close .poc-testimonial__mark {
		right: 0;
	}

	.poc-testimonial__quote {
		position: relative;
		margin: 0 0 44px;
		padding: 0;
		border: 0;

		@include media-down(md) {
			margin-bottom: $spacing-5;
		}

		p {
			@include card-title-sm;
			color: var(--color-text);
			margin: 0;

			@include media-down(md) {
				font-size: $font-size-base;
			}
		}
	}

	.poc-testimonial__footer {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: $spacing-4;
		margin-top: auto;
	}

	.poc-testimonial__avatar {
		flex-shrink: 0;
		width: 52px;
		height: 52px;
		object-fit: cover;
		border-radius: 6px;
	}

	.poc-testimonial__person {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: $spacing-1;
		min-width: 0;
	}

	.poc-testimonial__name {
		@include text-table-cell;
		color: var(--color-text);
	}

	.poc-testimonial__role {
		@include text-s;
		color: var(--color-text-secondary);
	}

	.poc-testimonial__logo {
		flex-shrink: 0;
		height: auto;

		@include media-down(md) {
			display: none;
		}
	}

	.poc-cases {
		padding-top: 56px;

		@include media-down(md) {
			padding-top: $spacing-6;
		}
	}

	.poc-cases__title {
		@include card-title;
		color: var(--color-text);
		text-align: center;
		margin: 0 0 $spacing-8;
	}

	.poc-cases__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 32px;
		margin: 0;
		padding: 0;
		list-style: none;

		@media (max-width: 959px) {
			grid-template-columns: 1fr;
		}
	}

	.poc-case {
		margin: 0;
	}

	.poc-case__link {
		position: relative;
		display: block;
		height: 299px;
		overflow: hidden;
		color: var(--color-white);
		text-decoration: none;
		background-position: center;
		background-size: cover;
		border-radius: 24px;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			background: inherit;
			background-size: cover;
			transform-origin: center;
			transition: transform 0.5s;
		}

		&:hover,
		&:focus-visible {
			&::after {
				transform: scale(1.2);
			}

			.poc-case__footer {
				padding-bottom: 45px;
			}

			.poc-case__short {
				opacity: 0;
			}

			.poc-case__long {
				opacity: 1;
			}
		}

		&:focus-visible {
			outline: 2px solid var(--sl-color-accent);
			outline-offset: 2px;
		}

		@media (prefers-reduced-motion: reduce) {
			&::after {
				transition: none;
			}

			&:hover::after,
			&:focus-visible::after {
				transform: none;
			}
		}

		@media (max-width: 599px) {
			height: auto;
			min-height: 299px;
			border-radius: $radius-xl;

			&:hover,
			&:focus-visible {
				.poc-case__footer {
					padding-bottom: 0;
				}
			}
		}
	}

	.poc-case__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: flex-start;
		gap: $spacing-10;
		height: 100%;
		min-height: inherit;
		padding: 20px;

		@media (max-width: 599px) {
			padding: $spacing-4;
		}
	}

	.poc-case__header {
		display: flex;
		justify-content: space-between;
		width: 100%;
	}

	.poc-case__tag {
		position: relative;
		overflow: hidden;
		@include text-s;
		font-weight: $font-weight-medium;
		padding: $spacing-1 $spacing-2;
		color: #1c1c1b;
		background: rgba(255, 255, 255, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 6px;
		backdrop-filter: blur(5px);
		-webkit-backdrop-filter: blur(5px);

		&::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 1px;
			background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
		}

		&::after {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			width: 1px;
			height: 100%;
			background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), transparent, rgba(255, 255, 255, 0.3));
		}
	}

	.poc-case__logo {
		width: auto;
		height: 36px;
	}

	.poc-case__footer {
		display: block;
		width: 100%;
		transition: padding 0.5s;
	}

	.poc-case__title {
		display: block;
		@include text-overlay;
		padding-bottom: $spacing-3;
		margin-bottom: $spacing-3;
		border-bottom: 1px solid #b9c0c5;

		@media (max-width: 599px) {
			line-height: 24px;
		}
	}

	.poc-case__stats {
		display: flex;
		min-height: 60px;

		@media (max-width: 599px) {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: $spacing-2;
			min-height: 0;
		}
	}

	.poc-case__stat {
		position: relative;
		flex-shrink: 0;
		@include text-s;
		width: 129px;
		color: inherit;

		&:last-child {
			width: auto;
		}

		@media (max-width: 599px) {
			width: auto;
		}
	}

	.poc-case__value {
		display: block;
		font-size: $font-size-2xl;
		font-weight: $font-weight-medium;
		line-height: 36px;
	}

	.poc-case__short,
	.poc-case__long {
		position: absolute;
		white-space: nowrap;
		transition: opacity 0.5s linear;

		@media (max-width: 599px) {
			position: static;
			white-space: normal;
		}
	}

	.poc-case__long {
		opacity: 0;

		@media (max-width: 599px) {
			display: block;
			opacity: 1;
		}
	}

	.poc-case__short {
		@media (max-width: 599px) {
			display: none;
		}
	}

	.poc-workshop {
		--poc-dark-bg: #1e1f23;
		--poc-dark-card: #262830;
		--poc-dark-border: #63656c;
		--poc-dark-text: #e4e5e7;
		--poc-dark-muted: #a1a2a8;
		--poc-dark-accent: #b3c7ff;

		display: grid;
		grid-template-columns: minmax(0, 1fr) 452px;
		gap: $spacing-5;
		margin: $spacing-20 calc(-1 * #{$spacing-5} - 1px) 0;
		padding: $spacing-10;
		color: var(--color-white);
		background: var(--poc-dark-bg);

		@media (max-width: 1079px) {
			grid-template-columns: minmax(0, 1fr) 396px;
			gap: $spacing-6;
		}

		@include media-down(lg) {
			grid-template-columns: 1fr;
			gap: $spacing-8;
		}

		@include media-down(md) {
			margin-top: $spacing-6;
			padding: $spacing-10 $spacing-5;
		}
	}

	.poc-workshop__badge {
		@include section-badge;
		color: var(--poc-dark-accent);
		margin: 0 0 $spacing-3;
	}

	.poc-workshop__title {
		@include subsection-title;
		color: var(--color-white);
		margin: 0 0 $spacing-5;
	}

	.poc-workshop__text {
