							class="poc-testimonial__mark"
							src={quoteMarks[item.mark].src}
							alt=""
							width="80"
							height="65"
						/>
						<blockquote class="poc-testimonial__quote">
							<p>{item.quote}</p>
						</blockquote>
						<figcaption class="poc-testimonial__footer">
							<SmartImage
								class="poc-testimonial__avatar"
								src={item.avatar}
								alt={item.name}
								width={52}
								height={52}
							/>
							<span class="poc-testimonial__person">
								<span class="poc-testimonial__name">{item.name}</span>
								<span class="poc-testimonial__role">{item.role}</span>
							</span>
							<SmartImage
								class="poc-testimonial__logo"
								src={`${testimonialsDir}/${item.logo}`}
								alt={`${item.company} logo`}
								width={item.logoWidth}
								height={item.logoHeight}
							/>
						</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="poc-cases">
		<h2 class="poc-cases__title">Where it has already been delivered</h2>
		<ul class="poc-cases__grid">
			{
				deliveredCases.map((item) => (
					<li class="poc-case">
						<a
							class="poc-case__link"
							href={`/case-studies/${item.slug}/`}
							style={`background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.3) 100%), url('/images/case-studies/${item.image}')`}
						>
							<span class="poc-case__content">
								<span class="poc-case__header">
									<span class="poc-case__tag">{item.tag}</span>
									<img
										class="poc-case__logo"
										src={`/images/case-studies/${item.logo}`}
										alt={item.logoAlt}
										width={item.logoWidth}
										height={item.logoHeight}
										style={item.logoDisplayHeight && `height: ${item.logoDisplayHeight}px`}
										loading="lazy"
									/>
								</span>
								<span class="poc-case__footer">
									<span class="poc-case__title">{item.title}</span>
									<span class="poc-case__stats">
										{item.stats.map((stat) => (
											<span class="poc-case__stat">
												<span class="poc-case__value">{stat.value}</span>
												<span class="poc-case__short">{stat.short}</span>
												<span class="poc-case__long">
													{(stat.long ?? [stat.short]).map((line, i) => (
														<>
															{i > 0 && <br />}
															{line}
														</>
													))}
												</span>
											</span>
										))}
									</span>
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="poc-workshop">
		<div class="poc-workshop__content">
			<p class="poc-workshop__badge">Next step</p>
			<h2 class="poc-workshop__title">A 30-minute technical workshop</h2>
			<p class="poc-workshop__text">
				Before anyone signs, we check that a fixed scope fits your use case. In 30 minutes we confirm
				the fit, walk through what you already have, and agree a kickoff date.
			</p>
			<NButton data-contact-modal-open="poc-contact" class="poc-cta poc-cta--workshop">Talk to an expert</NButton>
		</div>
		<aside class="poc-contact" aria-label="Your contact">
			<p class="poc-contact__label">Talk to</p>
			<div class="poc-contact__person">
				<SmartImage
					class="poc-contact__avatar"
					src="/src/assets/images/proof-of-concept/nizar-ali.png"
					alt="Nizar Ali"
					width={52}
					height={52}
				/>
				<div>
					<p class="poc-contact__name">Nizar Ali</p>
					<p class="poc-contact__role">ThingsBoard Custom Development Unit</p>
				</div>
			</div>
		</aside>
	</section>
	<ContactModal id="poc-contact" title="Let's talk about your project" formId="poc_sales_modal" tags="sales" />
</UseCaseLayout>

