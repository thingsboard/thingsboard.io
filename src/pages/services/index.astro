						<span class="we-card__toggle">
							<span class="we-card__toggle-label">More Detail</span>
							<Icon name="tabler:chevron-down" class="we-card__chevron" />
						</span>
					</button>

					<div class="we-card__intro">
						<p>
							Fixed-scope, fixed-cost development engagements. Full implementations, custom
							integrations, white-label mobile apps, custom widgets, and more — with a
							12-month maintenance period included on every delivery.
						</p>
					</div>

					<div class="we-card__body" id="we-card-deliver-body" hidden>
						<p class="we-card__opener">
							<strong>Your project, built by the team who built ThingsBoard.</strong> If you
							want the platform and your solution in the same hands, <strong>We Deliver</strong>
							is our full development service. Fixed scope, fixed cost, a structured timeline
							— and a year of maintenance included on everything we ship.
						</p>

						<h4 class="we-card__h4">What we build</h4>
						<ul class="we-list we-list--check">
							{deliverBuilds.map((item) => <li>{item}</li>)}
						</ul>

						<h4 class="we-card__h4 we-card__h4--with-gap">How it works</h4>
						<ol class="we-steps">
							{deliverSteps.map((step) => (
								<li class="we-step">
									<div class="we-step__n">Step {step.n}</div>
									<div class="we-step__title">{step.title}</div>
									<div class="we-step__desc">{step.desc}</div>
								</li>
							))}
						</ol>

						<aside class="we-callout we-callout--deliver">
							<div class="we-callout__head">
								<Icon name="tabler:bulb" class="we-callout__icon" />
								<strong>Advise or Deliver — how to choose.</strong>
							</div>
							<p>
								<strong>Advise</strong> if you have an engineering team and want a part-time
								ThingsBoard expert alongside them. <strong>Deliver</strong> if you want our
								team to build it for you. Fast.
							</p>
						</aside>
					</div>

					<footer class="we-card__footer">
						<p class="we-card__note">
							Fixed scope · fixed cost · 12 months of maintenance included.
						</p>
						<a class="we-card__cta" href="/services/development-services/">
							Explore Development Services <Icon name="tabler:chevron-right" />
						</a>
					</footer>
				</article>
			</div>
		</section>

		{/* ── Bottom CTA: Need help choosing the right mix? ──────────── */}
		<section class="sp-mix">
			<div class="sp-container">
				<div class="sp-mix__card">
					<h2 class="sp-mix__title">Need help choosing the right mix?</h2>
					<p class="sp-mix__lead">
						Most ThingsBoard engagements combine a couple of these services. Tell us what
						you’re building — we’ll recommend the right combination in a short call.
					</p>
					<ul class="sp-mix__grid">
						{recommendations.map((r) => (
							<li class="sp-mix__item">
								<h3 class="sp-mix__item-title">
									{r.title}{' '}
									<span class="sp-mix__item-suffix">({r.suffix})</span>
								</h3>
								<p class="sp-mix__item-desc">{r.desc}</p>
							</li>
						))}
					</ul>
					<div class="sp-mix__cta">
						<a class="sp-btn sp-btn--primary" href="/products/thingsboard/pricing/#contact-us">
							Talk to Our Team <Icon name="tabler:chevron-right" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	// Expand / collapse the More Detail body on each "We …" card.
	// The card head is the click target — keyboard support comes for free
	// because it's a <button>. We toggle `aria-expanded` and the `hidden`
	// attribute on the body so screen readers and CSS stay in sync.
	const cards = document.querySelectorAll<HTMLElement>('.we-card');
	cards.forEach((card) => {
		const head = card.querySelector<HTMLButtonElement>('.we-card__head');
		const body = card.querySelector<HTMLElement>('.we-card__body');
		if (!head || !body) return;
		head.addEventListener('click', () => {
			const expanded = head.getAttribute('aria-expanded') === 'true';
			head.setAttribute('aria-expanded', String(!expanded));
			if (expanded) {
				body.setAttribute('hidden', '');
				card.classList.remove('is-expanded');
			} else {
				body.removeAttribute('hidden');
				card.classList.add('is-expanded');
			}
		});
	});
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// ── Page-scoped tokens (theme-aware via CSS custom properties) ──────
	.services-page {
		// Card accent palette — drives icon background, callout tint,
		// vertical accent bars. Per-card values are picked further below.
		--card-accent: var(--color-primary);
		--card-accent-soft: rgba(42, 125, 236, 0.08);
		--card-accent-text: var(--color-primary-dark);

		// Page-level chrome
		--sp-page-bg: var(--color-bg);
		--sp-surface: var(--color-bg-surface);
		--sp-surface-2: var(--color-bg-light);
		--sp-border: var(--color-border);
		--sp-text: var(--color-text);
		--sp-text-secondary: var(--color-text-secondary);
		--sp-text-muted: var(--color-text-muted);

		background: var(--sp-page-bg);
		color: var(--sp-text);

		// Per-card accent palette — light mode
		[data-card='support'] {
			--card-accent: #7c3aed;
			--card-accent-soft: #f1ecfe;
			--card-accent-text: #5b21b6;
		}
		[data-card='maintain'] {
			--card-accent: #a855f7;
			--card-accent-soft: #f5edfe;
			--card-accent-text: #6b21a8;
		}
		[data-card='advise'] {
			--card-accent: #db2777;
			--card-accent-soft: #fce7f3;
			--card-accent-text: #9d174d;
		}
		[data-card='train'] {
			--card-accent: #d97706;
			--card-accent-soft: #fef3c7;
			--card-accent-text: #92400e;
		}
		[data-card='deliver'] {
			--card-accent: #059669;
			--card-accent-soft: #d1fae5;
			--card-accent-text: #065f46;
		}
	}

	// Dark-mode overrides — lighter accent text (high-contrast on dark
	// surfaces), darker, less-saturated soft fills.
	[data-theme='dark'] .services-page {
		[data-card='support'] {
			--card-accent: #a78bfa;
			--card-accent-soft: rgba(139, 92, 246, 0.12);
			--card-accent-text: #c4b5fd;
		}
		[data-card='maintain'] {
			--card-accent: #c084fc;
			--card-accent-soft: rgba(168, 85, 247, 0.12);
			--card-accent-text: #d8b4fe;
		}
		[data-card='advise'] {
			--card-accent: #f472b6;
			--card-accent-soft: rgba(219, 39, 119, 0.14);
			--card-accent-text: #f9a8d4;
		}
		[data-card='train'] {
			--card-accent: #fbbf24;
			--card-accent-soft: rgba(217, 119, 6, 0.14);
			--card-accent-text: #fcd34d;
		}
		[data-card='deliver'] {
			--card-accent: #34d399;
			--card-accent-soft: rgba(5, 150, 105, 0.14);
			--card-accent-text: #6ee7b7;
		}
	}

	// ── Layout primitives ────────────────────────────────────────────────
	.sp-container {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 $spacing-6;

		@include media-up(md) {
			padding: 0 $spacing-8;
		}
	}

	// ── Buttons ──────────────────────────────────────────────────────────
	.sp-btn {
		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		padding: 14px 24px;
		border-radius: 8px;
		font-size: $font-size-base;
		font-weight: $font-weight-semibold;
		line-height: 1.2;
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s;
		cursor: pointer;
		border: 1px solid transparent;
		white-space: nowrap;

		[data-icon] {
			width: 18px;
			height: 18px;
		}

		&--primary {
			background: var(--color-primary);
			color: var(--color-white);
			border-color: var(--color-primary);

			&:hover {
				background: var(--color-primary-hover);
				border-color: var(--color-primary-hover);
			}
		}

		&--secondary {
			background: transparent;
			color: var(--sp-text);
			border-color: var(--sp-border);

			&:hover {
				background: var(--sp-surface-2);
				border-color: var(--sp-text-secondary);
			}
		}
	}

	// ── Hero ─────────────────────────────────────────────────────────────
	.sp-hero {
		padding: $spacing-20 0 $spacing-12;
		position: relative;
		overflow: hidden;

		@include media-up(md) {
			padding: $spacing-24 0 $spacing-16;
		}

		// Subtle radial gradient backdrop (light only — dark mode keeps the
		// flat page bg).
		&::before {
			content: '';
			position: absolute;
			inset: 0;
			background: radial-gradient(
				ellipse at top right,
				rgba(124, 58, 237, 0.06),
				transparent 50%
			);
			pointer-events: none;
		}
		[data-theme='dark'] &::before {
			display: none;
		}

		&__inner {
			position: relative;
			text-align: center;
		}

		&__title {
			@include page-title;
			margin: 0 0 $spacing-5;
			color: var(--sp-text);
		}

		&__lead {
			max-width: 720px;
			margin: 0 auto $spacing-8;
			color: var(--sp-text-secondary);
			font-size: $font-size-lg;
			line-height: 1.6;
		}

		&__ctas {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: $spacing-3;
		}
	}

	// ── Stats strip ──────────────────────────────────────────────────────
	.sp-stats {
		padding: $spacing-8 0 $spacing-16;

		&__grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: $spacing-8 $spacing-6;
			list-style: none;
			padding: 0;
			margin: 0;
			text-align: center;

			@include media-up(md) {
				grid-template-columns: repeat(4, 1fr);
			}
		}
	}

	.sp-stat {
		&__value {
			font-size: 36px;
			font-weight: $font-weight-bold;
			line-height: 1.1;
			color: var(--sp-text);
			margin-bottom: $spacing-2;

			@include media-up(md) {
				font-size: 40px;
			}
		}

		&__label {
			font-size: $font-size-sm;
			line-height: 1.5;
			color: var(--sp-text-muted);
			white-space: pre-line;
		}
	}

	// ── Section chrome ───────────────────────────────────────────────────
	.sp-section {
		padding: $spacing-12 0;

		@include media-up(md) {
			padding: $spacing-16 0;
		}

		&__header {
			margin-bottom: $spacing-8;

			@include media-up(md) {
				margin-bottom: $spacing-10;
			}
		}

		&__title {
			@include section-title;
			margin: $spacing-3 0 $spacing-4;
			color: var(--sp-text);
		}

		&__lead {
			@include text-m;
			max-width: 720px;
			margin: 0;
			color: var(--sp-text-secondary);
		}
	}

	.sp-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		padding-left: $spacing-3;
		border-left: 3px solid var(--color-primary);
		font-size: $font-size-sm;
		font-weight: $font-weight-semibold;
		color: var(--color-primary);
		text-transform: none;
		letter-spacing: 0;
	}

	// ── "We …" card ──────────────────────────────────────────────────────
	.we-card {
		background: var(--sp-surface);
		border: 1px solid var(--sp-border);
		border-radius: 16px;
		padding: $spacing-6 $spacing-8;
		margin: 0 0 $spacing-6;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
		transition: box-shadow 0.2s ease, border-color 0.2s ease;

		@include media-up(md) {
			padding: $spacing-8 $spacing-10;
		}

		&.is-expanded {
			box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
			border-color: var(--sp-border);
		}

		&__head {
			// On mobile, the toggle drops to its own row so the title
			// has full width to breathe — at md+ we lay out icon, title,
			// and toggle on a single row.
			display: grid;
			grid-template-columns: auto 1fr;
			grid-template-areas:
				'icon title'
				'toggle toggle';
			align-items: start;
			gap: $spacing-3 $spacing-4;
			width: 100%;
			padding: 0;
			background: none;
			border: 0;
			font: inherit;
			color: inherit;
			text-align: left;
			cursor: pointer;

			@include media-up(md) {
				grid-template-columns: auto 1fr auto;
				grid-template-areas: 'icon title toggle';
			}

			&:focus-visible {
				outline: 2px solid var(--color-primary);
				outline-offset: 4px;
				border-radius: 8px;
			}
		}

		&__icon {
			grid-area: icon;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			border-radius: 8px;
			background: var(--card-accent-soft);
			color: var(--card-accent);
			flex-shrink: 0;

			[data-icon] {
				width: 20px;
				height: 20px;
			}
		}

		&__title {
			grid-area: title;
			margin: 6px 0 0;
			color: var(--sp-text);
			font-size: $font-size-lg;
			line-height: 1.4;
			font-weight: $font-weight-normal;

			strong {
				font-weight: $font-weight-semibold;
				color: var(--sp-text);
			}
		}

		&__toggle {
			grid-area: toggle;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: $spacing-2;
			padding: 8px 14px;
			border: 1px solid var(--sp-border);
			border-radius: 8px;
			font-size: $font-size-sm;
			font-weight: $font-weight-medium;
			color: var(--sp-text);
			background: var(--sp-surface);
			justify-self: stretch;
			white-space: nowrap;

			@include media-up(md) {
				justify-self: end;
				margin-top: 2px;
			}

			.we-card__head:hover & {
				border-color: var(--sp-text-secondary);
			}
		}

		&__chevron {
			width: 14px;
			height: 14px;
			transition: transform 0.2s ease;
		}

		&__head[aria-expanded='true'] .we-card__chevron {
			transform: rotate(180deg);
		}

		&__intro {
			margin: $spacing-4 0 0;

			p {
				@include text-m;
				margin: 0;
				color: var(--sp-text-secondary);
			}
		}

		&__body {
			margin-top: $spacing-6;
			padding-top: $spacing-6;
			border-top: 1px solid var(--sp-border);
		}

		&__opener {
			@include text-m;
			margin: 0 0 $spacing-6;
			color: var(--sp-text-secondary);

			strong {
				color: var(--sp-text);
				font-weight: $font-weight-semibold;
			}
		}

		&__grid {
			display: grid;
			gap: $spacing-6;
			margin-bottom: $spacing-6;

			&--2 {
				grid-template-columns: 1fr;

				@include media-up(md) {
					grid-template-columns: 1fr 1fr;
					gap: $spacing-8;
				}
			}
		}

		&__h4 {
			font-size: $font-size-base;
			font-weight: $font-weight-semibold;
			line-height: 1.5;
			color: var(--sp-text);
			margin: 0 0 $spacing-3;

			&--with-gap {
				margin-top: $spacing-6;
			}
		}

		&__plans {
			padding-top: $spacing-6;
			border-top: 1px solid var(--sp-border);
		}

		&__footer {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: center;
			gap: $spacing-3;
			margin-top: $spacing-6;
			padding-top: $spacing-5;
			border-top: 1px solid var(--sp-border);
		}

		&__note {
			margin: 0;
			font-size: $font-size-sm;
			color: var(--sp-text-muted);
		}

		&__cta {
			display: inline-flex;
			align-items: center;
			gap: $spacing-2;
			font-size: $font-size-sm;
			font-weight: $font-weight-semibold;
			color: var(--color-primary);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}

			[data-icon] {
				width: 14px;
				height: 14px;
			}
		}
	}

	// ── Lists used inside cards ──────────────────────────────────────────
	.we-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: $spacing-2;

		li {
			@include text-m;
			color: var(--sp-text-secondary);
			padding-left: $spacing-6;
			position: relative;
		}

		&--check li::before {
			content: '✓';
			position: absolute;
			left: 0;
			top: 0;
			color: var(--card-accent);
			font-weight: $font-weight-bold;
		}
	}

	// ── Inline SLA cells (Support card "How it works") ───────────────────
	.we-sla {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: $spacing-3;
		margin: 0;

		&__cell {
			border: 1px solid var(--sp-border);
			border-radius: 8px;
			padding: $spacing-3 $spacing-4;

			dt {
				font-size: $font-size-sm;
				color: var(--sp-text-muted);
				margin: 0 0 4px;
			}

			dd {
				margin: 0;
				font-size: $font-size-base;
				font-weight: $font-weight-semibold;
				color: var(--sp-text);
			}
		}
	}

	// ── Plans coverage row (Support card "Included on") ──────────────────
	.we-plans {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: $spacing-3;

		@include media-up(sm) {
			grid-template-columns: 1fr 1fr;
		}

		@include media-up(md) {
			grid-template-columns: repeat(4, 1fr);
		}
