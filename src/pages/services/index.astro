	// ── Four course tracks (Train card) ──────────────────────────────────
	.we-tracks {
		list-style: none;
		padding: 0;
		margin: 0 0 $spacing-6;
		display: grid;
		grid-template-columns: 1fr;
		gap: $spacing-4;

		@include media-up(sm) {
			grid-template-columns: 1fr 1fr;
