			font-size: $font-size-sm;
			color: var(--sp-text-muted);
		}
	}

	// ── Uptime SLA boxes (Maintain card) ─────────────────────────────────
	.we-uptime {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: $spacing-3;

		@include media-up(sm) {
			grid-template-columns: 1fr 1fr;
		}

		li {
			border: 1px solid var(--sp-border);
			border-radius: 8px;
			padding: $spacing-3 $spacing-4;
