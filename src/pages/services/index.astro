					<button
						class="we-card__head"
						type="button"
						aria-expanded="false"
						aria-controls="we-card-deliver-body"
					>
						<span class="we-card__icon" aria-hidden="true">
							<Icon name="tabler:code" />
						</span>
						<h3 class="we-card__title">
							<strong>We Deliver</strong> — Full IoT solutions, built by ThingsBoard
