---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';

// ── Hero stats ──────────────────────────────────────────────────────────
const heroStats = [
	{ value: '30 min', label: 'avg. support response\nwithin business hours' },
	{ value: '99.95%', label: 'platform uptime,\nScale plan and up' },
	{ value: '350+', label: 'delivered\nIoT projects' },
	{ value: '9 years', label: 'in the\nIoT domain' },
];

// ── Plans coverage matrix used on the "We Support" card ─────────────────
const supportPlans = [
	{ label: 'Self-hosted License', note: 'Pilot and above' },
	{ label: 'Public Cloud', note: 'Pilot and above' },
	{ label: 'Private Cloud', note: 'All plans' },
	{ label: 'Managed Service', note: 'All plans' },
];

const supportSLA = [
	{ label: 'Response SLA', value: '24 hours' },
	{ label: 'Avg. response', value: '~30 min' },
	{ label: 'Avg. resolution', value: '~8 hours' },
	{ label: 'Hours', value: '8:00–20:00 EET Mon–Fri' },
];

const maintainHandled = [
	'Major and minor ThingsBoard version upgrades',
	'Daily backups, with restoration when needed',
	'Proactive 24/7 monitoring and incident response',
	'Auto-scaling — compute (Enterprise) and storage (all tiers)',
	'Security patching — OS, database, and ThingsBoard itself',
	'Full access to logs and monitoring dashboards',
	'Migration of existing self-managed ThingsBoard onto our infrastructure',
];

const maintainSLA = [
	{ label: 'Pilot and Startup', value: '99.5%' },
	{ label: 'Scale plans and above', value: '99.95%' },
];

const adviseHow = [
	"20 hours per month of your Advisory Engineer's time",
	'Same engineer every month — they learn your setup end-to-end (with a named backup for vacation coverage)',
	'Weekly call + dedicated Slack channel + joint workshops',
	'6-month minimum engagement',
	'Available alongside any paid Support or Maintenance plan',
];

const adviseUses = [
	{ title: 'Integration design', desc: 'devices, cloud systems, external APIs' },
	{ title: 'Performance tuning', desc: 'slow rule chains, slow queries, widgets, scaling' },
	{ title: 'Feature strategy', desc: 'which ThingsBoard feature for which problem' },
	{ title: 'Architecture reviews', desc: 'data model, rule chains, tenant layout' },
	{ title: 'Upgrade planning', desc: 'what changes, what to test, how to roll it out' },
];

const trainTracks = [
	{ title: 'Data Visualization', desc: 'UI fundamentals, dashboards, widgets, custom widget development.' },
	{ title: 'Platform Administration', desc: 'Deployment, cluster setup, troubleshooting, AWS hands-on.' },
	{ title: 'SCADA', desc: 'Symbol library, dashboard creation, advanced properties and behaviors.' },
	{ title: 'Management & Security', desc: 'Rule engine, RBAC, alarms, API, custom rule nodes.' },
];

const deliverBuilds = [
	'Full IoT solution implementations — fleet tracking, energy monitoring, asset tracking, smart metering, SCADA, and more',
	'Custom integrations with your business systems',
	'Custom rule nodes',
	'Custom dashboards and widgets',
	'White-label mobile applications',
	'Custom protocol adapters',
];

const deliverSteps = [
	{ n: '1', title: 'Technical workshop', desc: 'Align on goals and constraints.' },
	{ n: '2', title: 'Scope & Proposal', desc: 'Fixed scope, fixed cost, clear timeline.' },
	{ n: '3', title: 'Kick-off', desc: 'Iterative development begins.' },
	{ n: '4', title: 'Deployment', desc: 'Shipped into your environment.' },
	{ n: '5', title: 'Maintenance', desc: '12-month period, included.' },
];

const recommendations = [
	{
		title: 'Foundation',
		suffix: 'Support + Maintain',
		desc: 'Day-to-day platform coverage.',
	},
	{
		title: 'Augment',
		suffix: '+ Advise',
		desc: 'When your team wants a part-time ThingsBoard architect.',
	},
	{
		title: 'Build',
		suffix: '+ Deliver',
		desc: 'When you want us to build the solution for you.',
	},
];
---

<BaseLayout
	title="Support and Services"
	description="Professional support, managed platform operations, and on-demand experts — everything you need to run ThingsBoard with confidence."
	pageId="services"
>
	<main class="services-page">
		{/* ── Hero ────────────────────────────────────────────────────── */}
		<section class="sp-hero">
			<div class="sp-container sp-hero__inner">
				<h1 class="sp-hero__title">Support and Services</h1>
				<p class="sp-hero__lead">
					Professional support, managed platform operations, and on-demand experts —
					everything you need to run ThingsBoard with confidence.
				</p>
				<div class="sp-hero__ctas">
					<a class="sp-btn sp-btn--primary" href="/products/thingsboard/pricing/#contact-us">
						Talk to Our Team
					</a>
					<a class="sp-btn sp-btn--secondary" href="#included">
						See What’s Included
					</a>
				</div>
			</div>
		</section>

		{/* ── Stats strip ─────────────────────────────────────────────── */}
		<section class="sp-stats">
			<div class="sp-container">
				<ul class="sp-stats__grid">
					{heroStats.map((s) => (
						<li class="sp-stat">
							<div class="sp-stat__value">{s.value}</div>
							<div class="sp-stat__label">{s.label}</div>
						</li>
					))}
				</ul>
			</div>
		</section>

		{/* ── Section 1: Included with your plan ──────────────────────── */}
		<section id="included" class="sp-section sp-section--included">
			<div class="sp-container">
				<header class="sp-section__header">
					<span class="sp-eyebrow">Included with your plan</span>
					<h2 class="sp-section__title">Support and platform operations, on us</h2>
					<p class="sp-section__lead">
						Professional support from the Pilot plan and above. Fully-managed operations on
						Public Cloud, Private Cloud, and Managed Services.
					</p>
				</header>

				{/* ── We Support card ───────────────────────────────────── */}
				<article class="we-card" data-card="support">
					<button
						class="we-card__head"
						type="button"
						aria-expanded="false"
						aria-controls="we-card-support-body"
					>
						<span class="we-card__icon" aria-hidden="true">
							<Icon name="tabler:headset" />
						</span>
						<h3 class="we-card__title">
							<strong>We Support</strong> — Technical support for paid ThingsBoard plans
						</h3>
						<span class="we-card__toggle">
							<span class="we-card__toggle-label">More Detail</span>
							<Icon name="tabler:chevron-down" class="we-card__chevron" />
						</span>
					</button>

					<div class="we-card__intro">
						<p>
							Open a ticket, get an expert response. Our support team is the same team that
							builds ThingsBoard — committed response SLA, unlimited tickets, no
							named-contact limits.
						</p>
					</div>

					<div class="we-card__body" id="we-card-support-body" hidden>
						<p class="we-card__opener">
							<strong>A direct line to the engineers behind ThingsBoard.</strong> When something
							in the platform isn’t working the way you expect, open a ticket — and get a real
							answer from someone who knows the code.
						</p>

						<div class="we-card__grid we-card__grid--2">
							<div>
								<h4 class="we-card__h4">What you can ask us about</h4>
								<ul class="we-list we-list--check">
									<li>Questions about standard ThingsBoard functionality</li>
									<li>Installation and upgrade assistance</li>
									<li>License management</li>
									<li>Tenant administration and password resets</li>
									<li>Bug reports</li>
								</ul>
							</div>
							<div>
								<h4 class="we-card__h4">How it works</h4>
								<dl class="we-sla">
									{supportSLA.map((row) => (
										<div class="we-sla__cell">
											<dt>{row.label}</dt>
											<dd>{row.value}</dd>
										</div>
									))}
								</dl>
							</div>
						</div>

						<div class="we-card__plans">
							<h4 class="we-card__h4">Included on</h4>
							<ul class="we-plans">
								{supportPlans.map((p) => (
									<li class="we-plan">
										<div class="we-plan__label">{p.label}</div>
										<div class="we-plan__note">{p.note}</div>
									</li>
								))}
							</ul>
						</div>
					</div>

					<footer class="we-card__footer">
						<p class="we-card__note">
							Average first response in ~30 minutes during business hours.
						</p>
						<a class="we-card__cta" href="/products/thingsboard/pricing/">
							Explore Plans <Icon name="tabler:chevron-right" />
						</a>
					</footer>
				</article>

				{/* ── We Maintain card ──────────────────────────────────── */}
				<article class="we-card" data-card="maintain">
					<button
						class="we-card__head"
						type="button"
						aria-expanded="false"
						aria-controls="we-card-maintain-body"
					>
						<span class="we-card__icon" aria-hidden="true">
							<Icon name="tabler:server-cog" />
						</span>
						<h3 class="we-card__title">
							<strong>We Maintain</strong> — Fully-managed platform operations
						</h3>
						<span class="we-card__toggle">
							<span class="we-card__toggle-label">More Detail</span>
							<Icon name="tabler:chevron-down" class="we-card__chevron" />
						</span>
					</button>

					<div class="we-card__intro">
						<p>
							We run ThingsBoard for you — upgrades, backups, monitoring, scaling, and
							security patching, all handled by our platform team. Included with Public
							Cloud, Private Cloud, and Managed Services.
						</p>
					</div>

					<div class="we-card__body" id="we-card-maintain-body" hidden>
						<p class="we-card__opener">
							<strong>Your platform, operated by our team.</strong> On Public Cloud, Private
							Cloud, and Managed Services, our platform team keeps ThingsBoard running —
							proactively. You focus on what you’re building; we make sure it stays up.
						</p>

						<div class="we-card__grid we-card__grid--2">
							<div>
								<h4 class="we-card__h4">What’s handled for you</h4>
								<ul class="we-list we-list--check">
									{maintainHandled.map((item) => <li>{item}</li>)}
								</ul>
							</div>
							<div>
								<h4 class="we-card__h4">Uptime SLA</h4>
								<ul class="we-uptime">
									{maintainSLA.map((row) => (
										<li>
											<div class="we-uptime__label">{row.label}</div>
											<div class="we-uptime__value">{row.value}</div>
										</li>
									))}
								</ul>
							</div>
						</div>

						<aside class="we-callout we-callout--maintain">
							<div class="we-callout__head">
								<Icon name="tabler:bulb" class="we-callout__icon" />
								<strong>Your application vision, delivered by our team.</strong>
							</div>
							<p>
								Rule chains, dashboards, integrations, and custom data models are yours to
								design and evolve. If you want expert hands on them, that’s what our
								<a href="#advise">Advisory Engineers</a> and
								<a href="/services/development-services/">Development Services</a> are for.
							</p>
						</aside>
					</div>

					<footer class="we-card__footer">
						<p class="we-card__note">99.95% uptime SLA on Scale plans and above.</p>
						<a class="we-card__cta" href="/products/thingsboard/pricing/">
							Explore Plans <Icon name="tabler:chevron-right" />
						</a>
					</footer>
				</article>

				{/* ── Community note ─────────────────────────────────── */}
				<p class="sp-community">
					<em>Using Community Edition, Maker, or Prototype plans?</em>
					<a href="https://github.com/thingsboard/thingsboard/discussions" target="_blank" rel="noopener noreferrer">
						Community support <Icon name="tabler:info-circle" />
					</a>
				</p>
			</div>
		</section>

		{/* ── Section 2: Expert hands on your solution ───────────────── */}
		<section id="expert" class="sp-section sp-section--expert">
			<div class="sp-container">
				<header class="sp-section__header">
					<span class="sp-eyebrow">Expert services</span>
					<h2 class="sp-section__title">Expert hands on your solution</h2>
					<p class="sp-section__lead">
						On-demand help when you want expert hands on your solution. Available on top of
						any Support or Maintenance plan.
					</p>
				</header>

				{/* ── We Advise card ─────────────────────────────────── */}
				<article id="advise" class="we-card" data-card="advise">
					<button
						class="we-card__head"
						type="button"
						aria-expanded="false"
						aria-controls="we-card-advise-body"
					>
						<span class="we-card__icon" aria-hidden="true">
							<Icon name="tabler:user-star" />
						</span>
						<h3 class="we-card__title">
							<strong>We Advise</strong> — A fractional ThingsBoard architect embedded with
							your team
						</h3>
						<span class="we-card__toggle">
							<span class="we-card__toggle-label">More Detail</span>
							<Icon name="tabler:chevron-down" class="we-card__chevron" />
						</span>
					</button>

					<div class="we-card__intro">
						<p>
							A dedicated ThingsBoard engineer working 20 hours a month alongside your team —
							architecture reviews, performance tuning, integration design, weekly calls,
							direct Slack access.
						</p>
					</div>

					<div class="we-card__body" id="we-card-advise-body" hidden>
						<p class="we-card__opener">
							<strong>The expert your engineers wish they worked with.</strong> We Advise
							pairs you with a dedicated ThingsBoard engineer who learns your deployment and
							works alongside your team — reviewing designs, tuning performance, answering
							hard questions in the weekly call, and responding on Slack in between. Your
							engineers stay in control of production; our engineer makes them faster and
							better at everything ThingsBoard-related.
						</p>

						<div class="we-card__grid we-card__grid--2">
							<div>
								<h4 class="we-card__h4">How it works</h4>
								<ul class="we-list we-list--check">
									{adviseHow.map((item) => <li>{item}</li>)}
								</ul>
							</div>
							<div>
								<h4 class="we-card__h4">What customers use them for</h4>
								<ul class="we-uses">
									{adviseUses.map((row) => (
										<li>
											<strong>{row.title}</strong> — {row.desc}
										</li>
									))}
								</ul>
							</div>
						</div>

						<aside class="we-callout we-callout--advise">
							<div class="we-callout__head">
								<Icon name="tabler:bulb" class="we-callout__icon" />
								<strong>Scope of Responsibility.</strong>
							</div>
							<p>
								Your Advisory Engineer is a senior expert, not a contractor. They won’t
								ship code into your production environment or deliver a full project
								single-handed — that’s where <a href="#deliver">We Deliver</a> picks up.
							</p>
						</aside>
					</div>

					<footer class="we-card__footer">
						<p class="we-card__note">
							20 hours / month · 6-month minimum · same engineer every month.
						</p>
						<a class="we-card__cta" href="/services/consulting/">
							Talk to Us About Advise <Icon name="tabler:chevron-right" />
						</a>
					</footer>
				</article>

				{/* ── We Train card ──────────────────────────────────── */}
				<article id="train" class="we-card" data-card="train">
					<button
						class="we-card__head"
						type="button"
						aria-expanded="false"
						aria-controls="we-card-train-body"
					>
						<span class="we-card__icon" aria-hidden="true">
							<Icon name="tabler:school" />
						</span>
						<h3 class="we-card__title">
							<strong>We Train</strong> — Live instructor-led courses for developers, admins,
							and architects
						</h3>
						<span class="we-card__toggle">
							<span class="we-card__toggle-label">More Detail</span>
							<Icon name="tabler:chevron-down" class="we-card__chevron" />
