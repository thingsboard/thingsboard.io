		&__value {
			font-size: $font-size-lg;
			font-weight: $font-weight-bold;
			color: var(--card-accent);
		}
	}

	// ── What customers use them for (Advise card) ────────────────────────
	.we-uses {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: $spacing-3;

