---
import { Icon } from 'astro-icon/components';
import DocTable from '@components/TrustCenter/DocTable.astro';
import CompareTable from '@components/TrustCenter/CompareTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import {
	CLOUD_COLUMNS,
	CLOUD_GROUPS,
	CLOUD_DOCS,
	CLOUD_LEDE,
	PRIVATE_CLOUD_DOCS,
	PRIVATE_CLOUD_DOCS_INTRO,
} from '@data/trust-center/deployment';
import { DEPLOYMENT_ICON } from '@data/trust-center/deployment-marks';

const DOC_COLUMNS = [
	{ title: 'ThingsBoard Cloud', icon: DEPLOYMENT_ICON.cloud, rows: CLOUD_DOCS },
	{ title: 'Private Cloud', icon: DEPLOYMENT_ICON.private, intro: PRIVATE_CLOUD_DOCS_INTRO, rows: PRIVATE_CLOUD_DOCS },
];
---

<TrustCenterLayout
	lede={CLOUD_LEDE}
	description="How ThingsBoard runs ThingsBoard Cloud and Private Cloud: hosting, data residency, isolation, encryption, backups, availability, uptime, retention, access and leaving."
>
	<section class="tc-section" aria-label="ThingsBoard Cloud compared with Private Cloud">
		<CompareTable
			caption="ThingsBoard Cloud compared with Private Cloud"
			firstLabel="Topic"
			columns={CLOUD_COLUMNS}
			groups={CLOUD_GROUPS}
		/>
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="cloud-docs-title">
		<h2 class="tc-h2" id="cloud-docs-title">
			Documents
		</h2>
		<div class="tc-doc-columns">
			{DOC_COLUMNS.map((column) => (
				<div>
					<h3 class="tc-doc-columns__title">
						<Icon name={column.icon} aria-hidden="true" />
						{column.title}
					</h3>
					{column.intro && <p class="tc-note tc-doc-columns__intro">{column.intro}</p>}
					<DocTable caption={`Documents for ${column.title}`} rows={column.rows} />
				</div>
			))}
		</div>
	</section>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-doc-columns {
		display: grid;
		gap: $spacing-10;
		align-items: start;

		@include media-up(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.tc-doc-columns__title {
		@include type-tile-lg;

		display: flex;
		align-items: center;
		gap: $spacing-2;
		margin-bottom: $spacing-3;
		color: var(--color-text);

		svg {
			flex: none;
			width: 22px;
			height: 22px;
			color: var(--color-text-secondary);
		}
		text-wrap: balance;
	}

	.tc-note.tc-doc-columns__intro {
		margin: 0 0 $spacing-3;
	}
</style>
