---
import { Icon } from 'astro-icon/components';
import DocTable from '@components/TrustCenter/DocTable.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { ONPREM_DOCS, ONPREM_FACTS, ONPREM_GUIDES, ONPREM_LEDE, PER_PRODUCT_NOTE } from '@data/trust-center/deployment';
---

<TrustCenterLayout
	lede={ONPREM_LEDE}
	family="onprem"
	description="Security for an on-premises ThingsBoard installation: what you run, what is built into the product, security fixes, release support, network requirements and the configuration guides."
>
	<section class="tc-section" aria-label="On-premises facts">
		<FactTable caption="On-premises: what you run and what the product provides" rows={ONPREM_FACTS} />
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="guides-title">
		<h2 class="tc-h2" id="guides-title">
			Security configuration guides
		</h2>
		<ul class="tc-guides">
			{ONPREM_GUIDES.map((guide) => (
				<li>
					<a href={guide.href}>
						{guide.label}
						<span class="tc-guides__note">
							<Icon name="tabler:chevron-right" aria-hidden="true" />
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="onprem-docs-title">
		<h2 class="tc-h2" id="onprem-docs-title">
			Documents
		</h2>
		<DocTable caption="Documents for on-premises installations" rows={ONPREM_DOCS} />
		<p class="tc-note" set:html={PER_PRODUCT_NOTE} />
	</section>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-guides {
		display: grid;
		gap: 0 $spacing-8;
		padding: 0;
		list-style: none;

		@include media-up(md) {
			grid-template-columns: 1fr 1fr;
		}

		li {
			border-bottom: 1px solid var(--color-border-light);
		}

		li:last-child {
			border-bottom: 0;
		}

		li:first-child a {
			padding-top: 0;
		}

		@include media-up(md) {
			li:nth-child(2) a {
				padding-top: 0;
			}

			li:nth-last-child(2):nth-child(odd) {
				border-bottom: 0;
			}
		}

		a {
			@include type-body;

			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: $spacing-4;
			padding: $spacing-3 0;
			color: var(--color-text);
			text-decoration: none;

			&:hover {
				color: var(--accent-ink);
			}
		}
	}

	.tc-guides__note {
		@include type-small-strong;

		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 2px;
		color: var(--accent-ink);

		svg {
			width: 16px;
			height: 16px;
		}
	}
</style>
