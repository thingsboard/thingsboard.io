---
import Catalog from '@components/TrustCenter/Catalog.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { TOPIC_PAGES } from '@data/trust-center/catalogs';
import { pageFor } from '@data/trust-center/pages';

/** The four security topic pages: Product security, Data security, Access control, Dev security. */

export function getStaticPaths() {
	return Object.entries(TOPIC_PAGES).map(([topic, data]) => ({ params: { topic }, props: { topic, data } }));
}

const { topic, data } = Astro.props;
---

<TrustCenterLayout lede={data.lede} family="security" description={data.description}>
	<section class="tc-section" aria-label={pageFor(topic).title}>
		<Catalog rows={data.rows} label={data.label} />
	</section>
</TrustCenterLayout>
