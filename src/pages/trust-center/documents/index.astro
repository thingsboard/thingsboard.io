---
import DocLibrary from '@components/TrustCenter/DocLibrary.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { NDA_TURNAROUND } from '@data/trust-center/nav';
---

<TrustCenterLayout
	lede={`Public documents are available right away. Documents marked NDA are shared within ${NDA_TURNAROUND} after we sign a mutual NDA.`}
	description="ThingsBoard's security and compliance documents: certificates, policies, reports and questionnaires, public or under NDA."
>
	<section class="tc-section" aria-label="Document library">
		<DocLibrary />
	</section>
</TrustCenterLayout>
