---
import ContactForm from '@components/TrustCenter/ContactForm.astro';
import FormPage, { type ElsewhereItem } from '@components/TrustCenter/FormPage.astro';
import { IMS_EMAIL, tc } from '@data/trust-center/nav';

/** The Trust Center's document request: the NDA documents, sent to the IMS team. */

const ELSEWHERE: ElsewhereItem[] = [
	{
		icon: 'tabler:file-text',
		lead: 'Looking for public documents?',
		label: 'Browse the documents',
		href: tc('documents'),
	},
	{ icon: 'tabler:message-circle', lead: 'Have a question?', label: 'Contact our security team', href: tc('contact') },
	{ icon: 'tabler:mail', lead: 'Prefer email?', label: IMS_EMAIL, href: `mailto:${IMS_EMAIL}` },
];
---

<FormPage
	title="Request documents"
	lede="Choose the policies, reports and other documents we share under NDA. Our compliance team replies by email."
	description="Request ThingsBoard's security and compliance documents shared under a mutual NDA."
	metaTitle="Request documents · Trust Center"
	elsewhere={ELSEWHERE}
>
	<ContactForm kind="documents" />
</FormPage>
