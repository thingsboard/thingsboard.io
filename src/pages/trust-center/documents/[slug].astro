---
import Button from '@components/ui/Button.astro';
import Link from '@components/ui/Link.astro';
import Badge from '@components/TrustCenter/Badge.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import Owner from '@components/TrustCenter/Owner.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { ACCESS, DOCS_WITH_PAGE, docActionHref, opensInNewTab, type TcDoc } from '@data/trust-center/documents';
import { SECURITY_TOPICS } from '@data/trust-center/forms';
import { contactHref } from '@data/trust-center/nav';

/** A page for every document that is not a page already: its details and its access action. */

export function getStaticPaths() {
	return DOCS_WITH_PAGE.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props as { doc: TcDoc };
const access = ACCESS[doc.access];
const action = docActionHref(doc);
const questionnaire = doc.access === 'pending' && doc.category === 'Questionnaires';
---

<TrustCenterLayout lede={doc.description} description={doc.description} next={[]}>
	<section class="tc-section tc-split tc-split--from-lg" aria-label="Document details">
		<FactTable caption={`${doc.name}: access, category, version and owner`}>
			<tr>
				<th scope="row">Access</th>
				<td>
					<Badge tone={access.tone} icon={access.icon} label={access.label} note={access.note} />
				</td>
			</tr>
			<tr>
				<th scope="row">Category</th>
				<td>{doc.category}</td>
			</tr>
			<tr>
				<th scope="row">Version</th>
				<td>{doc.version ?? '—'}</td>
			</tr>
			<tr>
				<th scope="row">Owner</th>
				<td>{doc.owner ? <Owner owner={doc.owner} stacked /> : '—'}</td>
			</tr>
		</FactTable>
		{(action || questionnaire) && (
			<div class="tc-aside">
				{action && access.pageAction && (
					<Button href={action} external={opensInNewTab(doc, action)}>
						{access.pageAction}
					</Button>
				)}
				{questionnaire && (
					<p class="tc-note">
						Until it is published, we can give you the information you need to complete your own security questionnaire.{' '}
						<Link variant="inline" href={contactHref(SECURITY_TOPICS.questionnaire.value)}>
							Send us your questionnaire
						</Link>
					</p>
				)}
			</div>
		)}
	</section>
</TrustCenterLayout>
