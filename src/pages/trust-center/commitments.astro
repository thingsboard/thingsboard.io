---
import { Icon } from 'astro-icon/components';
import Link from '@components/ui/Link.astro';
import Catalog from '@components/TrustCenter/Catalog.astro';
import CompareTable from '@components/TrustCenter/CompareTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import {
	COMMITMENT_ROWS,
	COMMITMENTS_LEDE,
	CONFIGURE_INTRO,
	CONFIGURE_LIST,
	PER_PRODUCT_NOTE,
	RESPONSIBILITY,
	RESPONSIBILITY_COLUMNS,
} from '@data/trust-center/deployment';
import { tc } from '@data/trust-center/nav';
import { pageAt } from '@data/trust-center/pages';

const COVERED = ['access', 'data', 'product'].flatMap((slug) => pageAt(tc(slug)) ?? []);
---

<TrustCenterLayout
	lede={COMMITMENTS_LEDE}
	family="deployment"
	description="What ThingsBoard commits to, what it handles in ThingsBoard Cloud, Private Cloud and on-premises, and the security controls built for you to configure."
>
	<section class="tc-section" aria-labelledby="commitments-title">
		<h2 class="tc-h2" id="commitments-title">
			Our commitments
		</h2>
		<Catalog rows={COMMITMENT_ROWS} label="Our commitments" heading="h3" />
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="handles-title">
		<h2 class="tc-h2" id="handles-title">
			What ThingsBoard handles
		</h2>
		<CompareTable
			caption="What ThingsBoard handles in ThingsBoard Cloud, Private Cloud and on-premises"
			firstLabel="Area"
			columns={RESPONSIBILITY_COLUMNS}
			groups={RESPONSIBILITY}
		/>
		<p class="tc-note" set:html={PER_PRODUCT_NOTE} />
	</section>

	<section class="tc-section tc-section--h2 tc-band tc-band--tint" aria-labelledby="configure-title">
		<h2 class="tc-h2" id="configure-title">
			Built for you to configure
		</h2>
		<div class="tc-split">
			<div>
				<p class="tc-lead">{CONFIGURE_INTRO}</p>
				<ul class="tc-checklist tc-checklist--body tc-configure__list">
					{CONFIGURE_LIST.map((item) => (
						<li>
							<Icon name="tabler:check" aria-hidden="true" />
							{item}
						</li>
					))}
				</ul>
			</div>
			<div class="tc-aside">
				<p class="tc-aside__title" id="configure-where">
					Where to find them
				</p>
				<ul class="tc-aside__links" aria-labelledby="configure-where">
					{COVERED.map((page) => (
						<li>
							<Link href={page.href} size="sm">
								{page.title}
							</Link>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-checklist.tc-configure__list {
		margin-top: 0;

		@include media-up(lg) {
			grid-template-columns: 1fr 1fr;
			column-gap: $spacing-6;
		}
	}
</style>
