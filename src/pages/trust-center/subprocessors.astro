---
import { Icon } from 'astro-icon/components';
import CompareTable from '@components/TrustCenter/CompareTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { TC_UPDATED } from '@data/trust-center/pages';
import { formatDate } from '@util/format-date';
import { SUBPROCESSOR_ROWS, SUBPROCESSORS_NOTE } from '@data/trust-center/subprocessors';
---

<TrustCenterLayout
	lede="These vendors may have access to customer or personal data. Each one is assessed in our supplier evaluation and reviewed at least once a year."
	description="The vendors that may access customer or personal data on ThingsBoard's behalf, with each one's purpose and location."
>
	<section class="tc-section" aria-label="Sub-processors">
		<CompareTable
			caption="Sub-processors, with each vendor's purpose and location"
			firstLabel="Vendor"
			columns={[{ name: 'Purpose' }, { name: 'Location' }]}
			groups={[{ rows: SUBPROCESSOR_ROWS }]}
		/>
		<p class="tc-dateline">
			<Icon name="tabler:calendar" class="tc-dateline__icon" aria-hidden="true" />
			<span>
				List last updated <time datetime={TC_UPDATED}>{formatDate(TC_UPDATED)}</time>
			</span>
		</p>
		<p class="tc-note" set:html={SUBPROCESSORS_NOTE} />
	</section>
</TrustCenterLayout>
