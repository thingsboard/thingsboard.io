---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import FaqSection from '@components/Pricing/FaqSection.astro';
import HubDocuments from '@components/TrustCenter/HubDocuments.astro';
import Owner from '@components/TrustCenter/Owner.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CERTIFIED_ON, ISO_CERTS } from '@data/trust-center/compliance';
import { TC_FAQ } from '@data/trust-center/faq';
import { MARK_COLOR, tc } from '@data/trust-center/nav';
import { TC_UPDATED } from '@data/trust-center/pages';
import { formatDate } from '@util/format-date';
import {
	DEPLOYMENT_CARDS,
	HUB_DOCUMENTS_INTRO,
	OVERVIEW_LEDE,
	DEPLOYMENTS_LEAD,
	TILES,
} from '@data/trust-center/overview';
---

<TrustCenterLayout
	title="Trust Center"
	wave
	eyebrow="Security, compliance and privacy"
	lede={OVERVIEW_LEDE}
	description="Security, compliance and privacy at ThingsBoard: certifications, how the platform protects your data, what we handle in each deployment model, documents, and how to reach us."
>
	<Fragment slot="actions">
		<Button href={tc('contact')}>Contact us</Button>
		<Button href={tc('documents')} variant="secondary">
			Browse documents
		</Button>
		<p class="tc-hero__note">
			<Icon name="tabler:shield-exclamation" aria-hidden="true" />
			<span>
				Found a vulnerability?{' '}
				<Link variant="inline" tone="ink" href={tc('report-vulnerability')}>
					Report it privately
				</Link>
			</span>
		</p>
	</Fragment>
	<ul slot="visual" class="tc-seals" aria-label="Certifications">
		{ISO_CERTS.map((cert) => (
			<li>
				<a class="tc-seals__link" href={cert.href}>
					<CertSeal number={cert.number} />
					<span class="ui-sr">{cert.title}</span>
					<span class="tc-seals__badge">
						<Icon name="tabler:circle-check-filled" aria-hidden="true" />
						{CERTIFIED_ON}
					</span>
					<span class="tc-seals__caption">Reg. {cert.registration}</span>
				</a>
			</li>
		))}
	</ul>

	<div class="tc-meta">
		<p class="tc-dateline">
			<Icon name="tabler:calendar-check" class="tc-dateline__icon" aria-hidden="true" />
			<span>
				Last updated <time datetime={TC_UPDATED}>{formatDate(TC_UPDATED)}</time> · Reviewed at least every six months
			</span>
		</p>
		<p class="tc-dateline">
			<span>
				Maintained by <Owner tone="muted" />
			</span>
		</p>
	</div>

	<section class="tc-section tc-section--h2" id="highlights" aria-label="Security highlights">
		<CardGrid>
			{TILES.map((tile) => (
				<Card href={tile.href} title={tile.title} edge="line" class="tc-link-card tc-tile">
					<Mark slot="mark" size={40} icon={tile.icon} accent={MARK_COLOR.graphite} />
					<p class="tc-tile__sub">{tile.subtitle}</p>
					<ul class="tc-checklist">
						{tile.points.map((point) => (
							<li>
								<Icon name="tabler:check" aria-hidden="true" />
								{point}
							</li>
						))}
					</ul>
					<span class="tc-tile__more" aria-hidden="true">
						Learn more
						<Icon name="tabler:chevron-right" aria-hidden="true" />
					</span>
				</Card>
			))}
		</CardGrid>
	</section>

	<section
		class="tc-section tc-section--h2 tc-band tc-band--deployments"
		id="deployment"
		aria-labelledby="deployment-title"
	>
		<h2 class="tc-h2" id="deployment-title">
			Deployments
		</h2>
		<p class="tc-lead">{DEPLOYMENTS_LEAD}</p>
		<CardGrid cols={2}>
			{DEPLOYMENT_CARDS.map((card) => (
				<Card href={card.href} title={card.title} class="tc-link-card tc-deploy-card">
					<Mark slot="mark" size={48} icon={card.icon} accent={card.accent} />
					<p class="tc-deploy-card__text">{card.text}</p>
					<dl class="tc-deploy-card__rows">
						{card.rows.map((row) => (
							<>
								<dt>{row.label}</dt>
								<dd>
									{row.lines.map((line, i) => (
										<>
											{i > 0 && <br />}
											{line}
										</>
									))}
								</dd>
							</>
						))}
					</dl>
					<Link slot="footer" href={card.href}>
						Learn more
					</Link>
				</Card>
			))}
		</CardGrid>
	</section>

	<section class="tc-section tc-section--h2" id="documents" aria-labelledby="documents-title">
		<h2 class="tc-h2" id="documents-title">
			Documents
		</h2>
		<p class="tc-lead" set:html={HUB_DOCUMENTS_INTRO} />
		<HubDocuments />
	</section>

	<section class="tc-section tc-section--h2" id="faq" aria-labelledby="faq-title">
		<h2 class="tc-h2" id="faq-title">
			Trust Center FAQs
		</h2>
		<FaqSection contextId="trust-center" categories={TC_FAQ} visibleCount={5} />
	</section>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-seals {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-8 $spacing-6;
		padding: 0;
		list-style: none;

		@include media-up(md) {
			flex-wrap: nowrap;
			justify-content: center;
		}
	}

	.tc-seals__link {
		display: grid;
		justify-items: center;
		gap: $spacing-2;
		color: inherit;
		text-align: center;
		text-decoration: none;

		// The ribbon hangs below the disc, outside the box.
		.tc-seal {
			margin-bottom: $spacing-8;
		}

		&:hover .tc-seal__disc {
			box-shadow:
				0 0 0 2px var(--accent-fill),
				0 8px 20px -8px rgba(23, 24, 28, 0.3);
		}

		&:hover .tc-seals__caption {
			color: var(--accent-ink);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 6px;
			border-radius: $radius-md;
		}
	}

	.tc-seals__badge {
		@include type-small;

		display: inline-flex;
		align-items: center;
		gap: 5px;
		height: 26px;
		padding: 0 10px 0 8px;
		border-radius: $radius-full;
		background: var(--color-bg-surface);
		color: var(--color-success);
		white-space: nowrap;

		svg {
			width: 16px;
			height: 16px;
		}
	}

	.tc-seals__caption {
		@include type-small;

		color: var(--color-text-secondary);
	}

	// The tile's own "Learn more" underlines with the card's hover.
	@media (hover: hover) {
		.ui-card--link.tc-tile:hover .tc-tile__more {
			text-decoration-line: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 3px;
		}
	}

	.tc-tile .ui-mark,
	.tc-deploy-card .ui-mark {
		margin-bottom: $spacing-3;
	}

	.tc-tile__sub {
		@include type-small;

		margin-top: 2px;
		color: var(--color-text-secondary);
	}

	.tc-tile__more {
		@include type-link;

		display: inline-flex;
		align-items: center;
		gap: 2px;
		margin-top: auto;
		padding-top: $spacing-4;
		color: var(--accent-ink);

		svg {
			width: 18px;
			height: 18px;
		}
	}

	.tc-deploy-card__text {
		@include type-body;

		margin-top: 2px;
		color: var(--color-text-secondary);
	}

	.tc-deploy-card__rows {
		@include type-small;

		display: grid;
		grid-template-columns: 104px minmax(0, 1fr);
		gap: $spacing-2 $spacing-3;
		margin: $spacing-4 0;

		dt {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}

		dd {
			margin: 0;
			color: var(--color-text-secondary);
		}
	}

	@media print {
		// Most of a sheet tall: kept whole, it would leave the sheet before it half empty.
		.ui-card.tc-deploy-card {
			break-inside: auto;
		}
	}
</style>
