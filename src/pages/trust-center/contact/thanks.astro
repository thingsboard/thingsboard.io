---
import { Icon } from 'astro-icon/components';
import ThanksPage from '@components/TrustCenter/ThanksPage.astro';
import { CONTACT_SENT_KEY, NDA_STEPS, SENT_MAX_AGE_MS, THANKS_BY_TOPIC } from '@data/trust-center/forms';
import { tc } from '@data/trust-center/nav';

/**
 * The contact form's thank-you. The inline script swaps the generic words for the reader's own and the
 * topic's (`THANKS_BY_TOPIC`), from what the form kept in session storage, before first paint; without
 * it (another tab, an hour later) they stay.
 */
---

<ThanksPage
	metaTitle="Message sent · Trust Center"
	description="Thank you for getting in touch with ThingsBoard's security team."
	eyebrow="Message sent"
	title="Thanks, your message is on its way"
	lede="Our security team will read it and reply by email."
	back={{ href: tc(), label: 'Back to the Trust Center' }}
>
	<div class="tc-thanks-more" data-thanks="docs" hidden>
		<p class="tc-thanks-more__label">What you asked for</p>
		<ul class="tc-thanks-more__docs" data-thanks="doclist"></ul>
	</div>
	<div class="tc-thanks-more" data-thanks="nda" hidden>
		<p class="tc-thanks-more__label">What happens next</p>
		<ol class="tc-steps">
			{NDA_STEPS.map((step, i) => (
				<li class="tc-steps__item">
					<span class="tc-steps__n" aria-hidden="true">
						{i + 1}
					</span>
					<span class="tc-steps__text">
						<span class="tc-steps__title">{step.title}</span>
						{step.line && <span class="tc-steps__line">{step.line}</span>}
					</span>
				</li>
			))}
		</ol>
	</div>
	{/* CLARIFY (privacy team): how is a data subject's identity confirmed, by whom, and how fast? */}
	<p class="tc-thanks-note" data-thanks="dsr" hidden>
		<Icon name="tabler:id-badge-2" class="tc-thanks-note__icon" aria-hidden="true" />
		We may ask you to confirm your identity before we act on the request.
	</p>

	{/* The name and the address are the reader's own input: the script builds nodes, never markup. */}
	<script
		slot="script"
		is:inline
		define:vars={{ KEY: CONTACT_SENT_KEY, MAX_AGE: SENT_MAX_AGE_MS, THANKS: THANKS_BY_TOPIC }}
	>
		(() => {
			let sent;
			try {
				sent = JSON.parse(sessionStorage.getItem(KEY) || 'null');
			} catch {
				return;
			}
			if (!sent || typeof sent.at !== 'number' || Date.now() - sent.at > MAX_AGE) return;

			const part = (name) => document.querySelector(`[data-thanks="${name}"]`);
			const name = typeof sent.firstName === 'string' ? sent.firstName : '';
			const email = typeof sent.email === 'string' ? sent.email : '';
			const docs = Array.isArray(sent.docs) ? sent.docs : [];
			const topic = THANKS[sent.subject];
			const noun = topic?.noun ?? 'message';

			if (topic?.eyebrow) part('eyebrow').textContent = topic.eyebrow;
			if (name) part('title').textContent = `Thanks, ${name}. Your ${noun} is on its way.`;
			else if (topic?.noun) part('title').textContent = `Thanks, your ${noun} is on its way`;
			if (topic && email) {
				const strong = document.createElement('strong');
				strong.textContent = email;
				part('lede').replaceChildren(topic.lede[0], strong, topic.lede[1]);
			}
			if (topic?.documents && docs.length) {
				const list = part('doclist');
				docs.forEach((d) => {
					const li = document.createElement('li');
					li.textContent = d.label;
					list.append(li);
				});
				part('docs').hidden = false;
				part('nda').hidden = false;
			}
			if (topic?.identity) part('dsr').hidden = false;
			if (typeof sent.from === 'string' && sent.from.startsWith('/')) {
				const url = new URL(sent.from, window.location.origin);
				url.searchParams.set('resend', '');
				part('fix-link').href = `${url.pathname}${url.search.replace('resend=', 'resend')}`;
				part('fix').hidden = false;
			}
		})();
	</script>
</ThanksPage>

<style is:global lang="scss">
	@use '../../../styles/variables' as *;

	// The card is a flex column that centres its children: these take the lede's width instead.
	.tc-thanks-more {
		align-self: center;
		box-sizing: border-box;
		width: 100%;
		max-width: 460px;
		margin: $spacing-6 auto 0;
		padding: $spacing-4 $spacing-5;
		border-radius: $radius-xl;
		background: color-mix(in srgb, var(--color-text) 4%, var(--color-bg-surface));
		text-align: left;

		& + & {
			margin-top: $spacing-3;
		}
	}

	.tc-thanks-more__label {
		@include type-small-strong;

		margin-bottom: $spacing-3;
		color: var(--color-text);
	}

	.tc-thanks-more__docs {
		@include type-small;

		display: grid;
		gap: 6px;
		padding-left: $spacing-5;
		color: var(--color-text);
	}

	.tc-steps {
		display: grid;
		gap: $spacing-3;
		padding: 0;
		list-style: none;
	}

	.tc-steps__item {
		display: flex;
		align-items: flex-start;
		gap: $spacing-3;
	}

	.tc-steps__n {
		display: grid;
		flex: none;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--color-text);
		color: var(--color-bg-surface);
		font-size: $font-size-xs;
		font-weight: $font-weight-medium;
		line-height: 1;
	}

	.tc-steps__text {
		display: grid;
		gap: 2px;
		padding-top: 2px;
	}

	.tc-steps__title {
		@include type-small-strong;

		color: var(--color-text);
	}

	.tc-steps__line {
		@include type-small;

		color: var(--color-text-secondary);
	}

	.tc-thanks-note {
		@include type-small;

		display: flex;
		align-self: center;
		box-sizing: border-box;
		gap: $spacing-2;
		width: 100%;
		max-width: 460px;
		margin: $spacing-3 auto 0;
		padding: 0 $spacing-1;
		color: var(--color-text-secondary);
		text-align: left;

		&[hidden] {
			display: none;
		}
	}

	.tc-thanks-note__icon {
		flex: none;
		width: 18px;
		height: 18px;
		margin-top: 1px;
	}
</style>
