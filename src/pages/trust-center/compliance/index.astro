---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CERTIFIED_ON, VERIFY, CERT_DETAILS, COMPLIANCE_LEDE, ISO_CERTS } from '@data/trust-center/compliance';
---

<TrustCenterLayout
	lede={COMPLIANCE_LEDE}
	description="ThingsBoard's ISO/IEC 27001:2022 and ISO 9001:2015 certificates for information security and quality: scope, certification body, validity and verification."
>
	<section class="tc-section" aria-labelledby="certs-title">
		<h2 class="tc-h2" id="certs-title">
			Certifications and assurance
		</h2>
		<div class="tc-certs">
			{ISO_CERTS.map((cert) => (
				<Card href={cert.href} title={cert.title} edge="line" class="tc-link-card tc-cert">
					<CertSeal slot="mark" number={cert.number} class="tc-cert__seal" />
					<p class="tc-cert__line">{cert.line}</p>
					<span class="tc-cert__status">
						<Icon name="tabler:circle-check-filled" aria-hidden="true" />
						{CERTIFIED_ON}
					</span>
					<p class="tc-cert__reg">Reg. No {cert.registration}</p>
					<Link slot="footer" href={cert.href}>
						Learn more
					</Link>
				</Card>
			))}
		</div>
		<div class="tc-split tc-split--from-lg tc-compliance__facts">
			<FactTable caption="Certification and assurance details" rows={CERT_DETAILS} />
			<div class="tc-aside">
				<Button href={VERIFY.href} variant="secondary" external>
					{VERIFY.label}
				</Button>
				<p class="tc-note">{VERIFY.note}</p>
			</div>
		</div>
	</section>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../../styles/variables' as *;

	.tc-certs {
		display: grid;
		gap: $spacing-4;

		@include media-up(sm) {
			grid-template-columns: 1fr 1fr;
		}
	}

	.ui-card.tc-cert {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-rows: repeat(5, auto);
		column-gap: $spacing-5;
		align-items: center;
		align-content: center;

		.tc-cert__seal {
			grid-row: 1 / span 5;
			align-self: start;
			margin: 0;
		}

		.ui-card__footer {
			margin-top: $spacing-3;
		}
	}

	.tc-cert__status {
		@include type-small;

		display: inline-flex;
		align-items: center;
		gap: 6px;
		align-self: start;
		justify-self: start;
		margin-top: $spacing-3;
		color: var(--color-success);

		svg {
			flex: none;
			width: 16px;
			height: 16px;
		}
	}

	.tc-cert__reg {
		@include type-small;

		margin: 2px 0 0;
		color: var(--color-text-secondary);
		font-variant-numeric: tabular-nums;
	}

	.tc-cert__line {
		@include type-small;

		margin-top: 2px;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.tc-compliance__facts {
		margin-top: $spacing-6;
	}
</style>
