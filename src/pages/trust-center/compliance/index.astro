---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import Badge from '@components/TrustCenter/Badge.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import {
	AUDIT,
	CERTIFIED_ON,
	VERIFY,
	CERT_DETAILS,
	COMPLIANCE_LEDE,
	ISO_CERTS,
	PRIVACY,
} from '@data/trust-center/compliance';
---

<TrustCenterLayout
	lede={COMPLIANCE_LEDE}
	description="ThingsBoard's ISO/IEC 27001:2022 and ISO 9001:2015 certification, its scope, penetration testing, data centers, GDPR and CCPA, and using our compliance in your own audit."
>
	<section class="tc-section" aria-labelledby="certs-title">
		<h2 class="tc-h2" id="certs-title">
			Certifications and assurance
		</h2>
		<div class="tc-certs">
			{ISO_CERTS.map((cert) => (
				<Card href={cert.href} title={cert.title} edge="line" class="tc-link-card tc-cert">
					<CertSeal slot="mark" number={cert.number} class="tc-cert__seal" />
					<p class="tc-cert__line">{cert.line}</p>
					<span class="tc-cert__status">
						<Icon name="tabler:circle-check-filled" aria-hidden="true" />
						{CERTIFIED_ON}
					</span>
					<p class="tc-cert__reg">Reg. No {cert.registration}</p>
					<Link slot="footer" href={cert.href}>
						Learn more
					</Link>
				</Card>
			))}
		</div>
		<div class="tc-split tc-split--from-lg tc-compliance__facts">
			<FactTable caption="Certification and assurance details" rows={CERT_DETAILS} />
			<div class="tc-aside">
				<Button href={VERIFY.href} variant="secondary" external>
					{VERIFY.label}
				</Button>
				<p class="tc-note">{VERIFY.note}</p>
			</div>
		</div>
	</section>

	<section class="tc-section tc-section--h2 tc-band tc-band--tint" aria-labelledby="audit-title">
		<h2 class="tc-h2" id="audit-title">
			{AUDIT.title}
		</h2>
		<div class="tc-split tc-audit">
			<div>
				<p class="tc-lead">{AUDIT.text}</p>
				<div class="tc-audit__cta">
					<Button href={AUDIT.cta.href}>{AUDIT.cta.label}</Button>
				</div>
			</div>
			<div class="tc-aside">
				<p class="tc-note">{AUDIT.controlsLead}</p>
				<ul class="tc-checklist tc-checklist--body">
					{AUDIT.controls.map((control) => (
						<li>
							<Icon name="tabler:check" aria-hidden="true" />
							<Link variant="inline" href={control.href}>
								{control.label}
							</Link>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="privacy-title">
		<h2 class="tc-h2" id="privacy-title">
			{PRIVACY.title}
		</h2>
		<p class="tc-lead">{PRIVACY.lead}</p>
		<div class="tc-certs">
			{PRIVACY.laws.map((law) => (
				<Card href={law.href} title={law.title} edge="line" class="tc-link-card tc-law">
					<Mark slot="mark" size={64} icon={law.icon} accent={law.accent} />
					<p class="tc-law__text">{law.text}</p>
					<Link slot="footer" href={law.href}>
						Learn more
					</Link>
				</Card>
			))}
		</div>
		<div class="tc-split tc-privacy__commitments">
			<ul class="tc-checklist tc-checklist--body tc-privacy__list">
				{PRIVACY.commitments.map((point) => (
					<li>
						<Icon name="tabler:check" aria-hidden="true" />
						<span set:html={point} />
					</li>
				))}
			</ul>
			<div class="tc-aside">
				<Badge tone="flat" icon="tabler:writing-sign" label="Self-declared" />
				<p class="tc-note">{PRIVACY.note}</p>
			</div>
		</div>
	</section>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../../styles/variables' as *;

	.tc-certs {
		display: grid;
		gap: $spacing-4;

		@include media-up(sm) {
			grid-template-columns: 1fr 1fr;
		}
	}

	.ui-card.tc-cert {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-rows: repeat(5, auto);
		column-gap: $spacing-5;
		align-items: center;
		align-content: center;

		.tc-cert__seal {
			grid-row: 1 / span 5;
			align-self: start;
			margin: 0;
		}

		.ui-card__footer {
			margin-top: $spacing-3;
		}
	}

	.tc-cert__status {
		@include type-small;

		display: inline-flex;
		align-items: center;
		gap: 6px;
		align-self: start;
		justify-self: start;
		margin-top: $spacing-3;
		color: var(--color-success);

		svg {
			flex: none;
			width: 16px;
			height: 16px;
		}
	}

	.tc-cert__reg {
		@include type-small;

		margin: 2px 0 0;
		color: var(--color-text-secondary);
		font-variant-numeric: tabular-nums;
	}

	.tc-cert__line {
		@include type-small;

		margin-top: 2px;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.tc-compliance__facts {
		margin-top: $spacing-6;
	}

	.tc-privacy__commitments {
		margin-top: $spacing-6;
	}

	.ui-card.tc-law {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-rows: repeat(3, auto);
		column-gap: $spacing-5;
		align-content: start;

		.ui-mark {
			grid-row: 1 / span 3;
			align-self: start;
			margin: 0;
		}

		.ui-card__footer {
			margin-top: $spacing-3;
		}
	}

	.tc-law__text {
		@include type-small;

		margin: 2px 0 0;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.tc-checklist.tc-privacy__list {
		gap: $spacing-3;
		max-width: var(--tc-main);
		margin-top: 0;
	}

	.tc-audit .tc-lead {
		margin-bottom: 0;
	}

	.tc-audit__cta {
		margin-top: $spacing-6;

		// The kit's button never wraps; this label is wider than a 320px screen.
		@include media-down(sm) {
			.ui-btn {
				height: auto;
				min-height: 44px;
				padding-block: $spacing-2;
				white-space: normal;
				text-align: center;
			}
		}
	}
</style>
