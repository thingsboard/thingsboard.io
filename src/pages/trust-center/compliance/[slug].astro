---
import Button from '@components/ui/Button.astro';
import Link from '@components/ui/Link.astro';
import Badge from '@components/TrustCenter/Badge.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CERTIFIED_NOTE, VERIFY, CERT_PAGES, type CertPage } from '@data/trust-center/compliance';
import { DOCS } from '@data/trust-center/documents';
import { pageFor } from '@data/trust-center/pages';
import { tc } from '@data/trust-center/nav';

/**
 * The certificate pages. An ISO page is also its certificate's entry in the document library (the
 * entry's `url` points here), so the certificate file opens from here.
 */

export function getStaticPaths() {
	return CERT_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: CertPage };
const { title } = pageFor(`compliance/${page.slug}`);
const certificate = DOCS.find((d) => d.url === tc(`compliance/${page.slug}`) && d.file);
---

<TrustCenterLayout lede={page.lede} description={`${title} at ThingsBoard: ${page.lede}`}>
	<section class:list={['tc-section', certificate && 'tc-split tc-split--from-lg']} aria-label={`${title} details`}>
		<FactTable caption={`${title} details`} rows={page.facts}>
			{page.certified && (
				<tr>
					<th scope="row">Status</th>
					<td>
						<Badge tone="ok" icon="tabler:circle-check-filled" label="Certified" note={CERTIFIED_NOTE} />
					</td>
				</tr>
			)}
		</FactTable>
		{certificate?.file && (
			<div class="tc-aside">
				<Button href={certificate.file} external class="tc-cert__view">
					View certificate
				</Button>
				<Link href={VERIFY.href} size="sm" external>
					Verify on {VERIFY.site}
				</Link>
			</div>
		)}
		{/* Announces the Copy buttons `FactTable` renders for the registration numbers. */}
		<span class="ui-sr" role="status" data-copy-status></span>
	</section>
</TrustCenterLayout>

<script>
	import { initCopyButtons } from '@util/copy-button';

	initCopyButtons(document, {
		status: document.querySelector<HTMLElement>('[data-copy-status]'),
		copiedMessage: 'Registration number copied',
		clearStatus: true,
	});
</script>

<style is:global lang="scss">
	@media print {
		.ui-btn.tc-cert__view {
			display: none;
		}
	}
</style>
