---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import {
	IOT_HUB_CATEGORIES,
	IOT_HUB_STRINGS,
	SEARCH_PAGE_SIZE,
	isNumericSlug,
	type GridEntry,
} from '@models/iot-hub';
import BaseLayout from '@layouts/BaseLayout.astro';
import FlatResultsPanel from '@components/IotHub/FlatResultsPanel.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import IotHubRuntimeConfig from '@components/IotHub/IotHubRuntimeConfig.astro';
import SearchFilterBar from '@components/IotHub/SearchFilterBar.astro';
import { recordSitemapLastmod } from '@util/sitemap-lastmod';

const T = IOT_HUB_STRINGS.searchPage;

export const getStaticPaths = (async () => {
	const categories = await getCollection('iotHubCategories');
	const byId = new Map(categories.map((c) => [c.id, c.data]));

	const allItems: GridEntry[] = [];
	for (const cat of IOT_HUB_CATEGORIES) {
		const items = byId.get(cat.slug)?.items ?? [];
		for (const item of items) {
			if (isNumericSlug(item.slug)) continue;
			allItems.push({ item, categorySlug: cat.slug });
		}
	}
	// Match the backend's order for `?sortProperty=installCount&sortOrder=DESC`
	// — installCount DESC, then createdTime DESC as tie-break — so the static
	// build and runtime refetches surface items in the same order.
	allItems.sort((a, b) => {
		const ic = (b.item.installCount ?? 0) - (a.item.installCount ?? 0);
		if (ic !== 0) return ic;
		return (b.item.createdTime ?? 0) - (a.item.createdTime ?? 0);
	});

	const total = allItems.length;
	const totalPages = Math.max(1, Math.ceil(total / SEARCH_PAGE_SIZE));

	return Array.from({ length: totalPages }, (_, i) => {
		const currentPage = i + 1;
		// Each item keeps the slug of the collection it was loaded from, which is
		// authoritative for the card's href.
		const items = allItems.slice(i * SEARCH_PAGE_SIZE, currentPage * SEARCH_PAGE_SIZE);
		return {
			params: { page: currentPage === 1 ? undefined : String(currentPage) },
			props: { items, currentPage, totalPages, total },
		};
	});
}) satisfies GetStaticPaths;

interface Props {
	items: GridEntry[];
	currentPage: number;
	totalPages: number;
	total: number;
}

const { items, currentPage, totalPages, total } = Astro.props as Props;
const searchText = '';
const basePath = '/iot-hub/search/';

// <lastmod> from the newest listing `updatedTime` on this page.
recordSitemapLastmod(
	Astro.url.pathname,
	items.map((entry) => entry.item.updatedTime)
);

// Distinct title/description on pages 2+ to avoid duplicate metadata.
const isFirstPage = currentPage === 1;
const title = isFirstPage
	? 'Search | IoT Hub | ThingsBoard'
	: `Search | Page ${currentPage} | IoT Hub | ThingsBoard`;
const baseDescription =
	'Search the ThingsBoard IoT Hub catalogue of devices, widgets, rule chains and more.';
const description = isFirstPage ? baseDescription : `${baseDescription} (page ${currentPage})`;
---

<BaseLayout title={title} description={description}>
	<main
		class="iot-hub-search"
		data-iot-hub-search-root
		data-base-path="/iot-hub/search/"
		data-page-size={SEARCH_PAGE_SIZE}
	>
		<div class="iot-hub-search__center">
			<div class="iot-hub-search__container">
				<div class="iot-hub-search__breadcrumb">
					<Breadcrumbs
						items={[
							{ label: T.breadcrumbRoot, href: '/iot-hub/' },
							{ label: T.breadcrumbCurrent },
						]}
					/>
				</div>
				<div class="iot-hub-search__items" data-search-items>
					<SearchFilterBar
						headingAs="h1"
						heading={T.headingEmpty}
						headingPrefix={T.headingPrefix}
						searchText={searchText}
						searchPlaceholder={T.searchPlaceholder}
						totalResults={total}
					/>
					<FlatResultsPanel
						items={items}
						currentPage={currentPage}
						totalPages={totalPages}
						basePath={basePath}
						perPage={SEARCH_PAGE_SIZE}
						titleAs="h2"
					/>
				</div>
			</div>
		</div>
		<IotHubRuntimeConfig />
	</main>
</BaseLayout>

<style lang="scss">
	@use '../../../styles/_variables.scss' as *;
	@use '../../../styles/_iot-hub.scss' as *;

	.iot-hub-search {
		@include iot-hub-hairline-token;
	}

	.iot-hub-search__center {
		@include iot-hub-center;
	}

	.iot-hub-search__container {
		@include iot-hub-container;
	}

	.iot-hub-search__breadcrumb {
		padding: calc(#{$header-height} + 40px) 16px 0;

		@include media-down(sm) {
			padding: calc(#{$header-height} + 40px) 12px 0;
		}
	}

	.iot-hub-search__items {
		@include iot-hub-listing-column;
	}

</style>

<script>
	import { initDynamicSearch } from '@components/IotHub/iot-hub-dynamic-search';
	initDynamicSearch();
</script>
