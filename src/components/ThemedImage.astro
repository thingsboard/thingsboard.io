---
// One image in a light and a dark version, swapped by Starlight's theme classes.
//
// Both load eagerly. Printing switches a dark page to light (ThemeProvider), and the
// light copy has to be there already: a lazy image hidden with display:none is never
// fetched, so it would print as a blank space.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props {
	src: ImageMetadata;
	darkSrc: ImageMetadata;
	alt: string;
	width?: number;
	style?: HTMLAttributes<'img'>['style'];
}

const { src, darkSrc, alt, width, style } = Astro.props;
---

<Image class="dark:sl-hidden" src={src} alt={alt} width={width} style={style} loading="eager" />
<Image class="light:sl-hidden" src={darkSrc} alt={alt} width={width} style={style} loading="eager" />
