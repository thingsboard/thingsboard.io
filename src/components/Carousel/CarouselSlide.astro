---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['carousel-slide', className]} role="group" aria-roledescription="slide">
	<slot />
</div>

<style lang="scss">
	// Sized by the parent Carousel via custom properties so the perView ladder
	// lives in one place (slot content is outside Carousel's style scope).
	// The "N of M" aria-label is set by carousel-init.ts.
	.carousel-slide {
		flex: 0 0 var(--carousel-slide-basis, 100%);
		min-width: 0;
		margin-right: var(--carousel-slide-gutter, 0px);
	}
</style>
