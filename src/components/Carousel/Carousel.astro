---
import { Icon } from 'astro-icon/components';
import SmartImage from '@components/SmartImage.astro';

export interface CarouselItem {
	src: string;
	alt: string;
	title?: string;
	description?: string;
	linkLabel?: string;
	href?: string;
	width: string | number;
	height: string | number;
}

interface Props {
	/** Prop-driven slides. Omit and fill the default slot with `<CarouselSlide>`s instead for arbitrary markup. */
	items?: CarouselItem[];
	/** Items-mode slide design. The usecase variant expects `href` on every item. */
	variant?: 'default' | 'usecase' | 'simple';
	showDots?: boolean;
	showArrows?: boolean;
	/** 'overlay' floats round buttons over the slides; 'header' puts them in a title row above. */
	arrowPlacement?: 'overlay' | 'header';
	/** Rendered as an h2 in the header row (header placement only). */
	title?: string;
	autoplay?: boolean;
	autoplayInterval?: number;
	loop?: boolean;
	/** 3 shows three slides per view on desktop, two below lg, one below md. */
	perView?: 1 | 3;
	class?: string;
	ariaLabel: string;
}

const {
	items,
	variant = 'default',
	showDots = true,
	showArrows = true,
	arrowPlacement = 'overlay',
	title,
	autoplay = false,
	autoplayInterval = 5000,
	loop = true,
	perView = 1,
	class: className = '',
	ariaLabel,
} = Astro.props;
---

<div
	class:list={[
		'carousel-wrapper',
		`carousel-${variant}`,
		{ 'carousel-multi': perView === 3, 'carousel-slotted': !items },
		className,
	]}
	role="region"
	aria-roledescription="carousel"
	aria-label={ariaLabel}
	data-autoplay={autoplay.toString()}
	data-autoplay-interval={autoplayInterval.toString()}
	data-loop={loop.toString()}
>
	{
		arrowPlacement === 'header' && (title || showArrows) && (
			<header class:list={['carousel-header', { 'carousel-header--no-title': !title }]}>
				{title && <h2 class="carousel-title">{title}</h2>}
				{showArrows && (
					<div class="carousel-buttons carousel-buttons--header">
						<button type="button" class="carousel-button carousel-button-prev" aria-label="Previous slide">
							<Icon name="tabler:chevron-left" />
						</button>
						<button type="button" class="carousel-button carousel-button-next" aria-label="Next slide">
							<Icon name="tabler:chevron-right" />
						</button>
					</div>
				)}
			</header>
		)
	}

	<div class="carousel-stage">
		<div class="carousel-viewport">
			<div class="carousel-container">
				{
					items ? (
						items.map((item, index) => (
							<div
								class="carousel-slide"
								role="group"
								aria-roledescription="slide"
								aria-label={`${index + 1} of ${items.length}`}
							>
								{variant === 'usecase' ? (
									<div class="carousel-item-flex-row">
										<div class="carousel-text">
											<h3>{item.title}</h3>
											{item.description && <p>{item.description}</p>}
											<a href={item.href} class="carousel-link">
												{item.linkLabel || 'Learn more'}
												<span class="arrow-container">
													<Icon name="tabler:chevron-right" class="arrow first" />
													<Icon name="tabler:chevron-right" class="arrow second" />
													<Icon name="tabler:chevron-right" class="arrow third" />
												</span>
											</a>
										</div>
										<div class="carousel-image">
											<a href={item.href}>
												<SmartImage
													src={item.src}
													alt={item.alt}
													width={item.width}
													height={item.height}
													loading="lazy"
												/>
												<div class="overlay">
													<div class="eye">
														<Icon name="tabler:eye" class="icon" />
														See more about {item.title}
													</div>
												</div>
											</a>
										</div>
									</div>
								) : (
									<div class={variant === 'simple' ? 'carousel-item-simple' : 'carousel-item-default'}>
										{item.href ? (
											<a href={item.href}>
												<SmartImage
													src={item.src}
													alt={item.alt}
													width={item.width}
													height={item.height}
													loading="lazy"
												/>
											</a>
										) : (
											<SmartImage
												src={item.src}
												alt={item.alt}
												width={item.width}
												height={item.height}
												loading="lazy"
											/>
										)}
										{item.title && <p class="carousel-caption">{item.title}</p>}
									</div>
								)}
							</div>
						))
					) : (
						<slot />
					)
				}
			</div>
		</div>

		{
			showArrows && arrowPlacement === 'overlay' && (
				<div class="carousel-buttons carousel-buttons--overlay">
					<button type="button" class="carousel-button carousel-button-prev" aria-label="Previous slide">
						<Icon name="tabler:chevron-left" />
					</button>
					<button type="button" class="carousel-button carousel-button-next" aria-label="Next slide">
						<Icon name="tabler:chevron-right" />
					</button>
				</div>
			)
		}
	</div>

	{
		showDots && (
			<div class="carousel-dots">
				{items?.map((_, index) => (
					<button
						type="button"
						class:list={['carousel-dot', { active: index === 0 }]}
						data-index={index}
						aria-label={`Go to slide ${index + 1}`}
						aria-current={index === 0 ? 'true' : undefined}
					/>
				))}
			</div>
		)
	}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	.carousel-wrapper {
		position: relative;
		margin: var(--carousel-margin, $spacing-16 0 $spacing-6);
		--carousel-gap: #{$spacing-5};
		// Slide sizing — read by items-mode slides below AND by CarouselSlide.astro
		// (slot content is outside this style scope, so plain selectors can't reach it)
		--carousel-slide-basis: 100%;
		--carousel-slide-gutter: 0px;
		// Brand accent: indigo in light theme, lavender in dark. --color-brand-indigo
		// lands with the brand unification; --color-product-cloud is the identical pair.
		--carousel-accent: var(--color-brand-indigo, var(--color-product-cloud));
		--carousel-accent-contrast: var(--color-brand-indigo-contrast, var(--color-bg));
	}

	// Multi-per-view (3/2/1 across breakpoints). Spacing moves from the container's
	// flex gap to a right-margin on each slide — Embla's loop mode translates wrapped
	// slides individually, and a flex gap doesn't travel with a slide across the loop
	// boundary, while a margin does.
	.carousel-multi {
		--carousel-gap: 0px;
		--carousel-slide-basis: calc(33.333% - 16px);
		--carousel-slide-gutter: #{$spacing-6};

		@include media-down(lg) {
			--carousel-slide-basis: calc(50% - 12px);
		}

		@include media-down(md) {
			--carousel-slide-basis: calc(100% - 8px);
		}

		.carousel-container {
			backface-visibility: hidden;
			-webkit-backface-visibility: hidden;
		}
	}

	// Header row — title on the left, arrows on the right
	.carousel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-6;
		margin-bottom: $spacing-6;
	}

	.carousel-header--no-title {
		justify-content: flex-end;
	}

	.carousel-title {
		@include section-title;
		color: var(--color-text);
		margin: 0;
	}

	// Anchors the arrow overlay to the slide area, excluding the dots row below
	.carousel-stage {
		position: relative;
	}

	.carousel-viewport {
		overflow: hidden;
	}

	// Slot-mode slides are usually cards — bleed the clip box 2px so their
	// inset borders and shadows aren't cut at the viewport edges
	.carousel-slotted .carousel-viewport {
		padding: 2px;
		margin: -2px;
	}

	.carousel-container {
		display: flex;
		gap: var(--carousel-gap);
		user-select: none;
		-webkit-touch-callout: none;
		-khtml-user-select: none;
		-webkit-tap-highlight-color: transparent;
	}

	.carousel-slide {
		flex: 0 0 var(--carousel-slide-basis);
		min-width: 0;
		margin-right: var(--carousel-slide-gutter);
	}

	// Default variant
	.carousel-item-default,
	.carousel-item-simple {
		text-align: center;
	}

	.carousel-item-default img,
	.carousel-item-simple img {
		max-width: 100%;
		height: auto;
		border-radius: var(--imageBorderRadius, $radius-xl);
	}

	.carousel-caption {
		@include action-link;
		margin-top: $spacing-4;
		color: var(--color-text);
	}

	// Usecase variant
	.carousel-usecase .carousel-item-flex-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		gap: $spacing-10;
		padding: 0 $spacing-16; // clear the 44px round nav buttons
	}

	.carousel-usecase .carousel-text {
		width: 30%;
		display: flex;
		flex-direction: column;
		gap: $spacing-4;
	}

	.carousel-usecase .carousel-text h3 {
		@include section-title;
		color: var(--color-text);
		margin: 0;
		text-align: left;
	}

	.carousel-usecase .carousel-text p {
		@include text-m;
		margin: 0;
	}

	.carousel-usecase .carousel-link {
		@include action-link;
		display: inline-block;
		position: relative;
		color: var(--color-primary);
		text-decoration: none;
		transition: color $transition-base;
	}

	.carousel-usecase .carousel-link:hover {
		text-decoration: none;
	}

	.carousel-usecase .arrow-container {
		position: relative;
		display: inline-block;
		margin-left: 12px;
		width: 50px;
		height: 20px;
		vertical-align: middle;
	}

	.carousel-usecase .arrow {
		position: absolute;
		top: 4px;
		left: 0;
		font-size: 16px;
		transition: transform $transition-base;
		color: var(--color-primary);
	}

	.carousel-usecase .arrow.first {
		opacity: 0.2;
	}

	.carousel-usecase .arrow.second {
		opacity: 0.5;
	}

	.carousel-usecase .arrow.third {
		opacity: 1;
	}

	.carousel-usecase .carousel-link:hover .arrow.first {
		transform: translateX(10px);
	}

	.carousel-usecase .carousel-link:hover .arrow.second {
		transform: translateX(20px);
	}

	.carousel-usecase .carousel-link:hover .arrow.third {
		transform: translateX(30px);
	}

	.carousel-usecase .carousel-image {
		width: 66%;
		position: relative;
	}

	.carousel-usecase .carousel-image img {
		width: 100%;
		height: auto;
		border-radius: $radius-md;
		box-shadow: var(--shadow-lg);
		display: block;
	}

	.carousel-usecase .carousel-image a {
		display: block;
		position: relative;
	}

	.carousel-usecase .carousel-image .overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(0deg, rgba($color-dark-alt, 0.8) 0%, rgba($color-dark-alt, 0.6) 100%);
		border-radius: $radius-md;
		opacity: 0;
		transition: opacity $transition-base;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding-bottom: 10%;
	}

	.carousel-usecase .carousel-image a:hover .overlay {
		opacity: 1;
	}

	.carousel-usecase .carousel-image .eye {
		color: $color-white;
		font-size: $font-size-base;
		display: flex;
		align-items: center;
		gap: 10px;
		transform: translateY(20px);
		transition: transform $transition-base;
	}

	.carousel-usecase .carousel-image a:hover .eye {
		transform: translateY(0);
	}

	.carousel-usecase .carousel-image .eye .icon {
		font-size: $font-size-2xl;
	}

	// Navigation buttons
	.carousel-buttons--overlay {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		right: 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 $spacing-3;
		pointer-events: none;
	}

	.carousel-buttons--header {
		display: flex;
		gap: $spacing-2;
		flex-shrink: 0;
	}

	.carousel-button {
		@include flex-center;
		width: 44px;
		height: 44px;
		font-size: $font-size-2xl; // astro-icon svg is 1em
		background: color-mix(in srgb, var(--carousel-accent) 10%, var(--color-bg-surface));
		border: none;
		border-radius: $radius-full;
		cursor: pointer;
		pointer-events: auto;
		color: var(--carousel-accent);
		box-shadow: var(--shadow-sm);
		transition:
			background $transition-base,
			color $transition-base;
		padding: 0;
		flex-shrink: 0;
	}

	.carousel-button:hover {
		background: var(--carousel-accent);
		color: var(--carousel-accent-contrast);
	}

	.carousel-button:focus-visible {
		outline: 2px solid var(--carousel-accent);
		outline-offset: 2px;
	}

	.carousel-button:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	// Simple-variant slides end with a one-line caption; exclude it from the
	// overlay so the buttons center on the image itself
	.carousel-simple .carousel-buttons--overlay {
		bottom: $spacing-10;
	}

	// Dots — 28×24px touch target around an 8px dot; the active dot stretches into a pill.
	// :global because slot-mode dots are created in carousel-init.ts and would
	// otherwise miss this component's scope attribute.
	.carousel-dots {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: $spacing-2;
		margin-top: $spacing-8;
	}

	.carousel-dots :global(.carousel-dot) {
		position: relative;
		width: 28px;
		height: 24px;
		border: none;
		background: transparent;
		cursor: pointer;
		padding: 0;
	}

	.carousel-dots :global(.carousel-dot::before) {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 8px;
		height: 8px;
		border-radius: $radius-full;
		background: color-mix(in srgb, var(--carousel-accent) 30%, transparent);
		transition:
			width $transition-base,
			background $transition-base;
	}

	.carousel-dots :global(.carousel-dot:hover::before) {
		background: color-mix(in srgb, var(--carousel-accent) 55%, transparent);
	}

	.carousel-dots :global(.carousel-dot.active::before) {
		width: 24px;
		background: var(--carousel-accent);
	}

	.carousel-dots :global(.carousel-dot:focus-visible) {
		outline: 2px solid var(--carousel-accent);
		outline-offset: -2px;
		border-radius: $radius-full;
	}

	// Responsive
	@include media-down(lg) {
		.carousel-usecase .carousel-item-flex-row {
			flex-direction: column;
			gap: $spacing-8;
			padding: 0;
		}

		.carousel-usecase .carousel-text,
		.carousel-usecase .carousel-image {
			width: 100%;
		}

		.carousel-usecase .carousel-text h3 {
			text-align: center;
		}

		.carousel-usecase .carousel-text {
			text-align: center;
			align-items: center;
		}

		// Header-placement arrows stay visible — they may be the only nav when dots are off
		.carousel-buttons--overlay {
			display: none;
		}
	}

	@include media-down(md) {
		.carousel-usecase .arrow-container {
			display: none;
		}
	}
</style>

<script>
	import { observeCarousels } from './carousel-init';

	document.addEventListener('DOMContentLoaded', observeCarousels);
	document.addEventListener('astro:page-load', observeCarousels);
</script>
