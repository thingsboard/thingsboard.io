---
import { Icon } from 'astro-icon/components';
import type { FooterList } from '@data/footer-map';
import { externalLinkAttrs, isExternalHref, NEW_TAB_NOTE } from '@util/external-links';

/** A titled list of links, for the link columns of both footers. */
interface Props {
	list: FooterList;
}

const { list } = Astro.props;
---

<h2 class="fl__title">{list.title}</h2>
<ul class="fl__links">
	{list.links.map((link) => (
		<li>
			<a href={link.href} {...externalLinkAttrs(link.href)}>
				{link.label}
				{isExternalHref(link.href) && (
					<Fragment>
						<Icon name="tabler:arrow-up-right" size={14} aria-hidden="true" />
						<span class="sr-only">{NEW_TAB_NOTE}</span>
					</Fragment>
				)}
			</a>
		</li>
	))}
</ul>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;
	@use '../../styles/footer' as *;

	.fl__title {
		margin-bottom: $spacing-3;
		color: var(--color-text);
		@include type-small-strong;

		@include in-dark-section {
			color: var(--color-white);
		}
	}

	.fl__links {
		display: grid;
		gap: 2px;
		padding: 0;
		list-style: none;

		a {
			display: inline-flex;
			align-items: center;
			gap: 2px;
			padding-block: 3px;
			@include type-small;
			@include footer-link;
		}

		svg {
			@include footer-new-tab-arrow;
		}
	}
</style>
