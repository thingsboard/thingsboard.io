---
import { Icon } from 'astro-icon/components';
import FooterBase from '@components/SiteFooter/FooterBase.astro';
import FooterList from '@components/SiteFooter/FooterList.astro';
import { FOOTER_DOCS_COLUMNS, FOOTER_SOCIAL, FOOTER_TAGLINE } from '@data/footer-map';
import { externalLinkAttrs, isExternalHref, NEW_TAB_NOTE } from '@util/external-links';

/**
 * The band at the end of every docs page, in the page's theme: the logo and the Follow links, three link columns,
 * then the base row (`FooterBase`). `starlight/TwoColumnContent` renders it after the page's `<main>`.
 */
---

<footer class="fd print:hidden">
	<div class="fd__top">
		<div>
			<a href="/" class="fd__logo" aria-label="ThingsBoard home"></a>
			<p class="fd__tagline">{FOOTER_TAGLINE}</p>
			<p class="fd__follow">
				Follow
				{FOOTER_SOCIAL.map((network) => (
					<a class={network.icon} href={network.href} {...externalLinkAttrs(network.href)}>
						<Icon name={network.icon} size={20} aria-hidden="true" />
						<span class="sr-only">
							{network.name}
							{isExternalHref(network.href) && NEW_TAB_NOTE}
						</span>
					</a>
				))}
			</p>
		</div>
		<nav class="fd__cols" aria-label="Footer">
			{FOOTER_DOCS_COLUMNS.map((list) => (
				<div class="fd__col">
					<FooterList list={list} />
				</div>
			))}
		</nav>
	</div>
	<FooterBase appearance />
</footer>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/footer' as *;

	.fd {
		container-type: inline-size;
		padding: $spacing-10 max(var(--sl-content-pad-x), calc((100% - #{$home-measure}) / 2)) $footer-end-space;
		border-top: 1px solid var(--color-border);
		background-color: var(--color-bg-light);
		// On a page shorter than the window, the band's color runs on to the bottom of the window. A shadow adds
		// no scroll height; the clip keeps it below the band.
		box-shadow: 0 0 0 100vh var(--color-bg-light);
		clip-path: inset(0 0 -100vh);
	}

	.fd__top {
		display: grid;
		gap: $spacing-8;
		margin-bottom: $spacing-6;
		padding-bottom: $spacing-8;
		border-bottom: 1px solid var(--color-border);
	}

	.fd__logo {
		@include footer-logo;
	}

	.fd__tagline {
		max-width: 36ch;
		margin-top: $spacing-3;
		color: var(--color-text-secondary);
		text-wrap: pretty;
		@include type-small;
	}

	// Icons only, so the line fits the brand column; each link's name is its hidden text.
	.fd__follow {
		margin-top: $spacing-4;
		@include footer-follow($spacing-2);

		a {
			justify-content: center;
			width: 32px;
			height: 32px;
			border-radius: $radius-sm;

			@media (hover: hover) {
				&:hover {
					background-color: color-mix(in srgb, currentColor 10%, transparent);
				}
			}
		}
	}

	.fd__cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-8;
	}

	// Breakpoints on the band's own width: the sidebar and "On this page" make it much narrower than the window.
	@container (min-width: 700px) {
		.fd__top {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 3fr);
		}
	}

	@container not (min-width: 480px) {
		.fd__cols {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: $spacing-5;
		}

		.fd__col:nth-child(odd):last-child {
			grid-column: 1 / -1;

			// The same gap as `.fd__cols`, so these links line up with the columns above.
			.fl__links {
				grid-template-columns: repeat(2, minmax(0, 1fr));
				column-gap: $spacing-5;
			}
		}
	}
</style>
