---
import ThemeChoice from '@components/ThemeChoice.astro';
import { footerLegalLinks, PRIVACY_CHOICES_LABEL } from '@data/privacy';

/**
 * The row every footer ends with: the copyright, the legal links, Your Privacy Choices and the Appearance
 * control, with the award badges at the end when a footer passes them (the `badges` slot). Theme colors,
 * white text inside a `data-surface="dark"` section (`FooterMap`).
 */
interface Props {
	/** The Appearance control. False on pages that force the light theme. */
	appearance: boolean;
}

const { appearance } = Astro.props;
const year = new Date().getFullYear();
---

<div class="fb">
	<div>
		<p class="fb__copy">&copy; {year} The ThingsBoard Authors</p>
		<ul class="fb__links" aria-label="Legal">
			{footerLegalLinks.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))}
			<li>
				{/* An opt-out icon (CCPA regs §7015) would go inside the button, before the label. */}
				<button type="button" class="cookie-settings" data-cc="show-preferences">
					{PRIVACY_CHOICES_LABEL}
				</button>
			</li>
		</ul>
		{appearance && (
			<div class="fb__appearance">
				<ThemeChoice />
			</div>
		)}
	</div>
	{Astro.slots.has('badges') && (
		<div class="fb__badges">
			<slot name="badges" />
		</div>
	)}
</div>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;
	@use '../../styles/footer' as *;

	.fb {
		display: grid;
		align-items: center;
		gap: $spacing-5 $spacing-10;
	}

	.fb:has(> .fb__badges) {
		grid-template-columns: minmax(0, 1fr) auto;
	}

	.fb__copy {
		color: var(--color-text-secondary);
		@include type-nav-note;

		@include in-dark-section {
			color: $on-dark-text-faint;
		}
	}

	.fb__links {
		display: flex;
		flex-wrap: wrap;
		column-gap: $spacing-5;
		margin-top: $spacing-1;
		padding: 0;
		list-style: none;

		// `cookie-settings` (from `CookieConsent`) resets the button to plain text. The padding makes each
		// row 24px tall, the minimum target size.
		:is(a, button) {
			display: inline-block;
			padding-block: 3px;
			@include type-nav-note;
			@include footer-link;
		}
	}

	.fb__appearance {
		margin-top: $spacing-3;
	}

	// Narrow gaps, so four badges fit in one line on the smallest phones.
	.fb__badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-3;
	}

	@include width-below($breakpoint-md) {
		.fb:has(> .fb__badges) {
			grid-template-columns: minmax(0, 1fr);
		}

		.fb__badges {
			order: -1;
		}
	}
</style>
