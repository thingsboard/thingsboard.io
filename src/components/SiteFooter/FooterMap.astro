---
import { Icon } from 'astro-icon/components';
import NavIcon from '@components/Landing/NavIcon.astro';
import SmartImage from '@components/SmartImage.astro';
import FooterBase from '@components/SiteFooter/FooterBase.astro';
import FooterList from '@components/SiteFooter/FooterList.astro';
import Button from '@components/ui/Button.astro';
import Field from '@components/ui/Field.astro';
import Link from '@components/ui/Link.astro';
import {
	FOOTER_COLUMNS,
	FOOTER_LICENSE_PORTAL,
	FOOTER_NEWSLETTER,
	FOOTER_PLATFORM_LINKS,
	FOOTER_PRODUCT_GROUPS,
	FOOTER_SOCIAL,
	FOOTER_TAGLINE,
} from '@data/footer-map';
import type { SubMenuItem } from '@data/navigation';
import { MENU_BADGES } from '@data/product-badges';
import { externalLinkAttrs, isExternalHref, NEW_TAB_NOTE } from '@util/external-links';

/**
 * The site footer on `BaseLayout` pages, black in both themes: the logo, the newsletter form and the Follow
 * links, the products, the link columns, then the base row (`FooterBase`) with the award badges.
 * `data-surface="dark"` gives the kit's field, button and links their dark look.
 */
interface Props {
	/** The Appearance control in the base row. False on pages that force the light theme. */
	appearance: boolean;
}

const { appearance } = Astro.props;

// The product's menu badge, or for the CLI its menu icon on a white wash. `MENU_BADGES` glyph sizes are for
// the menu's 32px tile, so they grow by 1.25 for this footer's 40px tile (`.fm__tile`).
function tileOf({ badge, icon }: SubMenuItem) {
	if (!badge) return { fill: 'wash', hue: 'var(--color-white)', glyph: icon, size: 32 };
	const { fill, hue, glyph, size } = MENU_BADGES[badge];
	return { fill, hue, glyph, size: size * 1.25 };
}
---

<footer class="fm print:hidden" data-surface="dark">
	<div class="fm__top">
		<div>
			<a href="/" class="fm__logo" aria-label="ThingsBoard home"></a>
			<p class="fm__tagline">{FOOTER_TAGLINE}</p>
		</div>
		<div>
			<div id="mlb2-7341216" class="fm__signup">
				<form
					id="Footer_SignUpForNewsForm"
					class="ml-block-form gtm_form"
					action={FOOTER_NEWSLETTER.action}
					method="POST"
					target="_blank"
				>
					{/*
						The id and `gtm_button` class stay on the email field as analytics hooks (GTM). The browser
						checks the address (no `novalidate`), so the field leaves `aria-invalid` to it. Its description
						repeats Field's hint id and adds the consent line, since Enter in the field also subscribes.
					*/}
					<Field
						name="fields[email]"
						id="Footer_SignUpForNews"
						type="email"
						size="md"
						label={FOOTER_NEWSLETTER.label}
						hint={FOOTER_NEWSLETTER.hint}
						placeholder="Email address"
						autocomplete="email"
						attrs={{
							class: 'gtm_button',
							spellcheck: 'false',
							autocapitalize: 'off',
							'aria-invalid': undefined,
							'aria-describedby': 'Footer_SignUpForNews-hint Footer_SignUpForNews-consent',
						}}
					>
						<Button slot="end" type="submit" class="gtm_button" attrs={{ id: 'Footer_SignUpForNews_Subscribe' }}>
							Subscribe
						</Button>
					</Field>
					<input type="hidden" name="ml-submit" value="1" />
					<p class="fm__consent" id="Footer_SignUpForNews-consent">
						{FOOTER_NEWSLETTER.consent}
					</p>
				</form>
				<div class="ml-block-success fm__thanks" role="status" tabindex="-1" hidden>
					<div class="fm__thanks-row">
						<Icon name="tabler:circle-check" size={24} aria-hidden="true" />
						<div>
							<p class="fm__thanks-title">{FOOTER_NEWSLETTER.thanks.title}</p>
							<p class="fm__thanks-text">{FOOTER_NEWSLETTER.thanks.text}</p>
						</div>
					</div>
				</div>
			</div>
			<p class="fm__follow">
				Follow
				{FOOTER_SOCIAL.map((network) => (
					<a class={network.icon} href={network.href} {...externalLinkAttrs(network.href)}>
						<Icon name={network.icon} size={18} aria-hidden="true" />
						{network.name}
						{isExternalHref(network.href) && <span class="sr-only">{NEW_TAB_NOTE}</span>}
					</a>
				))}
			</p>
		</div>
	</div>

	<nav class="fm__products" aria-label="Products">
		{FOOTER_PRODUCT_GROUPS.map((group) => (
			<div class="fm__group">
				<h2 class="fm__kicker">{group.name}</h2>
				<ul class="fm__tiles">
					{group.items.map((product) => {
						const tile = tileOf(product);
						const external = isExternalHref(product.href);
						return (
							<li>
								<a class="fm__product" href={product.href} {...externalLinkAttrs(product.href)}>
									<span
										class:list={['fm__tile', `fm__tile--${tile.fill}`]}
										style={`--badge-hue: ${tile.hue}; --badge-glyph: ${tile.size}px`}
									>
										<NavIcon src={tile.glyph} size={tile.size} alt="" />
									</span>
									<span class="fm__product-name">
										{product.heading}
										{external && <Icon name="tabler:arrow-up-right" size={14} aria-hidden="true" />}
									</span>
									<span class="fm__product-line">{product.description}</span>
									{external && <span class="sr-only">{NEW_TAB_NOTE}</span>}
								</a>
							</li>
						);
					})}
				</ul>
			</div>
		))}
		<div class="fm__next">
			<ul class="fm__platform-links">
				{FOOTER_PLATFORM_LINKS.map((link) => (
					<li>
						<Link href={link.href} size="sm" tone="ink" external={isExternalHref(link.href)}>
							{link.label}
						</Link>
					</li>
				))}
			</ul>
			<p class="fm__portal">
				{FOOTER_LICENSE_PORTAL.caption}
				<Link
					href={FOOTER_LICENSE_PORTAL.link.href}
					size="sm"
					tone="ink"
					external={isExternalHref(FOOTER_LICENSE_PORTAL.link.href)}
				>
					{FOOTER_LICENSE_PORTAL.link.label}
				</Link>
			</p>
		</div>
	</nav>

	<nav class="fm__cols" aria-label="Footer">
		{FOOTER_COLUMNS.map((column) => (
			<div class="fm__col">
				{column.map((list) => (
					<Fragment>
						<FooterList list={list} />
						{list.more && (
							<Link
								href={list.more.href}
								size="sm"
								tone="ink"
								external={isExternalHref(list.more.href)}
								class="fm__more"
							>
								{list.more.label}
							</Link>
						)}
					</Fragment>
				))}
			</div>
		))}
	</nav>

	<FooterBase appearance={appearance}>
		<SmartImage
			slot="badges"
			src="/src/assets/images/landings/footer/crozdesk-quality-choice-badge.png"
			alt="ThingsBoard achievement - Crozdesk Quality Choice"
			width={64}
			height={64}
			widths={[64, 128]}
			sizes="64px"
		/>
		<SmartImage
			slot="badges"
			src="/src/assets/images/landings/footer/crozdesk-trusted-vendor-badge.png"
			alt="ThingsBoard achievement - Crozdesk Trusted Vendor"
			width={64}
			height={64}
			widths={[64, 128]}
			sizes="64px"
		/>
		<SmartImage
			slot="badges"
			src="/src/assets/images/landings/footer/crozdesk-happiest-users-badge.png"
			alt="ThingsBoard achievement - Crozdesk Happiest Users"
			width={64}
			height={64}
			widths={[64, 128]}
			sizes="64px"
		/>
		<SmartImage
			slot="badges"
			src="/src/assets/images/landings/footer/supplier-retail.webp"
			alt="ThingsBoard achievement - Top Supplier in Retail 2024"
			width={44}
			height={64}
			widths={[44, 88]}
			sizes="44px"
		/>
	</FooterBase>
</footer>

<script>
	import { bindMailerLiteForm } from '@util/mailerlite';

	const form = document.querySelector<HTMLFormElement>('#Footer_SignUpForNewsForm');
	const email = document.querySelector<HTMLInputElement>('#Footer_SignUpForNews');
	const thanks = document.querySelector<HTMLElement>('#mlb2-7341216 .ml-block-success');
	const error = document.getElementById('Footer_SignUpForNews-error');
	if (form && email && thanks && error) {
		// MailerLite's refusal only comes after the submit: announce it, and keep it in the field's description
		// (the line is empty until then).
		error.setAttribute('role', 'alert');
		email.setAttribute('aria-describedby', `${email.getAttribute('aria-describedby')} ${error.id}`);
		bindMailerLiteForm(form, thanks, error);
	}
</script>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;
	@use '../../styles/ui' as *;
	@use '../../styles/badge' as *;
	@use '../../styles/footer' as *;

	// The products panel's padding and the gutter between its four tracks. The link columns use both, so
	// each column of links starts under a column of tiles.
	$fm-inset: $spacing-6;
	$fm-gutter: $spacing-5;
	$fm-panel: rgba(255, 255, 255, 0.07);

	.fm {
		padding: $spacing-16 var(--band-gutter) $footer-end-space;
		background-color: var(--color-black);
		color: var(--color-white);
	}

	// The form column starts where the products' third track does.
	.fm__top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) calc(50% - #{$fm-gutter} / 2);
		align-items: start;
		gap: $spacing-10 $spacing-16;
		padding-bottom: $spacing-10;
	}

	.fm__logo {
		@include footer-logo;
	}

	.fm__tagline {
		max-width: 38ch;
		margin-top: $spacing-3;
		color: $on-dark-text-secondary;
		text-wrap: pretty;
		@include type-body;
	}

	.fm__signup {
		max-width: 420px;

		.ui-field__hint {
			margin-bottom: 10px;
		}
	}

	.fm__consent {
		margin-top: $spacing-3;
		color: $on-dark-text-faint;
		@include type-caption;
	}

	// Focused by the script only so that it is announced; it is not a control.
	.fm__thanks {
		padding: $spacing-4;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: $radius-lg;
		background-color: $fm-panel;

		&:focus {
			outline: none;
		}
	}

	// The script shows the box with an inline `display: block`, so the row is an element inside it.
	.fm__thanks-row {
		display: flex;
		align-items: flex-start;
		gap: $spacing-3;

		svg {
			flex: none;
			color: var(--color-success);
		}
	}

	.fm__thanks-title {
		color: var(--color-white);
		@include type-tile;
	}

	.fm__thanks-text {
		color: $on-dark-text-secondary;
		@include type-small;
	}

	.fm__follow {
		margin-top: $spacing-6;
		@include footer-follow($spacing-5);

		a {
			gap: 6px;
		}
	}

	.fm__products {
		display: grid;
		grid-template-columns: calc((100% - 3 * #{$fm-gutter}) / 4) minmax(0, 1fr);
		gap: $spacing-8 $fm-gutter;
		padding: $fm-inset;
		border-radius: $radius-xl;
		background-color: $fm-panel;
	}

	.fm__kicker {
		margin-bottom: $spacing-3;
		color: $on-dark-text-faint;
		@include type-nav-label;
	}

	.fm__tiles {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-1 $fm-gutter;
		padding: 0;
		list-style: none;
	}

	.fm__product {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		column-gap: $spacing-3;
		padding-block: 10px;
		border-radius: $radius-md;
		color: var(--color-white);
		text-decoration: none;
		text-underline-offset: 3px;
		@include focus-ring(2px);

		@media (hover: hover) {
			&:hover .fm__product-name {
				text-decoration: underline;
			}
		}
	}

	.fm__tile {
		grid-row: span 2;
		@include badge-tile(40px);

		svg {
			width: var(--badge-glyph);
			height: var(--badge-glyph);
		}
	}

	.fm__tile--solid {
		@include badge-solid;
	}

	.fm__tile--wash {
		@include badge-wash-dark;
	}

	.fm__product-name {
		display: flex;
		align-items: center;
		gap: 2px;
		@include type-nav-link;

		svg {
			@include footer-new-tab-arrow;
		}
	}

	.fm__product-line {
		color: $on-dark-text-muted;
		@include type-nav-note;
	}

	.fm__next {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-3 $spacing-8;
	}

	.fm__platform-links {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-2 $spacing-8;
		padding: 0;
		list-style: none;
	}

	.fm__portal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-1 $spacing-2;
		color: $on-dark-text-muted;
		@include type-small;
	}

	.fm__cols {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: $spacing-8 $fm-gutter;
		padding: $spacing-12 $fm-inset;
	}

	.fm__col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	// The titles of the link lists (`FooterList`): bold here, not in the docs footer.
	.fm__col > .fl__title {
		font-weight: $font-weight-bold;

		&:not(:first-child) {
			margin-top: $spacing-8;
		}
	}

	.fm__more {
		margin-top: $spacing-2;
	}

	// The platforms, the first group, take one track: one tile per row.
	@include width-from($breakpoint-lg) {
		.fm__group:first-child .fm__tiles {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@include width-below($breakpoint-lg) {
		.fm__top {
			grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
			column-gap: $spacing-10;
		}

		.fm__products {
			grid-template-columns: minmax(0, 1fr);
			row-gap: $spacing-6;
		}
	}

	@include width-below($breakpoint-md) {
		.fm {
			padding-top: $spacing-12;
		}

		.fm__top {
			grid-template-columns: minmax(0, 1fr);
		}

		.fm__products {
			padding: $spacing-4;
		}

		.fm__tiles {
			grid-template-columns: minmax(0, 1fr);
		}

		.fm__cols {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			padding: $spacing-10 $spacing-4;
		}
	}
</style>
