---
/*
 * Sends a Jekyll-era hash to the version it names (see `src/util/legacy-release-hashes.ts`), before
 * the table paints. Id shapes: `#v4402` and `#v42` (releases), `#upgrading-to-4402`,
 * `#upgrading-to-42pe`, and the per-platform sections under each version (`#windows-42`,
 * `#ubuntucentos-42`, and on Edge `#docker-linux-mac-42`, `#ubuntucentosrpi-42`). Letter case and a
 * trailing `/` are ignored; a version the map doesn't know leaves the page alone.
 */
interface Props {
	map: Record<string, string>;
}

const { map } = Astro.props;
const pattern = '^(?:upgrading-to-|windows-|ubuntucentos-|ubuntucentosrpi-|docker-linux-mac-)?v?(\\d+)(?:pe)?/?$';
---

<script is:inline define:vars={{ map, pattern }}>
	const match = new RegExp(pattern, 'i').exec(location.hash.slice(1));
	const target = match && map['v' + match[1]];
	if (target) location.replace(target);
</script>
