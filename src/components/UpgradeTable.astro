---
import type { Products } from '@models/site.models';
import { getFamilySlug, getUpgradeTableVersions } from '@models/upgrade-instructions';
import { familySlug as getReleasesFamilySlug } from '@models/releases-table';
import LegacyHashRedirect from '@components/LegacyHashRedirect.astro';
import UpgradeVersionFilter from '@components/UpgradeVersionFilter.astro';
import { legacyHashMap, notesAnchors } from '@util/legacy-release-hashes';
import { isLegacyPe } from '@models/upgrade-shared';

interface Props {
	product: Products;
}

const { product } = Astro.props;

const isPE = product === 'PE';
const docsPrefix = isPE ? 'pe/' : '';
const platformBase = `/docs/${docsPrefix}installation/upgrade-instructions`;
const releasesBase = `/docs/${docsPrefix}releases/releases-table`;

// A row links to its version's release-notes heading, whose id is the row's own anchor
// (see `satteri-release-anchors.ts`), or to the family page when the notes have no heading for it.
const hasNotesHeading = (anchor: string, family: string) => notesAnchors(product, family).includes(anchor);

// Platform icons served straight from `public/icons/installation/`. The table
// renders ~78 versions × 5 platforms = ~390 cells per page; routing icons via
// Astro's asset pipeline let Vite inline anything under its 4 KB threshold as
// a per-cell data URI, which still added ~300 KB of duplicated markup on the
// upgrade pages. Hard-coded `public/` URLs guarantee a single shared HTTP
// request per icon (browser-cached across all upgrade pages), independent of
// version count. These five icons are stable brand assets — keeping them out
// of the hashed asset pipeline is an acceptable tradeoff for the size win.
const platforms = [
	{ key: 'docker', label: 'Docker upgrade instructions', icon: '/icons/installation/docker.svg' },
	{ key: 'docker-compose', label: 'Docker Compose upgrade instructions', icon: '/icons/installation/docker-compose.svg' },
	{ key: 'windows', label: 'Windows upgrade instructions', icon: '/icons/installation/windows.svg' },
	{ key: 'ubuntu', label: 'Ubuntu upgrade instructions', icon: '/icons/installation/ubuntu.svg' },
	{ key: 'centos', label: 'CentOS/RHEL upgrade instructions', icon: '/icons/installation/cent-os.svg' },
];

function formatDate(dateStr: string): string {
	try {
		const d = new Date(dateStr);
		if (isNaN(d.getTime())) return dateStr;
		return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
	} catch {
		return dateStr;
	}
}
---

{/* Old `/docs/user-guide/install/upgrade-instructions/#upgrading-to-4402` links land here. */}
<LegacyHashRedirect map={legacyHashMap(product, 'upgrade')} />

<UpgradeVersionFilter />

<div class="upgrade-table-wrapper not-content">
	<table class="upgrade-table">
		<thead>
			<tr>
				<th>Version</th>
				<th>Release Date</th>
				<th>Upgradable From</th>
				<th>
					<a
						class="lts-header-link"
						href={`/docs/${docsPrefix}releases/release-policy/#lifecycle-and-support`}
					>
						LTS
					</a>
				</th>
				<th>Release Notes</th>
				<th>Upgrade Instructions</th>
			</tr>
		</thead>
		<tbody>
			{getUpgradeTableVersions(product).map((v) => {
				const releaseDate = isPE && v.releaseDatePe ? v.releaseDatePe : v.releaseDate;
				// From 4.4 the product is plain "ThingsBoard", so only older versions carry the PE label.
				const versionLabel = isLegacyPe(isPE, v.version) ? `v${v.displayVersion} PE` : `v${v.displayVersion}`;
				const upgradableFromLabel = isLegacyPe(isPE, v.upgradableFrom)
					? `v${v.upgradableFrom} PE`
					: `v${v.upgradableFrom}`;
				const releaseNotesBase = `${releasesBase}/${getReleasesFamilySlug(v.family)}/`;
				const releaseNotesHref = hasNotesHeading(v.anchor, v.family)
					? `${releaseNotesBase}#${v.anchor}`
					: releaseNotesBase;

				return (
					<tr data-anchor={v.anchor}>
						<td class="version-col">{versionLabel}</td>
						<td class="date-col">
							<time datetime={new Date(releaseDate).toISOString().split('T')[0]}>
								{formatDate(releaseDate)}
							</time>
						</td>
						<td class="from-col">{upgradableFromLabel}</td>
						<td class="lts-col">
							{v.lts ? (
								<span class="status-badge status-active-lts">Available</span>
							) : (
								<span class="status-badge status-standard">Not available</span>
							)}
						</td>
						<td class="notes-col">
							<a
								href={releaseNotesHref}
								class="notes-link"
								title={`Release notes for v${v.displayVersion}`}
							>
								<span>v{v.displayVersion}</span>
								<svg class="print:hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path stroke="none" d="M0 0h24v24H0z" fill="none" />
									<path d="M17 7l-10 10" />
									<path d="M8 7l9 0l0 9" />
								</svg>
							</a>
						</td>
						<td class="icons-col">
							{platforms.map((p) => (
								<a
									href={`${platformBase}/${p.key}/${getFamilySlug(v.family)}/#${v.anchor}`}
									title={p.label}
									class="platform-icon"
								>
									<img
										src={p.icon}
										alt={p.label}
										class="icon-svg"
										width="36"
										height="36"
										loading="lazy"
										decoding="async"
									/>
								</a>
							))}
						</td>
					</tr>
				);
			})}
		</tbody>
	</table>
</div>

<style>
	:global(.sl-container:has(.upgrade-table-wrapper)) {
		max-width: 100%;
	}

	.upgrade-table-wrapper {
		overflow-x: auto;
		margin-block: 1.5rem;
	}

	.upgrade-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.upgrade-table th,
	.upgrade-table td {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		text-align: left;
		vertical-align: middle;
	}

	.upgrade-table th {
		background: var(--sl-color-gray-6);
		font-weight: 600;
	}

	.upgrade-table tbody tr:hover {
		background: var(--sl-color-gray-7);
	}

	.version-col {
		font-weight: 600;
	}

	.lts-header-link {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
	}

	.status-badge {
		display: inline-block;
		padding: 0.2em 0.55em;
		border-radius: 4px;
		font-size: 0.8rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.status-active-lts {
		background: color-mix(in srgb, var(--sl-color-green) 15%, transparent);
		color: var(--sl-color-green);
	}

	.status-standard {
		background: color-mix(in srgb, var(--sl-color-gray-3) 15%, transparent);
		color: var(--sl-color-gray-3);
	}

	.notes-col {
		white-space: nowrap;
	}

	.notes-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}

	.notes-link:hover {
		text-decoration: underline;
	}

	.icons-col {
		white-space: nowrap;
		width: 1px;
		transition: filter 0.15s;
		filter: grayscale(1) opacity(0.45);
	}

	.upgrade-table tbody tr:hover .icons-col {
		filter: none;
	}

	.platform-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		margin: 0 2px;
		border-radius: 4px;
		transition: background 0.15s;
		text-decoration: none;
	}

	.platform-icon:hover {
		background: var(--sl-color-gray-5);
	}

	.icon-svg {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
	}

	.icon-svg :global(svg) {
		width: 22px;
		height: 22px;
	}
	@media print {
		.upgrade-table-wrapper {
			overflow: visible;
		}

		.upgrade-table,
		.upgrade-table :is(th, td),
		.status-badge,
		.notes-col {
			white-space: normal;
		}

		.upgrade-table .icons-col {
			white-space: nowrap;
			filter: none;
		}
	}
</style>
