---
import DocLink from '@components/DocLink.astro';
import { Aside, Steps } from '@astrojs/starlight/components';
import { Products } from '@models/site.models';

interface Props {
	/** Cloud Kubernetes guides apply the license at deploy time, so there is no activation screen to follow. */
	variant?: 'default' | 'cloud';
}

const { variant = 'default' } = Astro.props;
const accountDescription =
	'your System Administrator account — the account that manages the platform itself (tenants, system settings, platform-wide resources).';
---

{
	variant === 'cloud' ? (
		<p>After launching ThingsBoard, open the web UI at the load balancer address. ThingsBoard prompts you to create {accountDescription}</p>
	) : (
		<p>Once activated, ThingsBoard prompts you to create {accountDescription}</p>
	)
}

<Steps>
	<ol>
		<li>Enter <strong>Email</strong>, <strong>Password</strong>, and <strong>Confirm password</strong>.</li>
		<li>The <strong>Set up a demo tenant</strong> option is selected by default: it creates a ready-made tenant with dashboards, devices, and rule chains for exploring the platform before building your own solution. Clear it if you want to start with an empty platform.</li>
		<li>Click <strong>Create account</strong>. You are signed in as the system administrator.</li>
	</ol>
</Steps>

<Aside type="caution">
  The demo tenant's administrator and customer user rely on published default passwords. Change them before exposing the instance to a network or moving to production. See <DocLink product={Products.PE} path="installation/demo-account/" target="_blank">Demo Account</DocLink> for the credentials.
</Aside>

<p>Your ThingsBoard instance is now installed and running.</p>
