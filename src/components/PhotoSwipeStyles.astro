---
// Global PhotoSwipe chrome: the vendor stylesheet plus this site's overrides
// for the overlay, buttons, counter and caption.
//
// What puts the CSS on a page is the import graph, not the render: Astro bundles
// a component's styles wherever the component is imported, reached or not. Every
// lightbox host imports this one anyway — <ImageGallery> in the docs, and the
// IoT Hub detail hero, screenshot gallery and readme renderer — so that no host
// is left relying on another's import. They overlap today, and the day someone
// drops <ImageGallery> from the readme renderer the overlay would otherwise lose
// its styling on pages that had been getting it through that chain.
//
// The render calls emit no markup; they exist so each host declares the
// dependency where it is used.
import 'photoswipe/style.css';
---

<style is:global>
	/* `.pswp` + `.pswp__bg` ship with `transform: translateZ(0)` + `will-change: opacity`.
	   Together they create a compositing layer that prevents `backdrop-filter` from
	   sampling the page behind PhotoSwipe (blur appears not to work). Drop both. */
	.pswp {
		--pswp-bg: rgba(10, 10, 20, 0.55);
		/* Suppress the `#222` placeholder bg painted during zoom-from-thumbnail. */
		--pswp-placeholder-bg: transparent;
		/* PhotoSwipe icons have a 2px grey stroke designed for light buttons —
		   make everything white for our dark blur-glass buttons. */
		--pswp-icon-color: #fff;
		--pswp-icon-color-secondary: #fff;
		--pswp-icon-stroke-color: #fff;
		--pswp-icon-stroke-width: 0;
		--color-bg: transparent;
		transform: none !important;
		will-change: auto !important;
	}
	.pswp__bg {
		backdrop-filter: blur(18px) !important;
		-webkit-backdrop-filter: blur(18px) !important;
		transform: none !important;
		/* Pre-allocate the blur compositing layer so it appears in sync with
		   the bg opacity fade-in. */
		will-change: backdrop-filter !important;
	}

	.pswp__img {
		border-radius: 4px;
	}
	/* Shadow on the always-present wrap → no flicker on placeholder→full swap.
	   Excludes HTML slides (own shadow on `.pswp__content`) and SVG slides. */
	.pswp__zoom-wrap:not(:has(.pswp__content)):not(:has(.pswp__img[src$='.svg'])) {
		filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.5));
	}

	/* Interactive-SVG slide content — white panel + shadow for contrast. */
	.pswp__zoom-wrap > .pswp__content {
		width: 100%;
		height: 100%;
		background: #fff;
		border-radius: 4px;
		padding: 1.5rem;
		box-sizing: border-box;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.pswp__zoom-wrap > .pswp__content > svg {
		max-width: 100%;
		max-height: 100%;
		width: 100%;
		height: 100%;
	}

	.pswp__button {
		border-radius: 50%;
		background: rgba(30, 30, 40, 0.6);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		/* No `!important` — PhotoSwipe's `:disabled` and `.pswp--one-slide` hide
		   rules must still win. */
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		transition: background 0.18s ease;
	}
	/* PhotoSwipe's `:hover, :active, :focus` reset wipes `transition` and
	   `background`. Cover all three states explicitly. */
	.pswp__button:hover,
	.pswp__button:active,
	.pswp__button:focus-visible {
		background: rgba(60, 60, 80, 0.85);
		transition: background 0.18s ease;
	}

	/* PhotoSwipe positions the icon absolutely with `top/left` — drop that
	   so the flex parent centers it. */
	.pswp__button .pswp__icn {
		position: static;
		margin: 0;
	}

	/* Lift the close button out of `.pswp__top-bar`'s flex flow so we can
	   pin it at the viewport corner. */
	.pswp__button--close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		margin: 0;
		width: 2.5rem;
		height: 2.5rem;
	}
	.pswp__button--close .pswp__icn {
		width: 1.5rem;
		height: 1.5rem;
	}

	.pswp__button--arrow {
		width: 3rem;
		height: 3rem;
		/* PhotoSwipe ships `margin-top: -50px` for its 100px-tall arrows;
		   we need half of our 3rem to keep vertical centering. */
		margin-top: -1.5rem;
		transition:
			background 0.18s ease,
			transform 0.18s ease;
	}
	.pswp__button--arrow .pswp__icn {
		width: 1.8rem;
		height: 1.8rem;
	}
	/* PhotoSwipe's chevron is drawn at x 10–29 of a 0–60 viewBox, so the glyph
	   sits 10.5 units (17.5% of the icon) left of the box centre — invisible on
	   the stock 75px-wide arrow, which positions its icon from the edge, but
	   plainly off-centre inside our 3rem circle. Nudge it back. `--next` keeps
	   its mirror; transforms apply right to left, so translating before the
	   flip lands the glyph on the same 17.5% correction. */
	.pswp__button--arrow--prev .pswp__icn {
		transform: translateX(17.5%);
	}
	.pswp__button--arrow--next .pswp__icn {
		transform: scaleX(-1) translateX(17.5%);
	}
	.pswp__button--arrow:hover,
	.pswp__button--arrow:active,
	.pswp__button--arrow:focus-visible {
		transform: scale(1.08);
		transition:
			background 0.18s ease,
			transform 0.18s ease;
	}
	/* PhotoSwipe defaults arrows to `left: 0` / `right: 0` — push them in. */
	.pswp__button--arrow--prev {
		left: 1rem;
	}
	.pswp__button--arrow--next {
		right: 1rem;
	}

	.pswp-caption {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		max-width: 80vw;
		padding: 0.5rem 1.25rem;
		background: rgba(0, 0, 0, 0.65);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		color: #fff;
		font-size: 1.125rem;
		line-height: 1.5;
		border-radius: 8px;
		text-align: center;
		pointer-events: none;
		z-index: 1500;
	}

	/* Suppress PhotoSwipe's `text-shadow` — its colour comes from
	   `--pswp-icon-color-secondary` which we set to white (would render as
	   white-on-white blur). */
	.pswp__counter {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.8rem;
		opacity: 1;
		text-shadow: none;
	}
</style>
