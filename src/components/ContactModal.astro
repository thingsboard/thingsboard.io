---
// Contact form in `Modal.astro`, posting to Formspree. `data-contact-modal-open="<id>"` opens it; a bare
// attribute opens the page's only one. The `intro` slot goes on to `Modal`.
import Modal from '@components/Modal.astro';
import { FORMSPREE_CONTACT } from '@data/formspree';

interface Props {
	id: string;
	title: string;
	submitLabel?: string;
	// Sent as the `form_id` / `tags` / `subject` fields when set.
	formId?: string;
	tags?: string;
	subject?: string;
}

const { id, title, submitLabel = 'Submit request', formId, tags, subject } = Astro.props;
---

<Modal id={id} title={title} data-contact-modal>
	<slot name="intro" slot="intro" />

	<form class="contact-modal__form gtm_form" method="post" action={FORMSPREE_CONTACT} novalidate>
		<div class="contact-modal__body">
			<div class="contact-modal__fields">
				<div class="contact-modal__field">
					<label for={`${id}-name`}>
						<span class="contact-modal__label">Name</span>
						<input
							class="contact-modal__input"
							type="text"
							id={`${id}-name`}
							name="name"
							placeholder="John Doe"
							maxlength="50"
							aria-invalid="false"
						/>
					</label>
				</div>
				<div class="contact-modal__field">
					<label for={`${id}-email`}>
						<span class="contact-modal__label">Email Address</span>
						<input
							class="contact-modal__input"
							type="email"
							id={`${id}-email`}
							name="email"
							placeholder="john@example.com"
							maxlength="80"
							aria-invalid="false"
						/>
					</label>
				</div>
				<div class="contact-modal__field contact-modal__field--full">
					<label for={`${id}-message`}>
						<span class="contact-modal__label">Message</span>
						<textarea
							class="contact-modal__input contact-modal__textarea"
							id={`${id}-message`}
							name="message"
							placeholder="Type your message here"
							maxlength="800"
							aria-invalid="false"
						></textarea>
					</label>
				</div>
			</div>

			<input type="hidden" name="utm_source" />
			<input type="hidden" name="utm_medium" />
			<input type="hidden" name="utm_campaign" />
			<input type="hidden" name="utm_term" />
			<input type="hidden" name="utm_content" />
			<input type="hidden" name="client_id" />
			<input type="hidden" name="fpr" />
			<input type="hidden" name="path" />
			<input type="hidden" name="_next" value="/contact-us-thanks/" />
			{formId && <input type="hidden" name="form_id" value={formId} />}
			{tags && <input type="hidden" name="tags" value={tags} />}
			{subject && <input type="hidden" name="subject" value={subject} />}
			<input type="hidden" class="form-rendered-at" value="" />
			<div class="contact-modal__hp">
				<label for={`${id}-hp`}>Leave this field empty</label>
				<input type="text" id={`${id}-hp`} name={`${id}-hp`} autocomplete="off" tabindex="-1" />
			</div>
		</div>

		<div class="contact-modal__footer">
			<button type="submit" class="contact-modal__submit gtm_button">
				{submitLabel}
			</button>
		</div>
	</form>
</Modal>

<script>
	import { armHoneypot, bindTrackingFields, clearFieldError, guardSubmit, stampRenderedAt } from '@util/form-guard';
	import { bindModalDialog } from '@util/modal-dialog';

	const FIELDS = [
		{ name: 'name', label: 'Name', type: 'text' },
		{ name: 'email', label: 'Email Address', type: 'email' },
		{ name: 'message', label: 'Message', type: 'textarea' },
	] as const;

	const dialogs = [...document.querySelectorAll<HTMLDialogElement>('dialog[data-contact-modal]')];

	function open(dialog: HTMLDialogElement) {
		const form = dialog.querySelector<HTMLFormElement>('form');
		// The timing check counts from the open, not from the page load.
		if (form) stampRenderedAt(form);
		bindModalDialog(dialog).open();
		// `showModal` lands on the close button; the first field takes the focus instead.
		dialog.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
	}

	for (const dialog of dialogs) {
		const form = dialog.querySelector<HTMLFormElement>('form');
		if (!form) continue;
		bindTrackingFields(form);
		const pathEl = form.querySelector<HTMLInputElement>('input[name="path"]');
		if (pathEl) pathEl.value = window.location.pathname;
		armHoneypot(form, '.contact-modal__hp');

		form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.contact-modal__input').forEach((el) => {
			el.addEventListener('input', () => {
				if (el.classList.contains('invalid-input')) clearFieldError(el);
			});
		});

		guardSubmit(form, FIELDS);
	}

	for (const trigger of document.querySelectorAll('[data-contact-modal-open]')) {
		trigger.setAttribute('aria-haspopup', 'dialog');
	}

	// Delegated, so triggers rendered after load open it too.
	document.addEventListener('click', (e) => {
		const trigger = (e.target as Element).closest<HTMLElement>('[data-contact-modal-open]');
		if (!trigger) return;
		const id = trigger.dataset.contactModalOpen;
		const dialog = id ? document.getElementById(id) : dialogs[0];
		if (!(dialog instanceof HTMLDialogElement) || !dialogs.includes(dialog)) return;
		e.preventDefault();
		open(dialog);
	});
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	.contact-modal__form {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;

		// The "Thank you" text a bot gets in place of the fields.
		> :global(p) {
			@include text-m;
			padding: 20px 0;
			margin: 0;
		}
	}

	.contact-modal__body {
		flex: 1;
		overflow-y: auto;
		min-height: 0;
		padding: 20px 0;
	}

	.contact-modal__fields {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	.contact-modal__field {
		width: calc(50% - 8px);

		&--full {
			width: 100%;
		}

		@include media-down(md) {
			width: 100%;
		}

		label {
			display: block;
		}
	}

	.contact-modal__label {
		@include text-s;
		display: block;
		font-weight: $font-weight-medium;
		color: var(--color-text-secondary);
		margin-bottom: 6px;
	}

	.contact-modal__input {
		@include text-m;
		width: 100%;
		border: 1px solid var(--color-border-light);
		border-radius: $radius-md;
		background-color: transparent;

		// --color-border-light is under 3:1 on the dark card, too faint for a field outline.
		:global([data-theme='dark']) & {
			border-color: var(--color-text-light);
		}

		&::placeholder {
			color: var(--color-text-muted);
		}

		// A box-shadow ring rather than a wider border, so the caret doesn't jump on focus.
		&:focus {
			outline: none;
			border-color: var(--color-brand);
			box-shadow: 0 0 0 1px var(--color-brand);

			&::placeholder {
				opacity: 0.2;
			}
		}

		&:global(.invalid-input) {
			border-color: var(--color-danger);

			&:focus {
				box-shadow: 0 0 0 0.2rem rgba($color-danger, 0.25);
			}
		}
	}

	input.contact-modal__input {
		height: 44px;
		padding: 0 16px;
	}

	.contact-modal__textarea {
		height: 170px;
		resize: vertical;
		padding: 8px 16px;
	}

	// Created by `validateFields`, so it never gets the scoping attribute.
	.contact-modal__field :global(.error-message-hint) {
		@include text-s;
		color: var(--color-danger);
		margin: 4px 0 0;
	}

	.contact-modal__hp {
		position: absolute;
		left: -9999px;
	}

	.contact-modal__footer {
		flex-shrink: 0;
		padding-top: 20px;
	}

	.contact-modal__submit {
		width: 100%;
		height: 56px;
		padding: 0;
		font-size: $font-size-xl;
		font-weight: $font-weight-semibold;
		line-height: 1;
		text-align: center;
		background-color: var(--color-brand);
		color: var(--color-brand-contrast);
		border: 1px solid var(--color-brand);
		border-radius: $radius-md;
		cursor: pointer;
		transition:
			background-color $transition-fast,
			color $transition-fast;

		&:hover {
			background-color: var(--color-bg-surface);
			color: var(--color-brand);
		}
	}
</style>
