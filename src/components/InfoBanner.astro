---
/**
 * InfoBanner — a reusable informational banner displayed for all product editions.
 *
 * Visually mirrors PEFeatureBanner but uses the blue (--color-product-cloud) accent
 * instead of the green PE accent. Width shrinks to fit the content (inline-block +
 * fit-content). Use for "widget-only", "section-only", or other feature-scope notes
 * that apply regardless of the product variant.
 *
 * Usage:
 *   <InfoBanner>This action is available for Map widgets only.</InfoBanner>
 *
 * Slot content can include components such as <DocLink>, <strong>, etc.
 */
---

<div class="info-banner-wrapper">
	<aside class="info-banner">
		<div class="info-banner-content">
			<p><slot /></p>
		</div>
	</aside>
</div>

<style>
	.info-banner-wrapper {
		margin-bottom: var(--sl-content-gap-y, 1rem);
	}

	.info-banner {
		display: inline-block;
		width: fit-content;
		border: 1px solid var(--color-product-cloud, #3d50f5);
		border-inline-start: 4px solid var(--color-product-cloud, #3d50f5);
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
		background: color-mix(in srgb, var(--color-product-cloud, #3d50f5) 6%, transparent);
	}

	.info-banner-content p {
		margin: 0;
		line-height: 1.6;
	}

	.info-banner a {
		color: var(--color-product-cloud, #3d50f5);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-product-cloud, #3d50f5) 40%, transparent);
		text-underline-offset: 2px;
	}

	.info-banner a:hover {
		text-decoration-color: var(--color-product-cloud, #3d50f5);
	}
</style>
