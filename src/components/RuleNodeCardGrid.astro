---
// RuleNodeCardGrid.astro
// Renders a responsive 3-column grid of rule node category cards.
// Each card has an image area (screenshot or SVG icon placeholder), title, description, and optional badge.
//
// Usage:
//   <RuleNodeCardGrid items={[
//     { href: '#filter-nodes', title: 'Filter', description: '...', icon: '/src/assets/images/...svg' },
//   ]} />

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Badge } from '@astrojs/starlight/components';

export interface CardItem {
	image?: string; // Raster screenshot path inside /src/assets/ (png/jpg/webp/gif) — optimized to WebP at build time
	icon?: string; // SVG icon path inside /src/assets/ — shown centered in placeholder when no image is provided
	alt?: string; // Alt text for the image; falls back to title
	title: string;
	href: string;
	description: string;
	badge?: string; // Badge label shown in the top-right corner of the image area
	badgeVariant?: 'default' | 'note' | 'tip' | 'caution' | 'danger' | 'success';
	span?: 1 | 2; // Columns the card occupies on desktop. Defaults to 1; 2 makes it a wide card
}

interface Props {
	items: CardItem[];
	/** Heading level for each card title. Defaults to 3. Use 2 when the grid sits at the top of a page without any ## sections above it. */
	headingLevel?: 2 | 3 | 4 | 5 | 6;
	/** Desktop column count. Defaults to 3; use 2 for four cards or for wide card images. */
	columns?: 2 | 3;
}

const { items, headingLevel = 3, columns = 3 } = Astro.props;
const HeadingTag = `h${headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

type OptimizedImage = Awaited<ReturnType<typeof getImage>>;

interface ProcessedItem extends CardItem {
	optimized: OptimizedImage | null; // Processed raster image; null when no image or path not found
	optimizedDark: OptimizedImage | null; // Processed `{base}-dark{ext}` variant when one exists next to the image
	iconSrc: string | null; // Resolved SVG src URL; null when no icon or path not found
}

// Eager globs — all paths resolved at build time by Vite
const assetModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp,gif}', {
	eager: true,
});

const svgModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.svg', {
	eager: true,
});

// Optimise raster images to WebP and resolve SVG src URLs for all items
const processedItems: ProcessedItem[] = await Promise.all(
	items.map(async (item) => {
		let optimized: OptimizedImage | null = null;
		let optimizedDark: OptimizedImage | null = null;
		const width = item.span === 2 ? 960 : 480;
		if (item.image) {
			const mod = assetModules[item.image];
			if (mod) optimized = await getImage({ src: mod.default, format: 'webp', quality: 85, width });
			const darkPath = item.image.replace(/(\.[a-z0-9]+)$/i, '-dark$1');
			const darkMod = assetModules[darkPath];
			if (mod && darkMod) optimizedDark = await getImage({ src: darkMod.default, format: 'webp', quality: 85, width });
		}
		const iconSrc = item.icon ? (svgModules[item.icon]?.default?.src ?? null) : null;
		return { ...item, optimized, optimizedDark, iconSrc };
	})
);
---

<ul class:list={['rn-grid', { 'rn-grid--two': columns === 2 }]}>
	{
		processedItems.map((item) => (
			<li class:list={['rn-card', { 'rn-card--wide': item.span === 2 }]}>
				<a href={item.href} class="rn-card__anchor">
					{/* Image area — shows optimised screenshot or SVG icon placeholder */}
					<div class="rn-card__img-wrap">
						{item.optimized ? (
							<>
								<img
									src={item.optimized.src}
									alt={item.alt ?? item.title}
									width={item.optimized.attributes.width}
									height={item.optimized.attributes.height}
									class:list={[{ 'rn-card__img--light': item.optimizedDark }]}
									loading="lazy"
									decoding="async"
								/>
								{item.optimizedDark && (
									<img
										src={item.optimizedDark.src}
										alt={item.alt ?? item.title}
										width={item.optimizedDark.attributes.width}
										height={item.optimizedDark.attributes.height}
										class="rn-card__img--dark"
										loading="lazy"
										decoding="async"
									/>
								)}
							</>
						) : (
							<div class="rn-card__placeholder" aria-hidden="true">
								{item.iconSrc && <img src={item.iconSrc} alt={item.alt ?? ''} class="rn-card__placeholder-icon" />}
							</div>
						)}
						{/* Badge — absolute-positioned in the top-right corner of the image area */}
						{item.badge && (
							<span class="rn-card__badge">
								<Badge text={item.badge} variant={item.badgeVariant ?? 'default'} />
							</span>
						)}
					</div>
					{/* Card body — title and description */}
					<div class="rn-card__body">
						<HeadingTag class="rn-card__title">{item.title}</HeadingTag>
						<p class="rn-card__desc">{item.description}</p>
					</div>
				</a>
			</li>
		))
	}
</ul>

<style>
	/* Grid layout — 3 columns desktop, 2 tablet, 1 mobile */
	.rn-grid {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		align-items: stretch;
		gap: 1rem;
	}

	.rn-grid--two {
		grid-template-columns: repeat(2, 1fr);
	}

	.rn-card--wide {
		grid-column: span 2;
	}

	/* Height is one column's 16:9, (width − gap) / 2 × 9/16, so titles in a row line up with the narrow cards */
	.rn-card--wide .rn-card__img-wrap {
		aspect-ratio: auto;
		height: calc((100cqw - 1rem) * 0.28125);
	}

	@media (max-width: 900px) {
		.rn-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Dark variant swap follows the theme attribute on <html> */
	.rn-card__img--dark {
		display: none;
	}

	:global([data-theme='dark']) .rn-card__img--light {
		display: none;
	}

	:global([data-theme='dark']) .rn-card__img--dark {
		display: block;
	}

	@media (max-width: 480px) {
		.rn-grid {
			grid-template-columns: 1fr;
		}

		.rn-card--wide {
			grid-column: auto;
		}

		.rn-card--wide .rn-card__img-wrap {
			aspect-ratio: 16 / 9;
			height: auto;
		}
	}

	/* Card */
	.rn-card {
		container-type: inline-size;
		height: 100%;
		margin-top: 0;
		border: 1px solid var(--sl-color-gray-5);
		overflow: hidden;
		transition: border-color 0.15s;
	}

	.rn-card:hover {
		border-color: var(--sl-color-text-accent);
	}

	.rn-card__anchor {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	/* Image area */
	.rn-card__img-wrap {
		padding: 0.75rem 1rem 1rem;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		position: relative;
	}

	.rn-card__img-wrap img {
		object-fit: cover;
		display: block;
	}

	/* Placeholder — shown when no raster image is provided; grid background + centered SVG icon */
	.rn-card__placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #eeeeee;
		background-image:
			linear-gradient(to right, var(--sl-color-gray-5) 1px, transparent 1px),
			linear-gradient(to bottom, var(--sl-color-gray-5) 1px, transparent 1px);
		background-size: 25px 25px;
	}

	/* SVG icon inside placeholder — scales up on card hover */
	.rn-card__placeholder-icon {
		height: 45px;
		object-fit: contain;
		transition: transform 0.2s ease;
	}

	.rn-card:hover .rn-card__placeholder-icon {
		transform: scale(1.2);
	}

	/* Card body */
	.rn-card__body {
		padding: 0.75rem 1rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		flex: 1;
		margin-top: 0;
	}

	.rn-card__title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--sl-color-white);
		line-height: 1.4;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem;
	}

	.rn-card__desc {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
	}

	/* Badge — absolute-positioned in the top-right corner of the image area */
	.rn-card__badge {
		position: absolute;
		top: 0;
		right: 0.5rem;
	}

	@media print {
		.rn-card {
			break-inside: avoid;
		}

		.rn-card__placeholder {
			background: none;
		}
	}
</style>
