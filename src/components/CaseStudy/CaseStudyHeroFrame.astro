---
// The hero shows the same framed image twice — inline between the heading and
// the copy on small screens, beside the copy on large ones — so both frames
// render through here.
interface Props {
	variant: 'inner' | 'large';
	backgroundImage: string;
	logo: string;
	logoAlt: string;
	selfBrandedArtwork: boolean;
	artworkLabel: string;
}

const { variant, backgroundImage, logo, logoAlt, selfBrandedArtwork, artworkLabel } = Astro.props;

const variantClass = variant === 'inner' ? 'cs-hero-image-inner' : 'cs-hero-image-large';
---

<div
	class:list={[variantClass, { 'cs-hero-image--artwork': selfBrandedArtwork }]}
	style={`background-image: url('${backgroundImage}')`}
	role={selfBrandedArtwork ? 'img' : undefined}
	aria-label={selfBrandedArtwork ? artworkLabel : undefined}
>
	{
		!selfBrandedArtwork && (
			<div class="cs-hero-logo-wrap">
				<img src={logo} alt={logoAlt} fetchpriority="high" loading="eager" decoding="async" />
			</div>
		)
	}
</div>
