---
import { caseStudyCards } from '@data/case-study-cards';

interface Props {
	slug: string;
}

// A case-study teaser card: the photo, tag, logo, title and figures, linking to the case study.
// The copy lives in `@data/case-study-cards`.
const { slug } = Astro.props;

const card = caseStudyCards[slug];
if (!card) throw new Error(`[CaseStudyCard] No card for case study "${slug}".`);
const { logo } = card;
---

<div class="case-card">
	<img class="case-card__bg" src={card.image} alt="" loading="lazy" decoding="async" />
	<a class="case-card__content" href={`/case-studies/${slug}/`} target="_blank" rel="noopener noreferrer">
		<span class="case-card__header">
			<span class="case-card__tag">{card.tag}</span>
			<img
				class="case-card__logo print:hidden"
				src={logo.src}
				title={logo.name}
				alt={`${logo.name} logo`}
				width={logo.width}
				height={logo.height}
				style={logo.displayHeight && `height: ${logo.displayHeight}px`}
				loading="lazy"
			/>
		</span>
		<span class="case-card__footer">
			<span class="case-card__title">{card.title}</span>
			<span class="case-card__stats">
				{
					card.stats.map((stat) => (
						<span class="case-card__stat">
							<span class="case-card__value">{stat.value}</span>
							{stat.long ? (
								<>
									<span class="case-card__short print:hidden">{stat.label}</span>
									<span class="case-card__long">
										{stat.long.map((line, i) => (
											<>
												{i > 0 && <br />}
												{line}
											</>
										))}
									</span>
								</>
							) : (
								<span class="case-card__label">{stat.label}</span>
							)}
						</span>
					))
				}
			</span>
		</span>
	</a>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The development-services case-card styles.
	.case-card {
		position: relative;
		height: 299px;
		overflow: hidden;
		color: $color-white;
		border-radius: $radius-2xl;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.3);
		}

		&:hover,
		&:focus-within {
			.case-card__bg {
				transform: scale(1.2);
			}

			.case-card__footer {
				padding-bottom: 45px;
			}

			.case-card__short {
				opacity: 0;
			}

			.case-card__long {
				opacity: 1;
			}
		}
	}

	// An <img> rather than a background-image so it can load lazily.
	.case-card__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform-origin: center;
		transition: transform 0.5s;

		@media (prefers-reduced-motion: reduce) {
			transition: none;
			transform: none !important;
		}
	}

	.case-card__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: flex-start;
		height: 100%;
		padding: $spacing-5;
		color: $color-white;
		text-decoration: none;

		// Inset, so the card's `overflow: hidden` does not clip it.
		&:focus-visible {
			outline: 2px solid var(--sl-color-accent);
			outline-offset: -4px;
			border-radius: inherit;
		}
	}

	.case-card__header {
		display: flex;
		justify-content: space-between;
		width: 100%;
	}

	.case-card__tag {
		position: relative;
		overflow: hidden;
		@include text-s;
		font-weight: $font-weight-medium;
		padding: $spacing-1 $spacing-2;
		color: $color-text-primary;
		background: rgba(255, 255, 255, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: $radius-md;
		backdrop-filter: blur(5px);
		-webkit-backdrop-filter: blur(5px);

		&::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 1px;
			background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
		}

		&::after {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			width: 1px;
			height: 100%;
			background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), transparent, rgba(255, 255, 255, 0.3));
		}
	}

	.case-card__logo {
		width: auto;
		height: 36px;
	}

	.case-card__footer {
		display: block;
		width: 100%;
		transition: all 0.5s;
	}

	.case-card__title {
		display: block;
		@include text-overlay;
		padding-bottom: $spacing-3;
		margin-bottom: $spacing-3;
		border-bottom: 1px solid #b9c0c5;
	}

	.case-card__stats {
		display: flex;
		min-height: 60px;

		@media (max-width: 599px) {
			justify-content: space-around;
		}
	}

	.case-card__stat {
		position: relative;
		flex-shrink: 0;
		width: 129px;
		font-size: 14px;
		line-height: 24px;

		&:last-child {
			width: auto;
		}

		@media (max-width: 599px) {
			width: 109px;
		}
	}

	.case-card__value {
		display: block;
		font-size: 24px;
		font-weight: 500;
		line-height: 36px;
	}

	.case-card__label {
		display: block;
	}

	.case-card__short,
	.case-card__long {
		position: absolute;
		white-space: nowrap;
		transition: opacity 0.5s linear;
	}

	.case-card__long {
		opacity: 0;
	}

	// Print drops the photo and its overlay and shows the long labels in dark text.
	@media print {
		.case-card {
			height: auto;
			color: #212121;
			border: 1px solid #d7d9e0;
			break-inside: avoid;

			&::after {
				content: none;
			}
		}

		.case-card__bg {
			display: none;
		}

		.case-card__content {
			color: inherit;
		}

		.case-card__long {
			position: static;
			opacity: 1;
		}
	}
</style>
