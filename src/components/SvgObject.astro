---
// Shows an SVG as an <object>, so the SVG's own links and scripts keep working (an <img> would make
// them dead), and reloads it when Safari brings the page back without it.
interface Props {
	src: string;
	/** The SVG's viewBox size. The box keeps that shape while the SVG isn't loaded. */
	width: number;
	height: number;
	/** For page scripts that look the object up. */
	id?: string;
	/** Accessible name, set as `aria-label`. */
	label?: string;
}

const { src, width, height, id, label } = Astro.props;
---

<object
	id={id}
	class="svg-object"
	data={src}
	type="image/svg+xml"
	aria-label={label}
	style={{ aspectRatio: `${width} / ${height}` }}
></object>

<style>
	.svg-object {
		display: block;
		width: 100%;
		height: auto;
	}
</style>

<script>
	import { reloadObjectsOnRestore } from '@root/scripts/page-restore';
	reloadObjectsOnRestore('object.svg-object');
</script>
