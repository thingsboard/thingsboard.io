---
import Button from '@components/ui/Button.astro';
---

<div class="contact-us-banner print:hidden">
	<div class="contact-us-banner-content">
		<h2>Read more about ThingsBoard</h2>
		<p>ThingsBoard is continuously evolving to deliver more scalable, efficient, and future-proof solutions. Learn more about us and explore how we're helping companies solve real-world challenges and accelerate their IoT transformation.</p>
		<div class="contact-us-banner-buttons">
			<Button variant="secondary" href="/company/" size="lg">About company</Button>
			<Button variant="secondary" href="/use-cases/" size="lg">Use cases</Button>
			<Button variant="secondary" href="/case-studies/" size="lg">Case studies</Button>
		</div>
	</div>
	<img src="/images/mediakit/logo-fade.svg" width="380" height="267" alt="ThingsBoard icon">
</div>

<style lang="scss">
	.contact-us-banner {
		max-width: min(1400px, calc(100% - 40px));
		position: relative;
		z-index: 1;
		padding: 46px;
		background: #fff;
		border-radius: 24px;
		box-shadow: -4px 15px 50px -20px rgba(0, 0, 0, 0.15), 0 0 8px 0 rgba(0, 0, 0, 0.08);
		width: 100%;
		margin: 0 auto 92px;
		overflow: hidden;

		& > img {
			position: absolute;
			right: 46px;
			top: 93px;

			@media (max-width: 1150px) {
				display: none;
			}
		}
	}

	.contact-us-banner-content {
		max-width: 600px;

		h2 {
			font-size: 36px;
			font-weight: 500;
			line-height: 48px;
			margin-bottom: 16px;
			padding: 0;

			@media (max-width: 599px) {
				font-size: 28px;
			}
		}

		p {
			font-size: 18px;
			font-weight: 400;
			line-height: 30px;
			color: rgba(0, 0, 0, 0.76);
			margin-bottom: 32px;
			margin-top: 0;

			@media (max-width: 599px) {
				font-size: 14px;
			}
		}
	}

	.contact-us-banner-buttons {
		--btn-min-w: 154px;

		display: flex;
		gap: 16px;
		flex-wrap: wrap;

		@media (max-width: 600px) {
			--btn-min-w: 100%;
		}
	}
</style>
