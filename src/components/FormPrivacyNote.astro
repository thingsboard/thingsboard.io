---
// The privacy line above the submit button of forms that send a name or an email.
import { WEBSITE_PRIVACY_HREF, formPrivacyNote } from '@data/privacy';

interface Props {
	// The submit button points here with `aria-describedby`, so screen readers read the line with the button.
	id: string;
	noun?: string;
}

const { id, noun = 'message' } = Astro.props;

// New tab, so the text already typed in the form is not lost.
const link = { href: WEBSITE_PRIVACY_HREF, target: '_blank', rel: 'noopener' };
---

<p id={id} class="form-privacy-note">
	{formPrivacyNote(noun)} <a {...link}>Privacy Policy</a>.
</p>

<style lang="scss">
	@use '../styles/variables' as *;

	// Doubled class: one class loses to the older forms' `p` and `a` rules.
	.form-privacy-note.form-privacy-note {
		@include type-small;
		margin: var(--form-privacy-note-margin, 0 0 #{$spacing-3});
		padding: 0;
		color: var(--color-text-secondary);
		text-align: start;

		a {
			// `--accent-ink` is set only on pages with the ui kit.
			color: var(--accent-ink, var(--color-primary));
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}
</style>
