---
import { Icon } from 'astro-icon/components';
---

<section class="stats-section">
	<div class="trainings-wrapper">
		<div class="stats-cards">
			<div class="stat-card">
				<div class="stat-icon">
					<Icon name="tabler:users-group" class="stat-glyph" width={64} height={64} aria-hidden="true" />
				</div>
				<div class="stat-number-wrap">
					<span class="stat-number"
						><span class="animated-num print:hidden" data-target="1200">0</span><span class="print:only">1200</span>+</span
					>
					<span class="stat-label">Participants</span>
				</div>
				<p class="stat-text">More than 1200 participants took part in ThingsBoard training sessions</p>
			</div>
			<div class="stat-card">
				<div class="stat-icon">
					<Icon name="tabler:message-2-filled" class="stat-glyph" width={64} height={64} aria-hidden="true" />
				</div>
				<div class="stat-number-wrap">
					<span class="stat-number"
						><span class="animated-num print:hidden" data-target="200">0</span><span class="print:only">200</span>+</span
					>
					<span class="stat-label">Sessions</span>
				</div>
				<p class="stat-text">More than 200 sessions were organized for ThingsBoard clients</p>
			</div>
		</div>
		<div class="stats-cta print:hidden">
			<p>Professional training tailored for your needs. Get in touch and start learning!</p>
			<a class="cta-btn" href="/contact-us/?subject=Training">Contact Us</a>
		</div>
	</div>
</section>

<script>
	function animateNumber(el: HTMLElement) {
		const target = parseInt(el.dataset.target || '0', 10);
		const duration = 2000;
		const start = performance.now();

		function update(now: number) {
			const elapsed = now - start;
			const progress = Math.min(elapsed / duration, 1);
			const eased = 1 - Math.pow(1 - progress, 3);
			el.textContent = String(Math.round(eased * target));
			if (progress < 1) requestAnimationFrame(update);
		}

		requestAnimationFrame(update);
	}

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.querySelectorAll<HTMLElement>('.animated-num').forEach(animateNumber);
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.3 }
	);

	document.querySelectorAll('.stats-cards').forEach((el) => observer.observe(el));
</script>

<style lang="scss">
	.stats-section {
		padding: 100px 0;
		background: var(--color-bg-light);

		:global([data-theme='dark']) & {
			background: var(--color-bg-muted);
		}
	}

	.trainings-wrapper {
		padding: 0 32px;
		max-width: 1460px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 80px;
	}

	.stats-cards {
		display: flex;
		justify-content: space-between;
		gap: 32px;
	}

	.stat-card {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 32px;
		background: var(--color-bg-surface);
		box-shadow: 0px 10px 25px -15px rgba(0, 0, 0, 0.08);
		border-radius: 24px;
		padding: 46px;

		// The shadow is lost on a dark page, so the border marks the card edge.
		:global([data-theme='dark']) & {
			border: 1px solid var(--color-border);
		}
	}

	.stat-icon {
		width: fit-content;
		padding: 22px 16px;
		border-radius: 24px;
		border: 3px solid var(--color-primary);
		color: var(--color-primary);
	}

	.stat-number-wrap {
		display: flex;
		align-items: baseline;
		flex-direction: row;
		gap: 16px;
	}

	.stat-number {
		font-size: 64px;
		font-weight: 500;
		line-height: normal;
		display: flex;
	}

	.stat-label {
		font-size: 32px;
		font-weight: 500;
		line-height: normal;
		color: rgba(0, 0, 0, 0.54);

		:global([data-theme='dark']) & {
			color: var(--color-text-secondary);
		}
	}

	.stat-text {
		color: rgba(68, 71, 74, 0.8);
		font-size: 18px;
		font-weight: 400;
		line-height: normal;
		letter-spacing: 0.15px;
		margin: 0;

		:global([data-theme='dark']) & {
			color: var(--color-text-secondary);
		}
	}

	.stats-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 32px;
	}

	.stats-cta p {
		line-height: 32px;
		font-size: 24px;
		color: rgba(0, 0, 0, 0.76);
		margin: 0;

		:global([data-theme='dark']) & {
			color: var(--color-text);
		}
	}

	.cta-btn {
		display: inline-block;
		font-size: 18px;
		font-weight: 500;
		padding: 12px 49px;
		border-radius: 6px;
		// The brand pair: indigo with a white label in light, lavender with a navy label in dark.
		background: var(--color-brand);
		color: var(--color-brand-contrast);
		text-decoration: none;
		transition: opacity 0.2s ease-in-out;
		width: fit-content;
	}

	.cta-btn:hover {
		opacity: 0.7;
		color: var(--color-brand-contrast);
		text-decoration: none;
	}

	@media (max-width: 1279px) {
		.stat-number-wrap {
			flex-direction: column;
			gap: 0;
		}
	}

	@media (max-width: 959px) {
		.stats-section {
			padding: 50px 0;
		}

		.stats-cards {
			flex-direction: column;
		}
	}

	@media print {
		.stats-section {
			background: none;
			padding-top: 0;
		}

		.stats-cards {
			flex-flow: row wrap;
		}

		.stat-card {
			flex: 1 1 17.5rem;
			gap: 16px;
			padding: 24px;
			break-inside: avoid;
			box-shadow: none;
			border: 1px solid #d7d9e0;
		}

		.stat-number-wrap {
			flex-flow: row wrap;
			gap: 0 16px;
		}
	}
</style>
