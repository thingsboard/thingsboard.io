---
import { Icon } from 'astro-icon/components';
---

<section class="info-cards-section">
	<div class="trainings-wrapper">
		<div class="cards-wrap">
			<div class="info-card">
				<h2 class="card-title">Who is this for</h2>
				<ul>
					<li>
						<Icon name="trainings/people" class="info-icon" width={32} height={32} aria-hidden="true" />
						<span>Teams of <b>up to 8 people</b> who need to learn at the same pace.</span>
					</li>
					<li>
						<Icon name="trainings/trophy" class="info-icon" width={32} height={32} aria-hidden="true" />
						<span>Individuals ready to get a <b>solid foundation and fully leverage</b> ThingsBoard.</span>
					</li>
					<li>
						<Icon name="trainings/target-line" class="info-icon" width={32} height={32} aria-hidden="true" />
						<span>Those eager to quickly create <b>top-notch solutions</b>.</span>
					</li>
				</ul>
			</div>
			<div class="info-card">
				<h2 class="card-title">Primary goals of the training</h2>
				<ul>
					<li>
						<Icon name="trainings/arrow-growth" class="info-icon" width={32} height={32} aria-hidden="true" />
						<span>Enhance your <b>experience</b> with ThingsBoard.</span>
					</li>
					<li>
						<Icon name="tabler:help-circle" class="question-icon" width={32} height={32} aria-hidden="true" />
						<span>Answer <b>practical questions</b> related to your specific use cases.</span>
					</li>
					<li>
						<Icon name="trainings/reduce" class="info-icon" width={32} height={32} aria-hidden="true" />
						<span>Reduce your <b>time-to-market</b> for IoT products or solutions.</span>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	.info-cards-section {
		padding: 100px 0;
		background: var(--color-bg-light);

		:global([data-theme='dark']) & {
			background: var(--color-bg-muted);
		}
	}

	.trainings-wrapper {
		padding: 0 32px;
		max-width: 1460px;
		margin: 0 auto;
	}

	.cards-wrap {
		display: flex;
		justify-content: space-between;
		gap: 32px;
	}

	.info-card {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 32px;
		background: var(--color-bg-surface);
		box-shadow: 0px 10px 25px -15px rgba(0, 0, 0, 0.08);
		border-radius: 24px;
		padding: 46px;

		// The shadow is lost on a dark page, so the border marks the card edge.
		:global([data-theme='dark']) & {
			border: 1px solid var(--color-border);
		}
	}

	.card-title {
		color: #212529;
		font-size: 32px;
		font-weight: 500;
		line-height: normal;

		:global([data-theme='dark']) & {
			color: var(--color-text);
		}
	}

	ul {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		gap: 16px;
		max-width: 501px;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	li {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	li span {
		font-size: 16px;
		color: rgba(68, 71, 74, 0.8);

		:global([data-theme='dark']) & {
			color: var(--color-text-secondary);
		}
	}

	// Drawn in currentColor, so they follow the accent in both themes.
	.info-icon,
	.question-icon {
		flex-shrink: 0;
		color: var(--color-primary);
	}

	@media (max-width: 959px) {
		.info-cards-section {
			padding: 50px 0;
		}

		.cards-wrap {
			flex-direction: column;
		}
	}

	@media print {
		.info-cards-section {
			padding: 24px 0;
			background: none;
		}

		.info-card {
			break-inside: avoid;
			box-shadow: none;
			border: 1px solid #d7d9e0;
		}
	}
</style>
