---
import NButton from '@components/Landing/NButton.astro';

interface Props {
	title: string;
	description: string;
	features: string[];
	gtmFormId: string;
}

const { title, description, features, gtmFormId } = Astro.props;

const fields: { name: string; label: string; type?: 'email' | 'tel'; autocomplete: string }[] = [
	{ name: 'first_name', label: 'First name', autocomplete: 'given-name' },
	{ name: 'last_name', label: 'Last name', autocomplete: 'family-name' },
	{ name: 'email', label: 'Business Email', type: 'email', autocomplete: 'email' },
	{ name: 'company', label: 'Company', autocomplete: 'organization' },
	{ name: 'city', label: 'City', autocomplete: 'address-level2' },
	{ name: 'phone', label: 'Phone', type: 'tel', autocomplete: 'tel' },
];
---

<section class="demo-request">
	<div class="demo-request__inner">
		<h1 class="demo-request__heading">{title}</h1>
		<div class="demo-request__body">
			<div class="demo-request__info">
				<p>{description}</p>
				<ul>
					{features.map((f) => <li>{f}</li>)}
				</ul>
			</div>
			<div class="demo-request__form print:hidden">
				<form
					id={gtmFormId}
					class="gtm_form"
					action="https://app.mailerlite.com/webforms/submit/e2f1u0"
					method="post"
					target="_blank"
				>
					{fields.map((f) => (
						<input
							class="demo-request__input"
							type={f.type ?? 'text'}
							name={`fields[${f.name}]`}
							placeholder={f.label}
							aria-label={f.label}
							autocomplete={f.autocomplete}
							required
						/>
					))}
					<input type="hidden" name="ml-submit" value="1" />
					<p class="demo-request__error" data-ml-error role="alert" hidden></p>
					<NButton type="submit" fullWidth>Contact Me</NButton>
				</form>
				<div class="demo-request__success" role="status" tabindex="-1" hidden>
					<p class="demo-request__success-title">Thank you!</p>
					<p>Our team will contact you shortly</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { bindMailerLiteForm } from '@util/mailerlite';

	const form = document.querySelector<HTMLFormElement>('.demo-request form');
	const success = document.querySelector<HTMLElement>('.demo-request__success');
	if (form && success) bindMailerLiteForm(form, success);
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	.demo-request {
		padding: 40px 24px 64px;

		&__inner {
			max-width: 900px;
			margin: 0 auto;
		}

		&__heading {
			text-align: center;
			font-size: 1.5rem;
			font-weight: 600;
			margin: 0 0 40px;
			color: var(--color-text);
		}

		&__body {
			display: flex;
			gap: 40px;
			align-items: flex-start;

			@media (max-width: 700px) {
				flex-direction: column;
				align-items: center;
			}
		}

		&__info {
			flex: 1;

			p {
				margin: 0 0 16px;
				color: var(--color-text-secondary);
				line-height: 1.6;
			}

			ul {
				list-style: disc !important;
				padding-left: 20px !important;
				margin: 0 !important;

				li {
					list-style: disc !important;
					margin-bottom: 8px;
					color: var(--color-text-secondary);
					line-height: 1.5;
				}
			}
		}

		&__form {
			flex: 1;
			width: 100%;

			form {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}
		}

		&__input {
			width: 100%;
			padding: 10px 14px;
			font: inherit;
			color: var(--color-text);
			background: var(--color-bg-surface);
			border: 1px solid var(--color-border);
			border-radius: 4px;

			&:focus-visible {
				outline: 2px solid var(--color-primary);
				outline-offset: -1px;
				border-color: transparent;
			}
		}

		&__error {
			margin: 0;
			color: var(--color-danger);
		}

		&__success {
			padding: 40px 0;
			text-align: center;
			color: var(--color-text-secondary);

			// Focused from the script only to announce it; not a control.
			&:focus {
				outline: none;
			}

			p {
				margin: 0;
			}
		}

		&__success-title {
			font-size: 1.5rem;
			font-weight: 600;
			color: var(--color-text);
		}
	}
</style>
