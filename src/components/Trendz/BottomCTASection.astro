---
import Button from '@components/ui/Button.astro';
---

<section id="trendz-bottom-cta" class="print:hidden">
	<div class="cta-inner">
		<div class="cta-card" data-surface="dark">
			<h2 class="cta-title">Create your powerful IoT Analytics Solutions</h2>
			<p class="cta-subtitle">
				Try Trendz for free with the Free plan, connect it to your ThingsBoard, or submit a request and we will help you
				choose the best option.
			</p>
			<div class="cta-actions">
				<Button href="/docs/trendz/activation/how-to/" size="xl" class="cta-white">Start for free</Button>
				<Button variant="secondary" size="xl" attrs={{ 'data-contact-modal-open': '' }}>Contact us</Button>
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/trendz' as *;

	#trendz-bottom-cta {
		background: #fff;
		padding: 32px 20px;
		box-sizing: border-box;

		@include media-up(sm) {
			padding: 60px 50px;
		}

		@include media-up(xl) {
			padding: 100px 50px;
		}
	}

	.cta-inner {
		max-width: 1400px;
		margin: 0 auto;
	}

	.cta-card {
		background: var(--color-trendz-accent);
		border-radius: 24px;
		padding: 32px 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 32px;
		text-align: center;

		@include media-up(sm) {
			padding: 46px;
		}
	}

	.cta-title {
		@include trendz-h2;
		color: #fff;
		margin: 0;

		@include media-down(sm) {
			@include trendz-h4;
		}
	}

	.cta-subtitle {
		@include trendz-h5;
		color: #fff;
		margin: -16px 0 0;
		max-width: 660px;

		@include media-down(sm) {
			@include trendz-body-s;
			margin-top: -16px;
		}
	}

	.cta-actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 16px;
		width: 100%;

		@include media-up(lg) {
			flex-direction: row;
			justify-content: center;
			align-items: center;
			width: auto;
			gap: 32px;
		}
	}

	.cta-white {
		--accent-fill: #fff;
		--accent-on-fill: var(--color-trendz-accent);
	}

	.cta-actions {
		@include media-up(sm) {
			--btn-px: 84px;
		}
	}
</style>
