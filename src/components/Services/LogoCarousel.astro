---
interface Logo {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface Props {
	title?: string;
	logos: Logo[];
}

const { title = 'WE CREATED SOLUTIONS FOR:', logos } = Astro.props;

// Duplicate logos to create seamless infinite scroll
const items = [...logos, ...logos];
---

<section class="logo-carousel">
	<span class="carousel-title">{title}</span>
	<div class="carousel-track-wrap">
		<div class="carousel-track">
			{items.map((logo, index) => (
				<div class:list={['logo', index >= logos.length && 'print:hidden']} aria-hidden={index >= logos.length ? 'true' : undefined}>
					<img src={logo.src} alt={logo.alt} loading="lazy" width={logo.width} height={logo.height} />
				</div>
			))}
		</div>
	</div>
</section>

<style lang="scss">
	.logo-carousel {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		z-index: 1;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.20);
		backdrop-filter: blur(25px);
		margin-bottom: 40px;

		// The white veil would read as a grey band; match the page so the edge fades blend.
		:global([data-theme='dark']) & {
			background: var(--sl-color-bg);
		}
	}

	.carousel-title {
		color: #3D3D3D;
		text-align: center;
		font-size: 16px;
		font-weight: 400;
		line-height: 28px;
		padding: 40px 0;

		:global([data-theme='dark']) & {
			color: var(--color-text-secondary);
		}
	}

	.carousel-track-wrap {
		position: relative;
		width: 90vw;
		overflow: hidden;

		// Room above the logos for the dark plates; the negative margin keeps the layout.
		:global([data-theme='dark']) & {
			padding-top: 6px;
			margin-top: -6px;
		}

		&::before,
		&::after {
			position: absolute;
			top: 0;
			width: 15vw;
			height: 100%;
			content: '';
			z-index: 1;
			pointer-events: none;
		}

		// --sl-color-bg is the page background: white in light, the dark page in dark.
		&::before {
			left: 0;
			background: linear-gradient(to right, var(--sl-color-bg) 40%, transparent 100%);
		}

		&::after {
			right: 0;
			background: linear-gradient(to left, var(--sl-color-bg) 40%, transparent 100%);
		}
	}

	.carousel-track {
		display: flex;
		align-items: center;
		gap: 150px;
		animation: logo-marquee 25s linear infinite;
		position: relative;
		padding-bottom: 40px;
		// max-content prevents block flex container from collapsing to parent width (90vw)
		// padding-right = gap so -50% lands exactly at the start of the second logo set
		width: max-content;
		padding-right: 150px;
	}

	.logo {
		filter: grayscale(100%);
		opacity: 0.6;
		flex-shrink: 0;

		img {
			height: 44px;
			width: auto;
		}

		&:hover {
			filter: unset;
			opacity: unset;
		}

		// Several marks are black or navy on a transparent background, so they sit on a white
		// plate. The plate is drawn around the mark so the box keeps its size, and the dimming
		// moves to the mark so the plate stays white.
		:global([data-theme='dark']) & {
			position: relative;
			filter: none;
			opacity: 1;

			&::before {
				content: '';
				position: absolute;
				top: -6px;
				left: -10px;
				right: -10px;
				height: calc(44px + 12px);
				z-index: -1;
				border-radius: var(--radius-md);
				background: var(--color-white);
			}

			img {
				filter: grayscale(100%);
				opacity: 0.6;
			}

			&:hover img {
				filter: none;
				opacity: 1;
			}
		}
	}

	@keyframes logo-marquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	// Respect users who've asked for less motion — hold the strip still
	@media (prefers-reduced-motion: reduce) {
		.carousel-track {
			animation: none;
		}
	}

	@media print {
		.logo-carousel {
			margin-bottom: 24px;
			backdrop-filter: none;
			break-inside: avoid;
		}

		.carousel-title {
			padding: 16px 0;
			break-after: avoid;
		}

		.carousel-track-wrap {
			width: 100%;

			&::before,
			&::after {
				content: none;
			}
		}

		.carousel-track {
			transform: none !important;
			width: auto;
			flex-wrap: wrap;
			justify-content: center;
			gap: 24px 48px;
			padding: 0 0 16px;
		}

		.logo {
			img {
				height: 36px;
			}
		}
	}
</style>