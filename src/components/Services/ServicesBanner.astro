---
import { Icon } from 'astro-icon/components';

type IconName = Parameters<typeof Icon>[0]['name'];

interface Props {
	title: string;
	titleTag?: 'h2' | 'h3';
	buttonText: string;
	buttonHref?: string;
	buttonOnClick?: string;
	buttonId?: string;
	buttonWidth?: string;
	/** A local icon drawn in currentColor; the banner colours it with the accent. */
	icon: IconName;
	imageWidth?: number;
	imageHeight?: number;
	imageTop?: number;
	imageHideAt?: number;
}

const {
	title,
	titleTag = 'h2',
	buttonText,
	buttonHref = '#',
	buttonOnClick,
	buttonId,
	buttonWidth = '376px',
	icon,
	imageWidth = 380,
	imageHeight = 267,
	imageTop = 35,
	imageHideAt = 1150,
} = Astro.props;

const TitleTag = titleTag;
---

<div
	class="services-banner-wrap print:hidden"
	style={`--btn-width: ${buttonWidth}; --img-top: ${imageTop}px; --img-hide-at: ${imageHideAt}px;`}
>
	<div class="banner-content">
		<TitleTag class="banner-title">{title}</TitleTag>
		{buttonOnClick ? (
			<button
				id={buttonId}
				onclick={buttonOnClick}
				class="banner-btn gtm_button"
			>{buttonText}</button>
		) : (
			<a
				id={buttonId}
				href={buttonHref}
				class="banner-btn gtm_button"
			>{buttonText}</a>
		)}
	</div>
	<Icon name={icon} width={imageWidth} height={imageHeight} class="banner-img" aria-hidden="true" />
</div>

<style lang="scss">
	.services-banner-wrap {
		position: relative;
		z-index: 1;
		padding: 46px;
		background: var(--color-bg-surface);
		border-radius: 24px;
		box-shadow: -4px 15px 50px -20px rgba(0, 0, 0, 0.15), 0 0 8px 0 rgba(0, 0, 0, 0.08);
		width: 100%;
		overflow: hidden;

		// The soft shadow disappears on a dark page, so a hairline marks the card edge.
		:global([data-theme='dark']) & {
			box-shadow: 0 0 0 1px var(--color-border);
		}
	}

	.banner-img {
		color: var(--color-primary);
		position: absolute;
		right: 46px;
		top: var(--img-top);
	}

	.banner-content {
		max-width: 600px;
	}

	.banner-title {
		font-size: 36px;
		font-weight: 500;
		line-height: 48px;
		margin-bottom: 32px;
		padding: 0;
		white-space: normal;
		color: #212121;

		:global([data-theme='dark']) & {
			color: var(--color-text);
		}
	}

	.banner-btn {
		display: inline-block;
		width: var(--btn-width);
		font-size: 20px;
		font-weight: 500;
		line-height: 28px;
		padding: 16px 24px;
		border-radius: 6px;
		text-align: center;
		white-space: normal;
		// The brand pair, outlined on hover: indigo and white in light, lavender and navy in dark.
		color: var(--color-brand-contrast);
		background-color: var(--color-brand);
		border: 1px solid var(--color-brand);
		cursor: pointer;
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s;

		&:hover {
			background-color: transparent;
			color: var(--color-brand);
			text-decoration: none;
			filter: none;
		}
	}

	@media (max-width: 1150px) {
		.banner-img { display: none; }
	}

	@media (max-width: 599px) {
		.services-banner-wrap { padding: 32px; }
		.banner-title { font-size: 28px; line-height: 40px; }
		.banner-btn { width: 100%; }
	}
</style>