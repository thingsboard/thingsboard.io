<!-- Google Tag Manager -->
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	// GTM ignores consent/config commands pushed as a plain array, so push `arguments` itself.
	window.gtag = function () {
		// eslint-disable-next-line prefer-rest-params
		window.dataLayer.push(arguments);
	};

	// Consent Mode v2 default from the banner's stored choice, everything optional denied otherwise.
	// The cookie is written by CookieConsent.astro; keep its name and version in step.
	(function () {
		let consent = null;
		try {
			const match = document.cookie.match(/(?:^|; )tb_consent=([^;]*)/);
			const value = match && JSON.parse(decodeURIComponent(match[1]));
			if (value && value.v === 1) consent = value;
		} catch {
			/**/
		}
		// Read by CookieConsent.astro, so the cookie is parsed once per page.
		window.tbConsent = consent;
		const analytics = consent && consent.analytics ? 'granted' : 'denied';
		const ads = consent && consent.marketing ? 'granted' : 'denied';
		window.gtag('consent', 'default', {
			analytics_storage: analytics,
			ad_storage: ads,
			ad_user_data: ads,
			// Never granted: the banner copy promises no remarketing audiences.
			ad_personalization: 'denied',
			functionality_storage: 'granted',
			security_storage: 'granted',
		});
		window.gtag('set', 'ads_data_redaction', true);
	})();

	// Production host only, so other hosts never report into the live property;
	// `?gtm_debug` (Tag Assistant preview) loads it anywhere.
	const gtmDebug = new URLSearchParams(location.search).has('gtm_debug');
	if (location.hostname === 'thingsboard.io' || gtmDebug) {
		const loadGtm = () => {
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				const f = d.getElementsByTagName(s)[0];
				const j = d.createElement(s);
				const dl = l !== 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-TGBNQXN');
		};

		if (gtmDebug) {
			loadGtm();
		} else {
			// 5s idle fallback (vs the 2.5s default) so tag-manager JS lands
			// after the LCP paint window for visitors who never interact.
			// Full tier schedule: DeferredLoadTrigger.astro.
			(window.__deferOnInteraction || ((cb) => cb()))(loadGtm, 5000);
		}
	}
</script>
<!-- End Google Tag Manager -->
