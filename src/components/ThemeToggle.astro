---
// Theme button that cycles auto, dark and light and saves the choice in localStorage ('starlight-theme').
// Temporary: it sits in the footers until the footer PR adds its own theme control.
---

{/* `not-content`: without it, the docs footer's `sl-markdown-content` spacing pushes the icons down. */}
<theme-toggle class="not-content">
	<button type="button" class="theme-toggle-btn" aria-label="Theme: System">
		<svg
			class="icon icon-sun"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="12" cy="12" r="5"></circle>
			<line x1="12" y1="1" x2="12" y2="3"></line>
			<line x1="12" y1="21" x2="12" y2="23"></line>
			<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
			<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
			<line x1="1" y1="12" x2="3" y2="12"></line>
			<line x1="21" y1="12" x2="23" y2="12"></line>
			<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
			<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
		</svg>
		<svg
			class="icon icon-moon"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
		<svg
			class="icon icon-auto"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
			<line x1="8" y1="21" x2="16" y2="21"></line>
			<line x1="12" y1="17" x2="12" y2="21"></line>
		</svg>
	</button>
</theme-toggle>

<script>
	declare const StarlightThemeProvider: { updatePickers: (theme: string) => void } | undefined;

	type Theme = 'auto' | 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const labels: Record<Theme, string> = { auto: 'System', dark: 'Dark', light: 'Light' };

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	const loadTheme = (): Theme => parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			// Auto is saved as '': ThemeProvider and Starlight read an empty value as "follow the system".
			localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
		}
	}

	const getPreferredColorScheme = (): Theme => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

	// The first click from auto always changes the look: to dark on a light system, to light on a dark one.
	const getThemeOrder = (): Theme[] => {
		const resolved = getPreferredColorScheme();
		return resolved === 'light' ? ['auto', 'dark', 'light'] : ['auto', 'light', 'dark'];
	};

	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
		storeTheme(theme);
		document.querySelectorAll('theme-toggle').forEach((toggle) => {
			toggle.setAttribute('data-theme', theme);
			toggle.querySelector('button')?.setAttribute('aria-label', `Theme: ${labels[theme]}`);
		});
		if (typeof StarlightThemeProvider !== 'undefined') {
			StarlightThemeProvider.updatePickers(theme);
		}
	}

	class ThemeToggle extends HTMLElement {
		constructor() {
			super();
			applyTheme(loadTheme());

			this.querySelector('button')?.addEventListener('click', () => {
				const current = parseTheme(this.getAttribute('data-theme'));
				const order = getThemeOrder();
				const nextIndex = (order.indexOf(current) + 1) % order.length;
				applyTheme(order[nextIndex]);
			});
		}
	}
	customElements.define('theme-toggle', ThemeToggle);
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	// A flex box, so the button sits in the middle of the link row instead of on the text line.
	theme-toggle {
		display: inline-flex;
		vertical-align: middle;
	}

	.theme-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		padding: 0;
		border: none;
		border-radius: $radius-sm;
		background: transparent;
		cursor: pointer;
		color: inherit;
		vertical-align: middle;

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.icon {
		width: 16px;
		height: 16px;
		display: none;
	}

	theme-toggle[data-theme='light'] .icon-sun {
		display: block;
	}

	theme-toggle[data-theme='dark'] .icon-moon {
		display: block;
	}

	// No data-theme until the script runs.
	theme-toggle:not([data-theme]) .icon-auto,
	theme-toggle[data-theme='auto'] .icon-auto {
		display: block;
	}
</style>
