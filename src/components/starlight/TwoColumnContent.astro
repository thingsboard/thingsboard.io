---
import Default from '@astrojs/starlight/components/TwoColumnContent.astro';
import FooterDocs from '@components/SiteFooter/FooterDocs.astro';

// Puts the docs footer after `<main>`, so it spans the content pane beside "On this page" without
// widening the article. `BaseLayout` pages render their own footer.
const isBaseLayout = (Astro.locals as unknown as Record<string, unknown>).bsl === true;
---

<Default>
	<slot name="right-sidebar" slot="right-sidebar" />
	<slot />
	{!isBaseLayout && <FooterDocs />}
</Default>
