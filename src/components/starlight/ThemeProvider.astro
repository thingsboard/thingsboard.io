---
// Replaces Starlight's ThemeProvider: inline scripts in <head> that set the theme before the page paints and
// handle printing. forceLightTheme pages are always light. Other pages use the choice saved by `ThemeChoice`,
// or follow the system setting, also when it changes while the page is open.
const locals = Astro.locals as unknown as Record<string, unknown>;
const forceLight = locals.bsl === true && locals.bslForceLight === true;
---

{
	forceLight ? (
		<script is:inline>
			(function () {
				document.documentElement.dataset.theme = 'light';
			})();
		</script>
	) : (
		<script is:inline>
			(() => {
				const storedTheme = () => {
					try {
						return localStorage.getItem('starlight-theme');
					} catch {
						return null;
					}
				};
				const theme =
					storedTheme() ||
					(window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
				window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
					const stored = storedTheme() ?? document.documentElement.dataset.themeChoice;
					if (stored === 'light' || stored === 'dark') return;
					document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
				});
				window.addEventListener('beforeprint', () => {
					if (document.documentElement.dataset.theme !== 'dark') return;
					document.documentElement.dataset.theme = 'light';
					document.documentElement.dataset.printRestoreTheme = 'dark';
				});
				window.addEventListener('afterprint', () => {
					if (!document.documentElement.dataset.printRestoreTheme) return;
					document.documentElement.dataset.theme = 'dark';
					delete document.documentElement.dataset.printRestoreTheme;
				});
			})();
		</script>
	)
}

<script is:inline>
	(function () {
		if (!document.getAnimations || typeof CSSTransition === 'undefined') return;
		let prePrint;
		let preScroll;
		window.addEventListener('beforeprint', () => {
			prePrint = new Set(document.getAnimations());
			preScroll = [window.scrollX, window.scrollY];
		});
		window.addEventListener('afterprint', () => {
			const seen = prePrint;
			const [x, y] = preScroll || [];
			prePrint = undefined;
			preScroll = undefined;
			if (!seen) return;
			const finishRestarted = () => {
				if (window.scrollX !== x || window.scrollY !== y) {
					window.scrollTo({ left: x, top: y, behavior: 'instant' });
				}
				for (const animation of document.getAnimations()) {
					if (seen.has(animation) || animation.playState === 'paused') continue;
					if (!(animation instanceof CSSAnimation || animation instanceof CSSTransition)) continue;
					if (animation.timeline !== document.timeline) continue;
					if (animation.effect?.getComputedTiming().iterations === Infinity) continue;
					animation.finish();
				}
			};
			finishRestarted();
			requestAnimationFrame(finishRestarted);
		});
	})();
</script>
