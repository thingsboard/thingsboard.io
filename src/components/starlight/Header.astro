---
import HeaderContent from '../Landing/HeaderContent.astro';
import PromoBanner from '../PromoBanner.astro';
import { Products } from '@models/site.models';

const pathname = Astro.url.pathname;

function getGitHubPlatform(path: string): Products {
	if (path.includes('/docs/iot-gateway/')) return Products.GW;
	if (path.includes('/docs/edge/pe/') || path.includes('/docs/edge/')) return Products.EDGE;
	if (path.includes('/docs/mqtt-broker/pe/') || path.includes('/docs/mqtt-broker/'))
		return Products.TBMQ;
	return Products.CE;
}

const gitHubPlatform = getGitHubPlatform(pathname);
---

<PromoBanner />
<HeaderContent gitHubPlatform={gitHubPlatform} />

{/* Docs hide-on-scroll: toggle .promo-hidden past the banner, restore near top
    (hysteresis avoids threshold flicker). Marketing uses .tb-topbar instead. */}
<script is:inline>
	(function () {
		const html = document.documentElement;
		let ticking = false;
		function update() {
			ticking = false;
			const y = window.scrollY;
			if (!html.classList.contains('promo-hidden')) {
				if (y > 48) html.classList.add('promo-hidden');
			} else if (y < 8) {
				html.classList.remove('promo-hidden');
			}
		}
		addEventListener(
			'scroll',
			function () {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true }
		);
		update();
	})();
</script>
