---
import HeaderContent from '../Landing/HeaderContent.astro';
import { Products } from '~/models/site.models';

const { pathname } = Astro.url;
const gitHubPlatform = pathname.includes('/docs/edge/pe/')
	? Products.EDGE_PE
	: pathname.includes('/docs/edge/')
		? Products.EDGE
		: undefined;
---

<HeaderContent gitHubPlatform={gitHubPlatform} />
