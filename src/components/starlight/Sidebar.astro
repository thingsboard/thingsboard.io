---
import Icon from '@components/starlight/Icon.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { stripLeadingAndTrailingSlashes } from '@util/path-utils';
import { hasCurrentEntry, type SidebarEntry } from '@util/sidebar';
import VersionSwitcher from '@components/VersionSwitcher.astro';
import TabbedContent from '@components/tabs/TabbedContent.astro';
import TabListItem from '@components/tabs/TabListItem.astro';
import TabPanel from '@components/tabs/TabPanel.astro';
import MobileMenuFooter from '@components/starlight/MobileMenuFooter.astro';
import { sidebarTabLinksByPrefix, type SidebarTabLinks } from '../../../astro.sidebar';

const { sidebar } = Astro.locals.starlightRoute;

// Pick tab navigation links for the current product by matching the URL prefix.
const { pathname } = Astro.url;
const tabLinks: SidebarTabLinks = sidebarTabLinksByPrefix.find(([prefix]) => pathname.startsWith(prefix))?.[1] ?? {};

// Make sure all top-level items in the sidebar are groups.
type Group = Extract<SidebarEntry, { type: 'group' }>;
function assertGroups(sidebar: SidebarEntry[]): asserts sidebar is Group[] {
	for (const entry of sidebar) {
		if (entry.type !== 'group') {
			throw new Error('Top-level links are not permitted in the docs sidebar.');
		}
	}
}
assertGroups(sidebar);

/** Convert a group label to an `id` we can use to identify tab panels. */
// The id is prefixed to avoid clashing with existing heading IDs on the page.
const makeId = (label: string) => '__tab-' + label.toLowerCase().replaceAll(/\s+/g, '-');

/** Get the icon for a group by its label. Add entries here to assign icons to specific groups. */
const iconByLabel: Record<string, string> = {
	'Getting Started': 'rocket',
	Documentation: 'information',
	Guides: 'open-book',
	Installation: 'tabler:device-imac-up',
	Recipes: 'puzzle',
	'Build with AI': 'tabler:brain',
	'APIs & SDKs': 'tabler:code',
	Reference: 'setting',
	Roadmap: 'tabler:route',
	Customization: 'tabler:puzzle',
	Configuration: 'tabler:settings-code',
	Connectors: 'tabler:plug-connected',
	Features: 'tabler:bulb',
	'Need help?': 'tabler:lifebuoy',
	Releases: 'tabler:news',
};
const fallbackIcons = ['rocket', 'open-book', 'information', 'puzzle', 'setting'] as const;
const getIcon = (label: string, index: number): string => iconByLabel[label] ?? fallbackIcons[index] ?? 'information';

// A tab is active when it contains the current page or its tab link is the current page.
const currentPath = stripLeadingAndTrailingSlashes(pathname);
const tabs = sidebar.map(({ label, entries }, index) => {
	const link = tabLinks[label];
	return {
		id: makeId(label),
		label,
		entries,
		link,
		icon: getIcon(label, index),
		active: hasCurrentEntry(entries) || (!!link && currentPath === stripLeadingAndTrailingSlashes(link)),
	};
});
---

<div class="switchers-wrapper">
	<VersionSwitcher />
</div>

<SidebarPersister>
	<TabbedContent class="tabbed-sidebar">
		<Fragment slot="tab-list">
			{
				tabs.map(({ id, label, link, icon, active }) => (
					<TabListItem id={id} initial={active} class="tab-item" link={link}>
						<Icon class="icon" name={icon} /> {label}
					</TabListItem>
				))
			}
		</Fragment>
		{
			tabs.map(({ id, entries, active }) => (
				<TabPanel id={id} initial={active}>
					<SidebarSublist sublist={entries} />
				</TabPanel>
			))
		}
	</TabbedContent>
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	.switchers-wrapper {
		display: flex;
		flex-direction: column;
		padding-bottom: 0.5rem;
	}

	/* The stable gutter stops the scrollbar from shifting content when it appears. macOS overlay
	   scrollbars reserve no gutter, so `.sidebar-content` keeps its own right padding. */
	:global(.sidebar-pane) {
		overflow-y: auto;
		scrollbar-gutter: stable;
	}

	:global(.sidebar-content) {
		padding-right: 0.5rem;
	}

	/* Styles for the custom tab switcher. */
	.tabbed-sidebar {
		/* Layout variables */
		--tab-switcher-border-width: 1px;
		--tab-switcher-padding: calc(0.25rem - var(--tab-switcher-border-width));
		--tab-item-border-radius: 0.5rem;
		--tab-switcher-border-radius: calc(
			var(--tab-item-border-radius) + var(--tab-switcher-padding) + var(--tab-switcher-border-width)
		);

		/* Color variables */
		--tab-switcher-border-color: var(--sl-color-hairline-light);
		--tab-switcher-background-color: var(--sl-color-gray-7, var(--sl-color-gray-6));
		--tab-switcher-text-color: var(--sl-color-gray-3);
		--tab-switcher-text-color--active: var(--sl-color-white);
		--tab-switcher-icon-color: var(--sl-color-gray-4);
		--tab-switcher-icon-color--active: var(--sl-color-text-accent);
		--tab-item-background-color--hover: var(--sl-color-gray-6);
		--tab-item-background-color--active: var(--sl-color-black);
	}
	/* Dark theme variations */
	:global([data-theme='dark']) .tabbed-sidebar {
		--tab-switcher-text-color: var(--sl-color-gray-2);
		--tab-switcher-icon-color: var(--sl-color-gray-3);
		--tab-item-background-color--hover: var(--sl-color-gray-5);
	}

	@media (min-width: 50rem) {
		/* Dark theme variations with the desktop sidebar visible */
		:global([data-theme='dark']) .tabbed-sidebar {
			--tab-switcher-background-color: var(--sl-color-black);
			--tab-item-background-color--hover: var(--sl-color-gray-6);
			--tab-item-background-color--active: var(--sl-color-gray-6);
		}
	}

	.tabbed-sidebar.tab-list {
		border: var(--tab-switcher-border-width) solid var(--tab-switcher-border-color);
		border-radius: var(--tab-switcher-border-radius);
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: var(--tab-switcher-padding);
		background-color: var(--tab-switcher-background-color);
		margin-bottom: 1.5rem;
	}

	.tab-item :global(a) {
		border: var(--tab-switcher-border-width) solid transparent;
		border-radius: var(--tab-item-border-radius);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: calc(0.5rem - var(--tab-switcher-border-width));
		background-clip: padding-box;
		line-height: var(--sl-line-height-headings);
		text-decoration: none;
		color: var(--tab-switcher-text-color);
		font-weight: 600;
	}

	.tab-item :global(a:hover) {
		color: var(--tab-switcher-text-color--active);
		background-color: var(--tab-item-background-color--hover);
	}
	.tab-item :global(a[aria-selected='true']) {
		border-color: var(--tab-switcher-border-color);
		color: var(--tab-switcher-text-color--active);
		background-color: var(--tab-item-background-color--active);
	}

	.icon {
		margin: 0.25rem;
		color: var(--tab-switcher-icon-color);
	}
	.tab-item :global(a:hover) .icon {
		color: inherit;
	}
	.tab-item :global(a[aria-selected='true']) .icon {
		color: var(--tab-switcher-icon-color--active);
	}
</style>
