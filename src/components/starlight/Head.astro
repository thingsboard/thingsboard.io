---
import Default from '@astrojs/starlight/components/Head.astro';
import markdownCss from '@astrojs/starlight/style/markdown.css?inline';
import layersCss from 'node_modules/@astrojs/starlight/dist/style/layers.css?inline';
import ThirdPartyScripts from '~/components/ThirdPartyScripts.astro';

const locals = Astro.locals as unknown as Record<string, unknown>;

// BaseLayout pages pass their marketing-formatted <title> via
// `Astro.locals.bslTitle`, and may opt out of the auto-emitted canonical
// link via `Astro.locals.bslNoCanonical = true`.
const bslTitle = locals.bslTitle;
if (typeof bslTitle === 'string') {
	for (const entry of Astro.locals.starlightRoute.head) {
		if (entry.tag === 'title') entry.content = bslTitle;
	}
}
if (locals.bslNoCanonical === true) {
	Astro.locals.starlightRoute.head = Astro.locals.starlightRoute.head.filter(
		(entry) => !(entry.tag === 'link' && entry.attrs && entry.attrs.rel === 'canonical')
	);
}

// Starlight's markdown.css, inlined on the pages that render `.sl-markdown-content`: every non-BaseLayout
// page, plus BaseLayout pages that pass `markdownCss`. It is not imported anywhere in the Starlight
// tree, since Astro ships imported CSS to every page in the module graph, rendered or not. This sheet
// precedes the bundled CSS, so Starlight's layer order comes first; without it `starlight.content` would
// become the lowest sublayer.
const markdownSheet = locals.bsl === true && locals.bslMarkdownCss !== true ? undefined : layersCss + markdownCss;
---

<Default {...Astro.props}><slot /></Default>
<ThirdPartyScripts />
{markdownSheet && <style is:inline set:html={markdownSheet}></style>}
