---
import Icon from '~/components/starlight/Icon.astro';
import { FORMSPREE_FEEDBACK } from '~/data/formspree';

const questions = {
	yes: [
		['Accurate', 'accurate'],
		['Easy to understand', 'easy-to-understand'],
		['Solved my problem', 'solved-my-problem'],
		['Helped me decide to use the product', 'helped-me-decide-to-use-the-product'],
		['Other', 'other-yes'],
	],
	no: [
		['Hard to understand', 'hard-to-understand'],
		['Incorrect information', 'incorrect-information'],
		['Missing information', 'missing-information'],
		['Other', 'other-no'],
	],
} as const;

const options = ['yes', 'no'] as const;

const successText = {
	sent: 'Thank you for your feedback!',
	already: "You've already sent feedback for this page. Thank you!",
};
---

<div class="feedback-prompt not-content print:hidden" data-feedback-root data-endpoint={FORMSPREE_FEEDBACK}>
	<p class="feedback-title" data-feedback-title>Was this helpful?</p>

	<div class="feedback-buttons" data-feedback-buttons>
		<button type="button" class="feedback-btn" data-option="yes">
			<Icon name="tabler:thumb-up" size="1.5rem" />
			<span>Yes</span>
		</button>
		<button type="button" class="feedback-btn" data-option="no">
			<Icon name="tabler:thumb-down" size="1.5rem" />
			<span>No</span>
		</button>
	</div>

	<form class="feedback-form" data-feedback-form hidden novalidate>

		{
			options.map((opt) => (
				<fieldset class="feedback-fieldset" data-option-fieldset={opt} hidden>
					<legend class="sr-only">
						{opt === 'yes' ? 'What did you like?' : 'What went wrong?'}
					</legend>
					<div class="feedback-reasons">
						{questions[opt].map(([label, value]) => (
							<label class="feedback-reason">
								<input
									type="radio"
									name="reason"
									value={value}
									class="feedback-reason-input"
									data-requires-comment={value.startsWith('other-') ? '' : undefined}
								/>
								<span class="feedback-reason-ring">
									<span class="feedback-reason-dot" />
								</span>
								<span class="feedback-reason-label">{label}</span>
							</label>
						))}
					</div>
				</fieldset>
			))
		}

		<label class="feedback-comment">
			<span class="sr-only">Comment</span>
			<textarea
				class="feedback-textarea"
				name="info"
				rows="2"
				placeholder="Tell us more about your experience."
				data-feedback-comment></textarea>
		</label>
		<p class="feedback-hint" data-feedback-hint hidden>A comment is required when you choose Other.</p>

		<input
			type="text"
			name="_gotcha"
			tabindex="-1"
			autocomplete="off"
			class="feedback-honeypot"
			aria-hidden="true"
		/>

		<button type="submit" class="feedback-submit" disabled>Submit</button>

		<p class="feedback-error" role="alert" data-feedback-error hidden>
			<Icon name="tabler:alert-circle-filled" size="1.125rem" />
			<span data-feedback-error-text></span>
		</p>
	</form>

	<div class="feedback-success" data-feedback-success tabindex="-1" hidden>
		<Icon name="tabler:circle-check-filled" size="1.5rem" />
		<span
			data-feedback-success-text
			data-sent={successText.sent}
			data-already={successText.already}>{successText.sent}</span>
	</div>

	<div class="sr-only" role="status" aria-live="polite" data-feedback-announce></div>
</div>

<script is:inline>
	// Before first paint, show the thank-you state for a page rated earlier (same key as below).
	(() => {
		const root = document.currentScript?.previousElementSibling;
		const path = location.pathname.replace(/\/index\.html?$/, '/').replace(/\/{2,}/g, '/');
		try {
			if (localStorage.getItem(`feedback-submitted:${path.replace(/\/?$/, '/')}`) !== '1') return;
		} catch {
			return;
		}
		const title = root?.querySelector('[data-feedback-title]');
		const buttons = root?.querySelector('[data-feedback-buttons]');
		const success = root?.querySelector('[data-feedback-success]');
		const text = root?.querySelector('[data-feedback-success-text]');
		if (!title || !buttons || !success || !text) return;
		root.dataset.feedbackState = 'success';
		title.hidden = true;
		buttons.hidden = true;
		text.textContent = text.dataset.already;
		success.hidden = false;
	})();
</script>

<script>
	type FeedbackOption = 'yes' | 'no';
	type SuccessKind = 'sent' | 'already';
	type Instance = { sync: () => void; setError: (shown: boolean) => void };

	const STORAGE_PREFIX = 'feedback-submitted:';
	const SUBMITTED_EVENT = 'feedback:submitted';
	const SEND_TIMEOUT_MS = 15_000;

	const MESSAGES = {
		error: "Couldn't send your feedback. Please try again.",
		commentMissing: 'Please add a comment before submitting.',
		requiredPlaceholder: 'Tell us more (required).',
		sending: 'Sending…',
	};

	// One key per page, with or without a trailing slash or index.html.
	const normalizePath = (path: string) =>
		path.replace(/\/index\.html?$/, '/').replace(/\/{2,}/g, '/').replace(/\/?$/, '/');

	const storageKey = STORAGE_PREFIX + normalizePath(location.pathname);
	// Raw-path per-tab flag written by older code; only read.
	const legacyKey = STORAGE_PREFIX + location.pathname;

	let submitted = false;
	let sending = false;
	let instanceCount = 0;
	const instances: Instance[] = [];

	const readFlag = (getStorage: () => Storage, key: string) => {
		try {
			return getStorage().getItem(key) === '1';
		} catch {
			return false;
		}
	};

	const writeFlag = (getStorage: () => Storage, key: string) => {
		try {
			getStorage().setItem(key, '1');
			return true;
		} catch {
			return false;
		}
	};

	const isSubmittedInSession = () =>
		readFlag(() => sessionStorage, storageKey) || readFlag(() => sessionStorage, legacyKey);

	const isSubmitted = () =>
		submitted || readFlag(() => localStorage, storageKey) || isSubmittedInSession();

	const markSubmitted = () => {
		submitted = true;
		if (!writeFlag(() => localStorage, storageKey)) writeFlag(() => sessionStorage, storageKey);
		document.dispatchEvent(new CustomEvent(SUBMITTED_EVENT));
	};

	const showSuccessFor = (root: HTMLElement, kind: SuccessKind) => {
		if (root.dataset.feedbackState === 'success') return;
		const title = root.querySelector<HTMLElement>('[data-feedback-title]');
		const buttons = root.querySelector<HTMLElement>('[data-feedback-buttons]');
		const form = root.querySelector<HTMLFormElement>('[data-feedback-form]');
		const success = root.querySelector<HTMLElement>('[data-feedback-success]');
		const text = root.querySelector<HTMLElement>('[data-feedback-success-text]');
		if (!title || !buttons || !form || !success || !text) return;
		root.dataset.feedbackState = 'success';
		title.hidden = true;
		buttons.hidden = true;
		form.hidden = true;
		text.textContent = text.dataset[kind] ?? '';
		success.hidden = false;
	};

	// A prompt that held focus passes it to its success box instead of dropping it to the page.
	const showSuccessEverywhere = (kind: SuccessKind) => {
		const active = document.activeElement;
		document.querySelectorAll<HTMLElement>('[data-feedback-root]').forEach((root) => {
			const hadFocus = !!active && root.contains(active);
			showSuccessFor(root, kind);
			if (!hadFocus) return;
			root.querySelector<HTMLElement>('[data-feedback-success]')?.focus({ preventScroll: true });
		});
	};

	// Announce and focus only in the prompt the user submitted from.
	const confirmIn = (root: HTMLElement) => {
		const success = root.querySelector<HTMLElement>('[data-feedback-success]');
		const text = root.querySelector<HTMLElement>('[data-feedback-success-text]');
		const announceEl = root.querySelector<HTMLElement>('[data-feedback-announce]');
		if (!success || success.hidden) return;
		success.focus({ preventScroll: true });
		success.scrollIntoView({ block: 'nearest' });
		// The focused box is read out already; announce only when focus didn't land.
		if (announceEl && document.activeElement !== success) announceEl.textContent = text?.textContent ?? '';
	};

	// Single module-scope listeners that mirror success state across prompts and tabs.
	document.addEventListener(SUBMITTED_EVENT, () => showSuccessEverywhere('sent'));

	window.addEventListener('storage', (e) => {
		if (e.key === storageKey && e.newValue === '1') showSuccessEverywhere('already');
	});

	window.addEventListener('pageshow', (e) => {
		if (e.persisted && isSubmitted()) showSuccessEverywhere('already');
	});

	function bind(root: HTMLElement) {
		if (root.dataset.bound) return;
		root.dataset.bound = '1';

		const endpoint = root.dataset.endpoint;
		const title = root.querySelector<HTMLElement>('[data-feedback-title]');
		const buttons = root.querySelector<HTMLElement>('[data-feedback-buttons]');
		const form = root.querySelector<HTMLFormElement>('[data-feedback-form]');
		const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
		const comment = form?.querySelector<HTMLTextAreaElement>('[data-feedback-comment]');
		const hint = form?.querySelector<HTMLElement>('[data-feedback-hint]');
		const error = form?.querySelector<HTMLElement>('[data-feedback-error]');
		const errorText = error?.querySelector<HTMLElement>('[data-feedback-error-text]');
		const announceEl = root.querySelector<HTMLElement>('[data-feedback-announce]');
		if (!endpoint || !title || !buttons || !form || !submit || !comment || !hint || !error || !errorText) {
			return;
		}

		if (isSubmitted()) {
			showSuccessFor(root, 'already');
			return;
		}

		hint.id = `feedback-${++instanceCount}-hint`;
		const submitLabel = submit.textContent ?? 'Submit';
		const optionalPlaceholder = comment.placeholder;
		const commentHint = hint.textContent ?? '';
		let chosen: FeedbackOption | null = null;

		// Only the visible list counts, never a radio the browser restored in the other one.
		const selectedReason = () =>
			chosen
				? form.querySelector<HTMLInputElement>(
						`[data-option-fieldset="${chosen}"] input[name="reason"]:checked`
					)
				: null;
		const commentRequired = () => selectedReason()?.dataset.requiresComment !== undefined;
		const hasComment = () => comment.value.trim() !== '';
		const isValid = () => !!selectedReason() && (!commentRequired() || hasComment());
		const isLocked = () => sending || submitted || root.dataset.feedbackState === 'success';
		const announce = (message: string) => {
			if (announceEl) announceEl.textContent = message;
		};

		const setCommentInvalid = (invalid: boolean) => {
			hint.textContent = invalid ? MESSAGES.commentMissing : commentHint;
			hint.classList.toggle('is-error', invalid);
			if (invalid) comment.setAttribute('aria-invalid', 'true');
			else comment.removeAttribute('aria-invalid');
		};

		// A closed form keeps its error hidden, so it can't surface on a later open.
		const setError = (shown: boolean) => {
			const visible = shown && !form.hidden;
			error.hidden = !visible;
			errorText.textContent = visible ? MESSAGES.error : '';
		};

		// `sending` is module-wide: one in-flight send locks every copy of the prompt.
		const sync = () => {
			submit.textContent = sending ? MESSAGES.sending : submitLabel;
			if (sending) submit.setAttribute('aria-busy', 'true');
			else submit.removeAttribute('aria-busy');
			submit.disabled = isLocked() || !isValid();
		};

		const update = () => {
			const required = commentRequired();
			comment.required = required;
			comment.placeholder = required ? MESSAGES.requiredPlaceholder : optionalPlaceholder;
			hint.hidden = !required;
			if (required) {
				comment.setAttribute('aria-required', 'true');
				comment.setAttribute('aria-describedby', hint.id);
			} else {
				comment.removeAttribute('aria-required');
				comment.removeAttribute('aria-describedby');
			}
			if (!required || hasComment()) setCommentInvalid(false);
			sync();
		};

		instances.push({ sync, setError });

		buttons.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-option]');
			if (!btn) return;
			chosen = btn.dataset.option as FeedbackOption;
			title.textContent = chosen === 'yes' ? 'What did you like?' : 'What went wrong?';
			buttons.hidden = true;
			form.hidden = false;
			root.querySelectorAll<HTMLFieldSetElement>('[data-option-fieldset]').forEach((fs) => {
				const active = fs.dataset.optionFieldset === chosen;
				fs.hidden = !active;
				// Keeps the other list out of the payload and clears any restored pick in it.
				fs.disabled = !active;
				if (active) return;
				fs.querySelectorAll<HTMLInputElement>('input[name="reason"]').forEach((input) => {
					input.checked = false;
				});
			});
			update();
			root
				.querySelector<HTMLInputElement>(
					`[data-option-fieldset="${chosen}"] .feedback-reason-input`
				)
				?.focus();
		});

		const onEdit = () => {
			instances.forEach((instance) => instance.setError(false));
			update();
		};
		form.addEventListener('change', onEdit);
		form.addEventListener('input', onEdit);

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!chosen || isLocked()) return;
			if (isSubmitted()) {
				showSuccessEverywhere('already');
				confirmIn(root);
				return;
			}
			setError(false);
			if (!selectedReason()) {
				root
					.querySelector<HTMLInputElement>(
						`[data-option-fieldset="${chosen}"] .feedback-reason-input`
					)
					?.focus();
				return;
			}
			if (commentRequired() && !hasComment()) {
				update();
				setCommentInvalid(true);
				comment.focus();
				return;
			}

			const hadFocus = document.activeElement === submit;
			sending = true;
			instances.forEach((instance) => {
				instance.setError(false);
				instance.sync();
			});
			// Disabling the focused button drops focus, so its new label isn't read out.
			announce(MESSAGES.sending);
			const controller = new AbortController();
			const timer = setTimeout(() => controller.abort(), SEND_TIMEOUT_MS);
			let ok = false;
			try {
				const response = await fetch(endpoint, {
					method: 'POST',
					headers: {
						Accept: 'application/json',
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({
						...Object.fromEntries(new FormData(form)),
						option: chosen,
						page: location.pathname,
					}),
					signal: controller.signal,
				});
				ok = response.ok;
			} catch {
				/* Network failure or timeout: reported below. */
			} finally {
				clearTimeout(timer);
			}
			sending = false;

			if (ok) {
				markSubmitted();
				instances.forEach((instance) => instance.sync());
				confirmIn(root);
				return;
			}

			instances.forEach((instance) => {
				instance.sync();
				instance.setError(true);
			});
			announce('');
			// Restore focus for a keyboard retry.
			if (hadFocus && document.activeElement === document.body) submit.focus({ preventScroll: true });
			error.scrollIntoView({ block: 'nearest' });
		});
	}

	const init = () => {
		// Carry a per-tab flag over so other tabs and later visits see it too.
		if (isSubmittedInSession() && !readFlag(() => localStorage, storageKey)) {
			writeFlag(() => localStorage, storageKey);
		}
		document.querySelectorAll<HTMLElement>('[data-feedback-root]').forEach(bind);
	};

	if (document.readyState !== 'loading') init();
</script>

<style lang="scss">
	/* HTML5 [hidden] is just `display: none` at user-agent level;
	   any class with `display: flex/grid` would override it, so force it. */
	.feedback-prompt [hidden] {
		display: none !important;
	}

	.feedback-prompt {
		container-type: inline-size;
		max-width: var(--feedback-max-width, 18rem);
		margin: 2rem 0 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.feedback-title {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.feedback-buttons {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	.feedback-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.25rem;
		padding: 0 0.875rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-text);
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 500;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.feedback-btn:hover {
		border-color: var(--sl-color-gray-3);
		background: var(--sl-color-gray-6, var(--sl-color-bg));
	}

	.feedback-btn :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
		font-size: 1.5rem;
		opacity: 0.75;
	}

	.feedback-success :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
		font-size: 1.5rem;
		flex-shrink: 0;
		color: var(--sl-color-text-accent);
	}

	.feedback-form {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	.feedback-fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}

	.feedback-reasons {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.feedback-reason {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.5rem 0.625rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		font-size: 0.8125rem;
		color: var(--sl-color-text);
		cursor: pointer;
		user-select: none;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.feedback-reason:hover {
		border-color: var(--sl-color-gray-3);
		background: var(--sl-color-bg-nav);
	}

	.feedback-reason:has(.feedback-reason-input:checked) {
		border-color: var(--sl-color-text-accent);
	}

	.feedback-reason:has(.feedback-reason-input:focus-visible) {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	.feedback-reason-input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		cursor: pointer;
		margin: 0;
	}

	.feedback-reason-ring {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
		border: 1px solid var(--sl-color-gray-3);
		border-radius: 50%;
		transition: border-color 0.15s ease, border-width 0.15s ease;
	}

	.feedback-reason:has(.feedback-reason-input:checked) .feedback-reason-ring {
		border-color: var(--sl-color-text-accent);
		border-width: 2px;
	}

	.feedback-reason-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--sl-color-text-accent);
		transform: scale(0);
		transition: transform 0.15s ease;
	}

	.feedback-reason:has(.feedback-reason-input:checked) .feedback-reason-dot {
		transform: scale(1);
	}

	.feedback-reason-label {
		line-height: 1.3;
	}

	.feedback-comment {
		display: block;
	}

	.feedback-textarea {
		display: block;
		width: 100%;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		font: inherit;
		font-size: 0.8125rem;
		resize: vertical;
		min-height: 4rem;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.feedback-textarea::placeholder {
		color: var(--sl-color-gray-3);
	}

	.feedback-textarea:focus {
		outline: none;
		border-color: var(--sl-color-text-accent);
		box-shadow: 0 0 0 1px var(--sl-color-text-accent);
	}

	.feedback-textarea[aria-invalid='true'] {
		border-color: var(--sl-color-red);
	}

	.feedback-textarea[aria-invalid='true']:focus {
		box-shadow: 0 0 0 1px var(--sl-color-red);
	}

	.feedback-hint {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--sl-color-gray-3);
	}

	.feedback-hint.is-error {
		color: var(--sl-color-red-high);
	}

	.feedback-honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.feedback-submit {
		align-self: flex-start;
		height: 2rem;
		padding: 0 1rem;
		border: 0;
		border-radius: 0.5rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-bg);
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 500;
		cursor: pointer;
		transition: opacity 0.15s ease;
	}

	.feedback-submit:hover:not(:disabled) {
		opacity: 0.9;
	}

	.feedback-submit:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.feedback-submit[aria-busy='true']:disabled {
		opacity: 1;
		cursor: progress;
	}

	.feedback-error {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-red);
		border-radius: 0.5rem;
		background: var(--sl-color-red-low);
		color: var(--sl-color-red-high);
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	.feedback-error :global(svg) {
		width: 1.125rem;
		height: 1.125rem;
		font-size: 1.125rem;
		flex-shrink: 0;
	}

	.feedback-success {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: 0.75rem;
		padding: 0.75rem 0.875rem;
		border: 1px solid var(--sl-color-green);
		border-radius: 0.5rem;
		background: var(--sl-color-green-low);
		color: var(--sl-color-green-high);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.feedback-success:focus-visible {
