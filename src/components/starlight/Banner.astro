---
import type { Announcement } from '~/types/announcement';

const data = Astro.locals.starlightRoute.entry.data as { announcement?: Announcement };
const a = data.announcement;
const expired = a?.expiresAt ? new Date(a.expiresAt).getTime() < Date.now() : false;
const show = !!a && !expired;
---

{show && a && (
	<aside
		class="tb-docs-banner"
		data-variant={a.variant}
		data-banner-id={a.id}
		data-banner-version={String(a.version)}
		aria-label="Site announcement"
		hidden
	>
		<div class="tb-docs-banner__inner">
			{a.icon && (
				<span class="tb-docs-banner__icon" aria-hidden="true">
					{a.variant === 'info' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
					)}
					{a.variant === 'success' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
					)}
					{a.variant === 'warning' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>
					)}
					{a.variant === 'promo' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
					)}
				</span>
			)}
			<div class="tb-docs-banner__text">
				{a.eyebrow && <strong class="tb-docs-banner__eyebrow">{a.eyebrow}</strong>}
				{a.eyebrow && <span class="tb-docs-banner__sep" aria-hidden="true">—</span>}
				<span class="tb-docs-banner__message" set:html={a.message} />
			</div>
			{a.cta && (
				<a class="tb-docs-banner__cta" href={a.cta.href}>{a.cta.text}</a>
			)}
			{a.dismissible && (
				<button type="button" class="tb-docs-banner__close" aria-label="Dismiss announcement">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
				</button>
			)}
		</div>
	</aside>
)}

{show && a?.dismissible !== false && (
	<script is:inline>
		(() => {
			const el = document.querySelector('.tb-docs-banner');
			if (!el) return;
			const id = el.dataset.bannerId;
			const version = Number(el.dataset.bannerVersion);
			if (!id || !Number.isFinite(version)) {
				el.hidden = false;
				return;
			}
			const KEY = 'tb-docs-banner-dismissed';
			let store = {};
			try {
				store = JSON.parse(localStorage.getItem(KEY) || '{}');
			} catch (_) {
				/* malformed / unavailable */
			}
			if (typeof store[id] === 'number' && store[id] >= version) return;
			el.hidden = false;
			const closeBtn = el.querySelector('.tb-docs-banner__close');
			if (!closeBtn) return;
			closeBtn.addEventListener('click', () => {
				el.hidden = true;
				try {
					store[id] = version;
					localStorage.setItem(KEY, JSON.stringify(store));
				} catch (_) {
					/* storage unavailable — in-page only */
				}
			});
		})();
	</script>
)}

{show && a?.dismissible === false && (
	<script is:inline>
		(() => {
			const el = document.querySelector('.tb-docs-banner');
			if (el) el.hidden = false;
		})();
	</script>
)}

<style>
	.tb-docs-banner {
		--banner-color: var(--color-primary);
		border: 1px solid color-mix(in srgb, var(--banner-color) 20%, transparent);
		background: color-mix(in srgb, var(--banner-color) 5%, transparent);
		border-radius: 6px;
		padding: 0.5rem 0.75rem;
		margin: 0.75rem 1rem 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--color-text);
	}

	.tb-docs-banner[data-variant='success'] {
		--banner-color: var(--color-product-tbmq);
	}

	.tb-docs-banner[data-variant='warning'] {
		--banner-color: #f59e0b;
	}

	.tb-docs-banner[data-variant='promo'] {
		--banner-color: var(--color-product-cloud);
	}

	.tb-docs-banner__inner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tb-docs-banner__icon {
		color: var(--banner-color);
		display: inline-flex;
		flex: 0 0 auto;
	}

	.tb-docs-banner__text {
		flex: 1 1 auto;
		min-width: 0;
	}

	.tb-docs-banner__eyebrow {
		font-weight: 600;
		color: var(--color-text);
	}

	.tb-docs-banner__sep {
		margin-inline: 0.35em;
		color: var(--color-text-secondary);
	}

	.tb-docs-banner__cta {
		margin-inline-start: auto;
		color: var(--banner-color);
		font-weight: 500;
		text-decoration: none;
		flex: 0 0 auto;
	}

	.tb-docs-banner__cta:hover {
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--banner-color) 60%, transparent);
		text-underline-offset: 2px;
	}

	.tb-docs-banner__cta::after {
		content: ' \2192';
	}

	.tb-docs-banner__close {
		appearance: none;
		background: transparent;
		border: 0;
		padding: 0.25rem;
		color: var(--color-text-secondary);
		cursor: pointer;
		line-height: 0;
		border-radius: 0.25rem;
		flex: 0 0 auto;
	}

	.tb-docs-banner__close:hover {
		color: var(--color-text);
		background: var(--color-bg-muted);
	}

	.tb-docs-banner__close:focus-visible {
		outline: 2px solid var(--banner-color);
		outline-offset: 2px;
	}

	@media (max-width: 30rem) {
		.tb-docs-banner {
			margin: 0.5rem 0.5rem 0;
		}
		.tb-docs-banner__cta {
			margin-inline-start: 0;
		}
	}
</style>
