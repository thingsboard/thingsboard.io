---
import CompactFooter from '@components/Landing/CompactFooter.astro';
import DocFooter from '~/components/starlight/DocFooter.astro';
import LandingFooter from '~/components/Landing/Footer.astro';

// Proxy in front of the actual Starlight footer chrome. Pages
// rendered through `BaseLayout` set `Astro.locals.bsl = true`
// to opt into the marketing footer (`Landing/Footer`); everything else
// gets the docs footer (`DocFooter`). `BaseLayout chrome="minimal"` pages
// get the compact footer the docs pages end with (`Landing/CompactFooter`).
// Each branch is a separate component so only the styles of the chosen
// variant land in the route's CSS bundle — there's no per-page cost for the
// unused one.
const locals = Astro.locals as unknown as Record<string, unknown>;
const isBaseStarlight = locals.bsl === true;
const minimal = locals.bslChrome === 'minimal';
---

{minimal ? (
	<div class="compact-footer-frame">
		<CompactFooter />
	</div>
) : isBaseStarlight ? (
	<LandingFooter />
) : (
	<DocFooter />
)}

<style lang="scss">
	@use '../../styles/variables' as *;

	// BaseLayout zeroes Starlight's content padding, so the frame puts the footer on the page container.
	// The frame continues the page's side rules (`UseCaseLayout`) and carries the footer's top rule, so
	// the two meet at the corners instead of the top rule stopping short at the container padding.
	.compact-footer-frame {
		@include container;
		border: 1px solid var(--color-border);
		border-bottom: 0;

		:global(.doc-footer) {
			border-top: 0;
		}
	}
</style>
