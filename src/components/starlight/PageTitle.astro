---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Badge from '~/components/Badge.astro';

const { data } = Astro.locals.starlightRoute.entry;
const pageBadge = data.sidebar?.badge as
	| {
			text: string;
			variant?: 'note' | 'danger' | 'success' | 'caution' | 'tip' | 'default';
			class?: string;
	  }
	| undefined;
---

{
	pageBadge ? (
		<div class="title-wrapper">
			<Default>
				<slot />
			</Default>
			<Badge
				text={pageBadge.text}
				variant={pageBadge.variant}
				class={pageBadge.class}
				size="medium"
			/>
		</div>
	) : (
		<Default>
			<slot />
		</Default>
	)
}

<style>
	.title-wrapper {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
	}
</style>
