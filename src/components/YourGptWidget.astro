---
import { Icon } from 'astro-icon/components';
import { CHAT_HUE_CSS, LAUNCHER_LABEL } from '@data/chat-widget';

// Our launcher for the YourGPT chat, mounted once per page from `starlight/SkipLink.astro`. Nothing loads from
// yourgpt.ai until it is clicked (`util/chat-widget`). The chat window's look is the YourGPT dashboard's.
---

<style set:html={CHAT_HUE_CSS}></style>

<button
	type="button"
	id="chat-launcher"
	class="chat-launcher print:hidden"
	aria-label={LAUNCHER_LABEL}
	title={LAUNCHER_LABEL}
	aria-expanded="false"
>
	<Icon name="question-bold" class="chat-launcher__glyph chat-launcher__glyph--rest" aria-hidden="true" />
	<Icon name="tabler:chevron-down" class="chat-launcher__glyph chat-launcher__glyph--open" aria-hidden="true" />
</button>
{/* Remembers a click that lands before the module script below is ready. */}
<script is:inline>
	document.currentScript.previousElementSibling.addEventListener(
		'click',
		(e) => (e.currentTarget.dataset.clicked = ''),
		{ once: true }
	);
</script>
<span id="chat-launcher-status" class="chat-launcher-status print:hidden" role="status"></span>

<script>
	import { wireChatLauncher } from '@util/chat-widget';

	const launcher = document.getElementById('chat-launcher') as HTMLButtonElement | null;
	const status = document.getElementById('chat-launcher-status');
	if (launcher && status) wireChatLauncher(launcher, status);
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	.chat-launcher {
		// The 16px inset and 44px size must match the YourGPT dashboard's Size & Position, which opens the chat
		// window over this launcher. The variable is the window's own, so `scroll-lock.ts` shifts both alike.
		--yourgptChatbotPositionX: 16px;
		--chat-hue: var(--chat-hue-0);

		position: fixed;
		right: var(--yourgptChatbotPositionX);
		bottom: 16px;
		// One under their root's, which clamps to the 32-bit maximum: open on a phone, their window covers it.
		z-index: 2147483646;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		color: var(--chat-hue);
		background: #fff;
		border: 0;
		border-radius: 50%;
		box-shadow:
			0 1px 3px rgba(23, 24, 28, 0.08),
			0 6px 16px -6px rgba(23, 24, 28, 0.16),
			0 12px 28px -8px color-mix(in srgb, var(--chat-hue) 60%, transparent);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition:
			transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.2s ease;

		&:hover {
			transform: translateY(-2px);
			box-shadow:
				0 1px 3px rgba(23, 24, 28, 0.08),
				0 10px 20px -6px rgba(23, 24, 28, 0.18),
				0 16px 34px -8px color-mix(in srgb, var(--chat-hue) 80%, transparent);
		}

		&:active {
			transform: scale(0.97);
		}

		&:focus-visible {
			outline: 2px solid var(--chat-hue);
			outline-offset: 3px;
		}

		&[aria-busy='true'] {
			cursor: progress;
		}

		// While the chat loads: an arc round the disc, from 300ms so a fast load never shows it.
		&::before {
			content: '';
			position: absolute;
			inset: -4px;
			border: 2px solid transparent;
			border-top-color: var(--chat-hue);
			border-radius: 50%;
			opacity: 0;
			transition: opacity 0.2s ease;
		}

		&[data-loading]::before {
			opacity: 1;
			transition-delay: 0.3s;
		}

		// Beside the cookie card (20px in, min(340px, 100vw - 40px) wide) there is no room under 432px: the
		// launcher steps out until a choice is made.
		@media (width < 432px) {
			:global(:root:has(#cc-main .cm:not([hidden]))) & {
				visibility: hidden;
			}
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.chat-launcher {
			animation: var(--chat-anim) var(--chat-cycle) linear infinite;
		}

		.chat-launcher[data-loading]::before {
			animation: chat-launcher-spin 0.9s linear infinite;
		}
	}

	@keyframes chat-launcher-spin {
		to {
			transform: rotate(360deg);
		}
	}

	// Beside the launcher: a slow load says what it is waiting for after 3s, a failed one says so at once.
	.chat-launcher-status {
		@include text-s;

		position: fixed;
		// The launcher's inset and width, and 8px between.
		right: 68px;
		bottom: 22px;
		z-index: 2147483646;
		padding: 4px 12px;
		// The launcher's white in both themes, so the ink is fixed too.
		color: #17181c;
		white-space: nowrap;
		background: #fff;
		border-radius: $radius-full;
		box-shadow: 0 6px 16px -6px rgba(23, 24, 28, 0.2);
		// Hidden by opacity alone: a live region under `visibility: hidden` is not announced.
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;

		&[data-state='loading'],
		&[data-state='error'] {
			opacity: 1;
		}

		&[data-state='loading'] {
			transition-delay: 3s;
		}
	}

	.chat-launcher__glyph {
		grid-area: 1 / 1;
		width: 24px;
		height: 24px;
		transition:
			opacity 0.2s ease,
			transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.chat-launcher__glyph--open {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}

	.chat-launcher[aria-expanded='true'] {
		.chat-launcher__glyph--rest {
			opacity: 0;
			transform: rotate(90deg) scale(0.6);
		}

		.chat-launcher__glyph--open {
			opacity: 1;
			transform: none;
		}
	}
</style>
