<script is:inline>
	window.YGC_WIDGET_ID = '388b06d9-9f7f-4125-81e7-0cd963efb031';

	const CHATBOT_FLAG = 'tb:chatbot-opened';

	const injectWidget = () => {
		const script = document.createElement('script');
		script.src = 'https://widget.yourgpt.ai/script.js';
		script.id = 'yourgpt-chatbot';
		script.async = true;
		document.body.appendChild(script);
	};

	// Once the widget mounts, watch for the user actually clicking it. That's
	// a much stronger intent signal than the generic "first interaction on
	// the site" flag from DeferredLoadTrigger. When set, the next page nav
	// loads the widget eagerly so the bubble re-appears instantly.
	const trackChatbotEngagement = () => {
		const detector = (e) => {
			const t = e.target;
			if (!t || typeof t.closest !== 'function') return;
			if (t.closest('#yourgpt-chatbot, [class*="ygpt-"], [class*="yourgpt-"]')) {
				try { sessionStorage.setItem(CHATBOT_FLAG, '1'); } catch { /* ignore */ }
				document.removeEventListener('pointerdown', detector, true);
			}
		};
		document.addEventListener('pointerdown', detector, true);
	};

	const loadWidget = () => {
		(window.requestIdleCallback || ((cb) => setTimeout(cb, 200)))(() => {
			injectWidget();
			trackChatbotEngagement();
		});
	};

	let alreadyOpenedChat = false;
	try { alreadyOpenedChat = sessionStorage.getItem(CHATBOT_FLAG) !== null; } catch { /* ignore */ }

	// Users who've opened chat once in this session get the eager path on
	// subsequent navs — bubble appears immediately. Everyone else stays on
	// the strict path so the widget's Inter font CSS doesn't land on the
	// LCP-critical chain on first impression — see DeferredLoadTrigger.astro.
	if (alreadyOpenedChat) {
		(window.__deferOnInteraction || ((cb) => cb()))(loadWidget, 10000);
	} else {
		(window.__deferUntilInteraction || window.__deferOnInteraction || ((cb) => cb()))(loadWidget, 10000);
	}
</script>
