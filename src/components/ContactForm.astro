---
import FormGuardFields from '@components/FormGuardFields.astro';
import TrackingFields from '@components/TrackingFields.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Field from '@components/ui/Field.astro';
import Select from '@components/ui/Select.astro';
import { CONTACT_TOPICS, DEFAULT_PROMPT, LINKED_TOPICS } from '@data/contact-form';

/**
 * The Contact us form. It posts natively to Formspree, which sends the reader on to the thank-you page
 * (`_next`). `?subject=` sets the topic and hides the field, `?message=` prefills the message, and
 * `?resend` restores the last message sent from this tab.
 */

interface Props {
	/** The id of the privacy line the page shows, read out with the submit button. */
	describedBy?: string;
}

const { describedBy } = Astro.props;

// The placeholder is disabled and hidden, so it shows until a topic is chosen and is never in the list.
const TOPIC_OPTIONS = [
	{
		value: '',
		label: 'Choose a topic',
		selected: true,
		placeholder: true,
		attrs: { disabled: 'disabled', hidden: 'hidden' },
	},
	...CONTACT_TOPICS.map(({ value, label }) => ({ value, label })),
];

// The message placeholder for each topic, the link-only ones too. The scripts read it off the form.
const PROMPTS = Object.fromEntries([
	['', DEFAULT_PROMPT],
	...[...CONTACT_TOPICS, ...LINKED_TOPICS].map(({ value, prompt }) => [value, prompt]),
]);
---

<Card
	as="form"
	role="panel"
	class="cf contact-form gtm_form print:hidden"
	attrs={{
		id: 'ContactUs',
		method: 'post',
		novalidate: 'novalidate',
		'aria-labelledby': 'contact-title',
		'data-prompts': JSON.stringify(PROMPTS),
	}}
>
	<h2 class="cf__title" id="contact-title">
		Send us a message
	</h2>
	<fieldset class="cf__fields">
		<legend class="ui-sr">Your details and message</legend>
		<Field name="name" label="Name" maxLength={100} autocomplete="name" attrs={{ autocapitalize: 'words' }} />
		<Field
			name="email"
			label="Work email"
			type="email"
			maxLength={80}
			autocomplete="email"
			inputmode="email"
			attrs={{ autocapitalize: 'off', autocorrect: 'off', spellcheck: 'false' }}
		/>
		<Field name="company" label="Company" maxLength={80} autocomplete="organization" class="cf__full" />

		<Select name="subject" label="What’s it about?" options={TOPIC_OPTIONS} optional class="cf__topic" />

		<Field
			name="message"
			label="How can we help?"
			type="textarea"
			placeholder={DEFAULT_PROMPT}
			maxLength={3000}
			counter
			class="cf__full"
		/>

		<TrackingFields />
		<input type="hidden" name="tags" id="tags" value="product" />
		<input type="hidden" name="form_id" id="form_id" value="contact_us" />
		<input type="hidden" name="path" id="path" value="" />
		<input type="hidden" name="_next" value="/contact-us-thanks/" />
		<input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
		<FormGuardFields id="contact-hp" />
	</fieldset>

	<div class="cf__actions">
		<Button
			type="submit"
			size="lg"
			class="gtm_button"
			attrs={{ id: 'ContactUs_Submit', style: '--btn-min-w: 200px', 'aria-describedby': describedBy }}
		>
			Send message
		</Button>
	</div>
</Card>

{/*
	Inline, so a link with a topic (?subject=, ?pcorder, ?message=) never shows the default form first.
	A link-only topic is not in the list, so it is added here; the field is hidden with it anyway.
	An order link is always about Private Cloud, also when it names no topic. `hasOwnProperty.call`, not
	`Object.hasOwn`: this script ships as written, and older Safari has no `Object.hasOwn`.
*/}
<script is:inline>
	(() => {
		const form = document.getElementById('ContactUs');
		if (!form) return;
		const params = new URLSearchParams(window.location.search);
		const prompts = JSON.parse(form.dataset.prompts || '{}');

		if (params.has('pcorder')) form.dataset.variant = 'order';

		const subject = params.get('subject') || (params.has('pcorder') ? 'Private Cloud' : null);
		const select = form.elements.namedItem('subject');
		if (subject && select && Object.prototype.hasOwnProperty.call(prompts, subject)) {
			if (![...select.options].some((option) => option.value === subject)) {
				select.add(new Option(subject, subject));
			}
			select.value = subject;
			form.dataset.topic = 'linked';
			form.elements.namedItem('message').placeholder = prompts[subject];
		}

		const message = params.get('message');
		if (message) form.elements.namedItem('message').value = message;
	})();
</script>

<script>
	import { CONTACT_SENT_FIELDS, CONTACT_US_SENT_KEY, type SentContact } from '@data/contact-form';
	import { FORMSPREE_CONTACT } from '@data/formspree';
	import {
		armHoneypot,
		bindTrackingFields,
		EMAIL_PATTERN,
		guardSubmitWith,
		stampRenderedAt,
		XSS_PATTERN,
	} from '@util/form-guard';
	import { validateAll, wireCounter, wireValidation, type FieldControl, type Problem } from '@util/form-validate';
	import { readSent, storeSent } from '@util/sent-form';

	const REQUIRED: Record<string, string> = {
		name: 'Enter your name.',
		email: 'Enter your email so we can reply.',
		company: 'Enter your company. Working on your own? Your name is fine.',
		message: 'Tell us a little about what you need.',
	};

	function check(el: FieldControl): Problem {
		const value = el.value.trim();
		if (value === '') return { kind: 'required', message: REQUIRED[el.name] };
		if (el.name === 'email' && !EMAIL_PATTERN.test(value)) {
			return { kind: 'format', message: 'Enter an email like name@company.com.' };
		}
		if (XSS_PATTERN.test(value)) return { kind: 'format', message: 'Remove any HTML or script tags.' };
		return null;
	}

	function init(form: HTMLFormElement) {
		const control = <T extends Element>(name: string) => form.elements.namedItem(name) as T | null;
		const select = control<HTMLSelectElement>('subject');
		const message = control<HTMLTextAreaElement>('message');
		const submit = form.querySelector<HTMLButtonElement>('#ContactUs_Submit');
		if (!select || !message) return;

		const prompts: Record<string, string> = JSON.parse(form.dataset.prompts || '{}');
		const applyTopic = () => {
			message.placeholder = prompts[select.value] ?? prompts[''] ?? '';
		};

		form.action = FORMSPREE_CONTACT;
		stampRenderedAt(form);
		armHoneypot(form);

		const restored = new URLSearchParams(window.location.search).has('resend')
			? readSent<SentContact>(CONTACT_US_SENT_KEY)
			: null;
		if (restored) {
			CONTACT_SENT_FIELDS.forEach((name) => {
				const el = control<FieldControl | HTMLSelectElement>(name);
				if (el && typeof restored[name] === 'string') el.value = restored[name];
			});
			if (select.selectedIndex < 0) select.value = '';
		}

		applyTopic();
		select.addEventListener('change', applyTopic);
		wireCounter(message);
		if (restored) {
			const email = control<HTMLInputElement>('email');
			email?.focus();
			email?.select();
		}

		const fields = Object.keys(REQUIRED)
			.map((name) => control<FieldControl>(name))
			.filter((el): el is FieldControl => !!el);
		const markAttempted = wireValidation(fields, check);

		guardSubmitWith(form, () => {
			markAttempted();
			return validateAll(fields, check);
		});
		// After the guard: only a submit it let through is on its way.
		form.addEventListener('submit', (event) => {
			if (event.defaultPrevented) return;
			const sent = {
				at: Date.now(),
				order: form.dataset.variant === 'order',
				linked: form.dataset.topic === 'linked',
			} as SentContact;
			// Trimmed in the field too, so the post carries no stray spaces.
			CONTACT_SENT_FIELDS.forEach((name) => {
				const el = control<FieldControl | HTMLSelectElement>(name);
				if (el && !(el instanceof HTMLSelectElement)) el.value = el.value.trim();
				sent[name] = el?.value ?? '';
			});
			storeSent(CONTACT_US_SENT_KEY, sent);
			// Disabled, so an answer left empty is not in the post at all.
			if (select.value === '') select.disabled = true;
			if (submit) submit.disabled = true;
		});

		// Back or a reload can bring the page back as it was left, mid-send, with the browser's own values.
		window.addEventListener('pageshow', () => {
			if (submit) submit.disabled = false;
			select.disabled = false;
			applyTopic();
		});

		const path = control<HTMLInputElement>('path');
		if (path) path.value = window.location.pathname;

		window.dataLayer = window.dataLayer || [];
		window.dataLayer.push({ event: 'contact-us', ...bindTrackingFields(form) });
	}

	const form = document.querySelector<HTMLFormElement>('#ContactUs');
	if (form) init(form);
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	.cf {
		margin: 0;

		:where(p, h2) {
			margin: 0;
		}
	}

	.cf__title {
		@include type-card;
		margin-bottom: $spacing-5;
		color: var(--color-text);
	}

	.cf__fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-4;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.cf__full,
	.cf__topic {
		grid-column: 1 / -1;
	}

	// The link has already set the topic.
	.cf[data-topic='linked'] .cf__topic,
	.cf[data-variant='order'] .cf__topic {
		display: none;
	}

	.cf__actions {
		display: flex;
		margin-top: $spacing-6;

		@include media-down(md) {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
