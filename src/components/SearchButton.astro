---
import { Icon } from 'astro-icon/components';
import Kbd from '@components/ui/Kbd.astro';

/**
 * The header's search button, which opens `SiteSearch`: a 40px icon square that widens into a 152px
 * field-style button with the Ctrl K hint from `$search-field-from`. 1300px is where the wide button
 * still fits next to the desktop menu; check it again if the menu gets longer.
 */
---

<search-button>
	<button type="button" class="search-toggle-btn" aria-label="Search" aria-keyshortcuts="Control+K Meta+K /">
		<Icon name="tabler:search" aria-hidden="true" />
		<span class="search-toggle-btn__label" aria-hidden="true">
			Search
		</span>
		{/* Rendered as "Ctrl K"; on Apple devices the `SiteSearch` script changes it to "⌘K". */}
		<Kbd class="search-toggle-btn__kbd">Ctrl K</Kbd>
	</button>
</search-button>

<style lang="scss" is:global>
	@use '../styles/variables' as *;

	$search-field-from: 1300px;

	.head-buttons .search-toggle-btn {
		--btn-px: 0px;

		width: 40px;
		font-weight: $font-weight-normal;

		svg {
			width: 20px;
			height: 20px;
			flex: none;
		}
	}

	.search-toggle-btn__label,
	.search-toggle-btn__kbd {
		display: none;
	}

	@media screen and (min-width: $search-field-from) {
		.head-buttons .search-toggle-btn {
			width: 152px;
			justify-content: flex-start;
			padding: 0 8px 0 12px;

			svg {
				width: 16px;
				height: 16px;
				opacity: 0.8;
			}
		}

		.search-toggle-btn__label {
			display: inline;
			opacity: 0.8;
		}

		.search-toggle-btn__kbd {
			display: inline-flex;
			margin-left: auto;
		}
	}
</style>
