---
import SiteMenuSection from '@components/SiteMenu/SiteMenuSection.astro';
import SiteMenuPromos from '@components/SiteMenu/SiteMenuPromos.astro';
import type { MenuSection } from '@components/SiteMenu/menu-model';

/**
 * One menu section's content: a heading, the link groups and the promo links. It is rendered once, in
 * the mobile menu sheet; on wide screens `SiteMenu`'s script moves the `[data-sm-body]` part into the
 * desktop menu panel.
 */
interface Props {
	entry: MenuSection;
	/** The heading's id. The heading sits outside `[data-sm-body]`, so it stays in the sheet. */
	titleId: string;
}

const {
	entry: { item, sub },
	titleId,
} = Astro.props;
---

<div class="sm__head">
	<p class="sm__title" id={titleId}>
		{item.label}
	</p>
</div>
<div class="sm__body" data-sm-body={sub.id}>
	<SiteMenuSection submenu={sub} sectionName={item.label} />
	<SiteMenuPromos section={sub.id} />
</div>
