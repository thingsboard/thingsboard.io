---
import { Icon } from 'astro-icon/components';
import NavIcon from '@components/Landing/NavIcon.astro';
import { MENU_BADGES, badgeGlyphSize, badgeStyle } from '@data/product-badges';
import type { SubMenu, SubMenuGroup } from '@data/navigation';
import { externalLinkAttrs, isExternalHref, newTabLinkLabel } from '@util/external-links';

/**
 * One menu section's link groups. Each group's links are one `<ul>`, even when the CSS splits them into
 * columns, so a screen reader announces one list instead of several.
 */
interface Props {
	submenu: SubMenu;
	sectionName: string;
}

const { submenu, sectionName } = Astro.props;
// `SiteMenuBody` sets `--sm-mark`, the same size, for the links and the bar under them.
const iconSize = submenu.iconSize ?? 24;
const repeatsSectionName = (groupName: string) => groupName.toLowerCase() === sectionName.toLowerCase();

const MAX_COLUMNS = 3;
// Rows per column: `perColumn`, raised when needed so a list never takes more than `MAX_COLUMNS` columns.
const rowsPerColumn = ({ items, perColumn }: SubMenuGroup) =>
	Math.max(perColumn ?? items.length, Math.ceil(items.length / MAX_COLUMNS));
---

<div class="sm__groups">
	{submenu.groups.map((group) => (
		<div>
			{group.name && (
				<p class="sm__group-name" data-sm-same={repeatsSectionName(group.name) || undefined}>
					{group.name}
				</p>
			)}
			<ul class="sm__cols" style={`--rows: ${rowsPerColumn(group)}`}>
				{group.items.map((item) => {
					const badge = item.badge && MENU_BADGES[item.badge];
					const glyphSize = item.badge ? badgeGlyphSize(item.badge, iconSize) : undefined;
					const badgeCss = item.badge ? badgeStyle(item.badge, iconSize) : undefined;
					return (
						<li>
							<a
								class:list={['sm__link', item.linkClass]}
								href={item.href}
								aria-label={isExternalHref(item.href) ? newTabLinkLabel(item.heading, item.href) : undefined}
								{...externalLinkAttrs(item.href)}
							>
								{item.logo ? (
									<span class="sm__link-logo">
										<img
											src={item.logo}
											alt={item.heading}
											style={item.logoHeight ? `--sm-logo-h: ${item.logoHeight}px` : undefined}
											loading="lazy"
											decoding="async"
										/>
									</span>
								) : (
									<Fragment>
										{badge ? (
											<span class="sm__link-icon">
												<span
													class:list={['sm__badge', `sm__badge--${badge.fill}`]}
													style={badgeCss}
												>
													<NavIcon src={badge.glyph} size={glyphSize} alt="" />
												</span>
											</span>
										) : (
											item.icon && (
												<span class="sm__link-icon">
													<NavIcon src={item.icon} size={iconSize} alt="" />
												</span>
											)
										)}
										<span class="sm__link-text">
											<span class="sm__link-heading">
												{item.heading}
												{isExternalHref(item.href) && (
													<Icon name="tabler:arrow-up-right" size={14} aria-hidden="true" />
												)}
											</span>
											{item.description && <span class="sm__link-desc">{item.description}</span>}
										</span>
									</Fragment>
								)}
							</a>
						</li>
					);
				})}
			</ul>
			{group.more && (
				<a class="sm__more" href={group.more.href}>
					{group.more.label}
					<Icon name="tabler:chevron-right" aria-hidden="true" />
				</a>
			)}
		</div>
	))}
</div>
