---
// Native modal <dialog> with a title, close button and the form-modal card; `data-modal-open="<id>"` opens it.
// Slots: `intro` under the title (`tb-modal__lead` / `tb-modal__note` style it) and the body.
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'dialog'>, 'id' | 'title'> {
	id: string;
	title: string;
}

const { id, title, class: className, ...attrs } = Astro.props;
const titleId = `${id}-title`;
---

<dialog id={id} class:list={['tb-modal', className]} aria-labelledby={titleId} data-modal {...attrs}>
	<div class="tb-modal__panel">
		<div class="tb-modal__header">
			<h2 class="tb-modal__title" id={titleId}>
				{title}
			</h2>
			<button type="button" class="tb-modal__close" data-modal-close aria-label="Close">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
		<slot name="intro" />
		<slot />
	</div>
</dialog>

<script>
	import { bindModalDialog } from '@util/modal-dialog';

	for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[data-modal]')) {
		const modal = bindModalDialog(dialog);
		dialog.querySelector('[data-modal-close]')?.addEventListener('click', () => modal.close());
	}

	for (const trigger of document.querySelectorAll('[data-modal-open]')) {
		trigger.setAttribute('aria-haspopup', 'dialog');
	}

	document.addEventListener('click', (e) => {
		const trigger = (e.target as Element).closest<HTMLElement>('[data-modal-open]');
		const dialog = trigger && document.getElementById(trigger.dataset.modalOpen!);
		if (!(dialog instanceof HTMLDialogElement) || !dialog.hasAttribute('data-modal')) return;
		e.preventDefault();
		bindModalDialog(dialog).open();
	});
</script>

<style lang="scss">
	@use '../styles/variables' as *;
	@use '../styles/form-modal' as *;

	// A transparent viewport-filling box around the panel, so only a backdrop click lands on the dialog
	// itself. The UA hides a closed dialog with `display: none`, so `display` is set on `[open]` only.
	.tb-modal {
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;

		&[open] {
			display: grid;
			place-items: center;
		}

		&::backdrop {
			background: rgba($color-black, 0.4);
		}

		// Intro text classes for the caller's slotted markup, which carries the caller's scope, not ours.
		:global(.tb-modal__lead) {
			@include text-m;
			color: var(--color-text-secondary);
			margin: 0;
		}

		:global(.tb-modal__note) {
			@include text-s;
			color: var(--color-text-muted);
			margin: 0;
		}
	}

	.tb-modal__panel {
		@include form-modal-shell;
		width: calc(100% - 40px);
		color: var(--color-text);
	}

	.tb-modal__header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		flex-shrink: 0;
		margin-bottom: 8px;
	}

	.tb-modal__title {
		@include heading-4;
		margin: 0;

		@include media-down(md) {
			font-size: $font-size-h5;
		}
	}

	.tb-modal__close {
		cursor: pointer;
		padding: 8px;
		background: transparent;
		border: none;
		border-radius: $radius-full;
		color: inherit;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: background $transition-fast;

		&:hover {
			background: var(--color-bg-light);
		}
	}
</style>
