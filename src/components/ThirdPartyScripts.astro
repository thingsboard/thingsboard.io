---
import DeferredLoadTrigger from './DeferredLoadTrigger.astro';
import FirstPromoterScript from './FirstPromoterScript.astro';
import GtmHead from './GtmHead.astro';
import YourGptWidget from './YourGptWidget.astro';
---

<!--
	Single entry point for all third-party browser scripts (GTM + YourGPT
	chatbot + FirstPromoter click tracking). Order matters:
	DeferredLoadTrigger MUST come first so the global
	window.__deferOnInteraction exists when the consumer scripts parse.
	FirstPromoter is intentionally NOT deferred — it has to set its
	attribution cookie on first paint, before the visitor clicks through to
	cloud.thingsboard.io or thingsboard.cloud. Both BaseLayout and the
	Starlight Head override mount this in <head>, so the docs site gets the
	same loaders as the marketing site.
-->
<DeferredLoadTrigger />
<GtmHead />
<FirstPromoterScript />
<YourGptWidget />
