---
import DeferredLoadTrigger from '@components/DeferredLoadTrigger.astro';
import GtmHead from '@components/GtmHead.astro';
---

<!--
	Entry point for the third-party scripts that load without a click (GTM).
	The YourGPT chat loads on click from its launcher, YourGptWidget.astro.
	DeferredLoadTrigger defines window.__deferOnInteraction for later
	scripts (GitHubButton.astro); GTM waits for `load` on its own.
	Mounted in <head> by the Starlight Head override so every route (docs,
	marketing via BaseLayout, etc.) gets the same loaders.
-->
<DeferredLoadTrigger />
<GtmHead />
