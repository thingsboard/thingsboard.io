---
/**
 * "Meet our team": the leadership row, then one card per department that opens a panel listing its
 * teams. The cards are buttons, which ui/Card does not cover, so their surface is written here.
 */
import { teamTabs, type TeamMember, type TeamTab } from '@data/company/team';
import { CAREERS_URL } from '@models/careers';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Button from '@components/ui/Button.astro';
import Chip from '@components/ui/Chip.astro';
import '@styles/ui-kit.scss';

// The first tab is the leadership row; every other tab is a department.
const [leadership, ...teams] = teamTabs;

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const isPlaceholder = (m: TeamMember) => m.src.endsWith('/kasharix.webp');
// A person can sit in several rows (e.g. Platform and TBMQ) — count them once.
const uniqueMembers = (tab: TeamTab) => {
	const seen = new Map<string, TeamMember>();
	for (const c of tab.clusters) for (const m of c.members) if (!seen.has(m.title)) seen.set(m.title, m);
	return [...seen.values()];
};
const STACK = 5;
const cards = teams.map((tab) => {
	const people = uniqueMembers(tab);
	// Real photos first; the cat only fills the stack when a department has too few.
	const stack = [...people.filter((m) => !isPlaceholder(m)), ...people.filter(isPlaceholder)].slice(0, STACK);
	return { tab, id: `team-${slug(tab.label)}`, count: people.length, stack, more: Math.max(0, people.length - STACK) };
});
const total = new Set(teamTabs.flatMap((t) => uniqueMembers(t).map((m) => m.title))).size;
const careersExternal = /^https?:\/\//.test(CAREERS_URL);
---

<section class="team-section">
	<div class="team-wrapper">
		<SectionHeader title="Meet our team" subtitle={`${total} people`} />

		<h3 class="team-eyebrow">Leadership</h3>
		<ul class="leaders">
			{leadership.clusters.flatMap((c) => c.members).map((member) => (
				<li class="person person--lead">
					<img src={member.src} alt={isPlaceholder(member) ? '' : member.title} width="240" height="240" loading="lazy" />
					<span class="person-name">{member.title}</span>
					<span class="person-role">{member.description}</span>
				</li>
			))}
		</ul>

		<h3 class="team-eyebrow">Departments</h3>
		{/* Each department's panel follows its card. From md the open one shows under all six cards,
		    on one column right under its card; without JS every panel shows. */}
		<CardGrid cols={3} class="team__grid">
			{cards.map(({ tab, id, count, stack, more }) => (
				<Fragment>
					<button type="button" class="dept-card" data-team={id} aria-expanded="false" aria-controls={id}>
						<span class="dept-card__top">
							<span class="dept-card__title">{tab.label}</span>
							<Chip kind="tag">{count} people</Chip>
						</span>
						<span class="dept-card__bottom">
							<span class="avatar-stack" aria-hidden="true">
								{stack.map((m) => <img src={m.src} alt="" width="40" height="40" loading="lazy" />)}
								{more > 0 && <span class="avatar-stack__more">+{more}</span>}
							</span>
							<span class="dept-card__chevron" aria-hidden="true">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none">
									<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
						</span>
					</button>
					<section class="dept-panel" id={id} aria-label={`${tab.label} department`}>
						<div class="dept-panel__inner">
							<header class="dept-panel__head">
								<div>
									<h4 class="dept-panel__title">{tab.label}</h4>
									<p class="dept-panel__meta">{count} people</p>
								</div>
								<button type="button" class="dept-panel__close" aria-label={`Close ${tab.label}`}>
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
									</svg>
								</button>
							</header>
							{tab.clusters.map((cluster) => (
								<div class="team-group">
									{cluster.label && <h5 class="team-group__label">{cluster.label}</h5>}
									<ul class="team-group__people">
										{cluster.members.map((member) => (
											<li class="person">
												<img src={member.src} alt={isPlaceholder(member) ? '' : member.title} width="240" height="240" loading="lazy" />
												<span class="person-name">{member.title}</span>
												<span class="person-role">{member.description}</span>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</section>
				</Fragment>
			))}
		</CardGrid>

		<div class="team-join print:hidden">
			<Button href={CAREERS_URL} external={careersExternal} size="lg">Join our team</Button>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	$photo-backdrop: linear-gradient(180deg, #a7b1b8 0%, #d8d9da 100%);

	.team-section {
		background: var(--color-bg-surface);
		color: var(--color-text);
		padding: $spacing-12 0;

		@include media-down(md) {
			padding-block: $spacing-8;
		}
	}

	.team-wrapper {
		padding-inline: var(--band-gutter);
	}

	.team-eyebrow {
		@include type-eyebrow;
		display: flex;
		align-items: center;
		gap: $spacing-4;
		margin: 0 0 $spacing-8;
		color: var(--color-text-secondary);

		&::before,
		&::after {
			content: '';
			flex: 1;
			height: 1px;
			background: var(--ui-line);
		}
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Every person gets the same column, so the rows keep one rhythm; a long title wraps inside it.
	$person-col: 168px;
	$lead-col: 200px;

	.person {
		display: flex;
		flex: 0 0 $person-col;
		flex-direction: column;
		align-items: center;
		text-align: center;
		text-wrap: balance;

		img {
			width: 104px;
			height: 104px;
			margin-bottom: $spacing-3;
			border-radius: 50%;
			object-fit: cover;
			// The team photos are cut-outs shot for this gray backdrop; any other ground washes them out.
			background: $photo-backdrop;
			box-shadow: var(--elev-mark);
		}
	}

	// Tight leading: names and titles wrap inside the column.
	.person-name {
		@include type-tile;
		line-height: 1.2;
		color: var(--color-text);
		margin-bottom: $spacing-1;
	}

	.person-role {
		@include type-small;
		line-height: 1.35;
		color: var(--color-text-secondary);
	}

	// At most four leaders a row, so seven split 4 + 3 instead of leaving one alone.
	.leaders {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-8 $spacing-6;
		max-width: calc(#{$lead-col} * 4 + #{$spacing-6} * 3);
		margin: 0 auto $spacing-16;

		.person {
			flex-basis: $lead-col;
		}

		.person img {
			width: 120px;
			height: 120px;
			margin-bottom: $spacing-4;
		}
	}

	.dept-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: $spacing-5;
		min-width: 0;
		padding: $spacing-5;
		font: inherit;
		text-align: left;
		color: var(--color-text);
		background: var(--color-bg-surface);
		border: 1px solid var(--ui-line);
		border-radius: $radius-lg;
		cursor: pointer;
		transition:
			border-color $transition-fast,
			border-radius $transition-fast;

		@include focus-ring;

		// The hover shadow is painted once on its own layer and only faded, so hovering doesn't
		// repaint the card on every frame.
		&::before {
			content: '';
			position: absolute;
			inset: -1px;
			border-radius: inherit;
			box-shadow: var(--elev-tile-hover);
			opacity: 0;
			transition: opacity 0.2s ease;
			pointer-events: none;
		}

		@media (hover: hover) {
			&:hover {
				&::before {
					opacity: 1;
				}

				.dept-card__chevron {
					background: var(--accent-fill);
					color: var(--accent-on-fill);
				}
			}
		}

		&:active {
			box-shadow: var(--elev-tile);

			&::before {
				opacity: 0;
			}
		}

		&.is-active {
			border-color: var(--accent-ink);

			.dept-card__chevron {
				background: var(--accent-fill);
				color: var(--accent-on-fill);

				svg {
					transform: rotate(180deg);
				}
			}

			// One column: the card and its panel read as one surface.
			@include media-down(md) {
				border-bottom-left-radius: 0;
				border-bottom-right-radius: 0;
			}
		}

		@media (forced-colors: active) {
			border: 1px solid CanvasText;
		}
	}

	.dept-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-3;
	}

	.dept-card__title {
		@include type-tile-lg;
	}

	.dept-card__top :global(.ui-chip) {
		flex-shrink: 0;
	}

	.dept-card__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.avatar-stack {
		display: flex;
		align-items: center;

		img,
		.avatar-stack__more {
			width: 40px;
			height: 40px;
			margin-left: -$spacing-2;
			border: 2px solid var(--color-bg-surface);
			border-radius: 50%;

			&:first-child {
				margin-left: 0;
			}
		}

		img {
			object-fit: cover;
			background: $photo-backdrop;
		}
	}

	.avatar-stack__more {
		@include type-small-strong;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--band-tint);
		color: var(--accent-ink);
	}

	.dept-card__chevron {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--band-tint);
		color: var(--accent-ink);
		transition: background $transition-fast, color $transition-fast;

		svg {
			transition: transform $transition-base;
		}
	}

	// A full row: from md under all six cards (`order` moves it past them), on one column right under
	// its own card. The negative margin takes back the grid's row gap; the inner's
	// margin puts it inside the height the script animates, so a closed panel leaves no gap. `clip`
	// (not `hidden`) keeps the sticky head working.
	.dept-panel {
		grid-column: 1 / -1;
		margin-top: -$spacing-5;
		overflow: clip;

		@include media-up(md) {
			order: 1;
		}
	}

	:global(.js-team) .dept-panel:not(.is-open) {
		display: none;
	}

	.dept-panel__inner {
		display: flex;
		flex-direction: column;
		gap: $spacing-10;
		margin-top: $spacing-5;
		padding: $spacing-8;
		border-radius: $radius-xl;
		background: var(--band-tint);

		@include media-down(md) {
			gap: $spacing-8;
			margin-top: 0;
			padding: 0 $spacing-4 $spacing-6;
			border: 1px solid var(--accent-ink);
			border-top: 0;
			border-radius: 0 0 $radius-lg $radius-lg;
		}
	}

	.dept-panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: $spacing-4;

		// One column: the head stays under the site header while the list scrolls, so ✕ is always in reach.
		@include media-down(md) {
			position: sticky;
			top: var(--sl-nav-height, #{$header-height});
			z-index: 1;
			margin: 0 (-$spacing-4);
			padding: $spacing-4;
			background: var(--band-tint);
		}
	}

	.dept-panel__title {
		@include type-card;
		margin: 0;
		color: var(--color-text);
	}

	.dept-panel__meta {
		@include type-small;
		margin: $spacing-1 0 0;
		color: var(--color-text-secondary);
	}

	.dept-panel__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: $radius-md;
		background: transparent;
		position: relative;
		color: var(--color-text);
		cursor: pointer;
		transition: background $transition-fast;

		@include focus-ring(2px);
		@include touch-target(40px);

		@media (hover: hover) {
			&:hover {
				background: color-mix(in srgb, currentColor 6%, transparent);
			}
		}

		&:active {
			background: color-mix(in srgb, currentColor 10%, transparent);
		}
	}

	:global(html:not(.js-team)) .dept-panel__close {
		display: none;
	}

	.team-group {
		display: flex;
		flex-direction: column;
		gap: $spacing-6;
	}

	.team-group__label {
		@include type-eyebrow;
		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin: 0;
		color: var(--color-text-secondary);

		&::after {
			content: '';
			flex: 1;
			height: 1px;
			background: var(--ui-line);
		}
	}

	.team-group__people {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-8 $spacing-6;
	}

	.team-join {
		display: flex;
		justify-content: center;
		margin-top: $spacing-12;
	}

	@include media-down(md) {
		.person {
			flex-basis: calc((100% - #{$spacing-2} * 2) / 3);

			img {
				width: 84px;
				height: 84px;
			}
		}

		.leaders {
			gap: $spacing-6 $spacing-2;

			.person {
				flex-basis: calc((100% - #{$spacing-2}) / 2);
			}
		}

		.leaders .person img {
			width: 88px;
			height: 88px;
		}

		.team-group__people {
			gap: $spacing-6 $spacing-2;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dept-card__chevron svg {
			transition: none;
		}
	}

	@media print {
		.dept-card {
			display: none;
		}

		.dept-panel {
			display: block !important;
		}

		.dept-panel__close {
			display: none;
		}

		.dept-panel__inner {
			margin-top: $spacing-6;
			padding: 0;
			background: none;
			break-inside: avoid;
		}
	}
</style>

<script>
	// One department open at a time: from md in one place under all six cards, on one column under
	// its own card. Under prefers-reduced-motion everything below is instant.
	//
	// Motion: entrances decelerate on the kit's own curve (Segmented's thumb), exits accelerate and run
	// about two thirds as long; a height change takes longer the further it travels (250–450 ms), so
	// 32 people don't shoot open in the time 7 do.
	document.documentElement.classList.add('js-team');

	const section = document.querySelector<HTMLElement>('.team-section')!;
	const grid = section.querySelector<HTMLElement>('.team__grid')!;
	const cards = [...grid.querySelectorAll<HTMLButtonElement>('.dept-card')];
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const sharedSlot = matchMedia('(min-width: 750px)'); // $breakpoint-md: every panel opens in the same place
	const ENTER = 'cubic-bezier(0.3, 0.7, 0.2, 1)';
	const EXIT = 'cubic-bezier(0.4, 0, 1, 1)';
	const travel = (px: number) => Math.min(450, Math.max(250, 250 + Math.abs(px) / 5));
	let active: HTMLButtonElement | null = null;
	// A cross-fade in progress: `old` is fading out; `to` is what opens once it has (null: nothing).
	let swap: { old: HTMLElement; to: HTMLElement | null } | null = null;

	const panelOf = (card: HTMLButtonElement) => document.getElementById(card.dataset.team!) as HTMLElement;
	const panels = cards.map(panelOf);
	const cardOf = (panel: HTMLElement) => cards[panels.indexOf(panel)];
	const listOf = (panel: HTMLElement) => panel.firstElementChild as HTMLElement;
	const isShown = (panel: HTMLElement) => panel.classList.contains('is-open');
	const headerOffset = () => parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;

	function show(panel: HTMLElement, on: boolean): void {
		panel.getAnimations({ subtree: true }).forEach((a) => a.cancel());
		panel.classList.toggle('is-open', on);
	}

	function mark(card: HTMLButtonElement, on: boolean): void {
		card.classList.toggle('is-active', on);
		card.setAttribute('aria-expanded', String(on));
		active = on ? card : null;
	}

	// Grows the panel from `from` px to its own height and brings the list in just behind it.
	function grow(panel: HTMLElement, from: number): void {
		if (reducedMotion.matches) return;
		const to = panel.offsetHeight;
		panel.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: travel(to - from), easing: ENTER });
		listOf(panel).animate(
			[
				{ opacity: 0, transform: 'translateY(8px)' },
				{ opacity: 1, transform: 'none' },
			],
			{ duration: 200, easing: ENTER, delay: from ? 0 : 100, fill: 'backwards' },
		);
	}

	// Fades the list and folds the panel, then hides it.
	function fold(panel: HTMLElement): void {
		const from = panel.getBoundingClientRect().height;
		show(panel, true);
		if (reducedMotion.matches) return show(panel, false);
		listOf(panel).animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: EXIT, fill: 'forwards' });
		panel.animate([{ height: `${from}px` }, { height: '0px' }], {
			duration: Math.round((travel(from) * 2) / 3),
			easing: EXIT,
			fill: 'forwards',
		}).onfinish = () => show(panel, false);
	}

	// Opened below the fold, the panel would grow where nobody sees it: bring its head into view,
	// without scrolling the cards away.
	function reveal(panel: HTMLElement): void {
		const top = panel.getBoundingClientRect().top;
		const by = Math.min(top - headerOffset(), top + 240 - innerHeight);
		if (by > 0) window.scrollBy({ top: by, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
	}

	function close(): void {
		if (!active) return;
		const card = active;
		mark(card, false);
		history.replaceState(null, '', location.pathname + location.search);
		if (swap) {
			swap.to = null;
			return;
		}
		// Scrolled down into a long list, folding would pull the page out from under the reader:
		// drop the panel at once and put its card back under the header.
		if (card.getBoundingClientRect().top < headerOffset()) {
			show(panelOf(card), false);
			card.scrollIntoView({ block: 'start', behavior: 'instant' });
		} else {
			fold(panelOf(card));
		}
	}

	function open(card: HTMLButtonElement, scroll = false): void {
		if (active === card) return close();
		if (active) mark(active, false);
		mark(card, true);
		history.replaceState(null, '', `#${card.dataset.team}`);
		const panel = panelOf(card);
		// Clicked again mid cross-fade (even back on the one fading out): only the ending changes.
		if (swap) {
			swap.to = panel;
			return;
		}
		const top = card.getBoundingClientRect().top;
		const others = panels.filter((p) => p !== panel && isShown(p));

		// Same place, something already there: the old list fades out first, then the new one takes
		// over its height and eases to its own.
		if (sharedSlot.matches && others.length && !reducedMotion.matches) {
			const [old, ...rest] = others;
			rest.forEach((p) => show(p, false));
			show(panel, false);
			const from = old.getBoundingClientRect().height;
			swap = { old, to: panel };
			listOf(old).animate([{ opacity: getComputedStyle(listOf(old)).opacity }, { opacity: 0 }], {
				duration: 100,
				easing: EXIT,
				fill: 'forwards',
			}).onfinish = () => {
				const { to } = swap!;
				swap = null;
				show(old, false);
				if (to) {
					show(to, true);
					grow(to, from);
				}
			};
			old.getAnimations().forEach((a) => a.pause()); // hold the old height while its list fades
			return;
		}

		// A panel still folding under this card resumes from where it is.
		let from = isShown(panel) ? panel.getBoundingClientRect().height : 0;
		for (const other of others) {
			if (sharedSlot.matches) {
				from = Math.max(from, other.getBoundingClientRect().height);
				show(other, false);
			} else if (cardOf(other).offsetTop < card.offsetTop) {
				// Above: it goes at once; the scroll below keeps the tapped card where it was.
				show(other, false);
			} else {
				fold(other);
			}
		}
		window.scrollBy({ top: card.getBoundingClientRect().top - top, behavior: 'instant' });
		show(panel, true);
		grow(panel, from);
		if (scroll) card.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'instant' : 'smooth' });
		else reveal(panel);
	}

	cards.forEach((card) => card.addEventListener('click', () => open(card)));
	section.querySelectorAll<HTMLButtonElement>('.dept-panel__close').forEach((btn) =>
		btn.addEventListener('click', () => {
			const card = active;
			close();
			card?.focus();
		}),
	);
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && active) {
			const card = active;
			close();
			card.focus();
		}
	});

	// Hovering or tabbing to a card is intent enough to start loading its people's photos, so they
	// are there by the time the panel opens rather than popping in as it grows.
	const preload = (card: HTMLButtonElement) =>
		panelOf(card)
			.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
			.forEach((img) => (img.loading = 'eager'));
	cards.forEach((card) => {
		card.addEventListener('pointerenter', () => preload(card), { once: true });
		card.addEventListener('focus', () => preload(card), { once: true });
	});

	// Deep link: /company/#team-support opens that department.
	const fromHash = cards.find((c) => `#${c.dataset.team}` === location.hash);
	if (fromHash) open(fromHash, true);
</script>
