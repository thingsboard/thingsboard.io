---
/**
 * "Meet our team": the leadership row, then one card per department that opens a panel listing its
 * teams. The cards are buttons, which ui/Card does not cover, so their surface is written here.
 */
import { teamTabs, type TeamMember, type TeamTab } from '@data/company/team';
import { CAREERS_URL } from '@models/careers';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Button from '@components/ui/Button.astro';
import Chip from '@components/ui/Chip.astro';
import '@styles/ui-kit.scss';

// The first tab is the leadership row; every other tab is a department.
const [leadership, ...teams] = teamTabs;

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const isPlaceholder = (m: TeamMember) => m.src.endsWith('/kasharix.webp');
// A person can sit in several rows (e.g. Platform and TBMQ) — count them once.
const uniqueMembers = (tab: TeamTab) => {
	const seen = new Map<string, TeamMember>();
	for (const c of tab.clusters) for (const m of c.members) if (!seen.has(m.title)) seen.set(m.title, m);
	return [...seen.values()];
};
const STACK = 5;
const cards = teams.map((tab) => {
	const people = uniqueMembers(tab);
	// Real photos first; the cat only fills the stack when a department has too few.
	const stack = [...people.filter((m) => !isPlaceholder(m)), ...people.filter(isPlaceholder)].slice(0, STACK);
	return { tab, id: `team-${slug(tab.label)}`, count: people.length, stack, more: Math.max(0, people.length - STACK) };
});
const total = new Set(teamTabs.flatMap((t) => uniqueMembers(t).map((m) => m.title))).size;
const careersExternal = /^https?:\/\//.test(CAREERS_URL);
---

<section class="team-section">
	<div class="team-wrapper">
		<SectionHeader title="Meet our team" subtitle={`${total} people`} />

		<h3 class="team-eyebrow">Leadership</h3>
		<ul class="leaders">
			{leadership.clusters.flatMap((c) => c.members).map((member) => (
				<li class="person person--lead">
					<img src={member.src} alt={isPlaceholder(member) ? '' : member.title} width="240" height="240" loading="lazy" />
					<span class="person-name">{member.title}</span>
					<span class="person-role">{member.description}</span>
				</li>
			))}
		</ul>

		<h3 class="team-eyebrow">Departments</h3>
		<CardGrid cols={3} class="team__grid">
			{cards.map(({ tab, id, count, stack, more }) => (
				<button type="button" class="dept-card" data-team={id} aria-expanded="false" aria-controls={id}>
					<span class="dept-card__top">
						<span class="dept-card__title">{tab.label}</span>
						<Chip kind="tag">{count} people</Chip>
					</span>
					<span class="dept-card__bottom">
						<span class="avatar-stack" aria-hidden="true">
							{stack.map((m) => <img src={m.src} alt="" width="40" height="40" loading="lazy" />)}
							{more > 0 && <span class="avatar-stack__more">+{more}</span>}
						</span>
						<span class="dept-card__chevron" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none">
								<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
					</span>
				</button>
			))}
		</CardGrid>

		{/* Department panels. JS moves the open one into the grid right under its card's row;
		    without JS they simply stay here, one after another. */}
		<div class="panel-pool">
			{cards.map(({ tab, id, count }) => (
				<section class="dept-panel" id={id} aria-label={`${tab.label} department`}>
					<div class="dept-panel__inner">
						<header class="dept-panel__head">
							<div>
								<h4 class="dept-panel__title">{tab.label}</h4>
								<p class="dept-panel__meta">{count} people</p>
							</div>
							<button type="button" class="dept-panel__close" aria-label={`Close ${tab.label}`}>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
								</svg>
							</button>
						</header>
						{tab.clusters.map((cluster) => (
							<div class="team-group">
								{cluster.label && <h5 class="team-group__label">{cluster.label}</h5>}
								<ul class="team-group__people">
									{cluster.members.map((member) => (
										<li class="person">
											<img src={member.src} alt={isPlaceholder(member) ? '' : member.title} width="240" height="240" loading="lazy" />
											<span class="person-name">{member.title}</span>
											<span class="person-role">{member.description}</span>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>
			))}
		</div>

		<div class="team-join print:hidden">
			<Button href={CAREERS_URL} external={careersExternal} size="lg">Join our team</Button>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	$photo-backdrop: linear-gradient(180deg, #a7b1b8 0%, #d8d9da 100%);

	.team-section {
		background: var(--color-bg-surface);
		color: var(--color-text);
		padding: $spacing-12 0;

		@include media-down(md) {
			padding-block: $spacing-8;
		}
	}

	.team-wrapper {
		padding-inline: var(--band-gutter);
	}

	.team-eyebrow {
		@include type-eyebrow;
		display: flex;
		align-items: center;
		gap: $spacing-4;
		margin: 0 0 $spacing-8;
		color: var(--color-text-secondary);

		&::before,
		&::after {
			content: '';
			flex: 1;
			height: 1px;
			background: var(--ui-line);
		}
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Every person gets the same column, so the rows keep one rhythm; a long title wraps inside it.
	$person-col: 168px;
	$lead-col: 200px;

	.person {
		display: flex;
		flex: 0 0 $person-col;
		flex-direction: column;
		align-items: center;
		text-align: center;
		text-wrap: balance;

		img {
			width: 104px;
			height: 104px;
			margin-bottom: $spacing-3;
			border-radius: 50%;
			object-fit: cover;
			// The team photos are cut-outs shot for this gray backdrop; any other ground washes them out.
			background: $photo-backdrop;
			box-shadow: var(--elev-mark);
		}
	}

	// Tight leading: names and titles wrap inside the column.
	.person-name {
		@include type-tile;
		line-height: 1.2;
		color: var(--color-text);
		margin-bottom: $spacing-1;
	}

	.person-role {
		@include type-small;
		line-height: 1.35;
		color: var(--color-text-secondary);
	}

	// At most four leaders a row, so seven split 4 + 3 instead of leaving one alone.
	.leaders {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-8 $spacing-6;
		max-width: calc(#{$lead-col} * 4 + #{$spacing-6} * 3);
		margin: 0 auto $spacing-16;

		.person {
			flex-basis: $lead-col;
		}

		.person img {
			width: 120px;
			height: 120px;
			margin-bottom: $spacing-4;
		}
	}

	.dept-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: $spacing-5;
		min-width: 0;
		padding: $spacing-5;
		font: inherit;
		text-align: left;
		color: var(--color-text);
		background: var(--color-bg-surface);
		border: 1px solid var(--ui-line);
		border-radius: $radius-lg;
		cursor: pointer;
		transition: box-shadow 0.2s ease, border-color $transition-fast;

		@include focus-ring;

		@media (hover: hover) {
			&:hover {
				box-shadow: var(--elev-tile-hover);

				.dept-card__chevron {
					background: var(--accent-fill);
					color: var(--accent-on-fill);
				}
			}
		}

		&:active {
			box-shadow: var(--elev-tile);
		}

		&.is-active {
			border-color: var(--accent-ink);

			.dept-card__chevron {
				background: var(--accent-fill);
				color: var(--accent-on-fill);

				svg {
					transform: rotate(180deg);
				}
			}

			// Notch pointing at the panel opened under this row.
			&::after {
				content: '';
				position: absolute;
				left: 50%;
				bottom: -$spacing-5 - 1px;
				translate: -50% 0;
				border: 12px solid transparent;
				border-top-width: 0;
				border-bottom-color: var(--band-tint);
			}
		}

		@media (forced-colors: active) {
			border: 1px solid CanvasText;
		}
	}

	.dept-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-3;
	}

	.dept-card__title {
		@include type-tile-lg;
	}

	.dept-card__top :global(.ui-chip) {
		flex-shrink: 0;
	}

	.dept-card__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.avatar-stack {
		display: flex;
		align-items: center;

		img,
		.avatar-stack__more {
			width: 40px;
			height: 40px;
			margin-left: -$spacing-2;
			border: 2px solid var(--color-bg-surface);
			border-radius: 50%;

			&:first-child {
				margin-left: 0;
			}
		}

		img {
			object-fit: cover;
			background: $photo-backdrop;
		}
	}

	.avatar-stack__more {
		@include type-small-strong;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--band-tint);
		color: var(--accent-ink);
	}

	.dept-card__chevron {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--band-tint);
		color: var(--accent-ink);
		transition: background $transition-fast, color $transition-fast;

		svg {
			transition: transform $transition-base;
		}
	}

	.dept-panel {
		grid-column: 1 / -1;
		display: grid;
		grid-template-rows: 1fr;
	}

	:global(.js-team) .panel-pool {
		display: none;
	}

	:global(.js-team) .dept-panel {
		grid-template-rows: 0fr;
		opacity: 0;
		transition: grid-template-rows $transition-base, opacity $transition-fast;

		&.is-open {
			grid-template-rows: 1fr;
			opacity: 1;
		}
	}

	.dept-panel__inner {
		display: flex;
		flex-direction: column;
		gap: $spacing-10;
		min-height: 0;
		overflow: hidden;
		padding: $spacing-8;
		border-radius: $radius-xl;
		background: var(--band-tint);

		@include media-down(md) {
			gap: $spacing-8;
			padding: $spacing-6 $spacing-4;
		}
	}

	.panel-pool .dept-panel__inner {
		margin-top: $spacing-5;
	}

	.dept-panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: $spacing-4;
	}

	.dept-panel__title {
		@include type-card;
		margin: 0;
		color: var(--color-text);
	}

	.dept-panel__meta {
		@include type-small;
		margin: $spacing-1 0 0;
		color: var(--color-text-secondary);
	}

	.dept-panel__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: $radius-md;
		background: transparent;
		position: relative;
		color: var(--color-text);
		cursor: pointer;
		transition: background $transition-fast;

		@include focus-ring(2px);
		@include touch-target(40px);

		@media (hover: hover) {
			&:hover {
				background: color-mix(in srgb, currentColor 6%, transparent);
			}
		}

		&:active {
			background: color-mix(in srgb, currentColor 10%, transparent);
		}
	}

	:global(html:not(.js-team)) .dept-panel__close {
		display: none;
	}

	.team-group {
		display: flex;
		flex-direction: column;
		gap: $spacing-6;
	}

	.team-group__label {
		@include type-eyebrow;
		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin: 0;
		color: var(--color-text-secondary);

		&::after {
			content: '';
			flex: 1;
			height: 1px;
			background: var(--ui-line);
		}
	}

	.team-group__people {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-8 $spacing-6;
	}

	.team-join {
		display: flex;
		justify-content: center;
		margin-top: $spacing-12;
	}

	@include media-down(md) {
		.person {
			flex-basis: calc((100% - #{$spacing-2} * 2) / 3);

			img {
				width: 84px;
				height: 84px;
			}
		}

		.leaders {
			gap: $spacing-6 $spacing-2;

			.person {
				flex-basis: calc((100% - #{$spacing-2}) / 2);
			}
		}

		.leaders .person img {
			width: 88px;
			height: 88px;
		}

		.team-group__people {
			gap: $spacing-6 $spacing-2;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dept-card__chevron svg,
		:global(.js-team) .dept-panel {
			transition: none;
		}
	}

	@media print {
		.team__grid {
			display: none;
		}

		.panel-pool {
			display: block !important;
		}

		.dept-panel__close {
			display: none;
		}

		.dept-panel__inner {
			margin-top: $spacing-6;
			padding: 0;
			background: none;
			break-inside: avoid;
		}
	}
</style>

<script>
	// Opens one department at a time in a panel placed right after the last card of the clicked
	// card's row, so the cards never move and the panel reads as "this department".
	document.documentElement.classList.add('js-team');

	const section = document.querySelector<HTMLElement>('.team-section')!;
	const grid = section.querySelector<HTMLElement>('.team__grid')!;
	const pool = section.querySelector<HTMLElement>('.panel-pool')!;
	const cards = [...grid.querySelectorAll<HTMLButtonElement>('.dept-card')];
	let active: HTMLButtonElement | null = null;

	const panelOf = (card: HTMLButtonElement) => document.getElementById(card.dataset.team!) as HTMLElement;

	// Last card sitting on the same visual row as `card` (the column count changes with width).
	function rowEnd(card: HTMLButtonElement): HTMLButtonElement {
		const top = card.offsetTop;
		return cards.filter((c) => c.offsetTop === top).at(-1) ?? card;
	}

	function close(): void {
		if (!active) return;
		const panel = panelOf(active);
		active.classList.remove('is-active');
		active.setAttribute('aria-expanded', 'false');
		panel.classList.remove('is-open');
		pool.append(panel);
		active = null;
		history.replaceState(null, '', location.pathname + location.search);
	}

	function open(card: HTMLButtonElement, scroll = false): void {
		if (active === card) return close();
		close();
		const panel = panelOf(card);
		rowEnd(card).after(panel);
		active = card;
		card.classList.add('is-active');
		card.setAttribute('aria-expanded', 'true');
		void panel.offsetWidth; // start the open transition from the collapsed state
		panel.classList.add('is-open');
		history.replaceState(null, '', `#${card.dataset.team}`);
		if (scroll) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}

	cards.forEach((card) => card.addEventListener('click', () => open(card)));
	section.querySelectorAll<HTMLButtonElement>('.dept-panel__close').forEach((btn) =>
		btn.addEventListener('click', () => {
			const card = active;
			close();
			card?.focus();
		}),
	);
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && active) {
			const card = active;
			close();
			card.focus();
		}
	});
	// Re-seat the open panel when the number of columns changes.
	window.addEventListener('resize', () => {
		if (active) rowEnd(active).after(panelOf(active));
	});

	// Deep link: /company/#team-support opens that department.
	const fromHash = cards.find((c) => `#${c.dataset.team}` === location.hash);
	if (fromHash) open(fromHash, true);
</script>
