---
import { Icon } from 'astro-icon/components';
import '@styles/ui-kit.scss';

const timeline = [
	{ year: '2016', events: ['2 co-founders', 'Release of CE', '100 first GitHub ⭐'] },
	{ year: '2017', events: ['10 employees', 'IoT Gateway 🚀'] },
	{ year: '2018', events: ['15 employees', 'Professional Edition 🚀'] },
	{ year: '2019', events: ['20 employees', 'Trendz release'] },
	{ year: '2020', events: ['30 employees', '5K GitHub ⭐', 'ThingsBoard Cloud 🚀'] },
	{ year: '2021', events: ['40 employees', 'ThingsBoard Edge 🚀', '10K GitHub ⭐'] },
	{ year: '2022', events: ['50 employees', 'Mobile SDK and application'] },
	{ year: '2023', events: ['65 employees', 'Release of TBMQ', '15K GitHub ⭐'] },
	{ year: '2024', events: ['100 employees', 'SCADA dashboards', 'TOP Supplier Retail 🏆'] },
	{ year: '2025', events: ['110 employees', 'ThingsBoard MCP 🚀', '20K+ GitHub ⭐'] },
	{ year: '2026', events: ['ISO Certified', 'AI tools for IoT 🚀', 'IoT Hub release'] },
];

// Each event's bullet is a kit icon in the color of its kind; the emoji it ended with becomes that icon.
const KINDS = [
	{ test: /employees|co-founders/, icon: 'tabler:users', color: 'var(--color-accent-graphite)' },
	{ test: /GitHub/, icon: 'tabler:star', color: 'var(--color-accent-amber)' },
	{ test: /🏆/, icon: 'tabler:trophy', color: 'var(--color-accent-amber)' },
	{ test: /ISO/, icon: 'tabler:certificate', color: 'var(--color-accent-cyan)' },
	{ test: /🚀|[Rr]elease|SDK|dashboards/, icon: 'tabler:rocket', color: 'var(--color-accent-brand)' },
];
const OTHER = { icon: 'tabler:sparkles', color: 'var(--color-accent-violet)' };
const eventOf = (text: string) => {
	const kind = KINDS.find((k) => k.test.test(text)) ?? OTHER;
	return { text: text.replace(/\s*(⭐|🚀|🏆)$/u, ''), icon: kind.icon, color: kind.color };
};
---

<section class="timeline-section">
	<div class="timeline-wrapper">
		<div class="timeline-viewport">
			<div class="timeline-track">
				{timeline.map((item) => (
					<div class="timeline-item">
						<span class="timeline-title">{item.year}</span>
						<span class="timeline-node print:hidden" aria-hidden="true"></span>
						<ul class="timeline-text">
							{item.events.map(eventOf).map((event) => (
								<li style={`--event-color: ${event.color}`}>
									<Icon name={event.icon} class="timeline-event-icon" aria-hidden="true" />
									{event.text}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
		<button type="button" class="timeline-nav timeline-nav--prev print:hidden" aria-label="Earlier years" disabled>
			<Icon name="tabler:chevron-left" aria-hidden="true" />
		</button>
		<button type="button" class="timeline-nav timeline-nav--next print:hidden" aria-label="Later years">
			<Icon name="tabler:chevron-right" aria-hidden="true" />
		</button>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;
	@use '../../styles/reveal' as *;

	// The rail's axis, from the top of an item: the year's line box, its gap, then half the node.
	// The arrows sit on it too, so it lives in one place.
	$year-h: 36px;
	$year-gap: $spacing-3;
	$node-h: 16px;
	$axis-top: $year-h + $year-gap + $node-h * 0.5;
	$rail: 3px;
	// How far the rail fades towards an edge with more years past it.
	$edge-fade: 96px;

	// Closes the tinted band HistorySection opens.
	.timeline-section {
		background: var(--band-tint);
		padding: $spacing-12 0 $spacing-16;

		@include media-down(md) {
			padding-block: $spacing-8 $spacing-12;
		}
	}

	// Margin, not padding: the arrows hang off this box's edges, so the box is the measure itself.
	.timeline-wrapper {
		@include reveal;

		margin-inline: var(--band-gutter);
		position: relative;
	}

	// The rail fades out towards an edge with more years past it (the script sets `has-before` /
	// `has-after`). Three mask layers, so only the rail's band fades, not the years or the events.
	.timeline-viewport {
		--fade-start: 0px;
		--fade-end: 0px;

		overflow: hidden;
		position: relative;
		cursor: grab;
		mask-image:
			linear-gradient(#000, #000),
			linear-gradient(
				to right,
				transparent,
				#000 var(--fade-start),
				#000 calc(100% - var(--fade-end)),
				transparent
			),
			linear-gradient(#000, #000);
		mask-size:
			100% #{$year-h + $year-gap},
			100% #{$node-h},
			100% calc(100% - #{$year-h + $year-gap + $node-h});
		mask-position:
			0 0,
			0 #{$year-h + $year-gap},
			0 100%;
		mask-repeat: no-repeat;

		&.has-before {
			--fade-start: #{$edge-fade};
		}

		&.has-after {
			--fade-end: #{$edge-fade};
		}

		&.dragging {
			cursor: grabbing;
		}
	}

	.timeline-track {
		display: flex;
		transition: transform 0.4s ease-in-out;
	}

	.timeline-item {
		flex: 0 0 calc(100% / 5);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	@media (max-width: 1279px) {
		.timeline-item {
			flex: 0 0 calc(100% / 3);
		}
	}

	.timeline-title {
		font-size: $font-size-3xl;
		font-weight: $font-weight-bold;
		line-height: $year-h;
		letter-spacing: -0.01em;
		font-variant-numeric: tabular-nums;
		color: var(--color-text);
		margin-bottom: $year-gap;
	}

	// Every item draws its own piece of the rail, so the line runs through each dot and moves with the
	// track; the first and last pieces fade.
	.timeline-node {
		position: relative;
		align-self: stretch;
		display: grid;
		place-items: center;
		height: $node-h;
		margin-bottom: $spacing-5;

		&::before {
			content: '';
			position: absolute;
			inset-inline: 0;
			top: 50%;
			height: $rail;
			transform: translateY(-50%);
			background: var(--accent-fill);
		}

		&::after {
			content: '';
			position: relative;
			box-sizing: border-box;
			width: $node-h;
			height: $node-h;
			border: $rail solid var(--accent-fill);
			border-radius: 50%;
			background: var(--color-bg-surface);
		}
	}

	.timeline-item:first-child .timeline-node::before {
		background: linear-gradient(to right, transparent, var(--accent-fill) 50%);
	}

	.timeline-item:last-child .timeline-node::before {
		background: linear-gradient(to right, var(--accent-fill) 50%, transparent);
	}

	.timeline-item:last-child .timeline-node::after {
		background: var(--accent-fill);
	}

	.timeline-text {
		display: flex;
		flex-direction: column;
		gap: $spacing-1;
		padding: 0 $spacing-3;
		margin: 0;
		list-style: none;

		li {
			@include type-body;
			display: flex;
			align-items: flex-start;
			gap: $spacing-2;
			color: var(--color-text-secondary);
		}
	}

	.timeline-event-icon {
		flex: none;
		width: 18px;
		height: 18px;
		// Centered on the first 24px line.
		margin-top: 3px;
		color: var(--event-color);
	}

	.timeline-nav {
		position: absolute;
		top: $axis-top;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--ui-line);
		border-radius: 50%;
		background: var(--color-bg-surface);
		box-shadow: var(--elev-tile);
		color: var(--color-text);
		cursor: pointer;
		transform: translateY(-50%);
		transition:
			opacity 0.25s ease,
			color 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
		@include focus-ring(3px);

		svg {
			width: 20px;
			height: 20px;
		}

		@media (hover: hover) {
			&:hover:not(:disabled) {
				color: var(--accent-ink);
				border-color: var(--accent-ink);
				box-shadow: var(--elev-tile-hover);
			}
		}

		&:disabled {
			opacity: 0;
			pointer-events: none;
		}

		&--prev {
			left: 0;
		}

		&--next {
			right: 0;
		}

		@media (forced-colors: active) {
			border-color: ButtonText;
		}
	}

	@media (max-width: 959px) {
		.timeline-item {
			flex: 0 0 calc(100% / 2);
		}
	}

	@media (max-width: 599px) {
		.timeline-item {
			flex: 0 0 100%;
		}
	}

	@media print {
		.timeline-viewport {
			overflow: visible;
			mask-image: none;
		}

		.timeline-track {
			flex-wrap: wrap;
			row-gap: 32px;
			transform: none !important;
		}

		.timeline-item {
			flex: 0 0 33.333%;
			break-inside: avoid;
		}
	}
</style>

<script>
	import { reveal } from '@root/scripts/reveal';

	const track = document.querySelector('.timeline-track') as HTMLElement;
	const prevBtn = document.querySelector('.timeline-nav--prev') as HTMLButtonElement;
	const nextBtn = document.querySelector('.timeline-nav--next') as HTMLButtonElement;
	const items = document.querySelectorAll('.timeline-item');
	const viewport = document.querySelector('.timeline-viewport') as HTMLElement;
	const total = items.length;

	function getVisible(): number {
		const w = window.innerWidth;
		if (w >= 1280) return 5;
		if (w >= 960) return 3;
		if (w >= 600) return 2;
		return 1;
	}

	let offset = total - getVisible();

	function updateTrack(): void {
		const visible = getVisible();
		const itemWidth = 100 / visible;
		track.style.transform = `translateX(-${offset * itemWidth}%)`;
		setEnds(offset, visible);
	}

	// The arrows and the edge fades follow whether more years lie past each side.
	function setEnds(at: number, visible: number): void {
		const before = at > 0;
		const after = at < total - visible;
		prevBtn.disabled = !before;
		nextBtn.disabled = !after;
		viewport.classList.toggle('has-before', before);
		viewport.classList.toggle('has-after', after);
	}

	// Drag to scroll
	let dragging = false;
	let dragStartX = 0;
	let dragStartOffset = 0;

	function startDrag(clientX: number): void {
		dragging = true;
		dragStartX = clientX;
		dragStartOffset = offset;
		viewport.classList.add('dragging');
		track.style.transition = 'none';
	}

	function moveDrag(clientX: number): void {
		if (!dragging) return;
		const visible = getVisible();
		const itemWidth = viewport.offsetWidth / visible;
		const delta = (dragStartX - clientX) / itemWidth;
		const raw = dragStartOffset + delta;
		offset = Math.max(0, Math.min(total - visible, Math.round(raw)));
		const exact = Math.max(0, Math.min(total - visible, raw));
		track.style.transform = `translateX(-${exact * (100 / visible)}%)`;
		setEnds(exact, visible);
	}

	function endDrag(): void {
		if (!dragging) return;
		dragging = false;
		viewport.classList.remove('dragging');
		track.style.transition = '';
		updateTrack();
	}

	viewport.addEventListener('mousedown', (e) => { startDrag(e.clientX); e.preventDefault(); });
	window.addEventListener('mousemove', (e) => { moveDrag(e.clientX); });
	window.addEventListener('mouseup', () => { endDrag(); });

	viewport.addEventListener('touchstart', (e) => { startDrag(e.touches[0].clientX); }, { passive: true });
	window.addEventListener('touchmove', (e) => { if (dragging) moveDrag(e.touches[0].clientX); }, { passive: true });
	window.addEventListener('touchend', () => { endDrag(); });

	prevBtn.addEventListener('click', () => {
		if (offset > 0) { offset--; updateTrack(); }
	});

	nextBtn.addEventListener('click', () => {
		const visible = getVisible();
		if (offset < total - visible) { offset++; updateTrack(); }
	});

	window.addEventListener('resize', () => {
		const visible = getVisible();
		if (offset > total - visible) offset = Math.max(0, total - visible);
		updateTrack();
	});

	updateTrack();
	reveal(document.querySelectorAll('.timeline-wrapper'));
</script>
