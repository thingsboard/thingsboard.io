---
import { Image } from 'astro:assets';
import '@styles/ui-kit.scss';
import tbLogo from '@root/assets/images/company-images/thingsboard_black.svg';
---

<section class="about-section">
	<div class="about-container">
		<h1 class="section-title">About us</h1>
		<div class="about-content">
			<div class="about-logo-block">
				<Image src={tbLogo} alt="ThingsBoard logo" width={168} height={156} />
			</div>
			<div class="about-text-block">
				<p class="about-text about-text--lede">At ThingsBoard, we help organizations worldwide unlock the full potential of IoT. Established with a vision to simplify and accelerate IoT adoption, we provide a complete, source-available IoT platform that enables easy device connectivity, data collection, processing, visualization, and management.</p>
				<p class="about-text">Our mission is to make IoT technology accessible, scalable, and flexible for organizations of all sizes. We empower businesses to optimize operations, reduce costs, and unlock new opportunities using cutting-edge tools and technologies.</p>
				<p class="about-text">Over a thousand organizations across industries such as energy, agriculture, retail, telecom, healthcare, and Industry 4.0 trust ThingsBoard to manage their devices and produce insights. Together, we are driving the future of IoT.</p>
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/reveal' as *;
	@use '../../styles/company' as *;

	// Opens under the photo strip, a different ground, so it takes a tinted band's 64 on top.
	.about-section {
		background: var(--color-bg-surface);
		padding: $spacing-16 var(--band-gutter) $spacing-12;

		@include media-down(md) {
			padding-block: $spacing-12 $spacing-8;
		}
	}

	.section-title {
		@include company-section-title;
	}

	.about-content {
		@include reveal;

		display: grid;
		grid-template-columns: 1fr 2fr;
		align-items: center;
		gap: $spacing-12;

		@include media-down(lg) {
			grid-template-columns: 1fr;
			gap: $spacing-8;
		}
	}

	// The ring's progress out from the logo, 0 to 1: registered so the mask can tween.
	@property --about-ring {
		syntax: '<number>';
		inherits: false;
		initial-value: 0;
	}

	// A dot grid that clears in a circle around the logo, with a ring of accent dots spreading from that
	// circle out past the corners (`--ring-end`); no ring under reduced motion.
	.about-logo-block {
		--tile-clear: 112px;
		--tile-full: 140px;
		--ring-end: 250px;

		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: $radius-xl;
		background: var(--color-bg-surface);

		&::before,
		&::after {
			content: '';
			position: absolute;
			inset: 0;
			background-size: 24px 24px;
			background-position: center;
		}

		&::before {
			background-image: radial-gradient(
				circle,
				color-mix(in srgb, var(--color-text) 26%, transparent) 1.25px,
				transparent 1.75px
			);
			mask-image: radial-gradient(circle, transparent var(--tile-clear), #000 var(--tile-full));
		}

		// The accent grid, seen only through the moving ring and never inside the clear circle.
		&::after {
			--_r: calc(var(--tile-clear) + var(--about-ring) * (var(--ring-end) - var(--tile-clear)));

			background-image: radial-gradient(circle, var(--accent-fill) 1.75px, transparent 2.25px);
			mask-image:
				radial-gradient(
					circle,
					transparent calc(var(--_r) - 28px),
					#000 var(--_r),
					transparent calc(var(--_r) + 28px)
				),
				radial-gradient(circle, transparent var(--tile-clear), #000 var(--tile-full));
			mask-composite: intersect;
			opacity: 0;
			animation: about-signal 5s cubic-bezier(0.4, 0, 0.2, 1) infinite;

			@media (prefers-reduced-motion: reduce) {
				content: none;
			}
		}

		img {
			position: relative;
			z-index: 1;
			width: 168px;
			height: auto;
		}

		@include media-down(lg) {
			--tile-clear: 92px;
			--tile-full: 118px;
			--ring-end: 420px;

			aspect-ratio: 2 / 1;

			img {
				width: 132px;
			}
		}
	}

	@keyframes about-signal {
		0% {
			--about-ring: 0;
			opacity: 0;
		}

		15% {
			opacity: 0.75;
		}

		75%,
		100% {
			--about-ring: 1;
			opacity: 0;
		}
	}

	.about-text-block {
		display: flex;
		flex-direction: column;
		gap: $spacing-4;
	}

	.about-text {
		@include type-body;
		color: var(--color-text-secondary);
		margin: 0;
		text-wrap: pretty;
	}

	.about-text--lede {
		@include type-lede;
		color: var(--color-text);
		margin-bottom: $spacing-2;
	}

	@media print {
		.about-logo-block {
			aspect-ratio: auto;
			background: none;
			justify-items: start;

			&::before,
			&::after {
				content: none;
			}

			img {
				width: 120px;
			}
		}
	}
</style>

<script>
	import { reveal } from '@root/scripts/reveal';

	reveal(document.querySelectorAll('.about-content'));
</script>
