---
/**
 * "Our values": a black card with the value's words in a third and its photo in the other two. The
 * photos are an Embla carousel (`initCarousel`); the words follow its selection.
 */
import { Image } from 'astro:assets';
import Mark from '@components/ui/Mark.astro';
import { companyValues } from '@data/company/values';
import '@styles/ui-kit.scss';
---

<section class="values" aria-labelledby="values-title">
	<h2 class="values__heading" id="values-title">Our values</h2>
	<div
		class="values__card"
		role="region"
		aria-roledescription="carousel"
		aria-label="Our values"
		data-loop="true"
		data-autoplay="true"
		data-autoplay-interval="6000"
	>
		<div class="values__copy">
			<div class="values__texts">
				{companyValues.map((value, i) => (
					<div class:list={['values__text', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
						<Mark size={48} icon={value.mark.icon} accent={value.mark.accent} class="values__mark" />
						<h3 class="values__title">{value.title}</h3>
						<p class="values__lede">{value.description}</p>
					</div>
				))}
			</div>
			<div class="values__dots carousel-dots print:hidden">
				{companyValues.map((value, i) => (
					<button
						type="button"
						class:list={['values__dot', 'carousel-dot', i === 0 && 'active']}
						data-index={i}
						aria-label={value.title}
						aria-current={i === 0 ? 'true' : undefined}
					/>
				))}
			</div>
		</div>
		<div class="values__panel carousel-viewport print:hidden" aria-hidden="true">
			<div class="values__track">
				{companyValues.map((value) => (
					<Image
						src={value.image}
						alt=""
						widths={[640, 960, 1280, 1920]}
						sizes="(min-width: 1024px) 700px, 100vw"
						loading="lazy"
						draggable="false"
						class="values__photo"
					/>
				))}
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;
	@use '../../styles/reveal' as *;
	@use '../../styles/company' as *;

	// The section is page-wide, so `--band-gutter` (which resolves its 100% against the box it pads)
	// puts the card on the page measure.
	.values {
		padding: $spacing-12 var(--band-gutter);
		background: var(--color-bg-surface);

		@include media-down(md) {
			padding-block: $spacing-8;
		}
	}

	.values__heading {
		@include company-section-title;
	}

	.values__card {
		@include reveal;

		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
		isolation: isolate;
		border-radius: $radius-xl;
		background-color: #000;
		color: #fff;

		@include media-up(lg) {
			grid-template-columns: 1fr 2fr;
			min-height: 440px;
		}
	}

	.values__copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: $spacing-8;
		padding: $spacing-8 $spacing-6;

		@include media-up(md) {
			padding: $spacing-10;
		}
	}

	$settle: 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);

	// Every value's words share one cell, so the column is as tall as the longest and nothing jumps.
	// `--dir` (1 forward, -1 back, set by the script) is the side the next words arrive from.
	.values__texts {
		--dir: 1;

		display: grid;
	}

	.values__text {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: $spacing-3;
		opacity: 0;
		visibility: hidden;
		transform: translate3d(calc(var(--dir) * 24px), 0, 0);
		transition:
			opacity 0.3s ease,
			transform $settle,
			visibility 0s 0.3s;

		&.is-active {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity 0.45s ease 0.12s,
				transform $settle 0.12s;
		}

		&.is-leaving {
			transform: translate3d(calc(var(--dir) * -24px), 0, 0);
		}

		@media (prefers-reduced-motion: reduce) {
			transform: none;
			transition: none;

			&.is-active {
				transition: none;
			}
		}

		// Mark renders the element, so this component's scope does not reach it.
		:global(.values__mark) {
			margin-bottom: $spacing-3;
		}
	}

	.values__title {
		@include type-section;
		margin: 0;
		text-wrap: balance;
	}

	.values__lede {
		@include type-body;
		color: rgb(255 255 255 / 72%);
		max-width: 40ch;
		margin: 0;
		text-wrap: pretty;
	}

	.values__dots {
		display: flex;
		gap: $spacing-2;
	}

	.values__dot {
		position: relative;
		width: 10px;
		height: 10px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-white);
		opacity: 0.45;
		cursor: pointer;
		transition:
			opacity 0.3s ease,
			background-color 0.3s ease;
		@include focus-ring(3px);
		@include touch-target(10px);

		&:hover {
			opacity: 1;
		}

		// `active` is the carousel's own class for the selected dot.
		&.active {
			background: var(--accent-fill);
			opacity: 1;
		}
	}

	.values__dot:focus-visible {
		outline-color: #fff;
	}

	// The photo fades in from the card's black: from the top when stacked, from the left beside the words.
	.values__panel {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		cursor: grab;
		touch-action: pan-y pinch-zoom;

		&:active {
			cursor: grabbing;
		}

		@include media-up(lg) {
			aspect-ratio: auto;
		}

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			pointer-events: none;
			background-image: linear-gradient(
				to bottom,
				#000 0,
				rgb(0 0 0 / 70%) 16px,
				rgb(0 0 0 / 30%) 40px,
				rgb(0 0 0 / 0%) 64px
			);

			@include media-up(lg) {
				background-image: linear-gradient(
					to right,
					#000 0,
					rgb(0 0 0 / 75%) 24px,
					rgb(0 0 0 / 40%) 56px,
					rgb(0 0 0 / 12%) 88px,
					rgb(0 0 0 / 0%) 120px
				);
			}
		}
	}

	// Embla's container.
	.values__track {
		position: absolute;
		inset: 0;
		display: flex;
	}

	.values__photo {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
		user-select: none;
		-webkit-user-drag: none;
	}

	@media print {
		.values {
			padding: $spacing-6 0;
		}

		.values__card {
			display: block;
			background: none;
			color: var(--color-text);
		}

		.values__copy {
			padding: 0;
		}

		.values__texts {
			display: block;
		}

		.values__text {
			opacity: 1;
			visibility: visible;
			transform: none;
			margin-bottom: $spacing-4;
			break-inside: avoid;

			:global(.values__mark) {
				display: none;
			}
		}

		.values__title {
			font-size: $font-size-2xl;
		}

		.values__lede {
			color: var(--color-text);
		}
	}
</style>

<script>
	import { initCarousel } from '@components/Carousel/carousel-init';
	import { reveal } from '@root/scripts/reveal';

	const card = document.querySelector<HTMLElement>('.values__card');

	if (card) {
		reveal([card]);

		const textBox = card.querySelector<HTMLElement>('.values__texts')!;
		const texts = card.querySelectorAll<HTMLElement>('.values__text');
		const total = texts.length;
		let current = 0;

		// The words follow the carousel's selection. They arrive from the side it traveled, taking the
		// short way round the loop, as Embla does.
		card.addEventListener('carousel:select', (event) => {
			const next = (event as CustomEvent<{ index: number }>).detail.index;
			if (next === current) return;
			const forward = (next - current + total) % total <= total / 2;
			textBox.style.setProperty('--dir', forward ? '1' : '-1');
			texts.forEach((text) => text.classList.remove('is-leaving'));
			texts[current].classList.replace('is-active', 'is-leaving');
			texts[current].setAttribute('aria-hidden', 'true');
			texts[next].classList.add('is-active');
			texts[next].removeAttribute('aria-hidden');
			current = next;
		});

		initCarousel(card);
	}
</script>
