---
// The two inputs `form-guard.ts` reads on a contact form: the honeypot and the render-time stamp.
// The honeypot is styled inline, because a page's scoped styles cannot reach it here. It is kept out of the
// Tab order and away from screen readers.
interface Props {
	// Unique on the page until `armHoneypot` renames the input.
	id: string;
}

const { id } = Astro.props;
---

<div class="form-hp" style="position:absolute;left:-9999px" aria-hidden="true">
	<label for={id}>Leave this field empty</label>
	<input type="text" id={id} name={id} autocomplete="off" tabindex="-1" />
</div>
<input type="hidden" class="form-rendered-at" value="" />
