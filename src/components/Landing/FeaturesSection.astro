---
import FeatureTile from '@components/Landing/FeatureTile.astro';
import { homeFeatures } from '@data/homeFeatures';

/** What the platform gives you out of the box, one tile per capability. */
---

<section id="bottom-features" class="features">
	<div class="main-div">
		<h2 class="features__title">ThingsBoard Features</h2>
		<div class="features__grid">
			{homeFeatures.map((feature) => (
				<FeatureTile {...feature} />
			))}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.features {
		padding-block: $spacing-16 $spacing-20;
		background-color: #f5f6ff;

		.main-div {
			max-width: $home-measure;
		}
	}

	.features__title {
		@include home-section-title;
		margin: 0 0 $spacing-8;
		text-align: center;
		color: var(--color-text);
	}

	.features__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: $spacing-3;

		@include media-up(md) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-up(lg) {
			grid-template-columns: repeat(3, 1fr);

			// A lone last tile takes the middle column.
			> :global(:last-child:nth-child(3n + 1)) {
				grid-column: 2;
			}
		}
	}
</style>
