---
import CtaButton from '@components/Landing/CtaButton.astro';

/** The "talk to an expert" path under the closing band's buttons. */
---

<p class="cta-note">
	Evaluating for a large deployment?
	<CtaButton href="/contact-us/?subject=ThingsBoard%20Products" icon="tabler:messages">
		Talk to an expert
	</CtaButton>
</p>

<style lang="scss">
	@use '../../styles/variables' as *;

	.cta-note {
		@include text-m;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: $spacing-3;
		margin-top: $spacing-8;
		color: rgb(255 255 255 / 72%);
	}
</style>
