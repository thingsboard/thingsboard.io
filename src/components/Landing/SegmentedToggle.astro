---
import { Icon } from 'astro-icon/components';

/**
 * A segmented switch between panels, as ARIA tabs. Each panel is `role="tabpanel"` with
 * `aria-labelledby="<panel>-tab"`. Fires `segmented:change` on the tablist with
 * `{ index, previous, panel, previousPanel }`; the listener swaps the panels.
 */

interface Option {
	label: string;
	/** Replaces `label` at phone width. */
	shortLabel: string;
	icon: string;
	panel: string;
	/** Label and icon colour while chosen; must read on the white thumb. */
	color: string;
}

interface Props {
	options: Option[];
}

const { options } = Astro.props;
---

<div
	class="seg"
	role="tablist"
	aria-label="Two ways to build with AI"
	data-segmented
	style={`--seg-count: ${options.length}; --seg-index: 0`}
>
	<span class="seg__thumb" aria-hidden="true"></span>
	{options.map((o, i) => (
		<button
			type="button"
			class="seg__opt"
			role="tab"
			id={`${o.panel}-tab`}
			aria-controls={o.panel}
			aria-selected={i === 0 ? 'true' : 'false'}
			tabindex={i === 0 ? 0 : -1}
			style={`--seg-color: ${o.color}`}
		>
			<Icon name={o.icon} class="seg__icon" aria-hidden="true" />
			<span class="seg__label seg__label--long">{o.label}</span>
			<span class="seg__label seg__label--short">{o.shortLabel}</span>
		</button>
	))}
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-segmented]').forEach((list) => {
		const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

		const panelOf = (tab: HTMLElement) => document.getElementById(tab.getAttribute('aria-controls') ?? '');

		const select = (i: number, focus: boolean) => {
			const previous = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
			if (focus) tabs[i].focus();
			// Here rather than in the click handler, so Home and End on the chosen tab are no-ops too.
			if (i === previous) return;
			tabs.forEach((tab, j) => {
				const on = j === i;
				tab.setAttribute('aria-selected', String(on));
				tab.tabIndex = on ? 0 : -1;
			});
			list.style.setProperty('--seg-index', String(i));

			list.dispatchEvent(
				new CustomEvent('segmented:change', {
					detail: { index: i, previous, panel: panelOf(tabs[i]), previousPanel: panelOf(tabs[previous]) },
				})
			);
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(i, false));
		});

		// Automatic activation: the panels are already rendered, so arrowing onto a tab shows its panel.
		list.addEventListener('keydown', (e) => {
			const at = tabs.findIndex((t) => t === document.activeElement);
			const n = tabs.length;
			const next = { ArrowRight: at + 1, ArrowLeft: at - 1 + n, Home: 0, End: n - 1 }[e.key];
			if (at < 0 || next === undefined) return;
			e.preventDefault();
			select(next % n, true);
		});
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	.seg {
		--seg-pad: 3px;

		position: relative;
		display: inline-grid;
		grid-auto-columns: 1fr;
		grid-auto-flow: column;
		padding: var(--seg-pad);
		border-radius: $radius-full;
		background: #eef0f4;
		isolation: isolate;
	}

	.seg__thumb {
		position: absolute;
		z-index: -1;
		top: var(--seg-pad);
		bottom: var(--seg-pad);
		left: var(--seg-pad);
		width: calc((100% - 2 * var(--seg-pad)) / var(--seg-count));
		border-radius: $radius-full;
		background: #fff;
		box-shadow:
			0 1px 2px rgb(23 24 28 / 10%),
			0 3px 10px rgb(23 24 28 / 8%);
		transform: translateX(calc(var(--seg-index) * 100%));
		transition: transform var(--seg-duration) var(--seg-ease);
	}

	.seg__opt {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 40px;
		margin: 0;
		padding: 0 $spacing-4;
		border: 0;
		border-radius: $radius-full;
		background: none;
		font-size: $font-size-base;
		font-weight: $font-weight-medium;
		line-height: 1;
		white-space: nowrap;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: color 180ms ease;

		&:hover {
			color: var(--color-text);
		}

		&[aria-selected='true'] {
			color: var(--seg-color);
			cursor: default;
		}

		&:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}
	}

	.seg__icon {
		flex: none;
		width: 22px;
		height: 22px;
	}

	// Ellipsis rather than widening its segment out from under the thumb. Its own line-height, since
	// clipping at the button's `1` cuts the descenders.
	.seg__label {
		min-width: 0;
		overflow: hidden;
		line-height: 1.4;
		text-overflow: ellipsis;
	}

	// `display: none`, so the label not showing is out of the accessibility tree too.
	.seg__label--short {
		display: none;
	}

	// `minmax(0, 1fr)`: a bare `1fr` has a min-content floor, so a long label would grow its segment.
	@media (max-width: 480px) {
		.seg {
			display: grid;
			grid-auto-columns: minmax(0, 1fr);
			width: 100%;
		}

		.seg__label--long {
			display: none;
		}

		.seg__label--short {
			display: inline;
		}

		.seg__opt {
			min-height: 44px;
			padding: 0 $spacing-3;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.seg__thumb {
			transition: none;
		}
	}
</style>
