---
import { Icon } from 'astro-icon/components';
import CtaButton from '@components/Landing/CtaButton.astro';
import mark from '@root/icons/thingsboard-mark.svg?raw';
import type { Cta } from '@models/cta';

/**
 * A product page's opening: the product's mark over a centred headline, lede, actions and caption.
 * Colours come from the page's `--page-accent`, `--page-accent-light`, `--page-hero-ground` and `--page-hero-wash`.
 */
interface Props {
	title: string;
	subtitle: string;
	buttons: Cta[];
	caption: string[];
}

const { title, subtitle, buttons, caption } = Astro.props;
---

<section class="product-hero">
	<span class="product-hero__mark" aria-hidden="true" set:html={mark} />
	<h1>{title}</h1>
	<p class="product-hero__subtitle">{subtitle}</p>

	<div class="product-hero__buttons">
		{buttons.map(({ text, ...button }) => (
			<CtaButton {...button}>{text}</CtaButton>
		))}
	</div>

	<ul class="product-hero__caption">
		{caption.map((item) => (
			<li>
				<Icon name="tabler:check" aria-hidden="true" />
				{item}
			</li>
		))}
	</ul>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.product-hero {
		background-color: var(--page-hero-ground);
		background-image: radial-gradient(120% 90% at 50% 100%, var(--page-hero-wash), transparent 70%);
		color: $color-white;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: calc(#{$header-height} + 28px) var(--band-gutter) $spacing-16;
		text-align: center;

		@include media-down(sm) {
			padding-top: calc(#{$header-height} + 16px);
		}
	}

	.product-hero__mark {
		display: grid;
		place-items: center;
		width: 88px;
		height: 88px;
		margin-bottom: $spacing-5;
		border-radius: 32%;
		background-color: var(--page-accent);
		background-image: linear-gradient(150deg, rgb(255 255 255 / 24%), rgb(255 255 255 / 0%) 62%);

		@media (max-height: 620px), (max-width: #{$breakpoint-sm}) {
			width: 64px;
			height: 64px;
		}

		// The artwork fills its viewBox edge to edge, so the tile's inset comes from this width.
		:global(svg) {
			display: block;
			width: 60%;
			height: auto;
		}
	}

	h1 {
		@include hero-title;
		margin: 0 0 20px;
	}

	.product-hero__subtitle {
		@include text-m;
		line-height: 1.5;
		// The mixin colours for a light surface; this ground is always dark.
		color: $color-white;
		max-width: 52ch;
		margin: 0 0 32px;
		text-wrap: pretty;
	}

	.product-hero__buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;

		@include media-down(md) {
			flex-direction: column;
			width: 100%;
			max-width: 26rem;
		}
	}

	.product-hero__caption {
		@include text-s;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-2 $spacing-5;
		margin: $spacing-6 0 0;
		padding: 0;
		list-style: none;
		color: rgb(255 255 255 / 72%);

		@include media-down(sm) {
			column-gap: $spacing-3;
		}

		li {
			display: flex;
			align-items: center;
			gap: 6px;
		}

		:global(svg) {
			flex: none;
			width: 16px;
			height: 16px;
			color: var(--page-accent-light);
		}
	}

	.product-hero > * {
		// `backwards` holds the from-state through the delay, so nothing is parked at 0.
		animation: hero-rise 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) backwards;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	h1 {
		animation-delay: 300ms;
	}

	.product-hero__subtitle {
		animation-delay: 600ms;
	}

	.product-hero__buttons {
		animation-delay: 900ms;
	}

	.product-hero__caption {
		animation-delay: 1200ms;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
		}
	}
</style>
