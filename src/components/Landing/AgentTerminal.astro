---
import { GLYPH, artCols, type AgentStep } from '@models/agent-terminal';
import { AI_AGENT_LABEL } from '@data/ai-visual';

/**
 * A terminal running a coding agent, playing `session` on a loop over a server-rendered finished log.
 * Reads `--accent` from `AiSection`'s band; sized to the mono stack's 0.6em advance.
 */

interface Props {
	session: AgentStep[];
}

const { session } = Astro.props;

/** A blank line between speakers. The banner carries its own gap. */
const speaker = (st: AgentStep) => (st.role === 'user' ? 'me' : st.role === 'banner' ? 'sys' : 'ai');
const gapBefore = (i: number) =>
	i > 0 && speaker(session[i - 1]) !== 'sys' && speaker(session[i - 1]) !== speaker(session[i]);
const turnCls = (i: number) => (gapBefore(i) ? 'agent__row agent__row--gap' : 'agent__row');
---

<div class="agent" role="img" aria-label={AI_AGENT_LABEL} data-agent-session={JSON.stringify(session)}>
	<div class="agent__bar" aria-hidden="true">
		<span class="agent__dot agent__dot--close"></span>
		<span class="agent__dot agent__dot--min"></span>
		<span class="agent__dot agent__dot--max"></span>
		<span class="agent__path">smart-retail — agent</span>
	</div>

	<div class="agent__scroll">
		{[false, true].map((final) => (
			<div class:list={['agent__body', final && 'agent__body--final print:only']} aria-hidden="true">
				{
					/* The `.agent__text` spans stay on one line: the column is `pre-wrap`, so a template
					   newline would render. */
					session.map((st, i) => {
						if (st.role === 'banner')
							return (
								<span class="agent__banner" style={`--agent-art: ${artCols(st.art)}`}>
									{st.art.map((row, i) =>
										// prettier-ignore
										<span class="agent__banner-row"><span class="agent__art">{row}</span><span class="agent__banner-line">{(st.lines[i] ?? []).map((sg) => (<span class={`agent__b-${sg.t}`}>{sg.v}</span>))}</span></span>
									)}
								</span>
							);
						if (st.role === 'user')
							return (
								<span class={turnCls(i)}>
									<span class="agent__prompt">{GLYPH.prompt}</span>
									{/* prettier-ignore */}
									<span class="agent__text agent__text--user">{st.text}</span>
								</span>
							);
						if (st.role === 'tool')
							return (
								<Fragment>
									<span class={turnCls(i)}>
										<span class="agent__bullet agent__bullet--tool">{GLYPH.dot}</span>
										{/* prettier-ignore */}
										<span class="agent__text agent__text--tool">{st.text}</span>
									</span>
									<span class="agent__row">
										<span class="agent__gap"></span>
										{/* prettier-ignore */}
										<span class="agent__text agent__text--nest agent__text--ok"><span class="agent__tree">{GLYPH.tree}</span>{st.result}</span>
									</span>
								</Fragment>
							);
						return (
							<Fragment>
								<span class={turnCls(i)}>
									<span class="agent__bullet">{GLYPH.dot}</span>
									{/* prettier-ignore */}
									<span class="agent__text">{st.text}</span>
								</span>
								{(st.items ?? []).map((it) => (
									<span class="agent__row">
										<span class="agent__gap"></span>
										{/* prettier-ignore */}
										<span class="agent__text agent__text--item"><span class="agent__dash">{GLYPH.item}</span>{it}</span>
									</span>
								))}
								{st.tail && (
									<span class="agent__row">
										<span class="agent__gap"></span>
										{/* prettier-ignore */}
										<span class="agent__text">{st.tail}</span>
									</span>
								)}
							</Fragment>
						);
					})
				}
			</div>
		))}
	</div>

	<div class="agent__input" aria-hidden="true">
		<span class="agent__prompt">{GLYPH.prompt}</span>
		{/* One line: the cell is `pre-wrap`. */}
		{/* prettier-ignore */}
		<span class="agent__line"><span class="agent__typed print:hidden"></span><span class="agent__caret agent__caret--idle"></span><span class="agent__ghost print:hidden"></span></span>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	.agent {
		--agent-chrome: 1;
		// Everything vertical is a multiple of this leading, so the log sizes in whole lines from it and
		// `font-size`.
		--agent-lead: 1.3;

		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 10px;
		background: #14161d;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.06) inset,
			0 8px 18px rgba(0, 0, 0, 0.3);
		font-family: $font-family-mono;
		font-size: 18px;
		line-height: var(--agent-lead);
		text-align: left;
	}

	.agent__bar {
		display: flex;
		flex: none;
		align-items: center;
		gap: calc(6px * var(--agent-chrome));
		padding: calc(10px * var(--agent-chrome)) calc(12px * var(--agent-chrome));
		background: #232733;
	}

	.agent__dot {
		width: calc(10px * var(--agent-chrome));
		height: calc(10px * var(--agent-chrome));
		border-radius: 50%;
	}

	.agent__dot--close {
		background: #ec6a5e;
	}

	.agent__dot--min {
		background: #f4bf4f;
	}

	.agent__dot--max {
		background: #61c454;
	}

	// The right padding mirrors the dots, so the title centres in the bar, not in the space left.
	// The line box is pinned so the bar keeps its height.
	.agent__path {
		flex: 1 1 auto;
		padding-right: calc(48px * var(--agent-chrome));
		font-size: 16px;
		line-height: 18.2px;
		letter-spacing: 0.02em;
		text-align: center;
		color: rgba(255, 255, 255, 0.6);
	}

	.agent__scroll {
		flex: 1 1 auto;
		min-height: 0;
	}

	.agent__body {
		height: 100%;
		// One empty line at the foot, so the last output never sits on the composer's rule.
		padding: $spacing-4 $spacing-4 calc(var(--agent-lead) * 1em);
		overflow-y: auto;
		overscroll-behavior: contain;
		color: #e6e8ef;
		transition: opacity 0.25s ease;
		scrollbar-width: none;

		&::-webkit-scrollbar {
			width: 0;
			height: 0;
		}
	}

	.agent__body--clearing {
		opacity: 0;
	}

	.agent__input {
		display: grid;
		flex: none;
		grid-template-columns: 1.65em minmax(0, 1fr);
		align-items: start;
		padding: 0.5em $spacing-4 0.6em;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		color: #f2f4f8;
	}

	.agent__line {
		min-width: 0;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.agent__ghost {
		color: rgba(230, 232, 239, 0.4);
	}

	// Every log rule is `:global`: the player builds its rows with `createElement`, so they never carry
	// the scope class. `.agent` itself is server-rendered and confines them.
	.agent {
		// A gutter and a text column, so a wrapped line comes back under its first word, not the glyph.
		:global(.agent__row) {
			display: grid;
			grid-template-columns: 1.65em minmax(0, 1fr);
			align-items: start;
		}

		// One whole blank line, so every gap stays on the line grid.
		:global(.agent__row--gap) {
			margin-top: calc(var(--agent-lead) * 1em);
		}

		// `pre`, so the art's spaces hold.
		:global(.agent__banner) {
			display: block;
			margin-bottom: calc(var(--agent-lead) * 1em);
			white-space: pre;
		}

		:global(.agent__banner-row) {
			display: block;
		}

		:global(.agent__art) {
			display: inline-block;
			width: calc(var(--agent-art) * 1ch);
			color: var(--accent);
		}

		:global(.agent__banner-line) {
			padding-left: 2em;
		}

		:global(.agent__b-brand) {
			color: #f2f4f8;
		}

		:global(.agent__b-ok) {
			color: #63d19e;
		}

		:global(.agent__b-arg) {
			color: #d2a8ff;
		}

		:global(.agent__b-dim) {
			color: rgba(230, 232, 239, 0.55);
		}

		:global(.agent__prompt),
		:global(.agent__bullet),
		:global(.agent__spin),
		:global(.agent__gap) {
			display: inline-block;
			width: 1.1em;
			text-align: center;
		}

		:global(.agent__text) {
			min-width: 0;
			white-space: pre-wrap;
			overflow-wrap: anywhere;
		}

		:global(.agent__prompt) {
			color: var(--accent);
		}

		:global(.agent__text--user) {
			color: #f2f4f8;
		}

		:global(.agent__bullet--tool) {
			color: var(--accent);
		}

		:global(.agent__text--tool) {
			color: #c7cdd6;
		}

		// Nested lines hang their glyph, so wrapped lines come back under the first word.
		:global(.agent__text--nest) {
			padding-left: 1.65em;
			text-indent: -1.65em;
		}

		:global(.agent__text--item) {
			padding-left: 1.15em;
			text-indent: -1.15em;
			color: rgba(230, 232, 239, 0.72);
		}

		:global(.agent__tree),
		:global(.agent__dash) {
			display: inline-block;
			width: 1.65em;
			text-indent: 0;
			color: rgba(230, 232, 239, 0.45);
		}

		:global(.agent__dash) {
			width: 1.15em;
		}

		:global(.agent__row--think) {
			color: var(--accent);
		}

		:global(.agent__row--done) {
			color: rgba(230, 232, 239, 0.45);
		}

		:global(.agent__text--ok) {
			color: #63d19e;
		}

		:global(.agent__text--dim) {
			color: rgba(230, 232, 239, 0.55);
		}

		// One character cell.
		:global(.agent__caret) {
			display: inline-block;
			width: 0.6em;
			height: 1em;
			vertical-align: -0.167em;
			background: #f2f4f8;
		}

		:global(.agent__caret--idle) {
			animation: agent-blink 1.1s steps(1, end) infinite;
		}

		// Over a suggestion, the cursor stands on its first cell in reverse video. It takes no cell, so
		// accepting the suggestion moves nothing but the cursor.
		:global(.agent__caret--over) {
			position: relative;
			z-index: 1;
			margin-right: -0.6em;
			mix-blend-mode: difference;
			animation: none;
		}

		:global(.agent__caret--over.agent__caret--hold) {
			animation: agent-blink 1.1s steps(1, end) infinite;
		}
	}

	@keyframes agent-blink {
		0%,
		50% {
			opacity: 1;
		}
		50.01%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.agent :global(.agent__caret--idle) {
			animation: none;
		}
	}

	@media print {
		.agent {
			border: 1px solid #d5d9e0;
			background: #fff;
			box-shadow: none;
		}

		.agent__bar {
			border-bottom: 1px solid #e3e6eb;
			background: #f1f3f6;
		}

		.agent__path {
			color: #5b616e;
		}

		.agent__scroll {
			position: relative;
		}

		.agent__body:not(.agent__body--final) {
			position: absolute;
			inset: 0;
			visibility: hidden;
		}

		.agent__body--final {
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			overflow: hidden;
		}

		.agent__body,
		.agent__input {
			color: #1c1f26;
		}

		.agent__input {
			border-top-color: rgba(0, 0, 0, 0.12);
		}

		.agent {
			:global(.agent__b-brand),
			:global(.agent__text--user) {
				color: #1c1f26;
			}

			:global(.agent__b-ok),
			:global(.agent__text--ok) {
				color: #17804a;
			}

			:global(.agent__b-arg) {
				color: #7c3aed;
			}

			:global(.agent__b-dim) {
				color: #646b78;
			}

			:global(.agent__text--tool),
			:global(.agent__text--item) {
				color: #3b4150;
			}

			:global(.agent__tree),
			:global(.agent__dash) {
				color: #8a909c;
			}

			:global(.agent__caret) {
				opacity: 1 !important;
				background: #1c1f26;
				mix-blend-mode: normal;
			}
		}
	}
</style>

<script>
	import { GLYPH, artCols, type AgentStep } from '@models/agent-terminal';
	import { whenRendered } from '@util/when-rendered';

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const PULSE = [...'⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'];

	/**
	 * Plays the session on a loop, held to the viewport and tab visibility at cycle boundaries, and
	 * restarted when the section's switch reveals the window from `display: none`.
	 */
	function play(
		root: HTMLElement,
		body: HTMLElement,
		typed: HTMLElement,
		caret: HTMLElement,
		ghost: HTMLElement,
		steps: AgentStep[]
	) {
		let timers: number[] = [];
		let run = 0;
		let onScreen = false;
		let parked = 0;
		let undisplayed = false;

		const at = (ms: number, fn: () => void) => {
			const id = run;
			timers.push(
				window.setTimeout(() => {
					if (id === run) fn();
				}, ms)
			);
		};

		// A reader who scrolls up is left alone. `away` is set by the gesture, not the scroll event, which
		// arrives a frame late, after a streamed word may already have scrolled the log back to its end.
		let away = false;
		let awaySince = 0;
		const atEnd = () => body.scrollHeight - body.clientHeight - body.scrollTop < 2;
		const leave = () => {
			if (!away) awaySince = performance.now();
			away = true;
		};
		const settle = () => {
			requestAnimationFrame(() => {
				if (atEnd()) away = false;
			});
		};
		body.addEventListener('wheel', (e) => (e.deltaY < 0 ? leave() : settle()), { passive: true });
		body.addEventListener('touchmove', leave, { passive: true });
		body.addEventListener('touchend', settle, { passive: true });
		body.addEventListener('keydown', (e) => (['ArrowUp', 'PageUp', 'Home'].includes(e.key) ? leave() : settle()));
		body.addEventListener(
			'scroll',
			() => {
				if (atEnd()) away = false;
			},
			{ passive: true }
		);
		// Scrolled away, or the pointer moving on the window, holds the restart for up to 30s.
		let hoverSince = 0;
		root.addEventListener('pointermove', () => (hoverSince = performance.now()), { passive: true });
		const engaged = () => {
			const now = performance.now();
			if (away && now - awaySince < 30000) return true;
			return root.matches(':hover') && now - hoverSince < 30000;
		};

		const follow = () => {
			if (away) return;
			body.scrollTop = body.scrollHeight;
		};

		// The thinking line: a row of the log, kept last while the agent works.
		let think: HTMLElement | null = null;
		let pulse = 0;
		let turnStart = 0;
		const thinking = (on: boolean) => {
			window.clearInterval(pulse);
			pulse = 0;
			if (!on) {
				think?.remove();
				think = null;
				follow();
				return;
			}
			if (!think) {
				turnStart = performance.now();
				think = document.createElement('span');
				think.className = 'agent__row agent__row--think';
				const g = document.createElement('span');
				g.className = 'agent__spin';
				const t = document.createElement('span');
				t.className = 'agent__text';
				t.textContent = 'Thinking…';
				think.append(g, t);
			}
			body.appendChild(think);
			const g = think.firstElementChild as HTMLElement;
			let f = 0;
			const tick = () => {
				g.textContent = PULSE[f++ % PULSE.length];
			};
			tick();
			pulse = window.setInterval(tick, 120);
			timers.push(pulse);
			follow();
		};

		/** The thinking line becomes `⠿ Done in Ns`, from the turn's real duration, and stays in the log. */
		const finish = () => {
			if (!think) return;
			window.clearInterval(pulse);
			pulse = 0;
			const secs = Math.max(1, Math.round((performance.now() - turnStart) / 1000));
			think.className = 'agent__row agent__row--think agent__row--done';
			(think.firstElementChild as HTMLElement).textContent = '\u283f';
			(think.lastElementChild as HTMLElement).textContent = `Done in ${secs}s`;
			think = null;
			follow();
		};

		/** Whether step `n` closes the agent's turn: the next step is the person's, or there is none. */
		const closes = (n: number) => !steps[n + 1] || steps[n + 1].role === 'user';

		// Who printed last, for `.agent__row--gap`. `sys` is the banner, which carries its own gap.
		let last: 'me' | 'ai' | 'sys' | '' = '';

		/** Opens a log row above the thinking line. `turn` is the speaker opening a turn, or false within one. */
		const row = (glyph: string, glyphCls: string, textCls: string, turn: 'me' | 'ai' | false) => {
			const r = document.createElement('span');
			const gap = turn && last && last !== 'sys' && last !== turn;
			r.className = gap ? 'agent__row agent__row--gap' : 'agent__row';
			if (turn) last = turn;
			const g = document.createElement('span');
			g.className = glyphCls;
			g.textContent = glyph;
			const t = document.createElement('span');
			t.className = textCls;
			r.append(g, t);
			body.insertBefore(r, think);
			follow();
			return { glyph: g, text: t };
		};

		/** A tool's result or an answer's point, behind its hanging glyph. */
		const nested = (glyph: string, glyphCls: string, textCls: string) => {
			const { text } = row('', 'agent__gap', textCls, false);
			const lead = document.createElement('span');
			lead.className = glyphCls;
			lead.textContent = glyph;
			const host = document.createElement('span');
			text.append(lead, host);
			return { text, lead, host };
		};

		const type = (value: string, done: () => void) => {
			caret.classList.remove('agent__caret--idle');
			let ci = 0;
			const tick = () => {
				if (document.hidden) {
					at(300, tick);
					return;
				}
				typed.textContent += value.charAt(ci++);
				if (ci >= value.length) {
					at(320, done);
					return;
				}
				at(28 + Math.random() * 40, tick);
			};
			tick();
		};

		/** Offers the text as ghost text after the caret, then accepts it whole, as Tab would. */
		const suggest = (value: string, done: () => void, hold = false) => {
			ghost.textContent = value;
			caret.classList.add('agent__caret--over');
			if (hold) {
				caret.classList.add('agent__caret--hold');
				return;
			}
			at(1400, () => {
				caret.classList.remove('agent__caret--idle', 'agent__caret--over');
				ghost.textContent = '';
				typed.textContent = value;
				at(420, done);
			});
		};

		const send = () => {
			const { text } = row(GLYPH.prompt, 'agent__prompt', 'agent__text agent__text--user', 'me');
			text.textContent = typed.textContent;
			typed.textContent = '';
			caret.classList.add('agent__caret--idle');
			follow();
		};

		const stream = (host: HTMLElement, text: string, done: () => void) => {
			const words = text.split(' ');
			let i = 0;
			const next = () => {
				if (document.hidden) {
					at(300, next);
					return;
				}
				host.textContent += (i ? ' ' : '') + words[i++];
				follow();
				if (i >= words.length) {
					done();
					return;
				}
				at(24 + Math.random() * 40, next);
			};
			next();
		};

		const step = (n: number) => {
			if (n >= steps.length) {
				at(7000, cycle);
				return;
			}
			const st = steps[n];
			const then = (ms: number) => at(ms, () => step(n + 1));

			if (st.role === 'banner') {
				const b = document.createElement('span');
				b.className = 'agent__banner';
				b.style.setProperty('--agent-art', String(artCols(st.art)));
				st.art.forEach((row, i) => {
					const r = document.createElement('span');
					r.className = 'agent__banner-row';
					const art = document.createElement('span');
					art.className = 'agent__art';
					art.textContent = row;
					const line = document.createElement('span');
					line.className = 'agent__banner-line';
					(st.lines[i] ?? []).forEach((sg) => {
						const el = document.createElement('span');
						el.className = `agent__b-${sg.t}`;
						el.textContent = sg.v;
						line.appendChild(el);
					});
					r.append(art, line);
					b.appendChild(r);
				});
				body.insertBefore(b, think);
				last = 'sys';
				follow();
				then(900);
				return;
			}

			if (st.role === 'user') {
				if (st.suggested && st.pending) {
					suggest(st.text, () => {}, true);
					then(0);
					return;
				}
				const enter = st.suggested ? suggest : type;
				enter(st.text, () => {
					send();
					thinking(true);
					then(700);
				});
				return;
			}

			if (st.role === 'tool') {
				thinking(true);
				const { text } = row(GLYPH.dot, 'agent__bullet agent__bullet--tool', 'agent__text agent__text--tool', 'ai');
				text.textContent = st.text;
				const nest = nested(GLYPH.tree, 'agent__tree', 'agent__text agent__text--nest agent__text--dim');
				nest.host.textContent = 'Running\u2026';
				// Follow after the text lands: an empty row has no height yet.
				follow();
				at(st.spin, () => {
					nest.host.textContent = st.result;
					nest.text.className = 'agent__text agent__text--nest agent__text--ok';
					follow();
					if (closes(n)) finish();
					then(420);
				});
				return;
			}

			// agent
			thinking(true);
			const { text } = row(GLYPH.dot, 'agent__bullet', 'agent__text', 'ai');
			const { items = [], tail } = st;
			const close = () => {
				if (closes(n)) finish();
				then(700);
			};
			const item = (i: number) => {
				if (i >= items.length) {
					if (!tail) {
						close();
						return;
					}
					at(360, () => {
						const { text: t } = row('', 'agent__gap', 'agent__text', false);
						stream(t, tail, close);
					});
					return;
				}
				const { host } = nested(GLYPH.item, 'agent__dash', 'agent__text agent__text--item');
				stream(host, items[i], () => at(140, () => item(i + 1)));
			};
			stream(text, st.text, () => at(220, () => item(0)));
		};

		function cycle() {
			if (!onScreen || document.hidden || engaged()) {
				if (parked) return;
				parked = window.setTimeout(() => {
					parked = 0;
					cycle();
				}, 600);
				return;
			}
			begin();
		}

		function begin() {
			run++;
			timers.forEach((t) => {
				window.clearTimeout(t);
				window.clearInterval(t);
			});
			timers = [];
			const start = () => {
				think = null;
				last = '';
				away = false;
				body.innerHTML = '';
				body.scrollTop = 0;
				body.classList.remove('agent__body--clearing');
				typed.textContent = '';
				ghost.textContent = '';
				caret.classList.remove('agent__caret--over', 'agent__caret--hold');
				caret.classList.add('agent__caret--idle');
				step(0);
			};
			// An empty log starts at once.
			if (!body.firstChild) {
				start();
				return;
			}
			body.classList.add('agent__body--clearing');
			at(260, start);
		}

		new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					onScreen = e.isIntersecting;
					if (onScreen && undisplayed) {
						window.clearTimeout(parked);
						parked = 0;
						begin();
					}
					undisplayed = !onScreen && e.boundingClientRect.height === 0;
				});
			},
			{ threshold: 0.2 }
		).observe(root);

		cycle();
	}

	document.querySelectorAll<HTMLElement>('.agent').forEach((root) => {
		const body = root.querySelector<HTMLElement>('.agent__body:not(.agent__body--final)');
		const typed = root.querySelector<HTMLElement>('.agent__typed');
		const caret = root.querySelector<HTMLElement>('.agent__caret');
		const ghost = root.querySelector<HTMLElement>('.agent__ghost');
		const raw = root.dataset.agentSession;
		if (!body || !typed || !caret || !ghost || !raw || reduce) return;
		whenRendered(root, () => play(root, body, typed, caret, ghost, JSON.parse(raw) as AgentStep[]));
	});
</script>
