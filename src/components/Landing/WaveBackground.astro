---
import { renderId } from '@util/render-id';

interface Props {
	/** Clipped to the section it sits in, rather than running the width of the page. */
	contained?: boolean;
}

const { contained = false } = Astro.props;
// Per-render gradient ids: with a fixed id, a second field on the page would use the first one's.
const uid = renderId(Astro.locals, 'wave-bg');
// Diagonal animated wave background — upper-left to bottom-right, converging at bottom
// Each wave is its own <svg> layer in an HTML wrapper, moved by a CSS transform animation that
// the compositor runs alone. SMIL <animateTransform> is never composited: every frame it re-ran
// SVG style and layout and re-rastered the masked field, which held back the next paint after
// every interaction.
// Light mode: blue waves on white; Dark mode: lighter waves on dark bg
---

<div class:list={['wave-bg', contained && 'wave-bg--contained', 'print:hidden']} aria-hidden="true">
	<div class="wave-bg__field">
		<svg
			class="wave-bg__layer"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 900 900"
			preserveAspectRatio="xMaxYMid slice"
		>
			<defs>
				{/*
					`userSpaceOnUse` so the radii are in absolute viewBox units,
					not relative to the backing rect. That lets us stretch the
					rect vertically (below) to cover the same -900..2700 range
					as the wave paths without dragging the gradient centres along
					with it.
				*/}
				<radialGradient id={`${uid}-glow-1`} cx="585" cy="315" r="495" gradientUnits="userSpaceOnUse">
					<stop offset="0%" stop-color="var(--wave-bg-color)" stop-opacity="0.10" />
					<stop offset="100%" stop-color="var(--wave-bg-color)" stop-opacity="0" />
				</radialGradient>
				<radialGradient id={`${uid}-glow-2`} cx="405" cy="630" r="360" gradientUnits="userSpaceOnUse">
					<stop offset="0%" stop-color="var(--wave-bg-color)" stop-opacity="0.06" />
					<stop offset="100%" stop-color="var(--wave-bg-color)" stop-opacity="0" />
				</radialGradient>
			</defs>

			{/*
				Static glow blobs — extended to the same -900..2700 range as the
				waves below so their top/bottom edges don't show as faint
				opacity steps after the field's -28deg rotation. The gradients
				use userSpaceOnUse and stay anchored to their original positions
				in the viewBox; the rect just provides the fill canvas.
			*/}
			<rect x="0" y="-900" width="900" height="3600" fill={`url(#${uid}-glow-1)`} />
			<rect x="0" y="-900" width="900" height="3600" fill={`url(#${uid}-glow-2)`} />
		</svg>

		{/*
			Wave A — large, very slow, rightmost
			Vertical sine: baseline x=700, amplitude 100, period 900.
			Path body extends one period above (y=-900) and one below
			(y=2700) the original 0..1800 range so the horizontal top/bottom
			closures stay well outside any visible viewport position even
			after the field's -28deg rotation slices into the canvas.
		*/}
		<div class="wave-bg__wave wave-bg__wave--a">
			<svg
				class="wave-bg__layer"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 900 900"
				preserveAspectRatio="xMaxYMid slice"
			>
				<path
					d="M700,-900 C800,-736 800,-614 700,-450 C600,-286 600,-164 700,0 C800,164 800,286 700,450 C600,614 600,736 700,900 C800,1064 800,1186 700,1350 C600,1514 600,1636 700,1800 C800,1964 800,2086 700,2250 C600,2414 600,2536 700,2700 L900,2700 L900,-900Z"
					fill="var(--wave-bg-color)"
					fill-opacity="0.055"
				/>
			</svg>
		</div>

		{/*
			Wave B — slow, mid-right, opposite direction
			Baseline x=550, amplitude 80, period 600. Extended -600..2400.
		*/}
		<div class="wave-bg__wave wave-bg__wave--b">
			<svg
				class="wave-bg__layer"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 900 900"
				preserveAspectRatio="xMaxYMid slice"
			>
				<path
					d="M550,-600 C630,-491 630,-409 550,-300 C470,-191 470,-109 550,0 C630,109 630,191 550,300 C470,409 470,491 550,600 C630,709 630,791 550,900 C470,1009 470,1091 550,1200 C630,1309 630,1391 550,1500 C470,1609 470,1691 550,1800 C630,1909 630,1991 550,2100 C470,2209 470,2291 550,2400 L900,2400 L900,-600Z"
					fill="var(--wave-bg-color)"
					fill-opacity="0.045"
				/>
			</svg>
		</div>

		{/*
			Wave C — medium, left-of-center
			Baseline x=380, amplitude 65, period 450. Extended -450..2250.
		*/}
		<div class="wave-bg__wave wave-bg__wave--c">
			<svg
				class="wave-bg__layer"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 900 900"
				preserveAspectRatio="xMaxYMid slice"
			>
				<path
					d="M380,-450 C445,-368 445,-307 380,-225 C315,-143 315,-82 380,0 C445,82 445,143 380,225 C315,307 315,368 380,450 C445,532 445,593 380,675 C315,757 315,818 380,900 C445,982 445,1043 380,1125 C315,1207 315,1268 380,1350 C445,1432 445,1493 380,1575 C315,1657 315,1718 380,1800 C445,1882 445,1943 380,2025 C315,2107 315,2168 380,2250 L900,2250 L900,-450Z"
					fill="var(--wave-bg-color)"
					fill-opacity="0.035"
				/>
			</svg>
		</div>

		{/*
			Wave D — very slow, largest, leftmost, opposite direction
			Baseline x=220, amplitude 120, period 900. Extended -900..2700.
		*/}
		<div class="wave-bg__wave wave-bg__wave--d">
			<svg
				class="wave-bg__layer"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 900 900"
				preserveAspectRatio="xMaxYMid slice"
			>
				<path
					d="M220,-900 C340,-736 340,-614 220,-450 C100,-286 100,-164 220,0 C340,164 340,286 220,450 C100,614 100,736 220,900 C340,1064 340,1186 220,1350 C100,1514 100,1636 220,1800 C340,1964 340,2086 220,2250 C100,2414 100,2536 220,2700 L900,2700 L900,-900Z"
					fill="var(--wave-bg-color)"
					fill-opacity="0.035"
				/>
			</svg>
		</div>
	</div>
</div>

<style>
	.wave-bg {
		--wave-bg-color: #3369FF;

		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
		perspective: 1400px;
	}

	/* Same class weight as `.wave-bg`, so it has to stay after it to win. */
	.wave-bg--contained {
		position: absolute;
	}

	/* `:global()`: the theme attribute sits on <html>, outside this component's scope. `:where()` keeps
	   this default below any section's own `--wave-bg-color`, whatever order the stylesheets land in. */
	:global([data-theme='dark']) :where(.wave-bg) {
		--wave-bg-color: #6b9aff;
	}

	.wave-bg__field {
		position: absolute;
		right: -20%;
		top: -45%;
		width: 110%;
		height: 180%;
		overflow: visible;
		transform: rotate(-28deg) rotateY(-6deg);
		transform-origin: top right;
		/* The waves size their travel from this box: see the keyframes. */
		container-type: size;

		/* Mask is in the field's local space, so this top→bottom fade rotates
		   with `transform` and tracks the -28deg edge — don't change to a
		   screen-space gradient. */
		--wave-bg-fade: linear-gradient(
			to bottom,
			transparent 0%,
			#000 12%,
			#000 88%,
			transparent 100%
		);
		-webkit-mask-image: var(--wave-bg-fade);
		mask-image: var(--wave-bg-fade);
	}

	/* Every layer fills the whole field with the same viewBox mapping, so its paths land
	   exactly where they would in one SVG. `overflow: visible` keeps painting the parts of
	   a wave outside y = 0..900, which the translate brings into view. */
	.wave-bg__layer {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* The animation sits on an HTML wrapper, not on the <svg>: Chromium never composites a
	   transform animation on an SVG element whose zoom isn't 1, and that zoom includes the
	   device pixel ratio and browser zoom, so on phones and HiDPI screens it would tick on the
	   main thread. Not a container, so the keyframes' `cq` units still measure the field. */
	.wave-bg__wave {
		position: absolute;
		inset: 0;
	}

	.wave-bg__wave--a {
		animation: wave-bg-a 40s linear infinite;
	}

	.wave-bg__wave--b {
		animation: wave-bg-b 28s linear infinite;
	}

	.wave-bg__wave--c {
		animation: wave-bg-c 18s linear infinite;
	}

	.wave-bg__wave--d {
		animation: wave-bg-d 50s linear infinite;
	}

	/* On narrow viewports the tall, narrow box made `slice` zoom the square
	   wave field ~1.8x and show only its right edge (a flat wedge). Keep the
	   box near-square so the full wave pattern shows, like on desktop. */
	@media (max-width: 768px) {
		.wave-bg__field {
			width: 220%;
			height: 110%;
			right: -60%;
			top: -20%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wave-bg__field {
			display: none;
		}
	}

	/* Each wave travels exactly one period, so the loop has no seam. The distances are in
	   viewBox units: `slice` scales the 900-unit viewBox to the larger side of the box, so
	   k units are k / 900 × max(width, height). A `%` would follow the height alone, and
	   on phones and wide desktop screens the box can be wider than it is tall. */
	@keyframes wave-bg-a {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(calc(max(100cqw, 100cqh) * -900 / 900));
		}
	}

	@keyframes wave-bg-b {
		from {
			transform: translateY(calc(max(100cqw, 100cqh) * -600 / 900));
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes wave-bg-c {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(calc(max(100cqw, 100cqh) * -450 / 900));
		}
	}

	@keyframes wave-bg-d {
		from {
			transform: translateY(calc(max(100cqw, 100cqh) * -900 / 900));
		}
		to {
			transform: translateY(0);
		}
	}
</style>
