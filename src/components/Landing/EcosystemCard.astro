---
import { Icon } from 'astro-icon/components';
import SmartImage from '@components/SmartImage.astro';
import GifVideo from '@components/GifVideo.astro';
import GatewayRelay from '@components/Landing/GatewayRelay.astro';
import { externalLinkAttrs } from '@util/external-links';
import type { EcosystemItem } from '@data/homeEcosystem';

/**
 * An ecosystem product card; a wide one spans two columns and carries a visual beside the copy.
 * The whole card is one link; the Hub's tiles sit above it as links of their own.
 */
type Props = EcosystemItem;

const {
	name,
	label,
	description,
	icon,
	href,
	action,
	accent,
	addOn = false,
	wide = false,
	layout,
	relay,
	video,
	tiles,
} = Astro.props;

// Iconify or local `src/icons/` names; anything else is an image path.
const isGlyph = !icon.startsWith('/');
---

<div
	class:list={[
		'eco',
		wide && 'eco--wide',
		layout?.cols3 === 'flip' && 'eco--flip-3',
		layout?.cols2 === 'flip' && 'eco--flip-2',
		layout?.cols2 === 'single' && 'eco--single-2',
	]}
	style={`--accent: ${accent}`}
>
	<span class="eco__badge" aria-hidden="true">
		{isGlyph ? (
			<Icon name={icon} class="eco__icon eco__icon--glyph" />
		) : (
			<SmartImage src={icon} alt="" class="eco__icon" width="72" height="72" loading="lazy" />
		)}
	</span>

	<div class="eco__body">
		<p class="eco__label">
			{label}
			{addOn && <span class="eco__addon"> · Add-on</span>}
		</p>
		<h3 class="eco__title">{name}</h3>
		{[description].flat().map((para) => (
			<p class="eco__description">{para}</p>
		))}

		<a href={href} class="eco__link print:hidden" {...externalLinkAttrs(href)}>
			{action}
			<span class="sr-only">— {name}</span>
			<Icon name="tabler:chevron-right" class="link-chevron" aria-hidden="true" />
		</a>
	</div>

	{relay && (
		<div class="eco__visual eco__relay">
			<GatewayRelay />
		</div>
	)}

	{tiles && (
		<div class="eco__visual eco__tiles">
			{tiles.map((tile) => (
				<a class="eco__tile" href={tile.href} style={`--tile: ${tile.color}`}>
					<Icon name={tile.icon} class="eco__tile-icon" aria-hidden="true" />
					{tile.label}
				</a>
			))}
		</div>
	)}

	{video && (
		<div class="eco__visual eco__mockup" aria-hidden="true">
			<div class="eco__phone">
				<GifVideo srcWebm={video.webm} srcMp4={video.mp4} threshold={0} />
			</div>
		</div>
	)}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/home-card' as *;
	@use '../../styles/print-mixins' as *;

	.eco {
		@include home-card;
		padding-top: calc($home-card-badge / 2 + #{$spacing-3});
		cursor: pointer;
		transition: box-shadow 0.18s ease;

		// Covers the whole card, as long as `.eco__body` stays unpositioned.
		.eco__link::after {
			content: '';
			position: absolute;
			inset: 0;
		}

		&:hover,
		&:focus-within {
			box-shadow: 0 12px 28px rgba(0, 0, 0, 0.07);

			.eco__link {
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}
	}

	.eco__badge {
		@include home-card-badge;
		background-color: var(--color-bg-surface);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
	}

	.eco__icon {
		width: 82%;
		height: auto;
	}

	.eco__icon--glyph {
		width: 64%;
		height: auto;
		color: var(--accent);
	}

	// The platform's own mark stays in ink rather than the product colour.
	.eco__icon--glyph[data-icon='thingsboard-mark'] {
		color: var(--color-text);
	}

	.eco__body {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.eco__label {
		@include home-card-eyebrow;
		color: var(--accent);
	}

	.eco__addon {
		color: var(--color-text-secondary);
	}

	.eco__title {
		@include home-card-title;
	}

	.eco__description {
		@include home-card-copy;

		&:not(:last-of-type) {
			margin-bottom: $spacing-1;
		}
	}

	// Pinned to the bottom, so the links line up across a row of cards of different heights.
	.eco__link {
		@include home-card-link;
		margin-top: auto;
		color: var(--accent);
	}

	// Stacked, a wide card is a plain one.
	.eco__visual {
		display: none;
	}

	.eco--wide {
		--glow-x: 50%;
		@include home-card-glow(var(--accent), var(--glow-x));
	}

	@mixin wide-layout {
		--glow-x: 25%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		gap: $spacing-5;

		.eco__badge {
			left: 25%;
		}

		// No badge over the visual column, so it rises into the head's room.
		.eco__visual {
			display: grid;
			margin-top: calc(#{$spacing-5} - $home-card-badge / 2 - #{$spacing-3});
		}
	}

	@mixin wide-flip {
		--glow-x: 75%;

		.eco__body {
			order: 2;
		}

		.eco__visual {
			order: 1;
		}

		.eco__badge {
			left: 75%;
		}
	}

	.eco--wide:not(.eco--single-2) {
		@include media-up(md) {
			@include wide-layout;
		}
	}

	.eco--wide.eco--single-2 {
		@include media-up(lg) {
			@include wide-layout;
		}
	}

	// `.eco--wide` again so the flip outranks the wide layout it amends.
	.eco--wide.eco--flip-3 {
		@include media-up(lg) {
			@include wide-flip;
		}
	}

	.eco--wide.eco--flip-2 {
		@media (min-width: $breakpoint-md) and (max-width: #{$breakpoint-lg - 1px}) {
			@include wide-flip;
		}
	}

	.eco__relay {
		align-self: center;
		min-width: 0;
	}

	.eco__tiles {
		position: relative;
		z-index: 1;
		grid-template-columns: repeat(2, 1fr);
		align-content: center;
		gap: $spacing-2;
	}

	.eco__tile {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: $spacing-1;
		min-height: 78px;
		padding: $spacing-3 $spacing-2;
		border: 1px solid rgba(0, 0, 0, 0.14);
		border-radius: $radius-md;
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		text-align: center;
		text-decoration: none;
		color: var(--color-text);
		transition:
			background-color $transition-fast,
			border-color $transition-fast;

		&:hover,
		&:focus-visible {
			border-color: rgba(0, 0, 0, 0.3);
			background-color: var(--tile);
		}
	}

	.eco__tile-icon {
		width: 28px;
		height: 28px;
	}

	// Stretched to the row and cut by the card's bottom edge, so the copy sets the card's height.
	.eco__mockup {
		position: relative;
		align-self: stretch;
		margin-bottom: calc(-1 * #{$spacing-5});
		overflow: hidden;
	}

	.eco__phone {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 260px;
		aspect-ratio: 480 / 1039;
		background-image: url(/images/mobile/iphone12promax-frame.png);
		background-size: 100% auto;
		background-repeat: no-repeat;

		// The frame image's screen opening, as percentages of the 480/1039 box.
		:global(video) {
			position: absolute;
			top: 2%;
			left: 5.15%;
			width: 89.8%;
			border-radius: 4%;
		}
	}

	.sr-only {
		@include visually-hidden;
	}

	@media print {
		.eco {
			@include home-card-print;
		}

		.eco__badge {
			border: 1px solid var(--color-border);
			box-shadow: none;
		}

		.eco__description:last-of-type {
			margin-bottom: 0;
		}

		.eco__relay,
		.eco__phone {
			@include print-exact;
		}

		.eco--wide:has(.eco__mockup):not(:has(source[src])) {
			display: flex;

			.eco__badge {
				left: 50%;
			}

			.eco__mockup {
				display: none;
			}
		}
	}

	@media print and (max-width: #{$breakpoint-md - 1px}) {
		.eco--wide {
			@include wide-layout;
		}
	}
</style>
