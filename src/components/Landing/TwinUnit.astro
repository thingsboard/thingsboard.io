---
import { Icon } from 'astro-icon/components';
import type { UnitSpec } from '@data/digital-twin-visual';

/** A physical unit in the twin visual: name, status light and attached devices. */

interface Props {
	unit: UnitSpec;
	class?: string;
}

const { unit, class: className } = Astro.props;
---

<div class:list={['unit', className]}>
	<header class="unit__head">
		<Icon name={unit.icon} aria-hidden="true" />
		<span class="unit__name">{unit.name}</span>
		<i class="unit__led" aria-hidden="true"></i>
	</header>
	<ul class="unit__list">
		{unit.devices.map((d) => (
			<li>
				<Icon name={d.icon} aria-hidden="true" />
				<span>{d.label}</span>
			</li>
		))}
	</ul>
</div>

<script>
	import { pauseOffscreen } from '@util/pause-offscreen';

	pauseOffscreen('.unit__led');
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.unit {
		display: flex;
		overflow: hidden;
		flex-direction: column;
		border-radius: u(8);
		background: #1b1e27;
		color: #fff;
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.08),
			0 #{u(14)} #{u(32)} #{u(-10)} rgba(16, 24, 40, 0.28);
	}

	.unit__head {
		position: relative;
		display: flex;
		align-items: center;
		gap: u(10);
		padding: u(12) u(16);
		background: rgba(255, 255, 255, 0.07);

		[data-icon] {
			flex: none;
			width: u(20);
			height: u(20);
		}
	}

	.unit__name {
		font-size: u(16);
		font-weight: $font-weight-semibold;
		line-height: u(22);
		white-space: nowrap;
	}

	.unit__led {
		--unit-led: #{$color-success-alt};
		position: absolute;
		top: u(8);
		right: u(8);
		width: u(7);
		height: u(7);
		border-radius: 50%;
		background: var(--unit-led);
		box-shadow: 0 0 u(6) 0 color-mix(in srgb, var(--unit-led) 45%, transparent);
		animation: unit-blink 2.6s steps(1, end) infinite;
		&[data-offscreen] {
			animation-play-state: paused;
		}

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes unit-blink {
		0%,
		100% {
			opacity: 1;
		}
		7% {
			opacity: 0.12;
		}
		14% {
			opacity: 1;
		}
		21% {
			opacity: 0.12;
		}
		28% {
			opacity: 1;
		}
		68% {
			opacity: 0.12;
		}
		76% {
			opacity: 1;
		}
	}

	.unit__list {
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			display: flex;
			align-items: center;
			gap: u(10);
			padding: u(8) u(16);
			font-size: u(14);
			font-weight: $font-weight-medium;
			line-height: u(22);
			white-space: nowrap;
		}

		// A shadow, not a border, so the separator adds no height.
		li + li {
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
		}

		[data-icon] {
			flex: none;
			width: u(18);
			height: u(18);
		}
	}
</style>
