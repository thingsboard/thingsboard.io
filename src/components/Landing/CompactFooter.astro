---
import SocialNetworks from '@components/Landing/SocialNetworks.astro';
import FooterLegalLinks from '@components/Landing/FooterLegalLinks.astro';
import { footerNavItems } from '@data/navigation';

// The compact footer: the nav row, then the copyright, legal links and social icons. Docs pages
// render it under their content (`starlight/DocFooter`); `BaseLayout chrome="minimal"` pages
// render it in place of the landing footer (`starlight/Footer`). One component, so the two can't drift.

const currentYear = new Date().getFullYear();
---

<div class="doc-footer sl-markdown-content print:hidden">
	<nav>
		{footerNavItems.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
	</nav>
	<div class="deepmost">
		<div class="copyright">
			&copy; {currentYear} The ThingsBoard Authors
			<FooterLegalLinks />
		</div>
		<SocialNetworks />
	</div>
</div>

<style>
	.doc-footer {
		container-type: inline-size;
		border-top: 1px solid var(--sl-color-hairline);
		padding: var(--sl-content-pad-x) 0;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.75rem;
		margin-bottom: 1.5rem;
	}

	@container (max-width: 36rem) {
		nav {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
	}

	nav a {
		font-size: 1rem;
		color: var(--sl-color-text);
		text-decoration: none;
		white-space: nowrap;
	}

	nav a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}

	.deepmost {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		--sn-color: var(--sl-color-gray-3);
	}

	.deepmost :global(.social) {
		margin-top: 0;
	}

	@container (max-width: 36rem) {
		.deepmost {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1.5rem;
		}
	}

	.copyright {
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
	}

	.copyright :global(a:hover),
	.copyright :global(.cookie-settings:hover) {
		color: var(--sl-color-white);
	}
</style>
