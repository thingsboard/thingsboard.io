---
import CtaButton from '@components/Landing/CtaButton.astro';
import SmartImage from '@components/SmartImage.astro';
import type { Cta } from '@models/cta';

interface Props {
	/** Every line but the last is a kicker sitting above the headline. */
	title: string[];
	subtitle: string;
	buttons?: Cta[];
	poster: string;
	video: { webm: string; mp4: string };
}

const { title, subtitle, buttons = [], poster, video } = Astro.props;
---

<section class="hero">
	<div class="hero__content">
		<h1>
			{title.map((line) => (
				<span class="hero__line">{line}</span>
			))}
		</h1>
		<p class="hero__subtitle">{subtitle}</p>

		{buttons.length > 0 && (
			<div class="hero__buttons">
				{buttons.map(({ text, ...button }) => (
					<CtaButton {...button}>{text}</CtaButton>
				))}
			</div>
		)}
	</div>

	<div class="hero__panel print:hidden" data-video-webm={video.webm} data-video-mp4={video.mp4}>
		{/* Decorative: the panel carried no accessible text as a CSS background either. */}
		<SmartImage
			src={poster}
			alt=""
			width={1920}
			height={924}
			widths={[480, 768, 960, 1280, 1600, 1920]}
			sizes="(min-width: 1024px) 80vw, (min-width: 750px) 50vw, 100vw"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
</section>

<style lang="scss">
	@use 'sass:list';
	@use 'sass:math';
	@use 'sass:string';
	@use '../../styles/variables' as *;
	@use '../../styles/print-mixins' as *;

	// The footage's size; must match the SmartImage width/height above.
	$footage-w: 1920;
	$footage-h: 924;

	// Black to clear over `$length` on a smootherstep curve.
	// Painted over the footage, not a mask: a mask over a playing video re-composites every frame.
	@function hero-edge-fade($length, $steps: 24) {
		$stops: ();
		@for $i from 0 through $steps {
			$t: math.div($i, $steps);
			$eased: $t * $t * $t * ($t * ($t * 6 - 15) + 10);
			$stops: list.append(
				$stops,
				string.unquote('rgb(0 0 0 / #{math.div(math.round((1 - $eased) * 1000), 10)}%)') ($length * $t),
				comma
			);
		}
		@return linear-gradient(to right, $stops);
	}

	// Source order is the layout — auto-placement gives both arrangements.
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		background-color: #000;
		color: #fff;
	}

	.hero__content {
		// The same room above the headline and under the buttons, so the copy stays centred.
		--hero-gap: 56px;

		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: calc(#{$header-height} + var(--hero-gap)) clamp(20px, calc(0.5rem + 2vw), 56px) var(--hero-gap);

		@media (max-height: 620px) {
			--hero-gap: 42px;
		}

		// Phones (after the short rule, so it wins): the footage sits right under the copy, centred on its axis.
		@media (max-width: 599px) {
			--hero-gap: 48px;

			align-items: center;
			text-align: center;
		}
	}

	h1 {
		@include hero-title;
		line-height: 1.2;
		margin: 0 0 20px;

		@media (max-width: 599px) {
			max-width: 7em;
			text-wrap: balance;
		}

		@media (max-height: 620px), (max-width: $breakpoint-sm) {
			margin-bottom: 12px;
		}
	}

	.hero__line {
		display: block;

		// One title line is a headline, not a kicker to nothing. The fade matches the logo strip's marks.
		&:not(:last-child) {
			background-image: linear-gradient(to bottom, rgb(255 255 255 / 62%), rgb(255 255 255 / 38%));
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
		}
	}

	.hero__subtitle {
		@include text-m;
		font-size: $font-size-lg;
		// The mixin colours for a light surface; this one is always black.
		color: #fff;
		max-width: 52ch;
		margin: 0 0 32px;
		text-wrap: pretty;

		@media (max-width: 599px) {
			margin-inline: auto;
		}

		@media (max-height: 620px), (max-width: $breakpoint-sm) {
			margin-bottom: 20px;
		}
	}

	.hero__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;

		// From CtaButton, hence `:global`.
		:global(.cta-button > svg) {
			width: 20px;
			height: 20px;
		}

		:global(.cta-button--brand) {
			position: relative;
			overflow: hidden;
			isolation: isolate;
		}

		:global(.cta-button--brand::after) {
			content: '';
			position: absolute;
			inset-block: 0;
			left: 0;
			width: 45%;
			z-index: -1;
			pointer-events: none;
			background: linear-gradient(100deg, transparent, rgb(255 255 255 / 38%), transparent);
			transform: translateX(-160%) skewX(-18deg);
		}

		@media (prefers-reduced-motion: no-preference) {
			:global(.cta-button--brand:hover::after),
			:global(.cta-button--brand:focus-visible::after) {
				animation: hero-shimmer 0.75s cubic-bezier(0.4, 0, 0.2, 1);
			}
		}

		@media (max-width: 599px) {
			justify-content: center;
		}
	}

	.hero__panel {
		position: relative;
		background-color: #000;
		filter: saturate(1.2);

		// Not `aspect-ratio`: on a stretched grid item it left the section shorter than its row.
		&::before {
			content: '';
			display: block;
			padding-top: calc(100% * #{$footage-h} / #{$footage-w});
		}

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 1;
			pointer-events: none;
		}

		// Both come from elsewhere — the image from SmartImage, the video from the
		// script below — so neither carries this component's scope attribute.
		:global(img),
		:global(video) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		// The two stack on the same `inset: 0`, and a translucent video no longer covers
		// the poster beneath it — both would show at once.
		&[data-video-playing] :global(img) {
			visibility: hidden;
		}
	}

	h1,
	.hero__subtitle,
	.hero__buttons {
		// `backwards` holds the from-state through the delay, so nothing is parked at 0.
		animation: hero-rise 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) backwards;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	.hero__subtitle {
		animation-delay: 300ms;
	}

	.hero__buttons {
		animation-delay: 600ms;
	}

	@keyframes hero-shimmer {
		from {
			transform: translateX(-160%) skewX(-18deg);
		}

		to {
			transform: translateX(320%) skewX(-18deg);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
		}
	}

	// Tablets, and any portrait screen from `md`: the footage under the copy, the copy in two
	// columns — the headline in one, the lede and the actions in the other.
	@media (min-width: 600px) and (max-width: #{$breakpoint-md - 1px}),
		(min-width: $breakpoint-md) and (orientation: portrait) {
		.hero__content {
			--hero-copy-gap: clamp(#{$spacing-6}, 4vw, #{$spacing-8});

			container-type: inline-size;
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto auto 1fr;
			column-gap: var(--hero-copy-gap);
			align-items: start;
			justify-items: start;
		}

		h1 {
			grid-column: 1;
			grid-row: 1 / -1;
			margin-bottom: 0;
			max-width: 7em;
			// Sized to its column: seven of its own ems fill half the copy.
			font-size: clamp(34px, calc((100cqi - var(--hero-copy-gap)) / 2 / 7), 48px);

			@media (max-height: 620px) {
				font-size: 34px;
			}
		}

		.hero__subtitle,
		.hero__buttons {
			grid-column: 2;
		}

		.hero__subtitle {
			max-width: 34ch;
		}

		.hero__panel {
			// Fills what the copy (~300px) leaves before the fold, the logo strip and 64px of the
			// next section kept in view, but never under 30vw.
			max-height: max(30vw, calc(100svh - var(--promo-h, 0px) - 100px - 64px - 300px));
			overflow: hidden;
		}
	}

	// Side by side, from `md` in landscape: the copy at its natural width, the footage taking the rest.
	@media (min-width: $breakpoint-md) and (orientation: landscape) {
		.hero {
			// The widest the copy and the footage get together; past it the composition centres.
			--hero-wide-cap: max(1823px, calc(4000px - 100vw), 53vw);
			// The copy's column: its natural width, widening to 540 on very wide screens.
			--hero-band-min: min(22vw, 540px);
			// How far the panel reaches under the copy, so the fade ends just past its widest line.
			--hero-reach: calc(#{$bar-inset} + 16px);
			// The first screen less the promo bar, header, ~100px logo strip and 120px of the next section,
			// capped at the footage's own height. The panel's own width caps it too (`::before` below).
			--hero-fold-h: min(#{$footage-h}px, calc(100svh - var(--promo-h, 0px) - #{$header-height} - 100px - 120px));
			// At most 2.6 of the panel's height wide, so no more than a fifth of the frame is cut. The height
			// is floored at 320, the copy's shortest side by side, so a phone on its side gets no portrait box.
			--hero-panel-col: calc(min(#{$footage-w}px, max(var(--hero-fold-h), 320px) * 2.6) - var(--hero-reach));

			// The copy takes its own width, the panel the rest up to its cap; past the wide cap it centres.
			grid-template-columns: minmax(var(--hero-band-min), auto) minmax(0, var(--hero-panel-col));
			justify-content: center;
			padding-inline: max(0px, calc((100% - var(--hero-wide-cap)) / 2));
		}

		.hero__content {
			align-self: center;
			// Above the panel, which reaches under it.
			position: relative;
			z-index: 1;
			padding-inline: $bar-inset;
		}

		h1 {
			max-width: 7em;
			text-wrap: balance;

			@include media-up(lg) {
				font-size: clamp(48px, 1.85vw, 64px);
			}
		}

		.hero__subtitle {
			max-width: clamp(34ch, calc(34ch + (100vw - 2000px) / 10), 44ch);
		}

		.hero__panel {
			// Grows with a taller text column so `cover` trims instead of leaving a gap.
			align-self: stretch;
			// Clears the bar so nothing plays behind it.
			margin-top: $header-height;
			width: calc(100% + var(--hero-reach));
			margin-left: calc(-1 * var(--hero-reach));

			// The footage's shape from the panel's own width, under the fold's height. The row stretches
			// the panel past it where the copy is taller, so no black shows under the footage.
			&::before {
				padding-top: min(calc(100% * #{$footage-h} / #{$footage-w}), var(--hero-fold-h));
			}

			&::after {
				background-image: hero-edge-fade(240px);
			}

			// 2px inside the box, so the fade's edge is the only one on the panel's fractional left pixel:
			// two anti-aliased edges there left a faint column of footage the black did not cover.
			:global(img),
			:global(video) {
				left: 2px;
				width: calc(100% - 2px);
			}
		}
	}

	@media print {
		.hero {
			@include print-section;
			grid-template-columns: 1fr;
		}

		.hero__content {
			padding: 0 0 $spacing-6;
		}

		.hero__line:not(:last-child) {
			background-image: none;
			color: var(--color-text-secondary);
		}

		.hero__subtitle {
			margin-bottom: 0;
			color: var(--color-text);
			text-shadow: none;
		}

		h1,
		.hero__subtitle {
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>

<script>
	window.addEventListener('load', () => {
		const panel = document.querySelector<HTMLElement>('.hero__panel');
		if (!panel) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
		if (conn?.saveData) return;
		if (conn?.effectiveType === 'slow-2g' || conn?.effectiveType === '2g') return;

		const { videoWebm, videoMp4 } = panel.dataset;
		if (!videoWebm || !videoMp4) return;

		const video = document.createElement('video');
		video.autoplay = true;
		video.loop = true;
		video.muted = true;
		video.playsInline = true;
		video.setAttribute('aria-hidden', 'true');
		// Marks the panel only once the footage is painting. Appending is too early: the
		// element exists with no frame yet, and hiding the poster then shows black.
		video.addEventListener('playing', () => panel.setAttribute('data-video-playing', ''), { once: true });

		for (const [src, type] of [
			[videoWebm, 'video/webm'],
			[videoMp4, 'video/mp4'],
		]) {
			const source = document.createElement('source');
			source.src = src;
			source.type = type;
			video.appendChild(source);
		}

		panel.appendChild(video);
	});
</script>
