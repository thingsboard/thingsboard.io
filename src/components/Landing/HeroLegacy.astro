---
import { Products } from '@models/site.models';
import { Icon } from 'astro-icon/components';
import SmartImage from '@components/SmartImage.astro';
import Button from '@components/ui/Button.astro';

interface HeroButton {
	text: string;
	href: string;
	variant?: 'outline' | 'white';
	srOnlySuffix?: string;
}

interface Achievement {
	href: string;
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface Props {
	/**
	 * Product type for styling and features
	 */
	product?: Products;
	/**
	 * Main title(s) - can be string or array of strings
	 */
	title: string | string[];
	/**
	 * Subtitle text
	 */
	subtitle: string;
	/**
	 * Hero buttons
	 */
	buttons?: HeroButton[];
	/**
	 * Show down arrow for scrolling
	 */
	showArrow?: boolean;
	/**
	 * Anchor link for arrow/button
	 */
	anchorLink?: string;
	/**
	 * Background image URL. Required: every caller passes its own, and a default
	 * here would be a path nothing keeps alive.
	 */
	backgroundImage: string;
	/**
	 * Portrait crop for portrait viewports below `md` (750px), which only show the middle
	 * of a 16:9 cover. Same look, far fewer bytes. Without it they get `backgroundImage`.
	 */
	backgroundImageMobile?: string;
	/**
	 * Video background config (for desktop)
	 */
	videoBackground?: {
		mp4?: string;
		webm?: string;
		poster?: string;
	};
	/**
	 * Custom achievement override (if not using default)
	 */
	achievement?: Achievement | null;
	/**
	 * Additional CSS class for hero section
	 */
	className?: string;
}

const {
	product,
	title,
	subtitle,
	buttons = [],
	showArrow = true,
	anchorLink = '#intro',
	backgroundImage,
	backgroundImageMobile,
	videoBackground,
	achievement,
	className = '',
} = Astro.props;

// Products that show achievement badge
const productsWithAchievement = [Products.CE, Products.PE, Products.PAAS, Products.PAAS_EU];
const showAchievement = achievement !== null && (achievement || (product && productsWithAchievement.includes(product)));

// Default achievement for CE/PE/PAAS
const defaultAchievement: Achievement = {
	href: '/blog/top-supplier-retail-2024-2/',
	src: '/src/assets/images/landings/ce/feature-logo/top-supplier-retail-2024.webp',
	alt: 'Top supplier retail 2024',
	width: 110,
	height: 160,
};

const achievementData = achievement || defaultAchievement;
const titles = Array.isArray(title) ? title : [title];
---

<section id="hero" class:list={['light-text', className]}>
	<!-- arrow-hidden sentinel: IntersectionObserver-driven, replaces a forced-reflow scroll listener -->
	<div class="hero-scroll-sentinel" aria-hidden="true"></div>
	<div
		class="video-cover print:hidden"
		data-video-mp4={videoBackground?.mp4}
		data-video-webm={videoBackground?.webm}
	>
		<picture>
			{/* 749px is `$breakpoint-md` minus 1px. */}
			{
				backgroundImageMobile && (
					<source media="(max-width: 749px) and (orientation: portrait)" srcset={backgroundImageMobile} />
				)
			}
			<img src={backgroundImage} alt="" fetchpriority="high" decoding="async" />
		</picture>
	</div>

	{
		showAchievement && (
			<div class="achievement print:hidden">
				<a href={achievementData.href}>
					<SmartImage
						class="achieve"
						src={achievementData.src}
						alt={achievementData.alt}
						width={achievementData.width || 110}
						height={achievementData.height || 160}
					/>
				</a>
			</div>
		)
	}

	<div id="hero-content">
		<h1 class="header-animation">
			{
				titles.map((t, i) => (
					<>
						{i > 0 && ' '}
						<span class="tb-title">{t}</span>
					</>
				))
			}
		</h1>
		<h2 class="header-animation tb-sub-title">{subtitle}</h2>

		{
			buttons.length > 0 && (
				<div class="header-animation hero-buttons print:hidden" data-surface="dark">
					{buttons.map((button) => (
						<Button
							href={button.href}
							variant={button.variant === 'outline' ? 'secondary' : 'primary'}
							size="xl"
							srSuffix={button.srOnlySuffix}
							class={button.variant === 'white' ? 'hero-button--white' : undefined}
						>
							{button.text}
						</Button>
					))}
				</div>
			)
		}

		{
			showArrow && (
				<div class="tb-arrow print:hidden">
					<a href={anchorLink} aria-label="Scroll to content">
						<Icon name="tabler:chevron-down" size="32" />
					</a>
				</div>
			)
		}

		<slot />
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	#hero {
		height: 100vh;
		padding-top: 0;
		position: relative;
		overflow: hidden;
		background: none;

		.hero-scroll-sentinel {
			position: absolute;
			top: 60px;
			left: 0;
			width: 1px;
			height: 1px;
			pointer-events: none;
			visibility: hidden;
		}

		.video-cover {
			position: absolute;
			z-index: -2;
			top: 0;
			left: 0;
			bottom: 0;
			right: 0;
			overflow: hidden;
			background-color: #000;

			img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			:global(video) {
				position: absolute;
				top: 50%;
				left: 50%;
				min-width: 100%;
				min-height: 100%;
				width: auto;
				height: auto;
				transform: translate(-50%, -50%);
				object-fit: cover;
			}
		}

		.achievement {
			position: absolute;
			top: 90px;
			right: 20px;
			z-index: 100;

			.achieve {
				width: 100%;
				height: auto;

				@media (max-width: 768px) {
					width: 60px;
				}
			}
		}

		#hero-content {
			height: 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-content: center;
			align-items: center;
			background-color: rgba(0, 0, 0, 0.72);
			text-align: center;
			padding: 0 20px;

			.tb-title {
				margin-bottom: 20px;
				font-size: 22px;
				font-weight: 400;
				text-shadow: 0 0 18px rgba(0, 0, 0, 0.66);
				color: white;
				display: block;

				@media screen and (min-width: 750px) {
					font-size: 36px;
				}

				@media screen and (min-width: 1250px) {
					margin-bottom: 40px;
					font-size: 64px;
				}
			}

			.tb-sub-title {
				margin-bottom: 40px;
				font-size: 14px;
				line-height: 1.5;
				text-shadow: 0 0 18px rgba(0, 0, 0, 0.66);
				color: white;
				font-weight: 300;
				max-width: 800px;

				@media screen and (min-width: 750px) {
					font-size: 20px;
					margin-bottom: 60px;
				}

				@media screen and (min-width: 1250px) {
					font-size: 28px;
					margin-bottom: 80px;
				}
			}

			.hero-buttons {
				display: flex;
				gap: 20px;
				flex-wrap: wrap;
				justify-content: center;
			}

			.hero-button--white {
				--accent-fill: #{$color-white};
				--accent-on-fill: var(--tb-main-color);
				// A white fill shades towards a light tint of its label color, which keeps the label at 4.5:1.
				--accent-shade: color-mix(in oklab, var(--accent-on-fill), white 65%);
			}

			.tb-arrow {
				position: fixed;
				bottom: 40px;
				left: 0;
				right: 0;
				margin: auto;
				width: 40px;
				height: 40px;
				opacity: 1;
				z-index: 24;
				color: #fff;
				text-align: center;

				a {
					color: #fff;
				}
			}

			&.arrow-hidden .tb-arrow {
				display: none;
			}
		}
	}

	// Animation
	.header-animation {
		max-width: 100%;
		opacity: 0;
		transform: translate3d(0, 45px, 0);
		animation-name: slideup-in;
		animation-duration: 600ms;
		animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
		animation-fill-mode: forwards;
	}

	.header-animation:nth-child(1) {
		animation-delay: 0ms;
	}

	.header-animation:nth-child(2) {
		animation-delay: 300ms;
	}

	.header-animation:nth-child(3) {
		animation-delay: 600ms;
	}

	.header-animation:nth-child(4) {
		animation-delay: 900ms;
	}

	.header-animation:nth-child(5) {
		animation-delay: 1200ms;
	}

	@keyframes slideup-in {
		from {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	@media (min-width: 1250px) {
		.hero-buttons {
			--btn-px: 40px;
		}
	}

	@media print {
		#hero {
			height: auto;
			overflow: visible;

			#hero-content {
				padding: 32px 0;
				background-color: transparent;

				.tb-title,
				.tb-sub-title {
					color: var(--color-text);
					text-shadow: none;
				}

				.tb-title {
					margin-bottom: 16px;
					font-size: 32px;
				}

				.tb-sub-title {
					font-size: 16px;
					margin-bottom: 0;
				}
			}
		}

		.header-animation {
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>

<script>
	// Smooth scroll for anchor links
	document.addEventListener('DOMContentLoaded', () => {
		const heroLinks = document.querySelectorAll('#hero-content a[href^="#"], #hero .tb-arrow a');
		heroLinks.forEach((link) => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const href = link.getAttribute('href');
				if (!href) return;

				const target = document.querySelector(href);
				if (target) {
					const headerHeight = 60;
					const targetPosition = target.getBoundingClientRect().top + window.scrollY - headerHeight;
					window.scrollTo({
						top: targetPosition,
						behavior: 'smooth',
					});
				}
			});
		});

		// Arrow visibility — IntersectionObserver on a sentinel positioned 60px below #hero top.
		// Avoids per-scroll getBoundingClientRect() reads that forced layout on first paint.
		const heroContent = document.getElementById('hero-content');
		const sentinel = document.querySelector<HTMLElement>('#hero .hero-scroll-sentinel');
		if (heroContent && sentinel) {
			new IntersectionObserver(([entry]) => heroContent.classList.toggle('arrow-hidden', !entry.isIntersecting), {
				threshold: 0,
			}).observe(sentinel);
		}
	});

	// Deferred video background — desktop only, fast connection only
	window.addEventListener('load', () => {
		const isMobile =
			window.innerWidth < 768 ||
			/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
		if (isMobile) return;

		const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
		if (conn?.saveData) return;
		if (conn?.effectiveType === 'slow-2g' || conn?.effectiveType === '2g') return;

		const cover = document.querySelector<HTMLElement>('#hero .video-cover');
		if (!cover) return;

		const mp4 = cover.dataset.videoMp4;
		const webm = cover.dataset.videoWebm;
		if (!mp4 && !webm) return;

		const video = document.createElement('video');
		video.autoplay = true;
		video.loop = true;
		video.muted = true;
		video.playsInline = true;
		video.setAttribute('aria-hidden', 'true');

		if (webm) {
			const src = document.createElement('source');
			src.src = webm;
			src.type = 'video/webm';
			video.appendChild(src);
		}
		if (mp4) {
			const src = document.createElement('source');
			src.src = mp4;
			src.type = 'video/mp4';
			video.appendChild(src);
		}

		cover.appendChild(video);
	});
</script>
