---
// Legal links after the copyright line in the landing and docs footers. Each item is nowrap with its separator, so
// the line wraps only between items.
import { footerLegalLinks, PRIVACY_CHOICES_LABEL } from '@data/privacy';
---

{footerLegalLinks.map((link) => (
	<span class="legal-item">
		· <a href={link.href}>{link.label}</a>
	</span>
))}
<span class="legal-item">
	· {/* An opt-out icon (CCPA regs §7015) would go inside the button, before the label. */}
	<button type="button" class="cookie-settings" data-cc="show-preferences">
		{PRIVACY_CHOICES_LABEL}
	</button>
</span>

<style>
	.legal-item {
		white-space: nowrap;
	}

	/* Beats the docs' `.sl-markdown-content a` accent colour. */
	a {
		color: inherit;
		text-decoration: underline;
	}
</style>
