---
import { Icon } from 'astro-icon/components';
import CtaButton from '@components/Landing/CtaButton.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import type { ChoiceNote, ChoiceOption } from '@models/choice-band';

/** Two ways to buy one product as side-by-side cards on the page's dark ground, with a note line under them. */
interface Props {
	title: string;
	lead: string;
	options: readonly ChoiceOption[];
	note: ChoiceNote;
}

const { title, lead, options, note } = Astro.props;
---

<section id="choose" class="choice">
	<PricingBackground contained />
	<h2 class="choice__title">{title}</h2>
	<p class="choice__lead">{lead}</p>

	<div class="choice-grid">
		{options.map((option) => (
			<div class="choice-card">
				<h3 class="choice-card__name">
					<Icon name={option.icon} class="choice-card__mark" aria-hidden="true" />
					{option.name}
				</h3>
				<p class="choice-card__price">
					{option.price}
					<span class="choice-card__price-note">{option.priceNote}</span>
				</p>
				<p class="choice-card__summary">{option.summary}</p>
				<ul class="choice-card__points">
					{option.points.map((point) => (
						<li>
							<Icon name="tabler:check" aria-hidden="true" />
							{point}
						</li>
					))}
				</ul>
				<div class="choice-card__actions">
					<CtaButton {...option.cta}>
						{option.cta.text}
						<span class="visually-hidden">— {option.name}</span>
					</CtaButton>
					<a class="choice-card__plans" href={option.plansHref}>
						{option.plansLabel ?? 'See plans'}
						<span class="visually-hidden">for the {option.name}</span>
						<Icon name="tabler:chevron-right" aria-hidden="true" />
					</a>
				</div>
			</div>
		))}
	</div>

	<p class="choice-note">
		<Icon name={note.icon} class="choice-note__mark" aria-hidden="true" />
		{note.lead}
		<a href={note.href}>{note.text}</a>
		{note.tail}
	</p>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.choice {
		overflow: hidden;
		// A stacking context, so the wave field's `z-index: -1` stays above this background.
		isolation: isolate;
		padding: $spacing-20 var(--band-gutter);
		background-color: var(--page-hero-ground);
		color: $color-white;

		@include media-down(md) {
			padding-block: $spacing-12;
		}

		// `:global()`: the field is another component's markup, which a scoped rule cannot reach.
		:global(.pricing-bg) {
			--pricing-wave-color: var(--page-wave);
		}
	}

	.choice__title {
		@include home-section-title;
		margin: 0 0 $spacing-3;
		text-align: center;
	}

	.choice__lead {
		@include text-m;
		max-width: 65ch;
		margin: 0 auto $spacing-10;
		line-height: 1.5;
		color: rgb(255 255 255 / 72%);
		text-align: center;
		text-wrap: pretty;
	}

	.choice-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: $spacing-6;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.choice-card {
		display: flex;
		flex-direction: column;
		gap: $spacing-3;
		padding: $spacing-8;
		border-radius: 16px;
		background-color: rgb(255 255 255 / 6%);

		@include media-down(md) {
			padding: $spacing-6 $spacing-5;
		}

		&__name {
			@include subsection-title;
			display: flex;
			align-items: center;
			gap: $spacing-3;
			margin: 0;
			font-weight: $font-weight-bold;
		}

		&__mark {
			flex: none;
			width: 1em;
			height: 1em;
		}

		&__price {
			@include card-title;
			display: flex;
			flex-direction: column;
			gap: 2px;
			margin: 0;
			font-weight: $font-weight-bold;
			color: var(--page-accent-light);

			@include media-down(md) {
				font-size: $font-size-xl;
			}
		}

		&__price-note {
			@include text-m;
			line-height: 1.5;
			color: rgb(255 255 255 / 60%);
		}

		&__summary {
			@include text-m;
			margin: 0;
			line-height: 1.5;
			color: rgb(255 255 255 / 72%);
		}

		&__points {
			@include text-m;
			display: flex;
			flex-direction: column;
			gap: $spacing-2;
			margin: $spacing-2 0 0;
			padding: 0;
			line-height: 1.5;
			// The mixin colours for a light surface; this band is dark.
			color: $color-white;
			list-style: none;

			li {
				display: flex;
				align-items: flex-start;
				gap: $spacing-2;
			}

			// `:global()`: an `<Icon>` without a class carries no scope attribute.
			:global(svg) {
				flex: none;
				width: 20px;
				height: 20px;
				margin-top: 2px;
				color: var(--page-accent-light);
			}
		}

		// `margin-top: auto` so the two cards' actions sit on one line however the copy falls.
		&__actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: $spacing-4;
			margin-top: auto;
			padding-top: $spacing-6;
		}

		&__plans {
			display: inline-flex;
			align-items: center;
			font-size: $font-size-base;
			font-weight: $font-weight-medium;
			line-height: 1.5;
			color: $color-white;

			:global(svg) {
				@include link-chevron;
			}

			&:hover,
			&:focus-visible {
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}
	}

	.choice-note {
		@include text-m;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: $spacing-2;
		margin: $spacing-10 0 0;
		line-height: 1.5;
		color: rgb(255 255 255 / 72%);

		&__mark {
			flex: none;
			width: 22px;
			height: 22px;
			color: $color-white;
		}

		a {
			color: $color-white;
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}
</style>
