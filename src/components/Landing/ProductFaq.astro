---
/**
 * FAQ block for a product landing page. Same shared FaqSection the pricing page
 * uses (accordion, category tabs, load-more, hash deep-links), fed from pricing
 * FAQ data the caller assembles (see @data/onprem-faq). Emits the page's single
 * FAQPage JSON-LD block, so use it once per page.
 */
import FaqSection from '@components/Pricing/FaqSection.astro';
import type { FaqCategory } from '@data/pricing/types';

interface Props {
	title: string;
	/** Namespaces the accordion ids and analytics events, e.g. `onprem`. */
	contextId: string;
	categories: FaqCategory[];
}

const { title, contextId, categories } = Astro.props;
---

<section id="faq" class="product-faq">
	<div class="product-faq__inner">
		<h2 class="product-faq__title">{title}</h2>
		<FaqSection contextId={contextId} categories={categories} jsonLd />
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.product-faq {
		padding: $spacing-20 0 96px;

		&__inner {
			max-width: $home-measure;
			margin-inline: auto;
			padding-inline: $spacing-5;
		}

		&__title {
			@include section-title;
			margin: 0 0 $spacing-12;
			font-weight: $font-weight-bold;
			color: var(--color-text);
			text-align: center;
		}

		@include media-down(md) {
			padding-block: $spacing-12 64px;

			&__title {
				margin-bottom: $spacing-8;
			}
		}
	}
</style>
