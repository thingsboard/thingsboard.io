---
import { Icon } from 'astro-icon/components';
import { SCALE_MODES } from '@data/scale-visual';

/** The two deployment modes side by side: cell field, device figure and tech stack. */

// Citus and Valkey are local icons under `src/icons/`: Simple Icons publishes neither.
const LOGOS: Record<string, string> = {
	PostgreSQL: 'simple-icons:postgresql',
	Citus: 'citus',
	Cassandra: 'simple-icons:apachecassandra',
	Kafka: 'simple-icons:apachekafka',
	Valkey: 'valkey',
};

// How far each card's surface reaches past its column (the `inset` on `.sd__card::before`).
const CARD_BLEED = 14;

const COL_W = 220;
// At or under 2 * CARD_BLEED the two card surfaces touch and read as one slab.
const COL_GAP = 34;
const NATIVE = SCALE_MODES.length * COL_W + (SCALE_MODES.length - 1) * COL_GAP;
const EXTENT = NATIVE + 2 * CARD_BLEED;

const COLS = 5;
const ROWS = 3;
const RATIO = 5;
const S = (COL_W * RATIO) / (COLS * RATIO + (COLS - 1));
const G = S / RATIO;
const FIELD_W = COL_W;
const FIELD_H = ROWS * S + (ROWS - 1) * G;
const R = S / 3;

const r2 = (v: number) => +v.toFixed(2);
const px = (c: number) => r2(c * (S + G));
// Rounded for attributes only; the unrounded values feed the rest of the arithmetic.
const S2 = r2(S);
const R2 = r2(R);

// The viewBox is padded by the ripple's overhang; the CSS takes it back off the margins.
const PULSE_SCALE = 1.75;
const PAD = Math.ceil(((S * (PULSE_SCALE - 1)) / 2) * 100) / 100;
const BOX_W = r2(FIELD_W + PAD * 2);
const BOX_H = r2(FIELD_H + PAD * 2);

const PATTERNS: { c: number; r: number }[][] = [
	[{ c: 0, r: ROWS - 1 }],
	[
		{ c: 0, r: ROWS - 3 },
		{ c: 0, r: ROWS - 2 },
		{ c: 1, r: ROWS - 2 },
		{ c: 0, r: ROWS - 1 },
		{ c: 1, r: ROWS - 1 },
		{ c: 2, r: ROWS - 1 },
	],
];

const HUES = ['var(--color-primary, #3d50f5)', 'var(--color-product-gw, #6d28d9)'];

/** Bars joining adjacent lit cells, drawn under them. Square ends, so the buried part does not pinch. */
const T = S / 3;
const BLEED = S / 15;
function bridges(cells: { c: number; r: number }[]) {
	const out: { x: number; y: number; width: number; height: number }[] = [];
	cells.forEach((a, i) =>
		cells.slice(i + 1).forEach((b) => {
			if (a.r === b.r && Math.abs(a.c - b.c) === 1) {
				const l = a.c < b.c ? a : b;
				out.push({
					x: r2(px(l.c) + S - BLEED),
					y: r2(px(l.r) + (S - T) / 2),
					width: r2(G + BLEED * 2),
					height: r2(T),
				});
			} else if (a.c === b.c && Math.abs(a.r - b.r) === 1) {
				const t = a.r < b.r ? a : b;
				out.push({
					x: r2(px(t.c) + (S - T) / 2),
					y: r2(px(t.r) + S - BLEED),
					width: r2(T),
					height: r2(G + BLEED * 2),
				});
			}
		})
	);
	return out;
}

/** Hops from the bottom-left lit cell, breadth-first — the ripple's delay per cell. */
function hops(cells: { c: number; r: number }[]) {
	const key = (x: { c: number; r: number }) => `${x.c},${x.r}`;
	const start = cells.reduce((a, b) => (b.r > a.r || (b.r === a.r && b.c < a.c) ? b : a), cells[0]);
	const dist = new Map<string, number>([[key(start), 0]]);
	const queue = [start];
	while (queue.length) {
		const cur = queue.shift()!;
		cells.forEach((n) => {
			if (dist.has(key(n))) return;
			if (Math.abs(n.c - cur.c) + Math.abs(n.r - cur.r) !== 1) return;
			dist.set(key(n), dist.get(key(cur))! + 1);
			queue.push(n);
		});
	}
	return cells.map((x) => dist.get(key(x)) ?? 0);
}

const STEPS = PATTERNS.map(hops);

// The unit is capped so the card's description (`.sd__trait`, u(14)) renders at 14px at most.
const TRAIT_U = 14;
const TRAIT_PX = 14;

const vars = [
	`--sd-u: min(calc(${TRAIT_PX}px / ${TRAIT_U}), calc(100cqw / ${EXTENT}))`,
	`--sd-extent: ${EXTENT}`,
	`--sd-card-bleed: ${CARD_BLEED}`,
	`--sd-cols: ${SCALE_MODES.length}`,
	`--sd-gap: ${COL_GAP}`,
	`--sd-field-h: ${BOX_H}`,
	`--sd-pad: ${PAD}`,
	`--sd-pulse-scale: ${PULSE_SCALE}`,
].join('; ');
---

<div class="sd-fit">
	<ul class="sd" role="list" style={vars}>
		{SCALE_MODES.map((m, i) => (
			<li class="sd__card" style={`--sd-hue: ${HUES[i % HUES.length]}`}>
				<svg
					class="sd__field"
					viewBox={`${-PAD} ${-PAD} ${BOX_W} ${BOX_H}`}
					preserveAspectRatio="xMinYMid meet"
					aria-hidden="true"
				>
					{Array.from({ length: COLS * ROWS }).map((_, n) => (
						<rect class="sd__cell" x={px(n % COLS)} y={px(Math.floor(n / COLS))} width={S2} height={S2} rx={R2} />
					))}
					{bridges(PATTERNS[i]).map((b) => (
						<rect class="sd__link" x={b.x} y={b.y} width={b.width} height={b.height} />
					))}
					{PATTERNS[i].map((cell) => (
						<rect class="sd__lit" x={px(cell.c)} y={px(cell.r)} width={S2} height={S2} rx={R2} />
					))}
					{/* On top of the lit cells, so the still frame is the finished drawing. */}
					{PATTERNS[i].map((cell, n) => (
						<rect
							class="sd__pulse"
							style={`--sd-step: ${STEPS[i][n]}`}
							x={px(cell.c)}
							y={px(cell.r)}
							width={S2}
							height={S2}
							rx={R2}
						/>
					))}
				</svg>

				<div class="sd__head">
					<p class="sd__mode">{m.mode}</p>
					<p class="sd__trait">{m.trait}</p>
				</div>

				<p class="sd__reach">
					{m.lead && <span class="sd__lead">{m.lead}</span>}
					<span class="sd__num">{m.devices}</span>
					{(m.unit ?? 'devices') && <span class="sd__unit">{m.unit ?? 'devices'}</span>}
				</p>

				<ul class="sd__stack" role="list">
					{m.stack.map((s) => (
						<li title={s}>
							<Icon name={LOGOS[s]} aria-hidden="true" />
							<span class="sd__sr">{s}</span>
						</li>
					))}
				</ul>
			</li>
		))}
	</ul>
</div>

<script>
	import { pauseOffscreen } from '@util/pause-offscreen';

	pauseOffscreen('.sd');
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.sd-fit {
		container-type: inline-size;
	}

	.sd {
		--u: var(--sd-u);
		display: grid;
		grid-template-columns: repeat(var(--sd-cols), minmax(0, 1fr));
		grid-template-rows: auto auto auto 1fr;
		align-items: stretch;
		row-gap: u(14);
		column-gap: u(var(--sd-gap));
		max-width: u(var(--sd-extent));
		margin: 0 auto;
		padding: 0 u(var(--sd-card-bleed));
		list-style: none;
	}

	// No `gap`: a subgrid that sets its own gutters overrides the parent's and collapses the rows.
	.sd__card {
		position: relative;
		display: grid;
		grid-row: span 4;
		grid-template-rows: subgrid;
	}

	.sd__card::before {
		content: '';
		position: absolute;
		inset: u(-16) u(-14);
		border-radius: u(14);
		background: var(--color-bg-surface, #fff);
	}

	.sd__card > * {
		position: relative;
	}

	// One `margin` shorthand: Astro's `:where()` scoping adds no specificity to override with.
	.sd__field {
		display: block;
		width: calc(100% + 2 * #{u(var(--sd-pad))});
		height: u(var(--sd-field-h));
		margin: calc(-1 * #{u(var(--sd-pad))}) 0 calc(#{u(6)} - #{u(var(--sd-pad))}) calc(-1 * #{u(var(--sd-pad))});
	}

	// Mixed with white, not transparent: the cells must be opaque to hide the bridges' buried ends.
	.sd__cell {
		fill: color-mix(in srgb, var(--sd-hue) 14%, #fff);
	}

	.sd__lit {
		fill: var(--sd-hue);
	}

	// `fill-opacity` rather than `opacity`, so the bars stay painted under the opaque cells.
	.sd__link {
		fill: var(--sd-hue);
		fill-opacity: 0.45;
	}

	.sd__pulse {
		fill: var(--sd-hue);
		transform-box: fill-box;
		transform-origin: center;
		animation: sd-pulse 3.6s ease-out infinite;
		animation-delay: calc(var(--sd-step, 0) * 100ms);

		.sd[data-offscreen] & {
			animation-play-state: paused;
		}
	}

	@keyframes sd-pulse {
		0% {
			opacity: 0.55;
			transform: scale(1);
		}
		9% {
			opacity: 0;
			transform: scale(var(--sd-pulse-scale));
		}
		100% {
			opacity: 0;
			transform: scale(var(--sd-pulse-scale));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sd__pulse {
			animation: none;
			opacity: 0;
		}
	}

	// Packed to the top, or the shorter column's leftover height drops its description.
	.sd__head {
		display: grid;
		align-content: start;
		gap: u(3);
	}

	.sd__mode {
		margin: 0;
		font-size: u(21);
		line-height: u(26);
		font-weight: $font-weight-semibold;
		color: var(--color-text);
	}

	.sd__trait {
		margin: 0;
		font-size: u(14);
		line-height: u(19);
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}

	.sd__reach {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 u(6);
		margin: 0;
		align-self: start;
	}

	.sd__num {
		font-size: u(24);
		font-weight: $font-weight-medium;
		line-height: u(30);
		color: var(--sd-hue);
		white-space: nowrap;
	}

	.sd__unit {
		font-size: u(14);
		line-height: u(20);
		color: var(--color-text-secondary, #5b616e);
	}

	.sd__stack {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: u(9);
		margin: 0;
		padding: 0;
		list-style: none;
		align-self: end;

		li {
			display: flex;
			align-items: center;
		}
	}

	// Sized in design units: astro-icon's width/height attributes are absolute pixels.
	.sd__stack [data-icon] {
		flex: none;
		width: u(34);
		height: u(34);
		color: var(--sd-hue);
	}

	// The Cassandra mark fills half its box, so it runs larger.
	.sd__stack li [data-icon='simple-icons:apachecassandra'] {
		width: u(40);
		height: u(40);
	}

	.sd__lead {
		font-size: u(14);
		line-height: u(20);
		color: var(--color-text-secondary, #5b616e);
	}

	// Narrow containers: hide the description, which would paint under ~12px.
	@container (max-width: 445px) {
		.sd__trait {
			@include visually-hidden;
		}

		.sd__mode {
			font-size: u(27);
			line-height: u(32);
		}

		.sd__num {
			font-size: u(32);
			line-height: u(38);
		}

		.sd__lead,
		.sd__unit {
			font-size: u(19);
			line-height: u(24);
		}
	}

	.sd__sr {
		@include visually-hidden;
	}
</style>
