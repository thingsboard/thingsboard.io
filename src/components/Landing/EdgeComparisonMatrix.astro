---
import DataTable from '@components/DataTable.astro';
import DataTableValue from '@components/DataTableValue.astro';
import type { DataTableColumn } from '@models/data-table';
import { EDGE_VS_GATEWAY_ROWS, type EdgeMatrixRow } from '@data/comparison/edge-vs-gateway';

interface Props {
	rows?: EdgeMatrixRow[];
}

const { rows = EDGE_VS_GATEWAY_ROWS } = Astro.props;

// Widths are emitted inline as well as via the col classes: inline is immune to any
// later specificity drift, and a fixed table with unreachable col widths silently
// falls back to equal quarters. Both sides read these constants — the stylesheet
// through the custom properties set on the section — so the pair cannot drift.
const FEATURE_COL_PCT = 40; // row-header column
const VALUE_COL_PCT = 20; // each of the three product columns

const columns: DataTableColumn[] = [
	{ colClass: 'col-feature', width: `${FEATURE_COL_PCT}%`, thClass: 'feature' },
	{ label: 'IoT\nGateway', colClass: 'col-gateway', width: `${VALUE_COL_PCT}%`, thClass: 'gateway' },
	{ label: 'ThingsBoard\nEdge', colClass: 'col-edge', width: `${VALUE_COL_PCT}%`, thClass: 'edge' },
	{ label: 'ThingsBoard\nServer', colClass: 'col-server', width: `${VALUE_COL_PCT}%`, thClass: 'server' },
];
---

<section
	id="matrix"
	class="edge-matrix"
	style={{
		'--edge-feature-col-w': `${FEATURE_COL_PCT}%`,
		'--edge-value-col-w': `${VALUE_COL_PCT}%`,
	}}
>
	<div class="main-content">
		<h2>Which ThingsBoard Product Is Right for You?</h2>

		{/* Caption hidden: the <h2> above already shows this text. */}
		<DataTable caption="Which ThingsBoard Product Is Right for You?" columns={columns}>
			{
				rows.map((row) => (
					<tr>
						<th scope="row">
							{row.labelHref ? (
								<>
									<a href={row.labelHref}>{row.label}</a>
									{row.labelExtra && (
										<>
											{' '}and{' '}
											<a href={row.labelExtra.href}>{row.labelExtra.text}</a>
										</>
									)}
								</>
							) : (
								row.label
							)}
						</th>
						{(['gateway', 'edge', 'server'] as const).map((col) => (
							<td>
								<DataTableValue
									value={row[col]}
									noIcon="tabler:x"
									noClass="disabled"
								/>
							</td>
						))}
					</tr>
				))
			}
		</DataTable>
	</div>
</section>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	/* Global, not scoped: the table shell comes from DataTable and Astro hashes
	   every compound, so scoped rules would stop matching. Everything nests under
	   .edge-matrix so the bare h2/table/thead/tbody selectors cannot leak. */
	.edge-matrix {
		max-width: 1400px;
		margin: 0 auto;
		padding: 60px 20px 88px;

		.main-content {
			position: relative;
		}

		h2 {
			text-align: center;
			margin-bottom: 48px;
			font-size: 42px;
			font-weight: 600;
			color: #212529;
		}

		table {
			width: 100%;
			border-collapse: separate;
			border-spacing: 16px 0;
			table-layout: fixed;
			border: none;

			.col-feature {
				width: var(--edge-feature-col-w);
			}

			.col-gateway,
			.col-edge,
			.col-server {
				width: var(--edge-value-col-w);
			}
		}

		thead {
			background: white;

			th {
				padding: 20px 12px;
				text-align: center;
				vertical-align: middle;
				font-weight: 600;
				font-size: 18px;
				line-height: 1.3;
				color: white;
				border: none;

				&.gateway {
					background: #7a4dc3;
					border-radius: 12px 12px 0 0;
					box-shadow: 0 -2px 8px rgba(122, 77, 195, 0.15);
				}

				&.edge {
					background: #009688;
					border-radius: 12px 12px 0 0;
					box-shadow: 0 -2px 8px rgba(0, 150, 136, 0.15);
				}

				&.server {
					background: #2a7dec;
					border-radius: 12px 12px 0 0;
					box-shadow: 0 -2px 8px rgba(42, 125, 236, 0.15);
				}
			}

			// The label column has no header of its own; it stays blank, as the
			// empty <td> here used to.
			.feature {
				padding: 0;
				background: transparent;
			}
		}

		tbody {
			th {
				font-weight: 600;
				font-size: 16px;
				line-height: 1.4;
				padding: 16px 12px 16px 0;
				color: #212529;
				text-align: left;
				border: none;
				background: white;

				a {
					color: #212529;
					font-weight: 600;
					font-size: 16px;
					text-decoration: none;

					&:hover {
						color: #009688;
						text-decoration: underline;
					}
				}
			}

			td {
				text-align: center;
				vertical-align: middle;
				font-weight: 600;
				font-size: 15px;
				padding: 16px 8px;
				background: white;
				border: none;

				svg {
					width: 20px;
					height: 20px;

					&.disabled {
						opacity: 0.3;
					}
				}

				&:nth-child(2) {
					color: #7a4dc3;
					border-left: 2px solid #7a4dc3;
					border-right: 2px solid #7a4dc3;

					svg {
						color: #7a4dc3;
					}
				}

				&:nth-child(3) {
					color: #009688;
					border-left: 2px solid #009688;
					border-right: 2px solid #009688;

					svg {
						color: #009688;
					}
				}

				&:nth-child(4) {
					color: #2a7dec;
					border-left: 2px solid #2a7dec;
					border-right: 2px solid #2a7dec;

					svg {
						color: #2a7dec;
					}
				}
			}

			tr:last-child td {
				&:nth-child(2) {
					border-bottom: 3px solid #7a4dc3;
					border-radius: 0 0 12px 12px;
				}

				&:nth-child(3) {
					border-bottom: 3px solid #009688;
					border-radius: 0 0 12px 12px;
				}

				&:nth-child(4) {
					border-bottom: 3px solid #2a7dec;
					border-radius: 0 0 12px 12px;
				}
			}
		}

		@media screen and (max-width: 1000px) {
			& {
				padding: 40px 12px 60px;
			}

			h2 {
				font-size: 26px;
				line-height: 38px;
				margin-bottom: 24px;
			}

			table {
				border-spacing: 10px 0;
			}

			thead th {
				padding: 12px 4px;
				font-size: 13px;
			}

			tbody {
				th {
					font-size: 13px;
					padding: 10px 6px 10px 0;

					a {
						font-size: 13px;
					}
				}

				td {
					font-size: 12px;
					padding: 10px 4px;

					svg {
						width: 16px;
						height: 16px;
					}
				}
			}
		}

		@media screen and (max-width: 576px) {
			& {
				padding: 20px 6px 40px;
			}

			h2 {
				font-size: 20px;
				line-height: 28px;
				margin-bottom: 16px;
			}

			table {
				border-spacing: 6px 0;
			}

			thead th {
				padding: 8px 2px;
				font-size: 10px;
				line-height: 1.3;
			}

			tbody {
				th {
					font-size: 10px;
					padding: 8px 4px 8px 0;

					a {
						font-size: 10px;
					}
				}

				td {
					font-size: 10px;
					padding: 8px 2px;

					svg {
						width: 14px;
						height: 14px;
					}
				}
			}
		}
	}
</style>
