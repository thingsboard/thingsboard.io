---
import DataTable from '@components/DataTable.astro';
import SmartImage from '@components/SmartImage.astro';
import type { DataTableColumn } from '@models/data-table';
import { externalLinkAttrs } from '@util/external-links';

interface ComparisonRow {
	label: string;
	href?: string;
	ce?: boolean;
	pe?: boolean;
	ceText?: string;
	peText?: string;
	ceLinkHref?: string;
	peLinkHref?: string;
}

interface ComparisonGroup {
	category: string;
	rows: ComparisonRow[];
}

interface Props {
	title?: string;
	/** Appended to each group's caption, visually hidden, so a table lifted out of
	 *  the page still says what is being compared. */
	captionContext?: string;
	groups?: ComparisonGroup[];
	peColor?: string;
	centerTitle?: boolean;
	bgColor?: string;
	noSkew?: boolean;
	fixedMaxWidth?: boolean;
}

const {
	title = 'Feature comparison',
	captionContext = 'ThingsBoard Community Edition compared with Professional Edition',
	groups: propGroups,
	peColor = '#038f7e',
	centerTitle = false,
	bgColor = '#f4f4f4',
	noSkew = false,
	fixedMaxWidth = false,
} = Astro.props;

const defaultGroups: ComparisonGroup[] = [
	{
		category: 'Platform Core',
		rows: [
			{ label: 'Scalability (Clustering)', href: '/docs/pe/reference/architecture/microservices/', ce: true, pe: true },
			{ label: 'Rule Engine & Data Processing', href: '/docs/pe/user-guide/rule-engine/', ce: true, pe: true },
			{ label: 'AI Models and AI Rule nodes', href: '/docs/pe/user-guide/ai-models/', ce: true, pe: true },
			{ label: 'Dashboards and Visualization', href: '/iot-data-visualization/', ce: true, pe: true },
			{ label: 'Mobile Application', href: '/docs/mobile/pe/', ce: true, pe: true },
		],
	},
	{
		category: 'Device Management',
		rows: [
			{ label: 'Device & Asset Modeling', href: '/docs/pe/user-guide/devices/', ce: true, pe: true },
			{ label: 'Device Claiming & Provisioning API', href: '/docs/pe/user-guide/claiming/', ce: true, pe: true },
			{ label: 'Bulk Device and Asset Provisioning via CSV', href: '/docs/pe/user-guide/provisioning/#bulk-provisioning', ce: true, pe: true },
			{ label: 'OTA Updates', href: '/docs/pe/user-guide/ota-updates/', ce: true, pe: true },
		],
	},
	{
		category: 'Connectivity',
		rows: [
			{ label: 'Standard IoT Protocols (MQTT, CoAP, HTTP, SNMP, LWM2M)', href: '/docs/pe/user-guide/connectivity-guide/', ce: true, pe: true },
			{ label: 'Industrial IoT Gateway (Modbus, OPC-UA, BACnet, etc.)', href: '/docs/iot-gateway/', ce: true, pe: true },
			{ label: 'LPWAN Integrations (LoRaWAN, Sigfox)', href: '/docs/pe/user-guide/integrations/', ce: false, pe: true },
			{ label: 'System Integrations (AWS IoT, Azure IoT, PubSub, Kafka)', href: '/docs/pe/user-guide/integrations/', ce: false, pe: true },
		],
	},
	{
		category: 'Security & Admin',
		rows: [
			{ label: 'User Management', href: '/docs/pe/user-guide/users/', ce: true, pe: true },
			{ label: 'Audit Logging', href: '/docs/pe/user-guide/security/audit-log/', ce: true, pe: true },
			{ label: 'Advanced Role-Based Access Control (RBAC)', href: '/docs/pe/user-guide/roles/', ce: false, pe: true },
			{ label: 'Single Sign-On (SSO) / OAuth2', href: '/docs/pe/user-guide/security/oauth-2-support/', ce: false, pe: true },
			{ label: 'Secrets Storage', href: '/docs/pe/user-guide/security/secrets-storage/', ce: false, pe: true },
		],
	},
	{
		category: 'Go-to-Market',
		rows: [
			{ label: 'White-Labeling', href: '/docs/pe/user-guide/white-labeling/', ce: false, pe: true },
			{ label: 'Custom menu', href: '/docs/pe/user-guide/white-labeling-menu/', ce: false, pe: true },
			{ label: 'Custom translation', href: '/docs/pe/user-guide/white-labeling-translation/', ce: false, pe: true },
			{ label: 'Reporting & Scheduling', href: '/docs/pe/user-guide/reporting/report-templates/', ce: false, pe: true },
			{ label: 'Solution Templates', href: '/docs/pe/recipes/solution-templates/overview/', ce: false, pe: true },
			{ label: 'Device Payload Codec Library (400+)', href: 'https://github.com/thingsboard/data-converters', ce: false, pe: true },
		],
	},
	{
		category: 'Deployment Options',
		rows: [
			{ label: 'Self-Managed (On-premise/Cloud)', href: '/pricing/?product=thingsboard-pe', ce: true, pe: true },
			{ label: 'Managed Public Cloud', href: '/pricing/?product=thingsboard-cloud', ce: false, pe: true },
			{ label: 'Managed Private Cloud', href: '/pricing/?product=thingsboard-private-cloud', ce: false, pe: true },
		],
	},
	{
		category: 'Support',
		rows: [
			{
				label: 'Support Model',
				ceText: 'Community',
				ceLinkHref: 'https://github.com/thingsboard/thingsboard/discussions',
				peText: 'Advanced + SLA',
				peLinkHref: '/pricing/?section=thingsboard-pe-options&product=thingsboard-pe&faqSection=supportAndAssistance#pe-pay-as-you-go-support-included',
			},
		],
	},
];

const groups = propGroups ?? defaultGroups;

// Announced column headers. The visible labels are the header card above the
// tables, so each table's own header row renders at zero height (headerHidden).
const dtColumns: DataTableColumn[] = [
	{ label: 'Features', colClass: 'c-feature' },
	{ label: 'Community Edition', colClass: 'c-ce' },
	{ label: 'Professional Edition', colClass: 'c-pe' },
];
---

<section
	class="comparison-table"
	style={`--comparison-pe-color: ${peColor}; --comparison-bg-color: ${bgColor}`}
	data-center-title={centerTitle ? 'true' : undefined}
	data-no-skew={noSkew ? 'true' : undefined}
	data-fixed-max-width={fixedMaxWidth ? 'true' : undefined}
>
	<div class:list={['comparison-inner', { 'comparison-inner--fixed': fixedMaxWidth }]}>
		<h2 class="comparison-title">{title}</h2>

		{/* Visual column labels only — the announced headers live in each table's
		    hidden thead, so this card must not be read a second time. */}
		<div class="comparison-header" aria-hidden="true">
			<div class="col-feature">Features</div>
			<div class="col-ce">
				<span class="long">Community Edition</span>
				<span class="short">CE</span>
			</div>
			<div class="col-pe">
				<span class="long">Professional Edition</span>
				<span class="short">PE</span>
			</div>
		</div>

		{groups.map((group) => {
			// A group containing any text-link cell gets wider value columns at mobile.
			// Column widths are table-wide, so this applies to the whole group.
			const hasCellLink = group.rows.some((row) => row.ceLinkHref || row.peLinkHref);
			return (
				<DataTable
					caption={group.category}
					captionSr={` — ${captionContext}`}
					captionVisible={true}
					captionClass="group-caption"
					columns={dtColumns}
					headerHidden={true}
					class={`comparison-group${hasCellLink ? ' comparison-group--link-cells' : ''}`}
				>
					{group.rows.map((row) => (
						<tr data-row-link={row.href ? 'true' : undefined}>
							<th scope="row" class="col-feature">
								{row.href ? (
									<a href={row.href} {...externalLinkAttrs(row.href)}>{row.label}</a>
								) : (
									row.label
								)}
							</th>
							<td class="col-ce">
								{row.ceText ? (
									row.ceLinkHref ? (
										<a href={row.ceLinkHref} target="_blank" rel="noopener noreferrer" class="cell-link">{row.ceText}</a>
									) : (
										<span>{row.ceText}</span>
									)
								) : row.ce ? (
									<>
										<SmartImage src="/src/assets/images/landings/pe/blue-mark.svg" alt="" width="20" height="20" />
										<span class="visually-hidden">Yes</span>
									</>
								) : (
									<span class="visually-hidden">No</span>
								)}
							</td>
							<td class="col-pe">
								{row.peText ? (
									row.peLinkHref ? (
										<a href={row.peLinkHref} target="_blank" rel="noopener noreferrer" class="cell-link pe-link">{row.peText}</a>
									) : (
										<span>{row.peText}</span>
									)
								) : row.pe ? (
									<>
										<SmartImage src="/src/assets/images/landings/pe/green-mark.svg" alt="" width="20" height="20" />
										<span class="visually-hidden">Yes</span>
									</>
								) : (
									<span class="visually-hidden">No</span>
								)}
							</td>
						</tr>
					))}
				</DataTable>
			);
		})}
	</div>
</section>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	/* Global, not scoped: the table shell comes from DataTable and Astro hashes
	   every compound, so scoped rules would stop matching the table, caption and
	   thead it renders. Every rule nests under .comparison-table so nothing leaks. */
	.comparison-table {
		position: relative;
		width: 100%;
		// The ::before pseudo uses `width: 100vw` for a full-bleed background.
		// `100vw` would normally trigger a page-wide horizontal scrollbar
		// because it includes the vertical scrollbar's gutter; that's
		// prevented globally by `body { overflow-x: clip }` in _base.scss.
		// No section-level clip needed here — and importantly, NOT adding
		// one preserves the skewY(-6deg) variant's vertical bleed into
		// adjacent sections (an explicit visual intent that section-level
		// clip would have broken).
		padding: 100px 1.875rem 6rem;
		padding-top: 200px;
		background-color: transparent;

		&[data-no-skew] {
			padding-top: 100px;
		}

		// Background (renders above section's default background)
		&::before {
			content: '';
			position: absolute;
			width: 100vw;
			height: 103%;
			background-color: var(--comparison-bg-color, #f4f4f4);
			z-index: 0;
			left: 49.4%;
			transform: translateX(-50%) skewY(-6deg);
			top: -67px;
		}

		&[data-no-skew]::before {
			transform: translateX(-50%);
			top: 0;
			height: 100%;
		}

		@media screen and (min-width: 1500px) {
			padding-left: 6.25rem;
			padding-right: 6.25rem;
		}

		@media screen and (max-width: 768px) {
			padding: 3rem 1.25rem;
		}

		.comparison-inner {
			position: relative;
			z-index: 1;
			max-width: 1200px;
			margin: 0 auto;

			@media screen and (min-width: 1500px) {
				max-width: 1400px;
			}

			&--fixed {
				@media screen and (min-width: 1500px) {
					max-width: 1200px;
				}
			}
		}

		.comparison-title {
			font-size: $font-size-4xl;
			font-weight: $font-weight-medium;
			line-height: 1.33;
			color: #202020;
			margin: 0 0 2rem;
			text-align: left;

			@media screen and (max-width: 900px) {
				font-size: $font-size-3xl;
			}
		}

		&[data-center-title] .comparison-title {
			text-align: center;
		}

		.comparison-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			background-color: $color-white;
			border-radius: 4px;
			height: 84px;
			margin-bottom: 4px;
			// Match the body rows' 20px horizontal padding so the flex columns
			// distribute over the same width. Without this, header columns are
			// 40px wider than body columns and the header labels sit ~13-18px
			// to the right of the checkmarks below them.
			padding: 0 1.25rem;

			.col-feature {
				flex: 1;
				font-size: $font-size-2xl;
				font-weight: $font-weight-medium;
				line-height: 2.25rem;
				color: $color-text-primary;

				@media screen and (max-width: 900px) {
					margin-left: 0;
					text-align: left;
				}
			}

			.col-ce {
				flex: 1;
				text-align: center;
				font-size: $font-size-2xl;
				font-weight: $font-weight-medium;
				line-height: 2.25rem;
				color: #0d417b;

				@media screen and (max-width: 900px) {
					flex: 0.3;
				}

				@media screen and (max-width: 500px) {
					// Tight CE/PE columns at narrow viewports: smaller flex pushes
					// them rightward (Features eats the extra space) and brings
					// the two icon columns closer together. Must match the body
					// row .col-ce flex so headers sit centered above the
					// checkmarks below.
					flex: 0.18;
				}
			}

			.col-pe {
				flex: 1;
				text-align: center;
				font-size: $font-size-2xl;
				font-weight: $font-weight-medium;
				line-height: 2.25rem;
				color: var(--comparison-pe-color, #038f7e);

				@media screen and (max-width: 900px) {
					flex: 0.3;
				}

				@media screen and (max-width: 500px) {
					flex: 0.18;
				}
			}

			.short {
				display: none;
			}

			@media screen and (max-width: 900px) {
				.long {
					display: none;
				}
				.short {
					display: inline;
				}
			}
		}

		// The white card is drawn as a 4px border rather than padding: a caption is a
		// sibling of the table's grid box, so the table's own padding, background and
		// radius never reach it. Splitting the frame across both boxes — and the radius
		// with it — reproduces the card exactly; the inner corners compute to 4-4 = 0,
		// matching the square corners of the header bar today.
		.comparison-group {
			width: 100%;
			table-layout: fixed;
			border-collapse: separate;
			border-spacing: 0;
			margin-bottom: 4px;
			background-color: $color-white;
			border: 4px solid $color-white;
			border-top: 0;
			border-radius: 0 0 4px 4px;

			// Column widths, measured from the flex layout these tables replaced, not
			// derived: each column is its flex share of (content − 40px), with the
			// row's 20px side padding folded into the first and last columns so the
			// divider spans the full card. A calc() containing a percentage is
			// silently dropped on <col>, so plain percentages, one set per block.
			//
			// Inputs per block — content = card width minus the 2×4px frame:
			//   base:  content 1192 (card 1200), flex shares 1 / 1 / 1
			//   ≥1500: content 1392 (card 1400), shares 1 / 1 / 1
			//   ≤900:  content ≈816.6 (900 viewport − scrollbar − 2×30px page
			//          padding − frame), shares 1 / 0.3 / 0.3
			//   ≤500:  content 452 (500 − 2×20px − frame), shares 1 / 0.18 / 0.18
			//   ≤430:  content 327 (measured at 375), shares 1 / 0.18 / 0.18
			// value % = share/Σshares × (content−40)/content, ±20px on the outer
			// columns. The literals carry the browser's own flex rounding — they sit
			// within 0.002% of the formula — so re-measure rather than recompute if
			// the paddings, frame or breakpoints ever change.
			.c-feature { width: 33.8926%; }
			.c-ce { width: 32.2148%; }
			.c-pe { width: 33.8926%; }

			@media screen and (min-width: 1500px) {
				.c-feature { width: 33.8123%; }
				.c-ce { width: 32.3755%; }
				.c-pe { width: 33.8123%; }
			}

			@media screen and (max-width: 900px) {
				.c-feature { width: 61.8886%; }
				.c-ce { width: 17.8311%; }
				.c-pe { width: 20.2803%; }
			}

			@media screen and (max-width: 500px) {
				.c-feature { width: 71.4469%; }
				.c-ce { width: 12.0642%; }
				.c-pe { width: 16.4889%; }
			}

			@media screen and (max-width: 430px) {
				.c-feature { width: 70.6514%; }
				.c-ce { width: 11.6177%; }
				.c-pe { width: 17.7309%; }
			}
		}

		// Was a flex row; a caption is a block box, so the flex centring is dropped and
		// the alignment made explicit (a caption is centred by default).
		.group-caption {
			padding: 0.625rem 1.25rem;
			font-weight: $font-weight-medium;
			font-size: 1.125rem;
			line-height: 1.875rem;
			color: #3b3c3c;
			background-color: #f5f9f8;
			text-align: left;
			border: 4px solid $color-white;
			border-bottom: 0;
			border-radius: 4px 4px 0 0;
		}

		// Rows are <tr> now. Padding and the divider live on the cells: a table row
		// ignores both padding and border in the separated model.
		.comparison-group tbody tr {
			transition: background $transition-base;
		}

		.comparison-group tbody th,
		.comparison-group tbody td {
			height: 50px;
			padding: 12px 0;
			vertical-align: middle;
			border-bottom: 2px solid #e0e0e0;
		}

		.comparison-group tbody th { padding-left: 20px; }
		.comparison-group tbody td:last-child { padding-right: 20px; }

		.comparison-group tbody tr:last-child > * {
			height: 48px;
			border-bottom: none;
		}

		// The row link lives in the row header and is stretched over the label cell, so
		// the accessible name is the feature label rather than the whole row's text.
		// The cell, not the row, is the containing block: WebKit does not reliably
		// honour `position` on a <tr>, and the fallback ancestor would be
		// .comparison-inner — one row's overlay would then cover every table.
		.comparison-group tbody th.col-feature {
			position: relative;
			font-size: $font-size-sm;
			font-weight: $font-weight-normal;
			line-height: 1.5rem;
			color: #212121;
			text-align: left;
			transition: font-size 0.3s;

			a {
				color: inherit;
				text-decoration: none;

				&::after {
					content: '';
					position: absolute;
					inset: 0;
				}
			}

			@media screen and (max-width: 500px) {
				font-size: 12px;
			}
		}

		.comparison-group tbody td.col-ce,
		.comparison-group tbody td.col-pe {
			text-align: center;
			overflow-wrap: break-word;

			// The mark is a block-level <img> (every image on the landing pages is), so
			// text-align cannot centre it.
			img {
				width: 20px;
				height: 20px;
				margin-inline: auto;
			}
		}

		// Hover is gated behind `@media (hover: hover) and (min-width: 901px)`:
		// - the hover query stops touch devices from firing the effect on
		//   tap-and-drag (no real hover state),
		// - the width query stops it from firing on mobile width even in
		//   Chrome dev-tools' responsive mode (where the primary input
		//   stays "mouse" and the hover query still resolves to true).
		@media (hover: hover) and (min-width: 901px) {
			// The tint deliberately spans the whole row even though only the label
			// cell navigates: it marks the row being read, and the cursor already
			// marks where the link is.
			.comparison-group tbody tr[data-row-link]:hover {
				background-color: #f9f9f9;

				// Font grows but the line box does not: bumping line-height too made the
				// row taller on hover, so the table shifted under the pointer.
				th.col-feature {
					font-size: 15px;

					a {
						text-decoration: underline;
						text-decoration-color: #212121;
					}
				}

				// Centred rather than offset by a constant, so it stays put on the taller
				// rows that a wrapped label produces.
				th.col-feature::before {
					content: '';
					height: 44px;
					display: block;
					border: 1px solid #00695c;
					position: absolute;
					left: 0;
					top: 50%;
					transform: translateY(-50%);
				}

				td.col-ce,
				td.col-pe {
					img {
						width: 24px;
						height: 24px;
					}
				}
			}
		}

		.comparison-group .cell-link {
			// Above any stretched row-link overlay, so both stay clickable on a row
			// that has an href as well as cell links.
			position: relative;
			z-index: 1;
			font-size: $font-size-sm;
			color: $color-primary;
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}

			&.pe-link {
				color: var(--comparison-pe-color, #{$color-pe});
			}
		}

		// Widths are table-wide, so a group with any text-link cell widens every row in
		// that group — exact for a single-row group, an accepted shift otherwise.
		// Same inputs as the blocks above, with flex shares 1 / 0.45 / 0.45.
		@media screen and (max-width: 500px) {
			.comparison-group--link-cells {
				.c-feature { width: 52.3987%; }
				.c-ce { width: 21.5883%; }
				.c-pe { width: 26.0130%; }
			}
		}

		@media screen and (max-width: 430px) {
			.comparison-group--link-cells {
				.c-feature { width: 52.3097%; }
				.c-ce { width: 20.7871%; }
				.c-pe { width: 26.9033%; }
			}
		}
	}
</style>
