---
import { Icon } from 'astro-icon/components';
import type { HomeRow } from '@data/home-rows';

/**
 * A homepage feature row: copy beside a visual. The copy is first in the markup and CSS moves the
 * media, so screen readers always read the text first.
 */
interface Props extends HomeRow {
	mediaFirst?: boolean;
	bleed?: boolean;
}

const { title, body, links, badge, mediaFirst = false, bleed = true } = Astro.props;
---

<section class:list={['feature-row', { 'feature-row--bleed': bleed }]} style={`--row-hue: ${badge.color}`}>
	<div class="main-div">
		<div class="feature-row__copy">
			<span class="feature-row__badge" style={`--badge-color: ${badge.color}`} aria-hidden="true">
				<Icon name={badge.icon} />
			</span>
			<h3 class="feature-row__title">{title}</h3>
			<p class="feature-row__body">{body}</p>
			<p class="feature-row__links print:hidden">
				{links.map((link) => (
					<a class="feature-row__link" href={link.href}>
						{link.text}
						<Icon name="tabler:chevron-right" class="link-chevron" aria-hidden="true" />
					</a>
				))}
			</p>
		</div>
		<div class:list={['feature-row__media', mediaFirst && 'feature-row__media--first']}>
			<slot />
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/print-mixins' as *;

	// Each row takes its badge's hue: a wash under it, and the rails and their labels in the visual.
	.feature-row {
		--flow-rail: var(--row-hue);
		--flow-label-font: #{$font-family-mono};
		--flow-label-size: 14;
		--flow-label-tracking: 0.02em;

		background: linear-gradient(180deg, #fff 0%, color-mix(in srgb, var(--row-hue) 8%, #fff) 100%);

		.main-div {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 56px;
			// The floor is the content's, so the padding is added back: it is what makes the five rows
			// one height, set to the tallest natural row rather than to a comfortable minimum.
			min-height: calc(350px + 2 * #{$spacing-20});
			max-width: $home-measure;
			padding-block: $spacing-20;
		}

		&__copy {
			flex: 0 1 40ch;
			max-width: 40ch;
		}

		&__media {
			display: flex;
			flex: 1 1 0;
			justify-content: center;
			min-width: 0;

			> :global(*) {
				width: 100%;
				max-width: 560px;
			}

			&--first {
				order: -1;
			}
		}

		&__badge {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 40px;
			height: 40px;
			margin-bottom: 14px;
			border-radius: 32%;
			background-color: var(--badge-color);
			color: $color-white;
			@include mark-shade;

			:global([data-icon]) {
				width: 24px;
				height: 24px;
			}
		}

		// A step below the statement above these rows, which is 32: at 32 a heading runs to three lines
		// in this column and the row has to grow to hold it.
		&__title {
			font-size: $font-size-3xl;
			font-weight: $font-weight-bold;
			line-height: 1.2;
			margin: 0 0 14px;
			text-wrap: balance;
			color: var(--color-text);
		}

		&__body {
			font-size: $font-size-base;
			font-weight: $font-weight-normal;
			line-height: 1.5;
			color: var(--color-text);
			margin: 0;
		}

		&__links {
			display: flex;
			flex-wrap: wrap;
			gap: $spacing-2 $spacing-6;
			margin: $spacing-5 0 0;
		}

		&__link {
			display: inline-flex;
			align-items: center;
			font-size: 1.125rem;
			font-weight: $font-weight-medium;
			text-decoration: none;
			text-underline-offset: 0.2em;
			color: var(--color-primary);

			:global(.link-chevron) {
				@include link-chevron;
			}

			&:hover {
				text-decoration: underline;
			}

			&:active {
				opacity: 0.75;
			}
		}

		@media screen and (min-width: 1120px) {
			&--bleed .feature-row__media > :global(*) {
				--row-bleed: 40px;

				width: calc(100% + var(--row-bleed));
				max-width: none;
				margin-right: calc(-1 * var(--row-bleed));
			}

			&--bleed .feature-row__media--first > :global(*) {
				margin-right: 0;
				margin-left: calc(-1 * var(--row-bleed));
			}
		}

		@include media-down(lg) {
			.main-div {
				flex-direction: column;
				// Not `center`: it would size the width to the content and collapse `width: 100%` media to zero.
				align-items: stretch;
				gap: $spacing-8;
				min-height: 0;
			}

			.feature-row__media--first {
				order: 0;
			}

			// Stacked, a 40ch flex-basis would resolve to height; the copy keeps a centred 544 column.
			.feature-row__copy {
				flex: 0 1 auto;
				align-self: center;
				width: 100%;
				max-width: 544px;
			}

			.feature-row__media > :global(*) {
				max-width: none;
			}
		}

		// Phones, which is also where the visuals switch to their own stacked layout.
		@media (max-width: 768px) {
			.main-div {
				padding-block: 36px;
			}

			.feature-row__media {
				margin-inline: -12px;
			}

			.feature-row__badge {
				margin-bottom: 10px;
			}

			.feature-row__title {
				margin-bottom: 10px;
			}

			.feature-row__links {
				margin-top: $spacing-4;
			}
		}

		@media print {
			background: none;

			.main-div {
				min-height: 0;
				padding-block: 0;
				margin-block: $spacing-6;
				break-inside: avoid;
			}

			.feature-row__media > :global(*) {
				max-width: 440px;
			}

			&__badge,
			&__media {
				@include print-exact;
			}
		}
	}
</style>
