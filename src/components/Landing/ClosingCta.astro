---
import mark from '@root/icons/thingsboard-mark.svg?raw';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import CtaButton from '@components/Landing/CtaButton.astro';
import type { Cta } from '@models/cta';

/** A page's closing call to action: mark, heading, lede and buttons over the wave field; the slot follows the buttons. */
interface Props {
	title: string;
	lead: string;
	buttons: Cta[];
	/** `dark` for the homepage; `band` for a product page's light tint, coloured by its `--page-*` tokens. */
	tone?: 'dark' | 'band';
	/** A small link under the buttons, e.g. the license or privacy policy. */
	note?: { text: string; href: string };
}

const { title, lead, buttons, tone = 'dark', note } = Astro.props;
---

<section class:list={['closing-cta', `closing-cta--${tone}`, 'print:hidden']}>
	<PricingBackground contained />

	<div class="main-div">
		<span class="closing-cta__badge" aria-hidden="true" set:html={mark} />
		<h2 class="closing-cta__title">{title}</h2>

		<p class="closing-cta__lead">{lead}</p>

		<div class="closing-cta__actions">
			{buttons.map(({ text, ...button }) => (
				<CtaButton {...button}>{text}</CtaButton>
			))}
		</div>

		<slot />

		{note && (
			<p class="closing-cta__note">
				<a href={note.href}>{note.text}</a>
			</p>
		)}
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.closing-cta {
		overflow: hidden;
		// Keeps the wave field's `z-index: -1` above this background.
		isolation: isolate;
		padding-block: 96px;

		@include media-down(md) {
			padding-block: $spacing-16;
		}

		.main-div {
			max-width: $home-measure;
			text-align: center;
		}
	}

	// Same ground as the Products section.
	.closing-cta--dark {
		background-color: #121425;
		color: $color-white;

		// Lighter than the brand colour, which would be invisible at the field's low opacity.
		:global(.pricing-bg) {
			--pricing-wave-color: #8b9bff;
		}

		.closing-cta__lead {
			color: rgb(255 255 255 / 72%);
		}

		// Holds the homepage headline to two lines; the balancer picks the break.
		.closing-cta__title {
			max-width: 28ch;
		}

		// Same tile and ink as `.hub__badge`, `.norm__badge` and `.plat__core-badge`, without their shadow.
		.closing-cta__badge {
			padding: 12px;
			color: #111318;
			background: linear-gradient(155deg, #fff 35%, color-mix(in srgb, var(--color-primary, #3d50f5) 5%, #fff) 100%);
		}
	}

	.closing-cta--band {
		--cta-outline-line: rgb(15 23 42 / 22%);
		--cta-outline-ink: var(--color-text);

		background-color: var(--page-band);
		color: var(--color-text);

		:global(.pricing-bg) {
			--pricing-wave-color: var(--page-wave);
		}

		.closing-cta__lead {
			color: var(--color-text-secondary);
		}

		// Matches `.product-hero__mark`.
		.closing-cta__badge {
			color: $color-white;
			background-color: var(--page-accent);
			background-image: linear-gradient(150deg, rgb(255 255 255 / 24%), rgb(255 255 255 / 0%) 62%);

			:global(svg) {
				width: 60%;
			}
		}
	}

	.closing-cta__badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 80px;
		height: 80px;
		margin: 0 auto 14px;
		border-radius: 32%;

		:global(svg) {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	.closing-cta__title {
		margin: 0 auto $spacing-5;
		font-size: clamp(30px, calc(0.5rem + 2.6vw), 40px);
		font-weight: $font-weight-bold;
		line-height: 1.2;
		text-wrap: balance;
	}

	.closing-cta__lead {
		@include text-m;
		max-width: 52ch;
		margin: 0 auto $spacing-8;
		line-height: 1.5;
		text-wrap: pretty;
	}

	.closing-cta__note {
		@include text-s;
		margin: $spacing-8 0 0;

		a {
			color: var(--color-text-secondary);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover,
			&:focus-visible {
				color: var(--page-accent-ink);
			}
		}
	}

	.closing-cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-2;
	}
</style>
