---
import mark from '@root/icons/thingsboard-mark.svg?raw';

/** Protocol hub: ten protocol chips wired to the platform badge in the middle. */

const BLUE = '#0e7490';
const LAVENDER = '#7b3fe4';
const BEIGE = '#b45309';
const GREEN = '#65a30d';

/** At most seven characters: `COL` fits the longest name. */
const LEFT = [
	{ name: 'MQTT', accent: BLUE },
	{ name: 'Modbus', accent: BEIGE },
	{ name: 'LoRaWAN', accent: GREEN },
	{ name: 'HTTP', accent: LAVENDER },
	{ name: 'OCPP', accent: BLUE },
];
const RIGHT = [
	{ name: 'OPC UA', accent: LAVENDER },
	{ name: 'CoAP', accent: BLUE },
	{ name: 'Sigfox', accent: BEIGE },
	{ name: 'BACnet', accent: GREEN },
	{ name: 'S7', accent: LAVENDER },
];

const rgb = (c: string) => {
	const n = parseInt(c.slice(1), 16);
	return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
};
const lit = (c: string) =>
	`rgb(${rgb(c)
		.map((v) => Math.round(v * 0.28 + 255 * 0.72))
		.join(', ')})`;
const tint = (c: string) => `rgba(${rgb(c).join(', ')}, 0.16)`;

const STUB = 36;
const GUT = 74;
const BADGE = 104;
const CHIP_H = 40;
// 17, not the design's 20: it is sized to this site's mono stack, whose advance is 0.6em where the
// design was drawn against Ubuntu Mono's 0.5em. `LoRaWAN` then paints 71 units of the 76 `COL`
// leaves it, which is the fit the design has.
const CHIP_FONT = 17;
const PITCH = 56; // must stay above CHIP_H or the rows overlap
const COL = 100;

const CHIP_IN = STUB + COL;
const NATIVE = 2 * (CHIP_IN + GUT) + BADGE;
const HEIGHT = LEFT.length * PITCH;

const MID_X = NATIVE / 2;
const MID_Y = HEIGHT / 2;
const BADGE_L = MID_X - BADGE / 2;
const BADGE_R = MID_X + BADGE / 2;
const CHIP_X = NATIVE - CHIP_IN;

const cy = (i: number) => PITCH / 2 + i * PITCH;

const FAN = 68;
const ay = (i: number, n: number) => MID_Y - FAN / 2 + (FAN / (n - 1)) * i;

/** How far the badge's rounded edge sits inside its bounding box at a given y, so lines touch it. */
const RADIUS = BADGE * 0.32;
const inset = (y: number) => {
	const dy = Math.min(y - (MID_Y - BADGE / 2), MID_Y + BADGE / 2 - y);
	if (dy >= RADIUS) return 0;
	return RADIUS - Math.sqrt(Math.max(0, RADIUS * RADIUS - (RADIUS - dy) ** 2));
};

const EASE = 0.55;
const curveLeft = (i: number) => {
	const y0 = cy(i);
	const y1 = ay(i, LEFT.length);
	const x1 = BADGE_L + inset(y1);
	const k = (x1 - CHIP_IN) * EASE;
	return `M ${CHIP_IN},${y0} C ${CHIP_IN + k},${y0} ${x1 - k},${y1} ${x1},${y1}`;
};
const curveRight = (i: number) => {
	const y0 = cy(i);
	const y1 = ay(i, RIGHT.length);
	const x1 = BADGE_R - inset(y1);
	const k = (CHIP_X - x1) * EASE;
	return `M ${CHIP_X},${y0} C ${CHIP_X - k},${y0} ${x1 + k},${y1} ${x1},${y1}`;
};

/**
 * Signal pips: a dash on a copy of each wire. `pathLength="100"` lets one dash pattern fit every
 * arm.
 */
const CYCLE_MS = 4800;
const TRAVEL_TARGET_MS = 620;
const DASH = 8;
const PATTERN = Math.round((100 * CYCLE_MS) / TRAVEL_TARGET_MS);
/** Golden-ratio phases so no two pips coincide; negative delay so all are live on frame one. */
const phase = (i: number) => +(((i * 0.618033988749895) % 1) * CYCLE_MS).toFixed(1);

const vars = [
	`--hub-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	`--hub-cycle: ${CYCLE_MS}ms`,
	`--hub-dash: ${DASH} ${PATTERN - DASH}`,
	`--hub-pattern: ${PATTERN}`,
	`--hub-native: ${NATIVE}`,
	`--hub-h: ${HEIGHT}`,
	`--hub-badge: ${BADGE}`,
	`--hub-chip-h: ${CHIP_H}`,
	`--hub-chip-font: ${CHIP_FONT}`,
	`--hub-chip-x: ${CHIP_X}`,
	`--hub-stub: ${STUB}`,
	`--hub-mid-y: ${MID_Y}`,
].join('; ');
---

<div class="hub-fit">
	<div class="hub" style={vars}>
		<svg
			class="hub__wires"
			viewBox={`0 0 ${NATIVE} ${HEIGHT}`}
			preserveAspectRatio="none"
			aria-hidden="true"
			focusable="false"
		>
			{LEFT.map((c, i) => (
				<path class="hub__wire" d={curveLeft(i)} stroke={c.accent} />
			))}
			{RIGHT.map((c, i) => (
				<path class="hub__wire" d={curveRight(i)} stroke={c.accent} />
			))}

			{LEFT.map((c, i) => (
				<path
					class="hub__pip"
					d={curveLeft(i)}
					pathLength="100"
					style={`--pip-accent: ${lit(c.accent)}; --pip-phase: ${phase(i)}ms`}
				/>
			))}
			{RIGHT.map((c, i) => (
				<path
					class="hub__pip"
					d={curveRight(i)}
					pathLength="100"
					style={`--pip-accent: ${lit(c.accent)}; --pip-phase: ${phase(LEFT.length + i)}ms`}
				/>
			))}
		</svg>

		{LEFT.map((c, i) => (
			<span
				class="hub__chip hub__chip--l"
				style={`--hub-accent: ${c.accent}; --hub-tint: ${tint(c.accent)}; --hub-y: ${cy(i)}`}
			>
				{c.name}
			</span>
		))}
		{RIGHT.map((c, i) => (
			<span
				class="hub__chip hub__chip--r"
				style={`--hub-accent: ${c.accent}; --hub-tint: ${tint(c.accent)}; --hub-y: ${cy(i)}`}
			>
				{c.name}
			</span>
		))}

		<span class="hub__badge" aria-hidden="true" set:html={mark} />
		<span class="hub__label">ThingsBoard</span>
	</div>
</div>

<script>
	import { pauseOffscreen } from '@util/pause-offscreen';

	pauseOffscreen('.hub');
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.hub-fit {
		container-type: inline-size;
	}

	.hub {
		--u: var(--hub-u);
		--hub-wire-w: max(1px, #{u(2)});
		// Bounds paint of the animating paths and clips a chip's fade if the mono font falls back.
		contain: paint;
		position: relative;
		width: u(var(--hub-native));
		max-width: 100%;
		height: u(var(--hub-h));
		margin-inline: auto;
	}

	.hub__wires {
		position: absolute;
		inset: 0;
		// An `svg` is a replaced element: with `auto` it takes its intrinsic size rather than the inset box.
		width: 100%;
		height: 100%;
	}

	// Without `vector-effect` the px stroke would be scaled again by the viewBox.
	.hub__wire,
	.hub__pip {
		fill: none;
		stroke-width: var(--hub-wire-w);
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}

	.hub__pip {
		stroke: var(--pip-accent);
		stroke-dasharray: var(--hub-dash);
		animation: hub-pip var(--hub-cycle) linear infinite;
		animation-delay: calc(-1 * var(--pip-phase, 0ms));

		.hub[data-offscreen] & {
			animation-play-state: paused;
		}
	}

	@keyframes hub-pip {
		from {
			stroke-dashoffset: var(--hub-pattern);
		}

		to {
			stroke-dashoffset: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hub__pip {
			display: none;
		}
	}

	.hub__chip::after {
		content: '';
		position: absolute;
		top: 50%;
		width: u(var(--hub-stub));
		height: var(--hub-wire-w);
		transform: translateY(-50%);
	}

	.hub__chip--l::after {
		right: 100%;
		background: linear-gradient(to left, var(--hub-accent), transparent);
	}

	.hub__chip--r::after {
		left: 100%;
		background: linear-gradient(to right, var(--hub-accent), transparent);
	}

	.hub__chip {
		position: absolute;
		top: calc(var(--hub-y) * var(--u));
		display: flex;
		align-items: center;
		height: u(var(--hub-chip-h));
		padding: 0 u(12);
		transform: translateY(-50%);
		border-radius: u(10);
		background: var(--hub-tint);
		font-family: $font-family-mono;
		font-size: u(var(--hub-chip-font));
		font-weight: $font-weight-bold;
		line-height: 1;
		white-space: nowrap;
		color: var(--color-text, #17181c);
	}

	.hub__chip--l {
		right: u(var(--hub-chip-x));
	}

	.hub__chip--r {
		left: u(var(--hub-chip-x));
	}

	.hub__badge {
		position: absolute;
		top: calc(var(--hub-mid-y) * var(--u));
		left: 50%;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: u(var(--hub-badge));
		height: u(var(--hub-badge));
		padding: u(16);
		transform: translate(-50%, -50%);
		border-radius: 32%;
		// Same tile and ink as `.norm__badge` (NormalizeSeries) and `.plat__core-badge` (PlatformOverview).
		color: #111318;
		background: linear-gradient(155deg, #fff 35%, color-mix(in srgb, var(--color-primary, #3d50f5) 5%, #fff) 100%);
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.06),
			0 #{u(7)} #{u(16)} #{u(-5)} rgba(16, 24, 40, 0.22);

		:global(svg) {
			display: block;
			width: 100%;
			height: 100%;
		}
	}

	.hub__label {
		@include visually-hidden;
	}

	@media print {
		.hub__pip {
			visibility: hidden;
		}

		.hub__badge {
			border: 1px solid var(--color-border, #ebebeb);
			box-shadow: none;
		}
	}
</style>
