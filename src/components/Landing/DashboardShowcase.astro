---
import { Icon } from 'astro-icon/components';
import SmartImage from '@components/SmartImage.astro';
import ImageComparison from '@components/UseCase/ImageComparison.astro';
import { homeCarouselItems } from '@data/homeCarousel';
import { DASHBOARDS_BADGE } from '@data/home-rows';

/** Dashboard showcase: one board on top, a tab list of the use cases below. */

// The prefix that pairs each tab with its panel through `aria-controls` / `aria-labelledby`.
const ID = 'dashboards';

const ratioOf = (item: (typeof homeCarouselItems)[number]) => Number(item.width) / Number(item.height);

// The board is `100vw - 46px` wide, capped at 1158px; the srcset stops at the source's own width.
const SLIDE_WIDTHS = [480, 800, 1160, 1600, 1920];
const SLIDE_SIZES = '(max-width: 1204px) calc(100vw - 46px), 1158px';
const widthsOf = (item: (typeof homeCarouselItems)[number]) => {
	const max = Number(item.width);
	return [...SLIDE_WIDTHS.filter((w) => w < max), max];
};
---

<section id={ID} class="dashboards" style={`--glow-hue: ${DASHBOARDS_BADGE.color}`} data-dashshow>
	<div class="main-div">
		<header class="dashboards__head">
			<span class="dashboards__badge" style={`--badge-color: ${DASHBOARDS_BADGE.color}`} aria-hidden="true">
				<Icon name={DASHBOARDS_BADGE.icon} />
			</span>
			<h2 class="dashboards__title">Build real-time IoT dashboards</h2>
			<p class="dashboards__lede">
				Assemble the view your users need from 600+ widgets, and control devices from the same screen. No front-end code
				required.
			</p>
			<a class="dashboards__all print:hidden" href="/use-cases/">
				Browse all use cases
				<Icon name="tabler:chevron-right" class="link-chevron" aria-hidden="true" />
			</a>
		</header>

		<div class="dashshow__stage">
			<div class="dashshow__glow print:hidden" aria-hidden="true"></div>
			<div class="dashshow__board" style={`--item-ratio: ${ratioOf(homeCarouselItems[0])}`}>
				{homeCarouselItems.map((item, i) => (
					<div
						class="dashshow__frame"
						hidden={i !== 0}
						data-ratio={ratioOf(item)}
						style={item.overlaySrc ? `--cmp-ratio: ${item.width} / ${item.height}` : undefined}
					>
						{item.overlaySrc ? (
							<ImageComparison
								baseImage={item.src}
								baseImageAlt={item.alt}
								overlayImage={item.overlaySrc}
								overlayImageAlt={item.overlayAlt ?? item.alt}
							/>
						) : (
							<SmartImage
								src={item.src}
								alt={item.alt}
								width={item.width}
								height={item.height}
								widths={widthsOf(item)}
								sizes={SLIDE_SIZES}
								loading={i === 0 ? 'eager' : 'lazy'}
							/>
						)}
					</div>
				))}

				<div class="dashshow__arrows print:hidden">
					<button type="button" class="dashshow__arrow" data-dashshow-prev aria-label="Previous use case">
						<Icon name="tabler:chevron-left" aria-hidden="true" />
					</button>
					<button type="button" class="dashshow__arrow" data-dashshow-next aria-label="Next use case">
						<Icon name="tabler:chevron-right" aria-hidden="true" />
					</button>
				</div>
			</div>

			<div class="dashshow__body">
				<div
					class="dashshow__nav print:hidden"
					role="tablist"
					aria-orientation="vertical"
					aria-label="Use cases"
					style={`--nav-rows: ${Math.ceil(homeCarouselItems.length / 2)}`}
				>
					{homeCarouselItems.map((item, i) => (
						<button
							type="button"
							role="tab"
							class="dashshow__case"
							id={`${ID}-tab-${i}`}
							aria-controls={`${ID}-panel-${i}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
						>
							<Icon name={item.icon} class="dashshow__case-icon" aria-hidden="true" />
							{item.title}
						</button>
					))}
				</div>

				{homeCarouselItems.map((item, i) => (
					<div role="tabpanel" id={`${ID}-panel-${i}`} aria-labelledby={`${ID}-tab-${i}`} hidden={i !== 0}>
						<h3 class="dashshow__title">{item.title}</h3>
						<p class="dashshow__desc">{item.description}</p>
						<a href={item.href} class="dashshow__link print:hidden">
							{item.title} use case
							<Icon name="tabler:chevron-right" class="link-chevron" aria-hidden="true" />
						</a>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/print-mixins' as *;

	.dashboards {
		// Shared by the board and the glow centred on it.
		--board-w: min(1160px, calc(100vw - #{$spacing-10}));
		--board-h: calc(var(--board-w) / (1920 / 866));

		// The glow's -1 stays above the band; the clip keeps its overhang from widening the page.
		isolation: isolate;
		overflow: clip;
		padding-block: $spacing-20;

		.main-div {
			max-width: $home-measure;
		}

		@include media-down(md) {
			padding-block: $spacing-10;
		}
	}

	.dashboards__head {
		margin-bottom: $spacing-8;
		text-align: center;
	}

	.dashboards__badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		margin: 0 auto 14px;
		border-radius: 32%;
		background-color: var(--badge-color);
		color: $color-white;
		@include mark-shade;

		:global([data-icon]) {
			width: 40px;
			height: 40px;
		}
	}

	.dashboards__title {
		@include home-section-title;
		margin: 0 0 $spacing-5;
		color: var(--color-text);
	}

	.dashboards__lede {
		@include text-m;
		line-height: 1.5;
		max-width: 65ch;
		margin: 0 auto;
	}

	.dashboards__all {
		@include action-link;
		display: inline-flex;
		align-items: center;
		margin-top: $spacing-4;
		color: var(--color-primary);
		text-decoration: none;

		:global(.link-chevron) {
			@include link-chevron;
		}

		&:hover {
			text-decoration: underline;
		}
	}

	// Zero-height, so it anchors the glow at the board's top without moving it.
	.dashshow__glow {
		position: relative;
		z-index: -1;
		height: 0;

		&::before {
			content: '';
			position: absolute;
			top: calc(var(--board-h) / 2);
			left: 50%;
			width: calc(var(--board-w) * 1.3);
			height: calc(var(--board-h) * 1.9);
			transform: translate(-50%, -50%);
			background: radial-gradient(
				closest-side,
				color-mix(in srgb, var(--glow-hue) 24%, transparent) 0%,
				color-mix(in srgb, var(--glow-hue) 13%, transparent) 50%,
				color-mix(in srgb, var(--glow-hue) 4%, transparent) 78%,
				transparent 100%
			);
			pointer-events: none;
		}
	}

	// Margins, not a transform, which would resample the screenshot. The height is fixed so nothing
	// below moves between tabs; the width follows the current shot's ratio.
	.dashshow__board {
		--fit-w: min(var(--board-w), calc(var(--board-h) * var(--item-ratio)));

		position: relative;
		overflow: hidden;
		width: var(--fit-w);
		height: var(--board-h);
		margin: 0 calc((100% - var(--fit-w)) / 2) $spacing-6;
		// Horizontal pans are left to the swipe handler in the script.
		touch-action: pan-y;
		border: 1px solid var(--color-border);
		border-radius: $radius-lg;
		background: var(--color-bg-surface);
		box-shadow: var(--shadow-card);
		// Every shot in one cell, so the leaving one stays under the arriving one while it drifts out.
		display: grid;
		grid-template: minmax(0, 1fr) / minmax(0, 1fr);
		// Must match HAND_OFF_MS and EASE in the script.
		transition:
			width 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
			margin-inline 420ms cubic-bezier(0.2, 0.8, 0.2, 1);

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}
	}

	.dashshow__frame {
		grid-area: 1 / 1;
		z-index: 1;
		height: 100%;

		&.is-leaving {
			z-index: 0;
			pointer-events: none;
		}

		:global(img) {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		// The comparison keeps its own ratio, so the handle never runs over blank space.
		:global(.uc-img-comparison) {
			height: 100%;
			margin: 0 auto;
			aspect-ratio: var(--cmp-ratio);
		}

		// Both halves fit the same box, or the shots drift out of register.
		:global(.uc-img-overlay img) {
			object-fit: contain;
		}
	}

	.dashshow__arrows {
		position: absolute;
		// Above the frames, which stack at 1.
		z-index: 2;
		right: $spacing-3;
		bottom: $spacing-3;
		display: flex;
		gap: $spacing-2;

		// Phones swipe the board instead (see the script).
		@include media-down(md) {
			display: none;
		}
	}

	// Solid, so they stay visible over dark screenshots.
	.dashshow__arrow {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--color-text);
		color: $color-white;
		cursor: pointer;
		transition: opacity $transition-fast;

		&:hover,
		&:focus-visible {
			opacity: 0.82;
		}

		svg {
			width: 22px;
			height: 22px;
		}
	}

	.dashshow__body {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: $spacing-8;
		align-items: start;

		@include media-down(md) {
			grid-template-columns: 1fr;
			gap: $spacing-5;
		}
	}

	.dashshow__nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: repeat(var(--nav-rows, 5), auto);
		grid-auto-flow: column;
		column-gap: $spacing-4;

		@include media-down(md) {
			display: flex;
			gap: $spacing-2;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			margin-inline: -$spacing-5;
			// Keeps the focus ring off the scroll container's clipped edge.
			padding: $spacing-1 $spacing-5;
			// A mouse drags the rail (see the script); this stops the drag selecting labels.
			user-select: none;
			scrollbar-width: none;

			&::-webkit-scrollbar {
				display: none;
			}
		}
	}

	.dashshow__case {
		@include text-s;
		line-height: 22px;
		display: flex;
		align-items: center;
		gap: $spacing-3;
		padding: 7px 0 7px $spacing-4;
		border: 0;
		border-left: 2px solid var(--color-border);
		background: none;
		color: var(--color-text-secondary);
		text-align: left;
		cursor: pointer;
		transition:
			color $transition-fast,
			border-color $transition-fast;

		&:hover {
			border-left-color: rgba(0, 0, 0, 0.3);
			color: var(--color-text);
		}

		&[aria-selected='true'] {
			border-left-color: var(--color-primary);
			color: var(--color-text);
			font-weight: $font-weight-bold;
		}

		@include media-down(md) {
			flex: none;
			padding: $spacing-2 $spacing-4;
			border: 1px solid var(--color-border);
			border-radius: $radius-full;
			font-weight: $font-weight-medium;

			&:hover {
				border-color: rgba(0, 0, 0, 0.3);
			}

			// Not bold: it would widen the chip and shift the rest of the rail.
			&[aria-selected='true'] {
				border-color: var(--color-primary);
				background: var(--color-primary);
				color: $color-white;
				font-weight: $font-weight-medium;
			}
		}
	}

	.dashshow__case-icon {
		flex: none;
		width: 18px;
		height: 18px;
	}

	.dashshow__title {
		@include card-title;
		font-weight: $font-weight-bold;
		margin: 0 0 $spacing-3;
		color: var(--color-text);
	}

	.dashshow__desc {
		@include text-s;
		line-height: 22px;
		margin: 0 0 $spacing-4;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.dashshow__link {
		display: inline-flex;
		align-items: center;
		font-size: $font-size-base;
		font-weight: $font-weight-medium;
		line-height: 1.5;
		color: var(--color-primary);
		text-decoration: none;

		:global(.link-chevron) {
			@include link-chevron;
		}

		&:hover,
		&:focus-visible {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}

	@media print {
		.dashboards {
			overflow: visible;
			margin-bottom: $spacing-8;
			padding-block: $spacing-8 0;
		}

		.dashshow__stage {
			display: grid;
			grid-template-columns: minmax(0, min(300px, 44%)) minmax(0, 1fr);
			grid-auto-flow: row dense;
			gap: $spacing-5 $spacing-6;
			align-items: center;
		}

		.dashboards__head {
			@include print-section-head;
			margin-bottom: $spacing-6;
		}

		.dashboards__badge {
			@include print-exact;
			break-after: avoid;
		}

		.dashshow__board,
		.dashshow__body {
			display: contents;
		}

		.dashshow__frame {
			display: block;
			grid-area: auto / 1;
			height: auto;
			overflow: hidden;
			border: 1px solid var(--color-border);
			border-radius: $radius-md;
			break-inside: avoid;

			:global(img),
			:global(.uc-img-comparison) {
				height: auto;
			}

			:global(.uc-img-comparison) {
				aspect-ratio: auto;
			}

			:global(.uc-img-caption) {
				@include text-s;
				margin: $spacing-2 $spacing-3;
			}
		}

		.dashshow__body > [role='tabpanel'] {
			display: block;
			grid-column: 2;
			break-inside: avoid;
		}

		.dashshow__desc {
			margin-bottom: 0;
		}
	}

	@media print and (min-width: 1000px) {
		.dashboards {
			padding-top: $spacing-4;
		}

		.dashboards__head {
			margin-bottom: $spacing-4;
		}

		.dashshow__stage {
			grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-dashshow]').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
		const frames = [...root.querySelectorAll<HTMLElement>('.dashshow__frame')];
		const board = root.querySelector<HTMLElement>('.dashshow__board');
		const rail = root.querySelector<HTMLElement>('[role="tablist"]');
		if (!tabs.length || !board || !rail) return;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let active = 0;

		const railScrolls = () => rail.scrollWidth > rail.clientWidth;

		// Centres the selection on the phone rail. Scrolls only the rail: `scrollIntoView` would scroll
		// the page too.
		const keepInView = (el: HTMLElement) => {
			if (!railScrolls()) return;
			const r = rail.getBoundingClientRect();
			const t = el.getBoundingClientRect();
			rail.scrollBy({ left: t.left - r.left - (r.width - t.width) / 2, behavior: reduced ? 'auto' : 'smooth' });
		};

		const HAND_OFF_MS = 420;
		const EASE = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
		const EASE_OUT = 'cubic-bezier(0.4, 0, 1, 1)';
		let inFlight: Animation[] = [];

		const settle = () => {
			inFlight.forEach((a) => a.cancel());
			inFlight = [];
			frames.forEach((frame, i) => {
				frame.classList.remove('is-leaving');
				frame.hidden = i !== active;
			});
		};

		// Runs on settled frames, so at most two boards are ever shown.
		const handOff = (from: HTMLElement, to: HTMLElement, panel: HTMLElement, dir: number) => {
			from.hidden = false;
			from.classList.add('is-leaving');
			const out = from.animate(
				[
					{ transform: 'none', opacity: 1 },
					{ transform: `translateX(${-dir * 20}px)`, opacity: 0.4 },
				],
				{ duration: HAND_OFF_MS, easing: EASE_OUT, fill: 'forwards' }
			);
			// A single keyframe at `offset: 0` is a start: the element animates from it to its own style.
			const arrive = to.animate([{ transform: `translateX(${dir * 28}px)`, opacity: 0, offset: 0 }], {
				duration: HAND_OFF_MS,
				easing: EASE,
				fill: 'backwards',
			});
			const rise = panel.animate([{ transform: 'translateY(8px)', opacity: 0, offset: 0 }], {
				duration: 300,
				delay: 80,
				easing: EASE,
				fill: 'backwards',
			});
			inFlight = [out, arrive, rise];
			arrive.finished.then(settle, () => {});
		};

		// The slide follows `next` before it wraps, so "next" from the last case still slides forward.
		const show = (next: number, focus = false) => {
			const previous = active;
			const dir = Math.sign(next - previous);
			active = (next + tabs.length) % tabs.length;

			tabs.forEach((tab, i) => {
				const on = i === active;
				tab.setAttribute('aria-selected', String(on));
				// Roving tabindex: the list is one stop, arrow keys move within it.
				tab.tabIndex = on ? 0 : -1;
			});
			panels.forEach((panel, i) => (panel.hidden = i !== active));
			settle();
			if (!reduced && dir) handOff(frames[previous], frames[active], panels[active], dir);

			const ratio = frames[active].dataset.ratio;
			if (ratio) board.style.setProperty('--item-ratio', ratio);

			// `focus()` would scroll the chip in by its own shortest hop and cancel the centring below.
			if (focus) tabs[active].focus({ preventScroll: railScrolls() });
			keepInView(tabs[active]);
		};

		// Each tick checks whether it may advance: not on hover, focus, off screen or in a background
		// tab. Any choice by the reader stops it for good.
		let stopped = reduced;
		let onScreen = false;

		new IntersectionObserver((entries) => (onScreen = entries[0].isIntersecting)).observe(root);

		const ticker = window.setInterval(() => {
			if (stopped) {
				window.clearInterval(ticker);
				return;
			}
			if (!onScreen || document.hidden) return;
			if (root.matches(':hover') || root.contains(document.activeElement)) return;

			show(active + 1);
		}, 12000);

		const stop = () => (stopped = true);

		tabs.forEach((tab, i) =>
			tab.addEventListener('click', () => {
				show(i);
				stop();
			})
		);

		root.querySelector('[data-dashshow-prev]')?.addEventListener('click', () => {
			show(active - 1);
			stop();
		});
		root.querySelector('[data-dashshow-next]')?.addEventListener('click', () => {
			show(active + 1);
			stop();
		});

		// Touch swipe on the board steps cases; not on the comparison, whose handle drags horizontally.
		const SWIPE_MIN = 40;
		let swipeFrom: { x: number; y: number } | null = null;

		board.addEventListener('pointerdown', (event) => {
			const onComparison = event.target instanceof Element && !!event.target.closest('.uc-img-comparison');
			swipeFrom = event.pointerType === 'touch' && !onComparison ? { x: event.clientX, y: event.clientY } : null;
		});
		// A vertical pan is the browser's and cancels the pointer, so a scroll cannot land as a swipe.
		board.addEventListener('pointercancel', () => (swipeFrom = null));
		board.addEventListener('pointerup', (event) => {
			if (!swipeFrom) return;
			const dx = event.clientX - swipeFrom.x;
			const dy = event.clientY - swipeFrom.y;
			swipeFrom = null;
			if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) < Math.abs(dy)) return;
			show(active + (dx < 0 ? 1 : -1));
			stop();
		});

		// A mouse cannot scroll the rail natively (hidden scrollbar, vertical wheel), so it drags it.
		// Any interaction with the rail stops autoplay, or the next tick would pull it back.
		const DRAG_MIN = 5;
		let drag: { x: number; left: number; moved: boolean } | null = null;

		rail.addEventListener('pointerdown', (event) => {
			stop();
			if (event.pointerType !== 'mouse' || event.button !== 0 || !railScrolls()) return;
			drag = { x: event.clientX, left: rail.scrollLeft, moved: false };
		});
		rail.addEventListener('wheel', stop, { passive: true });
		rail.addEventListener('pointermove', (event) => {
			if (!drag) return;
			// Released off the rail before the drag was captured: its pointerup went elsewhere.
			if (!(event.buttons & 1)) {
				drag = null;
				return;
			}
			const dx = event.clientX - drag.x;
			if (!drag.moved && Math.abs(dx) < DRAG_MIN) return;
			// Captured only once it is a drag, so a plain press still clicks its chip.
			if (!drag.moved) rail.setPointerCapture(event.pointerId);
			drag.moved = true;
			rail.scrollLeft = drag.left - dx;
		});

		// The click that ends a drag belongs to no chip. Removed on the next tick, since a drag ending off
		// the rail produces no click and a waiting listener would eat the next real one.
		const swallowClick = (event: Event) => {
			event.preventDefault();
			event.stopPropagation();
		};
		rail.addEventListener('pointerup', () => {
			if (drag?.moved) {
				rail.addEventListener('click', swallowClick, { capture: true, once: true });
				window.setTimeout(() => rail.removeEventListener('click', swallowClick, { capture: true }));
			}
			drag = null;
		});
		rail.addEventListener('pointercancel', () => (drag = null));

		rail.addEventListener('keydown', (event) => {
			const key = (event as KeyboardEvent).key;
			const step = key === 'ArrowDown' || key === 'ArrowRight' ? 1 : key === 'ArrowUp' || key === 'ArrowLeft' ? -1 : 0;

			if (step) {
				event.preventDefault();
				show(active + step, true);
			} else if (key === 'Home' || key === 'End') {
				event.preventDefault();
				show(key === 'Home' ? 0 : tabs.length - 1, true);
			}
		});
	});
</script>
