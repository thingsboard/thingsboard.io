---
import { Icon } from 'astro-icon/components';
import SolutionAppShell from './SolutionAppShell.astro';

/** Device to end-user: two capability lists feeding the customer's app. Scales as one, never reflows. */

const STAGES = [
	{
		title: 'Connect devices',
		rows: [
			{ label: 'Sensors', icon: 'tabler:access-point' },
			{ label: 'Gateways', icon: 'tabler:topology-star' },
			{ label: 'Machines', icon: 'tabler:engine' },
			{ label: 'Meters', icon: 'tabler:gauge' },
		],
	},
	{
		title: 'Build solution',
		rows: [
			{ label: 'Digital twins', icon: 'tabler:box-model' },
			{ label: 'Rule chains', icon: 'tabler:hierarchy-2' },
			{ label: 'Alarms', icon: 'tabler:bell-ringing' },
			{ label: 'Dashboards', icon: 'tabler:layout-dashboard' },
		],
	},
];
---

<div class="flow-fit">
	<div class="flow" data-flow>
		{STAGES.map((stage) => (
			<>
				<div class="flow__stage">
					<p class="flow__label">{stage.title}</p>
					<ul class="flow__list" role="list">
						{stage.rows.map((row) => (
							<li>
								<Icon name={row.icon} width="20" height="20" aria-hidden="true" />
								<span>{row.label}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="flow__arrow" aria-hidden="true">
					<span class="flow__arrow-line" />
					<span class="flow__arrow-head" />
				</div>
			</>
		))}

		<div class="flow__stage">
			<p class="flow__label">Share with your users</p>
			<div class="flow__app-slot">
				<SolutionAppShell />
			</div>
		</div>
	</div>
</div>

<script>
	// Lights the flow in reading order ahead of the shell's brand swap.
	const HOLD_MS = 260;

	document.querySelectorAll<HTMLElement>('[data-flow]').forEach((flow) => {
		const lists = Array.from(flow.querySelectorAll<HTMLElement>('.flow__list'));
		const arrows = Array.from(flow.querySelectorAll<HTMLElement>('.flow__arrow'));
		const order = [lists[0], arrows[0], lists[1], arrows[1]].filter(Boolean);
		if (order.length < 4) return;

		flow.addEventListener('solution-swap-soon', (e) => {
			const lead = (e as CustomEvent<{ in: number }>).detail?.in ?? 1000;
			const step = lead / order.length;
			order.forEach((el, i) => {
				setTimeout(() => el.classList.add('is-lit'), i * step);
				setTimeout(() => el.classList.remove('is-lit'), i * step + HOLD_MS);
			});
		});
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.flow-fit {
		container-type: inline-size;
	}

	.flow {
		--u: clamp(0.45px, calc(100cqw / 560), 1.15px);
		--flow-label-h: #{u(24)};
		--flow-label-gap: #{u(8)};
		display: grid;
		grid-template-columns: 1fr u(18) 1fr u(18) 1.45fr;
		align-items: stretch;
		// Stops the fr columns stretching once the unit hits its cap.
		max-width: calc(560 * var(--u));
		margin: 0 auto;
	}

	.flow__stage {
		display: flex;
		flex-direction: column;
	}

	.flow__label {
		min-height: var(--flow-label-h);
		margin: 0 0 var(--flow-label-gap);
		font-size: u(15);
		line-height: u(24);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	.flow__list {
		display: flex;
		overflow: hidden;
		flex-direction: column;
		margin: auto 0;
		padding: 0;
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: u(8);
		background: var(--color-bg-surface, #fff);
		list-style: none;

		li {
			display: flex;
			align-items: center;
			gap: u(12);
			padding: u(8) u(16);
			font-size: u(16);
			font-weight: $font-weight-medium;
			line-height: u(28);
			white-space: nowrap;
			color: var(--color-text);
		}

		li + li {
			border-top: 1px solid var(--color-border, #ebebeb);
		}

		[data-icon] {
			flex: none;
			width: u(20);
			height: u(20);
			color: var(--color-text-secondary, #5b616e);
		}
	}

	.flow__arrow {
		--flow-rail-color: var(--color-text-secondary, #5b616e);
		--flow-rail-w: max(1px, #{u(3)});
		display: flex;
		align-items: center;
		padding-top: calc(var(--flow-label-h) + var(--flow-label-gap));
	}

	// A border rather than a background, like the head's arms: Blink rounds border widths to device
	// pixels, so both halves must be borders to match at sub-pixel units.
	.flow__arrow-line {
		flex: 1;
		height: 0;
		border-top: var(--flow-rail-w) solid var(--flow-rail-color);
	}

	// Two borders of a square turned 45deg. Pulled back by 1.2071x the box (8 + 16 * 0.7071) so the
	// line ends at the apex.
	.flow__arrow-head {
		flex: none;
		width: u(16);
		height: u(16);
		margin-left: u(-19.31);
		border-top: var(--flow-rail-w) solid var(--flow-rail-color);
		border-right: var(--flow-rail-w) solid var(--flow-rail-color);
		transform: rotate(45deg);
	}

	.flow__list [data-icon],
	.flow__arrow-line,
	.flow__arrow-head {
		transition:
			color 420ms ease,
			background-color 420ms ease,
			border-color 420ms ease;
	}

	.flow__list.is-lit [data-icon] {
		color: var(--color-primary, #3d50f5);
		transition-duration: 90ms;
	}

	.flow__arrow.is-lit {
		--flow-rail-color: var(--color-primary, #3d50f5);

		.flow__arrow-line,
		.flow__arrow-head {
			transition-duration: 90ms;
		}
	}

	.flow__app-slot {
		margin: auto 0;
	}
</style>
