---
import { Icon } from 'astro-icon/components';
import { externalLinkAttrs } from '@util/external-links';
import type { FeatureItem } from '@data/homeFeatures';

/** One capability: a glyph, a name that is the whole tile's link, and what it gets you. */
type Props = FeatureItem;

const { tablerIcon, title, description, href } = Astro.props;
---

<div class="tile">
	<Icon name={tablerIcon} class="tile__icon" aria-hidden="true" />
	<h3 class="tile__title">
		<a class="tile__link" href={href} {...externalLinkAttrs(href)}>
			{title}
		</a>
	</h3>
	<p class="tile__description" set:html={description} />
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	.tile {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		padding: $spacing-5;
		border-radius: $radius-lg;
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.04),
			0 8px 16px -8px rgba(0, 0, 0, 0.06);
		background-color: var(--color-bg-surface);
		color: var(--color-text);
		transition: box-shadow 0.18s ease;

		@include media-up(md) {
			@include media-down(lg) {
				padding: $spacing-8;
			}
		}

		&:hover,
		&:focus-within {
			box-shadow: 0 12px 28px rgba(0, 0, 0, 0.07);
		}
	}

	.tile__icon {
		width: 28px;
		height: 28px;
		color: var(--color-text);
	}

	.tile__title {
		font-size: $font-size-base;
		font-weight: $font-weight-bold;
		line-height: 1.25;
		margin: $spacing-1 0 0;
	}

	// Stretched over the tile, so the whole card is the target while the accessible name stays the title.
	.tile__link {
		color: inherit;
		text-decoration: none;
		text-underline-offset: 2px;
		transition: color $transition-fast;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
		}
	}

	.tile:hover .tile__link,
	.tile:focus-within .tile__link {
		text-decoration: underline;
		text-decoration-color: rgba(0, 0, 0, 0.35);
	}

	.tile__title:hover .tile__link,
	.tile__link:focus-visible {
		color: var(--color-primary);
		text-decoration-color: currentColor;
	}

	.tile__description {
		@include text-s;
		margin: 0;
		line-height: 22px;
		color: var(--color-text-secondary);
		text-wrap: pretty;

		// Above the title's stretched link, so links in the description stay clickable.
		:global(a) {
			position: relative;
			z-index: 1;
			color: inherit;
			text-decoration: underline;
			text-decoration-color: rgba(0, 0, 0, 0.35);
			text-underline-offset: 2px;
			transition: color $transition-fast;

			&:hover,
			&:focus-visible {
				color: var(--color-primary);
				text-decoration-color: currentColor;
			}
		}
	}

	@media print {
		.tile {
			border: 1px solid var(--color-border);
			box-shadow: none;
			break-inside: avoid;
		}
	}
</style>
