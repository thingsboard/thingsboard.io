---
import { Icon } from 'astro-icon/components';
import { AI_ASSISTANT_DEMO, AI_ASSISTANT_LABEL } from '@data/ai-visual';

/**
 * The AI Assistant as a looping picture: prompts typed into the composer and answered. Nothing is
 * interactive, so the whole window is one `role="img"`.
 */
interface Props {
	/** Titles the bar in place of the `New chat` picker and drops the edit control, for a window shown whole. */
	titled?: boolean;
}

const { titled } = Astro.props;
---

<div class:list={['assistant', titled && 'assistant--titled']} role="img" aria-label={AI_ASSISTANT_LABEL}>
	<div class="assistant__bar" aria-hidden="true">
		{titled ? (
			<span class="assistant__title">AI Assistant</span>
		) : (
			<span class="assistant__chat">
				New chat
				<Icon name="tabler:chevron-down" />
			</span>
		)}
		<span class="assistant__tools">
			{/* The context-usage gauge; `pathLength` makes the dash a percentage. */}
			<svg class="assistant__ring" viewBox="0 0 20 20">
				<circle class="assistant__ring-track" cx="10" cy="10" r="8"></circle>
				<circle class="assistant__ring-arc" cx="10" cy="10" r="8" pathLength="100"></circle>
			</svg>
			{!titled && <Icon name="tabler:edit" />}
			<Icon name="tabler:x" />
		</span>
	</div>

	<div class="assistant__log" aria-hidden="true">
		<div class="assistant__intro">
			<p class="assistant__hello">{AI_ASSISTANT_DEMO.hello}</p>
			<p class="assistant__lead">{AI_ASSISTANT_DEMO.lead}</p>
		</div>
	</div>

	<div class="assistant__input" aria-hidden="true">
		{/* The placeholder is drawn by CSS `content`. */}
		<span class="assistant__typed is-idle" style={`--placeholder: "${AI_ASSISTANT_DEMO.placeholder}"`}></span>
		<span class="assistant__send">
			<Icon name="tabler:send" />
		</span>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The product UI's own colours, fixed rather than themed: this is a picture of the app.
	.assistant {
		--tb-green: #0a5648;
		--tb-ink: #1c1c1c;
		--tb-muted: #5d6d68;
		--tb-bubble: #e9f0ee;

		// Drawn at native width and scaled by `--ui-scale`, which the section sets. Scales from the bottom,
		// so the overflow goes off the top, the edge the section crops.
		--ui-scale: 1;

		position: relative;
		display: flex;
		flex-direction: column;
		width: 365px;
		height: 289px;
		overflow: hidden;
		transform: scale(var(--ui-scale));
		transform-origin: bottom center;
		// Page pixels, undoing `--ui-scale`.
		border-radius: calc(#{$radius-lg} / var(--ui-scale));
		background: $color-white;
		box-shadow: 0 4px 12px rgb(23 24 28 / 10%);
		text-align: left;
	}

	.assistant__bar {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		height: 34px;
		padding: 0 12px;
		border-bottom: 1px solid $color-border-dark;
		font-size: 12px;
		color: var(--tb-ink);
	}

	.assistant__chat {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.assistant__title {
		font-weight: $font-weight-medium;
	}

	.assistant__tools {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.assistant :global(svg) {
		width: 16px;
		height: 16px;
		color: var(--tb-muted);
	}

	// Starts at twelve o'clock; an SVG circle starts at three. Through its parent, to outrank `.assistant svg`.
	.assistant__tools .assistant__ring {
		width: 17px;
		height: 17px;
		transform: rotate(-90deg);
		fill: none;
		stroke-width: 2.4;
	}

	.assistant__ring-track {
		stroke: #e2e6e5;
	}

	.assistant__ring-arc {
		stroke: var(--tb-green);
		stroke-linecap: round;
		stroke-dasharray: 22 100;
	}

	.assistant__log {
		position: relative;
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		justify-content: flex-end;
		gap: 14px;
		min-height: 0;
		padding: 18px 18px 14px;
		overflow: hidden;
		// On the log, not the window, so the window's edge and shadow stay crisp. Shorter at rest, clear
		// of the greeting.
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 52px);
		mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 52px);
		transition: opacity 0.45s ease;
	}

	.assistant__log.is-clearing {
		opacity: 0;
	}

	.assistant__log.is-running {
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 96px);
		mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 96px);
	}

	// Under a visible bar only a short ramp, so a line scrolling out dissolves rather than being cut by the bar.
	.assistant--titled .assistant__log {
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 24px);
		mask-image: linear-gradient(to bottom, transparent 0, #000 24px);
	}

	.assistant--titled .assistant__log.is-running {
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 44px);
		mask-image: linear-gradient(to bottom, transparent 0, #000 44px);
	}

	.assistant__intro {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 7px;
		// Centred between the crop and the composer. Keep the sum at 72 so the block's box is unchanged.
		padding-top: 42px;
		padding-bottom: 30px;
		text-align: center;
		transition: opacity 0.3s ease;
	}

	// Must match `AiSection`'s 600px threshold, where the chat drops to scale 1.
	@media (max-width: 599px) {
		.assistant__intro {
			padding-top: 48px;
			padding-bottom: 24px;
		}
	}

	.assistant__intro.is-out {
		opacity: 0;
	}

	.assistant__hello {
		margin: 0;
		font-size: 15px;
		font-weight: $font-weight-medium;
		color: var(--tb-ink);
	}

	.assistant__lead {
		// Four lines at most, or the greeting runs into the mask.
		max-width: 330px;
		margin: 0;
		font-size: 12px;
		line-height: 17px;
		color: var(--tb-muted);
	}

	// `:global`: the script appends these, so they never carry the scope class.
	.assistant__log :global(.assistant__msg) {
		max-width: 78%;
		margin: 0;
		font-size: 13px;
		line-height: 18px;
		animation: assistant-in 0.35s ease-out both;
	}

	.assistant__log :global(.assistant__msg--user) {
		align-self: flex-end;
		padding: 9px 12px;
		border-radius: 10px 10px 3px 10px;
		background: var(--tb-bubble);
		color: var(--tb-ink);
	}

	.assistant__log :global(.assistant__msg--bot) {
		align-self: flex-start;
		max-width: 92%;
		padding: 4px 3px;
		color: var(--tb-ink);
	}

	.assistant__log :global(.assistant__msg--bot b) {
		font-weight: $font-weight-medium;
		color: var(--tb-green);
	}

	.assistant__log :global(.assistant__done b) {
		font-weight: $font-weight-medium;
	}

	.assistant__log :global(.assistant__thinking) {
		display: flex;
		align-items: center;
		gap: 7px;
		margin: 0;
		font-size: 13px;
		color: var(--tb-muted);
	}

	.assistant__log :global(.assistant__done) {
		display: flex;
		align-items: flex-start;
		align-self: flex-start;
		gap: 6px;
		max-width: 92%;
		margin: 0;
		padding: 0 3px;
		font-size: 13px;
		line-height: 18px;
		color: var(--tb-ink);
		animation: assistant-in 0.35s ease-out both;
	}

	.assistant__log :global(.assistant__tick) {
		flex: none;
		width: 14px;
		height: 18px;
		fill: none;
		stroke: var(--tb-green);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	// 5:1 on white; `background: none` clears the site's code style.
	.assistant__log :global(:is(.assistant__msg--bot, .assistant__done) code) {
		font-family: $font-family-mono;
		font-size: 1em;
		font-weight: $font-weight-bold;
		line-height: 1;
		color: #b45309;
		background: none;
	}

	.assistant__log :global(code[data-severity='critical']) {
		color: #b23c33;
	}

	.assistant__log :global(.assistant__dots) {
		display: inline-flex;
		gap: 3px;
	}

	.assistant__log :global(.assistant__dots i) {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--tb-green);
		animation: assistant-dot 1.2s ease-in-out infinite;
	}

	.assistant__log :global(.assistant__dots i:nth-child(2)) {
		animation-delay: 0.15s;
	}

	.assistant__log :global(.assistant__dots i:nth-child(3)) {
		animation-delay: 0.3s;
	}

	@keyframes assistant-dot {
		0%,
		60%,
		100% {
			opacity: 0.25;
		}
		30% {
			opacity: 1;
		}
	}

	@keyframes assistant-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.assistant__input {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		min-height: 44px;
		margin: 0 14px 14px;
		// A 2px edge in page pixels, undoing `--ui-scale`. The padding reserves it rounded down, so the
		// field keeps its size.
		--composer-edge: calc(2px / var(--ui-scale));
		--composer-reserve: round(down, var(--composer-edge), 1px);

		padding-block: calc(6px + var(--composer-reserve));
		padding-inline: calc(12px + var(--composer-reserve)) calc(8px + var(--composer-reserve));
		// An inset shadow, not a border: a border's width is snapped to device pixels, a shadow's spread
		// keeps the fraction.
		box-shadow: inset 0 0 0 var(--composer-edge) rgba(0, 0, 0, 0.12);
		border-radius: 8px;
		font-size: 13px;
	}

	.assistant__input.is-focused {
		box-shadow:
			inset 0 0 0 calc(2.5px / var(--ui-scale)) var(--tb-green),
			0 0 0 calc(4px / var(--ui-scale)) rgba(10, 86, 72, 0.07);
	}

	.assistant__typed {
		display: flex; // the pseudos become items, so the caret can lead
		flex: 1 1 auto;
		align-items: center;
		min-width: 0;
		color: var(--tb-ink);
		// One line, as a real input; the script keeps it scrolled to the tail.
		white-space: nowrap;
		overflow: hidden;

		&::after {
			content: '';
			display: inline-block;
			width: 1px;
			// A real caret spans the font's ascent to descent, taller than its em.
			height: 1.25em;
			margin-left: 1px;
			background: var(--tb-green);
			animation: assistant-caret 1.1s steps(1) infinite;
		}
	}

	.assistant__typed:empty::before {
		content: var(--placeholder);
		color: #9aa5a1;
	}

	// `animation: none` as well: an animation's keyframes beat a plain `opacity: 0`.
	.assistant__typed.is-idle::after {
		animation: none;
		opacity: 0;
	}

	.assistant__typed.is-typing::after {
		animation: none;
		opacity: 1;
	}

	// With nothing typed the caret sits at the head of the hint, against it.
	.assistant__typed:empty::after {
		order: -1;
		margin-right: 1px;
		margin-left: 0;
	}

	@keyframes assistant-caret {
		0%,
		50% {
			opacity: 1;
		}
		50.01%,
		100% {
			opacity: 0;
		}
	}

	.assistant__send {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		transition:
			background-color 0.15s ease,
			transform 0.15s ease;
	}

	.assistant__send :global(svg) {
		width: 22px;
		height: 22px;
		color: var(--tb-green);
	}

	.assistant__send.is-press {
		background: #e2eae7;
		transform: scale(0.94);
	}

	.assistant__send.is-busy :global(svg) {
		color: #b5c0bc;
	}
</style>

<script>
	import { AI_ASSISTANT_DEMO } from '@data/ai-visual';
	import { whenRendered } from '@util/when-rendered';

	// Reduced motion keeps the server-rendered greeting.
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/** Tabler's `check`, inline because the script cannot render `<Icon>`. */
	const CHECK =
		'<svg class="assistant__tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5l10 -10" /></svg>';

	document.querySelectorAll<HTMLElement>('.assistant').forEach((frame) => {
		const log = frame.querySelector<HTMLElement>('.assistant__log');
		const typed = frame.querySelector<HTMLElement>('.assistant__typed');
		const field = frame.querySelector<HTMLElement>('.assistant__input');
		const sendBtn = frame.querySelector<HTMLElement>('.assistant__send');
		if (!log || !typed || !field || !sendBtn || reduce) return;

		const introHTML = log.innerHTML;
		const { exchanges } = AI_ASSISTANT_DEMO;

		let timers: number[] = [];
		let run = 0;
		let onScreen = false;
		let waiting = false;

		/** Tagged with the cycle that booked it, so a restart cancels the old run. */
		const at = (ms: number, fn: () => void) => {
			const id = run;
			timers.push(
				window.setTimeout(() => {
					if (id === run) fn();
				}, ms)
			);
		};

		const el = (cls: string, html: string) => {
			const node = document.createElement('p');
			node.className = cls;
			node.innerHTML = html;
			log.appendChild(node);
			return node;
		};

		const exchange = (n: number) => {
			const { prompt, reply, working, actions } = exchanges[n];
			const intro = log.querySelector<HTMLElement>('.assistant__intro');
			let i = 0;

			const type = () => {
				if (document.hidden) {
					at(400, type);
					return;
				}
				typed.classList.add('is-typing');
				typed.textContent = prompt.slice(0, ++i);
				typed.scrollLeft = typed.scrollWidth;
				if (i < prompt.length) {
					at(38 + Math.random() * 38, type);
					return;
				}
				typed.classList.remove('is-typing');
				at(420, commit);
			};

			const done = () => {
				if (n + 1 < exchanges.length) at(1500, () => exchange(n + 1));
				else at(5200, cycle);
			};

			// Each confirmation lands above the working row, which goes once the answer lands.
			const think = () => {
				sendBtn.classList.add('is-busy');
				const dots = '<span class="assistant__dots"><i></i><i></i><i></i></span>';
				const row = el('assistant__thinking', `${dots}${working}`);

				const answer = () => {
					row.remove();
					sendBtn.classList.remove('is-busy');
					el('assistant__msg assistant__msg--bot', reply);
					done();
				};

				const confirm = (k: number) => {
					if (k === actions.length) {
						at(650, answer);
						return;
					}
					const line = document.createElement('p');
					line.className = 'assistant__done';
					line.innerHTML = `${CHECK}<span>${actions[k]}</span>`;
					log.insertBefore(line, row);
					at(700, () => confirm(k + 1));
				};

				at(1400, () => confirm(0));
			};

			const send = () => {
				typed.textContent = '';
				typed.scrollLeft = 0;
				if (intro) {
					intro.classList.add('is-out');
					at(300, () => intro.remove());
				}
				log.classList.add('is-running');
				at(180, () => {
					el('assistant__msg assistant__msg--user', prompt);
					at(520, think);
				});
			};

			const commit = () => {
				sendBtn.classList.add('is-press');
				at(200, () => sendBtn.classList.remove('is-press'));
				send();
			};

			at(n === 0 ? 900 : 300, type);
		};

		const cycle = () => {
			// Parked only at the cycle boundary, so nothing is left half-played.
			if (!onScreen || document.hidden) {
				if (waiting) return;
				waiting = true;
				window.setTimeout(() => {
					waiting = false;
					cycle();
				}, 600);
				return;
			}

			if (log.classList.contains('is-running') && !log.classList.contains('is-clearing')) {
				log.classList.add('is-clearing');
				at(480, cycle);
				return;
			}

			run++;
			timers.forEach(clearTimeout);
			timers = [];

			log.innerHTML = introHTML;
			log.classList.remove('is-running', 'is-clearing');
			typed.textContent = '';
			typed.scrollLeft = 0;
			typed.classList.remove('is-typing', 'is-idle');
			field.classList.add('is-focused');
			sendBtn.classList.remove('is-press', 'is-busy');

			exchange(0);
		};

		whenRendered(frame, () => {
			new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						onScreen = entry.isIntersecting;
					});
				},
				{ threshold: 0.2 }
			).observe(frame);

			cycle();
		});
	});
</script>
