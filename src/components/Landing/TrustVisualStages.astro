---
import { Icon } from 'astro-icon/components';
import {
	TRUST_CERTS,
	TRUST_REPO,
	TRUST_SCALE_STAGES,
	TRUST_STAGES_LABELS,
	TRUST_STORES,
	type TrustKind,
} from '@data/home-trust';
import GITHUB_STARS from '@data/github-stars.json';
import { formatStars, formatStarsLong } from '@util/github-stars';
import mark from '@root/icons/thingsboard-mark.svg?raw';

/**
 * The trust band cards' drawings: security (shield and ISO seals), scale (a 9s loop from monolith to
 * cluster) and open (the GitHub repo card). Sized in units of a 260 × 136 box.
 */

interface Props {
	kind: TrustKind;
}

const { kind } = Astro.props;

const NATIVE = 260;
const BODY_H = 136;

const CELLS = 5;
const S = 24;
const G = S / 5;
const STRIP_W = CELLS * S + (CELLS - 1) * G;
const T = S / 3;
const BLEED = S / 15;
const r2 = (v: number) => +v.toFixed(2);
const at = (n: number) => r2(n * (S + G));
const STORES = Object.keys(TRUST_STORES);
/** The first and last stage that light a store; its stages must be consecutive. */
const storeRange = (store: string) => {
	const lit = TRUST_SCALE_STAGES.flatMap((st, i) => (st.stores.includes(store) ? [i] : []));
	return `${lit[0]}-${lit[lit.length - 1]}`;
};
const spanTotal = TRUST_SCALE_STAGES.reduce((sum, st) => sum + st.span, 0);
const meterAt = TRUST_SCALE_STAGES.map(
	(_, i) => +(TRUST_SCALE_STAGES.slice(0, i + 1).reduce((sum, st) => sum + st.span, 0) / spanTotal).toFixed(4)
);
const scaleVars = TRUST_SCALE_STAGES.map((st, i) => `--trs-hue-${i}: ${st.hue}`).join('; ');
const NODES = Math.max(...TRUST_SCALE_STAGES.map((st) => st.cells));

const stars = GITHUB_STARS[TRUST_REPO];
const [owner, repo] = TRUST_REPO.split('/');

const boxVars = `--u: min(1.15px, calc(100cqw / ${NATIVE})); --trs-native: ${NATIVE}; --trs-body-h: ${BODY_H}`;
---

<div class="trs-fit">
	<div
		class:list={['trs', kind === 'scale' && 'trs--scale']}
		role={kind === 'open' ? undefined : 'img'}
		aria-label={kind === 'open' ? undefined : TRUST_STAGES_LABELS[kind]}
		style={kind === 'scale' ? `${boxVars}; --trs-strip-w: ${r2(STRIP_W)}` : boxVars}
	>
		{kind === 'open' ? (
			/* Named by its content, not an aria-label, which would have to repeat every visible word
			   (axe label-content-name-mismatch); the hidden tail adds the host and the count. */
			<a class="trs__repo" href={`https://github.com/${TRUST_REPO}`}>
				<span class="trs__repo-head">
					<span class="trs__avatar" aria-hidden="true" set:html={mark} />
					<span class="trs__repo-name">
						{owner}
						<span class="trs__slash">/</span>
						<strong class="trs__name">{repo}</strong>
					</span>
				</span>
				<span class="trs__repo-foot" aria-hidden="true">
					<span class="trs__star-btn">
						<Icon name="tabler:star" class="trs__star" />
						Star
						<span class="trs__counter">{formatStars(stars)}</span>
					</span>
					<span class="trs__public">Public</span>
					<Icon name="simple-icons:github" class="trs__gh" />
				</span>
				<span class="trs__sr">on GitHub, {formatStarsLong(stars)} stars</span>
			</a>
		) : kind === 'security' ? (
			<div class="trs__pair" aria-hidden="true">
				<span class="trs__shield">
					<Icon name="tabler:shield-lock-filled" />
				</span>
				<ul class="trs__seals" role="list">
					{TRUST_CERTS.map((number) => (
						<li class="trs__seal">
							<svg class="trs__ribbon" viewBox="0 0 44 40">
								<path class="trs__ribbon-band" d="M0 0h44v40L22 31 0 40z" />
								<path class="trs__ribbon-fold" d="M22 0h22v40L22 31z" />
							</svg>
							<span class="trs__seal-disc">
								<span class="trs__seal-body">ISO</span>
								<span class="trs__seal-number">{number}</span>
							</span>
						</li>
					))}
				</ul>
			</div>
		) : (
			<div class="trs__scale" aria-hidden="true" style={scaleVars}>
				<svg class="trs__strip" viewBox={`0 0 ${r2(STRIP_W)} ${r2(S)}`}>
					{Array.from({ length: CELLS }, (_, n) => (
						<rect class="trs__cell" x={at(n)} y={0} width={r2(S)} height={r2(S)} rx={r2(S / 3)} />
					))}
					{Array.from({ length: NODES - 1 }, (_, n) => (
						<rect
							class={`trs__link trs__bridge-${n + 1}`}
							x={r2(at(n) + S - BLEED)}
							y={r2((S - T) / 2)}
							width={r2(G + BLEED * 2)}
							height={r2(T)}
						/>
					))}
					{Array.from({ length: NODES }, (_, n) => (
						<g class:list={['trs__node', n > 0 && `trs__join-${n}`]} style={`--trs-hop: ${n}`}>
							<rect class="trs__ping" x={at(n)} y={0} width={r2(S)} height={r2(S)} rx={r2(S / 3)} />
							<rect class="trs__lit" x={at(n)} y={0} width={r2(S)} height={r2(S)} rx={r2(S / 3)} />
						</g>
					))}
				</svg>
				<div class="trs__heads">
					{TRUST_SCALE_STAGES.map((st, i) => (
						<p class={`trs__head trs__stage-${i}`} style={`--trs-hue: ${st.hue}`}>
							<span class="trs__mode">{st.mode}</span>
							<span class="trs__devices">{st.devices}</span>
						</p>
					))}
				</div>
				<div class="trs__meter">
					<span class="trs__meter-fill" />
					{meterAt.slice(0, -1).map((at) => (
						<span class="trs__notch" style={`--at: ${at}`} />
					))}
				</div>
				<ul class="trs__logos" role="list">
					{STORES.map((store) => (
						<li class:list={[`trs__logo--s${storeRange(store)}`, store === 'Cassandra' && 'is-lens']}>
							<Icon name={TRUST_STORES[store]} />
						</li>
					))}
				</ul>
			</div>
		)}
	</div>
</div>

<style lang="scss">
	@use 'sass:list';
	@use 'sass:math';
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.trs-fit {
		container-type: inline-size;
	}

	.trs {
		--trs-indigo: var(--color-primary, #3d50f5);
		--trs-tile-shadow: 0 1px 2px rgba(16, 24, 40, 0.1), 0 #{u(6)} #{u(14)} #{u(-6)} rgba(16, 24, 40, 0.22);

		width: 100%;
		max-width: u(var(--trs-native));
		height: u(var(--trs-body-h));
	}

	.trs:not(.trs--scale) {
		display: flex;
		align-items: center;
	}

	.trs__pair {
		display: flex;
		gap: u(20);
	}

	.trs__shield {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: u(72);
		height: u(72);
		border-radius: 23%;
		color: #fff;
		background:
			radial-gradient(120% 70% at 50% 0%, rgba(255, 255, 255, 0.12) 0%, transparent 70%),
			linear-gradient(180deg, color-mix(in srgb, var(--trs-indigo) 22%, #121425) 0%, #121425 100%);
		box-shadow:
			inset 0 #{u(1)} 0 rgba(255, 255, 255, 0.16),
			var(--trs-tile-shadow);

		:global([data-icon]) {
			width: u(52);
			height: u(52);
		}
	}

	.trs__seals {
		display: flex;
		gap: u(20);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.trs__seal {
		position: relative;
		flex: none;
		width: u(72);
		height: u(72);
		margin: 0;
	}

	.trs__ribbon {
		position: absolute;
		top: u(50);
		left: 50%;
		width: u(44);
		max-width: none;
		height: u(40);
		transform: translateX(-50%);
		overflow: visible;
	}

	.trs__ribbon-band {
		fill: var(--trs-indigo);
	}

	.trs__ribbon-fold {
		fill: color-mix(in srgb, var(--trs-indigo) 82%, #000);
	}

	.trs__seal-disc {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--color-bg-surface, #fff);
		box-shadow: var(--trs-tile-shadow);

		&::before {
			content: '';
			position: absolute;
			inset: u(4);
			border: max(1px, #{u(1.5)}) solid color-mix(in srgb, var(--color-text, #17181c) 14%, transparent);
			border-radius: 50%;
		}
	}

	.trs__seal-body {
		margin-right: -0.14em;
		font-size: u(14);
		font-weight: $font-weight-bold;
		line-height: u(16);
		letter-spacing: 0.14em;
		color: var(--trs-indigo);
	}

	.trs__seal-number {
		font-size: u(18);
		font-weight: $font-weight-medium;
		line-height: u(22);
		font-variant-numeric: tabular-nums;
		color: var(--color-text, #17181c);
	}

	.trs__repo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: u(10);
		box-sizing: border-box;
		width: 100%;
		padding: u(12) u(14);
		border: 1px solid #d0d7de;
		border-radius: u(6);
		background: #fff;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
		text-decoration: none;
		box-shadow:
			0 1px 2px rgba(31, 35, 40, 0.06),
			0 #{u(6)} #{u(16)} #{u(-6)} rgba(31, 35, 40, 0.16);
		transition: border-color 150ms ease-out;

		&:hover {
			border-color: #8c959f;

			.trs__name {
				text-decoration: underline;
			}
		}

		&:focus-visible {
			outline: 2px solid var(--trs-indigo);
			outline-offset: 2px;
		}
	}

	.trs__sr {
		@include visually-hidden;
	}

	.trs__repo-head,
	.trs__repo-foot {
		display: flex;
		align-items: center;
		gap: u(8);
	}

	.trs__repo-foot {
		align-self: stretch;
	}

	.trs__avatar {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: u(28);
		height: u(28);
		border-radius: u(6);
		color: #fff;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, #{$color-pe-hover} 28%, #{$color-pe-dark}) 0%,
			#{$color-pe-dark} 100%
		);
		box-shadow:
			inset 0 #{u(1)} 0 rgba(255, 255, 255, 0.18),
			0 1px 2px rgba(16, 24, 40, 0.1),
			0 #{u(3)} #{u(6)} #{u(-2)} rgba(16, 24, 40, 0.18);

		:global(svg) {
			width: u(18);
			height: u(18);
		}
	}

	.trs__repo-name {
		overflow: hidden;
		font-size: u(15);
		line-height: u(22);
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--trs-indigo);
	}

	.trs__slash {
		margin-inline: u(3);
		color: #59636e;
	}

	.trs__name {
		font-weight: 600;
	}

	.trs__gh {
		flex: none;
		margin-left: auto;
		width: u(28);
		height: u(28);
		color: #1f2328;
	}

	.trs__public {
		flex: none;
		padding: 0 u(7);
		border: 1px solid #d0d7de;
		border-radius: 2em;
		font-size: u(13);
		font-weight: 500;
		line-height: u(20);
		color: #59636e;
	}

	.trs__star-btn {
		display: inline-flex;
		align-items: center;
		gap: u(6);
		height: u(30);
		padding: 0 u(8) 0 u(10);
		border: 1px solid #d0d7de;
		border-radius: u(6);
		background: #f6f8fa;
		font-size: u(14);
		font-weight: 500;
		color: #25292e;
	}

	.trs__star {
		width: u(16);
		height: u(16);
		color: #59636e;
	}

	.trs__counter {
		padding: 0 u(6);
		border-radius: 2em;
		background: rgba(129, 139, 152, 0.16);
		font-size: u(13);
		font-weight: 600;
		line-height: u(18);
	}

	// Registered so the loop can blend it; everything inside inherits the frame's value.
	@property --trs-node-hue {
		syntax: '<color>';
		inherits: true;
		initial-value: #6d28d9;
	}

	.trs__scale {
		--trs-node-hue: var(--trs-hue-2);

		display: grid;
		grid-template-columns: minmax(0, 1fr);
		// 6 + 24 + 12 + 20 + 12 + 6 + 12 + 4 + 40 = 136, BODY_H.
		grid-template-rows: u(24) u(20) u(6) auto;
		row-gap: u(12);
		padding-top: u(6);
	}

	// The stages' names share one cell and take turns in it.
	.trs__heads {
		display: grid;
		grid-template: minmax(0, 1fr) / minmax(0, 1fr);
		min-width: 0;
	}

	.trs__head {
		display: flex;
		grid-area: 1 / 1;
		align-items: baseline;
		justify-content: space-between;
		gap: u(10);
		margin: 0;
		font-size: u(16);
		line-height: u(20);
		white-space: nowrap;
		opacity: 0;
	}

	.trs__mode {
		font-weight: $font-weight-medium;
		color: var(--trs-hue);
	}

	.trs__devices {
		font-variant-numeric: tabular-nums;
		color: var(--color-text-secondary, #5b616e);
	}

	.trs__strip {
		width: u(var(--trs-strip-w));
		max-width: none;
		height: auto;
		overflow: visible;
	}

	.trs__cell {
		fill: color-mix(in srgb, var(--trs-node-hue) 14%, #fff);
	}

	.trs__lit {
		fill: var(--trs-node-hue);
	}

	.trs__node,
	.trs__ping {
		transform-box: fill-box;
		transform-origin: center;
	}

	.trs__ping {
		opacity: 0;
		fill: var(--trs-node-hue);
	}

	.trs__link {
		transform-box: fill-box;
		transform-origin: left center;
		fill: var(--trs-node-hue);
		fill-opacity: 0.45;
	}

	.trs__meter {
		position: relative;
		overflow: hidden;
		border-radius: u(3);
		background: color-mix(in srgb, var(--color-text, #17181c) 8%, #fff);
	}

	.trs__meter-fill {
		position: absolute;
		inset: 0;
		background: var(--trs-node-hue);
		transform-origin: left center;
	}

	.trs__notch {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--at) * 100% - #{u(1)});
		width: u(2);
		background: var(--color-bg-surface, #fff);
	}

	.trs__logos {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: u(4) 0 0;
		padding: 0;
		list-style: none;

		li {
			display: flex;
			margin: 0;
			opacity: 0.25;
		}

		:global([data-icon]) {
			width: u(40);
			height: u(40);
			color: var(--color-text, #17181c);
		}

		.is-lens :global([data-icon]) {
			transform: scale(1.18);
		}
	}

	// At rest and without motion: the cluster.
	.trs__head.trs__stage-2,
	.trs__logos li:is(.trs__logo--s0-2, .trs__logo--s1-2, .trs__logo--s2-2) {
		opacity: 1;
	}

	// The loop is 9s, six beats of the 1.5s ping; the bar fills over the first four, so the stages'
	// boundaries sit at their `span`s (25 / 25 / 50) of that fill.
	$fill: math.div(200%, 3);
	$bounds: (0%, $fill * 0.25, $fill * 0.5, 100%);
	$cluster: list.nth($bounds, 3);
	// Half a cross-fade.
	$xf: 1.5%;
	$snap: cubic-bezier(0.2, 0.8, 0.2, 1);

	// Opacity $hi from stage $from's start to stage $to's end, $lo outside, cross-faded at each boundary;
	// a run touching the loop's seam is halfway at 0% and 100% so it fades across the wrap.
	@mixin run($name, $from, $to, $lo, $hi) {
		$s: list.nth($bounds, $from + 1);
		$e: list.nth($bounds, $to + 2);
		$mid: math.div($lo + $hi, 2);

		@keyframes #{$name} {
			@if $from == 0 and $to == 2 {
				0%,
				100% {
					opacity: $hi;
				}
			} @else if $from == 0 {
				0% {
					opacity: $mid;
				}
				#{$xf},
				#{$e - $xf} {
					opacity: $hi;
				}
				#{$e + $xf},
				#{100% - $xf} {
					opacity: $lo;
				}
				100% {
					opacity: $mid;
				}
			} @else if $to == 2 {
				0% {
					opacity: $mid;
				}
				#{$xf},
				#{$s - $xf} {
					opacity: $lo;
				}
				#{$s + $xf},
				#{100% - $xf} {
					opacity: $hi;
				}
				100% {
					opacity: $mid;
				}
			} @else {
				#{0%},
				#{$s - $xf} {
					opacity: $lo;
				}
				#{$s + $xf},
				#{$e - $xf} {
					opacity: $hi;
				}
				#{$e + $xf},
				#{100%} {
					opacity: $lo;
				}
			}
		}
	}

	@for $i from 0 through 2 {
		@include run(trs-stage-#{$i}, $i, $i, 0, 1);
	}

	@for $i from 0 through 2 {
		@for $j from $i through 2 {
			@include run(trs-logo-#{$i}-#{$j}, $i, $j, 0.25, 1);
		}
	}

	@keyframes trs-meter-fill {
		0% {
			transform: scaleX(0);
		}
		#{$fill},
		97% {
			transform: scaleX(1);
			opacity: 1;
		}
		100% {
			transform: scaleX(1);
			opacity: 0;
		}
	}

	@keyframes trs-node-hue {
		0%,
		#{list.nth($bounds, 2) - 2%} {
			--trs-node-hue: var(--trs-hue-0);
		}
		#{list.nth($bounds, 2) + 2%},
		#{$cluster - 2%} {
			--trs-node-hue: var(--trs-hue-1);
		}
		#{$cluster + 2%},
		95% {
			--trs-node-hue: var(--trs-hue-2);
		}
		100% {
			--trs-node-hue: var(--trs-hue-0);
		}
	}

	@keyframes trs-ping {
		0% {
			opacity: 0.5;
			transform: scale(1);
		}
		22%,
		100% {
			opacity: 0;
			transform: scale(1.45);
		}
	}

	// Node k joins as the fill passes k quarters of the cluster's section; they fold home newest first.
	@for $k from 1 through 4 {
		$join: $cluster + ($fill - $cluster) * math.div($k, 4);
		$leave: 90% + (4 - $k) * 1.5%;

		@keyframes trs-join-#{$k} {
			0%,
			#{$join} {
				opacity: 0;
				transform: scale(0.4);
			}
			#{$join + 3%} {
				opacity: 1;
				transform: scale(1.08);
			}
			#{$join + 5%},
			#{$leave} {
				opacity: 1;
				transform: scale(1);
			}
			#{$leave + 3%},
			100% {
				opacity: 0;
				transform: scale(0.4);
			}
		}

		@keyframes trs-bridge-#{$k} {
			0%,
			#{$join - 1%} {
				transform: scaleX(0);
			}
			#{$join + 2%},
			#{$leave} {
				transform: scaleX(1);
			}
			#{$leave + 2.5%},
			100% {
				transform: scaleX(0);
			}
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@for $i from 0 through 2 {
			.trs__head.trs__stage-#{$i} {
				animation: trs-stage-#{$i} 9s linear infinite;
			}
		}

		@for $i from 0 through 2 {
			@for $j from $i through 2 {
				.trs__logos li.trs__logo--s#{$i}-#{$j} {
					animation: trs-logo-#{$i}-#{$j} 9s linear infinite;
				}
			}
		}

		.trs__scale {
			animation: trs-node-hue 9s linear infinite;
		}

		@for $k from 1 through 4 {
			.trs__join-#{$k} {
				animation: trs-join-#{$k} 9s $snap infinite;
			}

			.trs__bridge-#{$k} {
				animation: trs-bridge-#{$k} 9s $snap infinite;
			}
		}

		.trs__ping {
			animation: trs-ping 1.5s ease-out infinite;
