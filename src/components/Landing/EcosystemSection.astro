---
import EcosystemCard from '@components/Landing/EcosystemCard.astro';
import { homeEcosystem } from '@data/homeEcosystem';

/** What you can add to the platform: one card per product, the wide ones spanning two columns. */
---

<section id="product-ecosystem" class="ecosystem">
	<div class="main-div">
		<header class="ecosystem__head">
			<h2 class="ecosystem__title">Product ecosystem</h2>
			<p class="ecosystem__lede">
				Add what your project needs — protocol bridges, analytics, edge nodes, a mobile app, and a library of ready-made
				components.
			</p>
		</header>
		<div class="ecosystem__list">
			{homeEcosystem.map((product) => (
				<EcosystemCard {...product} />
			))}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/print-mixins' as *;

	.ecosystem {
		padding-block: $spacing-16;
		background-color: var(--color-bg-surface);

		.main-div {
			max-width: $home-measure;
		}
	}

	.ecosystem__head {
		margin-bottom: $spacing-8;
		text-align: center;
	}

	.ecosystem__title {
		@include home-section-title;
		margin: 0 0 $spacing-5;
		color: var(--color-text);
	}

	.ecosystem__lede {
		@include text-m;
		max-width: 65ch;
		margin: 0 auto;
		line-height: 1.5;
	}

	// Two columns before three, or the wide card's halves get narrower than the phone.
	.ecosystem__list {
		display: grid;
		grid-template-columns: 1fr;
		gap: $spacing-5;

		@include media-up(md) {
			grid-template-columns: repeat(2, 1fr);

			> :global(.eco--wide:not(.eco--single-2)) {
				grid-column: span 2;
			}
		}

		@include media-up(lg) {
			grid-template-columns: repeat(3, 1fr);

			> :global(.eco--wide) {
				grid-column: span 2;
			}
		}
	}

	@media print {
		.ecosystem {
			padding-block: $spacing-8;
		}

		.ecosystem__head {
			@include print-section-head;
			margin-bottom: $spacing-6;
		}

		.ecosystem__list {
			grid-template-columns: repeat(2, 1fr);

			> :global(.eco--wide) {
				grid-column: span 2;
			}

			@media (min-width: 1000px) {
				grid-template-columns: repeat(3, 1fr);
			}
		}
	}
</style>
