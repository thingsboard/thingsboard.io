---
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import ProductChoiceCard from '@components/Landing/ProductChoiceCard.astro';
import { homeProducts } from '@data/homeProducts';

/** The Products section: the two ways to run the platform. */
---

<section id="products" class="products">
	<PricingBackground contained />
	<div class="main-div">
		<header class="products__head">
			<h2 class="products__title">Products</h2>
			<p class="products__lede">
				The same platform and the same features either way — what changes is who runs it. We handle hosting, scaling and
				upgrades, or you do, on infrastructure you choose.
			</p>
		</header>
		<div class="products__list">
			{homeProducts.map((product) => (
				<ProductChoiceCard {...product} />
			))}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/print-mixins' as *;

	.products {
		// Holds the wave field: without a stacking context its `z-index: -1` drops behind the
		// section's own background and disappears.
		isolation: isolate;
		position: relative;
		padding-block: $spacing-16;
		background-color: #121425;
		color: $color-white;

		.main-div {
			max-width: $home-measure;
		}

		:global(.pricing-bg) {
			--pricing-wave-color: #{$color-brand};
		}
	}

	.products__head {
		margin-bottom: $spacing-12;
		text-align: center;
	}

	// A step above the other sections' 32: this band opens the second half of the page, and the
	// ecosystem under it reads as its continuation rather than as a peer.
	.products__title {
		@include section-title;
		margin: 0 0 $spacing-5;
		font-weight: $font-weight-bold;
	}

	.products__lede {
		@include text-m;
		max-width: 65ch;
		margin: 0 auto;
		line-height: 1.5;
		color: $color-text-disabled;
	}

	.products__list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: $spacing-5;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	@media print {
		.products {
			@include print-section($spacing-8);
			break-inside: avoid;
		}

		.products__head {
			@include print-section-head;
			margin-bottom: $spacing-6;
		}

		.products__lede {
			color: var(--color-text-secondary);
		}

		.products__list {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
