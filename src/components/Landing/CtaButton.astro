---
import Button from '@components/ui/Button.astro';
import type { CloudFlow } from '@util/cloud-regions';

/**
 * A call-to-action on the homepage's and product pages' bands: the kit's primary or secondary button.
 * A dark band sets `data-surface="dark"` for the white outline.
 */
interface Props {
	href: string;
	/** Leading icon, e.g. `tabler:cloud-filled`. */
	icon?: string;
	variant?: 'brand' | 'outline';
	ariaLabel?: string;
	target?: string;
	cloudAuth?: CloudFlow;
}

const { href, icon, variant = 'outline', ariaLabel, target, cloudAuth } = Astro.props;
---

{/* A `cloudAuth` link opens the region dialog, so it keeps its target for no-script visitors but gets no new-tab arrow. */}
<Button
	href={href}
	variant={variant === 'brand' ? 'primary' : 'secondary'}
	icon={icon}
	external={target === '_blank' && !cloudAuth}
	class={`cta-button cta-button--${variant} print:hidden`}
	attrs={{ 'aria-label': ariaLabel, target: cloudAuth ? target : undefined, 'data-cloud-auth': cloudAuth }}
>
	<slot />
</Button>

<style lang="scss">
	// A page may set `--page-accent` to recolour its brand buttons.
	.cta-button--brand {
		--accent-fill: var(--page-accent, var(--color-brand));
	}
</style>
