---
import { Icon } from 'astro-icon/components';
import { relForTarget } from '@util/external-links';
import type { CloudFlow } from '@util/cloud-regions';

/** A call-to-action button on the homepage's and product pages' bands. */
interface Props {
	href: string;
	/** Leading icon, e.g. `tabler:cloud-filled`. */
	icon?: string;
	variant?: 'brand' | 'outline';
	ariaLabel?: string;
	target?: string;
	cloudAuth?: CloudFlow;
}

const { href, icon, variant = 'outline', ariaLabel, target, cloudAuth } = Astro.props;
---

<a
	href={href}
	class:list={['cta-button', `cta-button--${variant}`, 'print:hidden']}
	aria-label={ariaLabel}
	target={target}
	{...relForTarget(target)}
	data-cloud-auth={cloudAuth}
>
	{icon && <Icon name={icon} size="18" aria-hidden="true" />}
	<slot />
</a>

<style lang="scss">
	@use '../../styles/variables' as *;

	.cta-button {
		@include button-base;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border: 1px solid transparent;
		border-radius: $radius-md;
		font-weight: $font-weight-bold;
		color: $color-white;

		&:focus-visible {
			// `currentColor`: white on the dark bands, the page's ink on a light one.
			outline: 2px solid currentColor;
			outline-offset: 3px;
		}
	}

	// A page may set `--page-accent` to recolour its brand buttons.
	.cta-button--brand {
		--cta-brand: var(--page-accent, #{$color-brand});

		background-color: var(--cta-brand);
		border-color: var(--cta-brand);

		&:hover {
			background-color: color-mix(in srgb, var(--cta-brand) 88%, white);
		}
	}

	// Dark-band defaults; a light ground sets `--cta-outline-line` and `--cta-outline-ink`.
	.cta-button--outline {
		--cta-line: var(--cta-outline-line, #{rgba($color-white, 0.35)});

		border-color: var(--cta-line);
		color: var(--cta-outline-ink, #{$color-white});

		&:hover,
		&:focus-visible {
			// On the dark default these resolve to the 55% border and 14% fill.
			border-color: color-mix(in srgb, var(--cta-line) 69%, currentColor);
			background-color: color-mix(in srgb, currentColor 14%, transparent);
		}
	}
</style>
