---
import Button from '@components/ui/Button.astro';
import { relForTarget } from '@util/external-links';
import type { CloudFlow } from '@util/cloud-regions';

/**
 * A call-to-action button on the homepage's and product pages' bands: the kit's primary or secondary
 * button. A dark band marks itself `data-surface="dark"`, which gives the outline its white look.
 */
interface Props {
	href: string;
	/** Leading icon, e.g. `tabler:cloud-filled`. */
	icon?: string;
	variant?: 'brand' | 'outline';
	ariaLabel?: string;
	target?: string;
	cloudAuth?: CloudFlow;
}

const { href, icon, variant = 'outline', ariaLabel, target, cloudAuth } = Astro.props;
---

<Button
	href={href}
	variant={variant === 'brand' ? 'primary' : 'secondary'}
	icon={icon}
	class={`cta-button cta-button--${variant} print:hidden`}
	attrs={{ 'aria-label': ariaLabel, target, ...relForTarget(target), 'data-cloud-auth': cloudAuth }}
>
	<slot />
</Button>

<style lang="scss">
	// A page may set `--page-accent` to recolour its brand buttons.
	.cta-button--brand {
		--accent-fill: var(--page-accent, var(--color-brand));
	}
</style>
