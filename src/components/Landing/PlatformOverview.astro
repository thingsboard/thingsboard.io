---
import { Icon } from 'astro-icon/components';
import {
	PLATFORM_ZONES,
	PLATFORM_STAGES,
	PLATFORM_RUNS,
	PLATFORM_CORE,
	type Zone,
	type PlatformRun,
} from '@data/platform-overview';
import mark from '@root/icons/thingsboard-mark.svg?raw';

/**
 * The platform overview: two zones of yours either side of what ThingsBoard does to what flows
 * between them, with four runs going round.
 *
 * It is drawn on a unit grid, so type size is `container / R`, R being NATIVE over the smallest
 * type's floor: 1010 / u(14) = 72.1, giving 13.3px in the 960 column and 10.7px at 768, where the
 * composition turns vertical. `U_CAP` tops that floor out at 16.1px. The narrow cut is 340 units on
 * the same floor, R 24.3.
 */

// Fixed, not generated: one drawing per page, and the ids only pair a group with its own title.
const uid = 'plat';

// --- the grid, in design units -------------------------------------------------------------

// 253 is the floor for a side column: "Gateways and platforms" needs 179.6 units on one line and a
// card spends 73 on chrome. A name that wraps puts the left card's three rows out of step with the
// right. Four across in the middle keeps the stages a run rather than a block.
const COL = { side: 264, gut: 0, mid: 482 };
/** How far the platform runs over each side column. */
const OVERLAP = 12;
const NATIVE = COL.side * 2 + COL.gut * 2 + COL.mid; // 1010
// 340, not 480: 480 units in a 335px phone column put the floor at 9.8px. 340 is what the CORE
// needs — 288 of content after padding, 135 per stage column — and puts the floor at 13.8px.
const NARROW = 340;

// --- the four runs -------------------------------------------------------------------------

/** 34: the band is where the picture breathes most, so it is the loosest number here. */
const BAND = 34;
const LANE = 6;
const BEND = 10;
const HEAD = 6;
const WING = 4;

const TURN = 112;

/** The page's shared squircle: 32% radius, white mark on the brand, 69% mark-to-tile. */
const BADGE = 76;
const BADGE_PAD = Math.round((BADGE * (1 - 0.69)) / 2); // 10 -> a 44-unit mark in a 64-unit tile

/**
 * Equipment takes Connect's hue and people Operate's — the stages the loop enters and leaves at.
 * Read off `PLATFORM_STAGES` by position, so the pair cannot drift from the icons it matches.
 */
const ZONE_IN = PLATFORM_STAGES[0].accent;
const ZONE_OUT = PLATFORM_STAGES[PLATFORM_STAGES.length - 1].accent;

/**
 * Stacked, the card's centre to each run's stem. 56 is the floor: the badge straddling the
 * platform's top edge is 64 wide, so a stem at 56 clears it by 17. Labels sit outboard of the stems.
 */
const LANE_X = 56;

/** One sweep for all four, because the loop goes one way. */
const CW = 1;
const LO = BAND - LANE;

/** 2, the weight the page's other line work takes; all that must agree with it derives from it. */
const WIRE_W = 2;
const WIRE_HALF = WIRE_W / 2;

/** The label's room inside its U: the wire's painted edge to the card edge its legs land on. */
const RUN_WELL = BAND - LANE - WIRE_HALF; // 27

/**
 * The U-shaped runs. Each leaves the top or bottom of its card, turns across the band and lands on
 * the platform — endpoints the band SVG can address, the cards being `align-self: start`. The one
 * distance not computable here is a side card's bottom to the row's bottom; `.plat__drop` covers it.
 */
const ATTACH_L = COL.side / 2;
const ATTACH_R = NATIVE - ATTACH_L;
const CORE_IN = NATIVE / 2 - TURN;
const CORE_OUT = NATIVE / 2 + TURN;
/** A label is as wide as its run's horizontal reach, so centring the text centres it on the arrow. */
const RUN_W = CORE_IN - ATTACH_L;

/**
 * The signal: a dashed copy of the wire whose offset animates one pattern per cycle, so one lit
 * segment travels the path in the direction the arrow points. `PIP_PATTERN` is longer than the
 * longest path (~310 units), so only one pip is on a wire at a time.
 */
const CYCLE_MS = 1800;
const PIP_DASH = 14;
const PIP_PATTERN = 380;
/** Golden-ratio phases, so four runs never pulse together and the loop has no beat of its own. */
const pipPhase = (i: number) => +(((i * 0.618033988749895) % 1) * CYCLE_MS).toFixed(1);

const TOP = {
	telemetry: {
		line: `M ${ATTACH_L},${BAND} V ${LANE + BEND} A ${BEND},${BEND} 0 0 ${CW} ${ATTACH_L + BEND},${LANE} H ${CORE_IN - BEND} A ${BEND},${BEND} 0 0 ${CW} ${CORE_IN},${LANE + BEND} V ${BAND}`,
		head: `M ${CORE_IN - WING},${BAND - HEAD} L ${CORE_IN},${BAND} L ${CORE_IN + WING},${BAND - HEAD}`,
	},
	views: {
		line: `M ${CORE_OUT},${BAND} V ${LANE + BEND} A ${BEND},${BEND} 0 0 ${CW} ${CORE_OUT + BEND},${LANE} H ${ATTACH_R - BEND} A ${BEND},${BEND} 0 0 ${CW} ${ATTACH_R},${LANE + BEND} V ${BAND}`,
		// No head: this run ends on the right card, so its head rides the CSS tail past the band.
		head: '',
	},
};

const BOT = {
	commands: {
		line: `M ${CORE_IN},0 V ${LO - BEND} A ${BEND},${BEND} 0 0 ${CW} ${CORE_IN - BEND},${LO} H ${ATTACH_L + BEND} A ${BEND},${BEND} 0 0 ${CW} ${ATTACH_L},${LO - BEND} V 0`,
		// No head: this run ends on the LEFT card, so its head rides the CSS tail below the band.
		head: '',
	},
	actions: {
		line: `M ${ATTACH_R},0 V ${LO - BEND} A ${BEND},${BEND} 0 0 ${CW} ${ATTACH_R - BEND},${LO} H ${CORE_OUT + BEND} A ${BEND},${BEND} 0 0 ${CW} ${CORE_OUT},${LO - BEND} V 0`,
		head: `M ${CORE_OUT - WING},${HEAD} L ${CORE_OUT},0 L ${CORE_OUT + WING},${HEAD}`,
	},
};

const BANDS = { in: [TOP.telemetry, TOP.views], out: [BOT.commands, BOT.actions] };

// --- the stacked form's arrows ---------------------------------------------------------------

const STEM = { w: 14, h: 12 };
const HEAD_D = `M ${STEM.w / 2 - WING},${STEM.h - HEAD} L ${STEM.w / 2},${STEM.h} L ${STEM.w / 2 + WING},${STEM.h - HEAD}`;

/**
 * The arrowhead's box, half a stroke taller than its path: the chevron's point sits on the viewBox's
 * bottom edge, and an `svg` clips to its viewBox, so the round join was slicing the point flat.
 */
const HEAD_STROKE = WIRE_W;
const HEAD_BOX_H = STEM.h + HEAD_STROKE / 2; // 13

const ORDER = ['equipment', 'platform', 'people'];
const dirOf = (r: PlatformRun) => (ORDER.indexOf(r.from) < ORDER.indexOf(r.to) ? 'down' : 'up');

/**
 * The zone a run belongs to — the end that is not the platform. NOT `from`: two runs leave the
 * platform, and keying colour off the source would leave their outbound half grey.
 */
const zoneOf = (id: PlatformRun['id']) => {
	const r = PLATFORM_RUNS.find((x) => x.id === id)!;
	return r.from === 'platform' ? r.to : r.from;
};
const bandSrc = { in: ['telemetry', 'views'], out: ['commands', 'actions'] } as const;

const zoneItems = (z: Zone) => z.items;

/** The unit's ceiling, shared by both cuts: at 1.15 the 14-unit floor tops out at 16.1px. */
const U_CAP = 1.15;

// One declaration on `.plat`, inherited below. NOT `define:vars`: it writes the whole set onto
// every element of the template — 114 here, 73 KB of identical inline style.
const vars = {
	'plat-u': `min(${U_CAP}px, calc(100cqw / ${NATIVE}))`,
	'plat-u-narrow': `min(${U_CAP}px, calc(100cqw / ${NARROW}))`,
	'plat-native': NATIVE,
	'plat-narrow': NARROW,
	'plat-col-side': COL.side,
	'plat-col-gut': COL.gut,
	'plat-col-mid': COL.mid,
	'plat-overlap': OVERLAP,
	'plat-attach': ATTACH_L,
	'plat-core-out': CORE_OUT,
	'plat-run-w': RUN_W,
	'plat-run-well': RUN_WELL,
	'plat-wire-w': WIRE_W,
	'plat-wire-r': WIRE_HALF,
	'plat-pip-dash': `${PIP_DASH} ${PIP_PATTERN - PIP_DASH}`,
	'plat-pip-pattern': PIP_PATTERN,
	'plat-cycle': `${CYCLE_MS}ms`,
	...Object.fromEntries(PLATFORM_STAGES.map((st, i) => [`plat-stage-${i + 1}`, st.accent])),
	'plat-head-h': HEAD_BOX_H,
	'plat-band': BAND,
	'plat-lane': LANE_X,
	'plat-badge': BADGE,
	'plat-badge-pad': BADGE_PAD,
	'plat-equipment': ZONE_IN,
	'plat-people': ZONE_OUT,
};

const varStyle = Object.entries(vars)
	.map(([name, value]) => `--${name}: ${value}`)
	.join('; ');
---

<div class="plat-fit">
	<div class="plat" style={varStyle}>
		{
			PLATFORM_ZONES.map((z) => (
				<div class={`plat__col plat__col--${z.id}`}>
					<span class="plat__tail plat__tail--lift" aria-hidden="true">
						<span class="plat__tail-line" />
						{z.id === 'people' && (
							<svg class="plat__tail-head" viewBox={`0 0 ${STEM.w} ${HEAD_BOX_H}`}>
								<path d={HEAD_D} />
							</svg>
						)}
					</span>
					{/* `role="group"`, not `section`: a section here has no background on the homepage, and
					    three of them open three `region` landmarks inside one decorative drawing. */}
					<div class={`plat__zone plat__zone--${z.id}`} role="group" aria-labelledby={`${uid}-${z.id}`}>
						<header class="plat__zone-head">
							{/* `<p>`, not `<h3>`: `aria-labelledby` works against any element, and as headings these
							    three diagram fragments entered the page outline beside the feature rows. */}
							<p class="plat__zone-title" id={`${uid}-${z.id}`}>
								{z.title}
							</p>
						</header>
						<ul class="plat__items" role="list">
							{zoneItems(z).map((it) => (
								<li class="plat__item">
									<Icon class="plat__item-icon" name={it.icon} aria-hidden="true" />
									<div>
										<p class="plat__item-name">{it.name}</p>
										<p class="plat__item-note">{it.note}</p>
									</div>
								</li>
							))}
						</ul>
					</div>
					{/* The vertical half of the lower U. The card hugs its text, so this endpoint is a runtime
					    fact; as the free space in a flex column it needs no number. */}
					<span class="plat__tail plat__tail--drop" aria-hidden="true">
						{z.id === 'equipment' && (
							<svg class="plat__tail-head plat__tail-head--up" viewBox={`0 0 ${STEM.w} ${HEAD_BOX_H}`}>
								<path d={HEAD_D} />
							</svg>
						)}
						<span class="plat__tail-line" />
					</span>
				</div>
			))
		}

		{
			PLATFORM_RUNS.map((r, i) => (
				<p class={`plat__run plat__run--${r.id}`} data-zone={zoneOf(r.id)} style={`--pip-phase: ${pipPhase(i)}ms`}>
					<span class="plat__stem" data-dir={dirOf(r)} aria-hidden="true">
						<span class="plat__stem-line" />
						<svg class="plat__stem-head" viewBox={`0 0 ${STEM.w} ${HEAD_BOX_H}`}>
							<path d={HEAD_D} />
						</svg>
					</span>
					<span class="plat__run-label">{r.label}</span>
				</p>
			))
		}

		{/* Before the platform in the DOM, so the card paints over the last unit of each run and its
		    shadow falls across them — the runs pass under something raised. */}
		{
			(['in', 'out'] as const).map((which) => (
				<div class={`plat__band plat__band--${which}`} aria-hidden="true">
					<svg class="plat__wires" viewBox={`0 0 ${NATIVE} ${BAND}`} preserveAspectRatio="none">
						{BANDS[which].map((r, i) => (
							<Fragment>
								<path class="plat__wire" data-zone={zoneOf(bandSrc[which][i])} d={r.line} />
								<path
									class="plat__pip"
									data-zone={zoneOf(bandSrc[which][i])}
									d={r.line}
									style={`--pip-phase: ${pipPhase(which === 'in' ? i : i + 2)}ms`}
								/>
								{r.head && <path class="plat__head" data-zone={zoneOf(bandSrc[which][i])} d={r.head} />}
							</Fragment>
						))}
					</svg>
				</div>
			))
		}

		{/* `role="group"`, not `section`: the page's `:root section { background: none }` would strip
		    the fill this card paints over the hairlines it overlaps with. */}
		<div class="plat__core" role="group" aria-labelledby={`${uid}-core`}>
			{/* Straddling the card's top edge, out of flow, so the heading's position ignores its size. */}
			<span class="plat__core-badge" aria-hidden="true" set:html={mark} />
			{/* `<p>`, not a heading: it only names this region for `aria-labelledby`. */}
			<p class="plat__core-title" id={`${uid}-core`}>{PLATFORM_CORE.brand} {PLATFORM_CORE.product}</p>

			<ol class="plat__stages" role="list">
				{
					PLATFORM_STAGES.map((s) => (
						<li class="plat__stage" style={`--stage: ${s.accent}`}>
							<Icon class="plat__stage-icon" name={s.icon} aria-hidden="true" />
							<p class="plat__stage-name">{s.name}</p>
							<ul class="plat__stage-list" role="list">
								{s.items.map((it) => (
									<li>{it}</li>
								))}
							</ul>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</div>

<script>
	import { pauseOffscreen } from '@util/pause-offscreen';

	pauseOffscreen('.plat');
</script>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/print-mixins' as *;

	/** The stage accents' wash: the icon tiles' fill, and the rule above them. One number, one colour. */
	$stage-wash: 10%;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.plat-fit {
		container-type: inline-size;
		container-name: plat;
		// `container-type: inline-size` zeroes max-content, so a flex or grid parent would collapse this.
		width: 100%;
	}

	.plat {
		--u: var(--plat-u);

		// No fallback for `--plat-equipment` / `--plat-people`: it would be a second copy of the pairing.

		// White, like the zones: the platform is told apart by being lifted, not by being tinted.
		--plat-paper: var(--color-bg-surface, #fff);
		// One grey for every part of a run; the colour lives on the stage icons instead.
		--plat-wire: var(--color-text-secondary, #63656c);
		// A run takes the hue of the zone it touches — `data-zone` is on every wire, head and label.
		--plat-wire-in: var(--plat-equipment);
		--plat-wire-out: var(--color-primary, #{$color-brand});
		--plat-line: var(--color-border, #ebebeb);
		--plat-ink: var(--color-text, #17181c);
		--plat-muted: var(--color-text-secondary, #5b616e);

		display: grid;
		grid-template-columns:
			u(var(--plat-col-side)) u(var(--plat-col-gut)) u(var(--plat-col-mid))
			u(var(--plat-col-gut)) u(var(--plat-col-side));
		grid-template-rows: auto u(var(--plat-band)) auto u(var(--plat-band)) auto;
		max-width: u(var(--plat-native));
		margin: 0 auto;
	}

	// --- the two outer zones ---------------------------------------------------------------

	// Row 3 only: the bands are clear space above and below all three cards, which the U-runs need.
	.plat__col {
		display: flex;
		flex-direction: column;
		grid-row: 3;
		// The card sits on the platform's axis: the two tails take an equal share of what is left.
		justify-content: center;
	}

	.plat__col--equipment {
		grid-column: 1;
	}

	.plat__col--people {
		grid-column: 5;
	}

	// Between a card and its band; its length is free space, and `flex: 1 1 0` on both tails centres the card.
	.plat__tail {
		display: flex;
		flex: 1 1 0;
		flex-direction: column;
		align-items: center;
		// An arrowhead cannot fit in a gap shorter than itself, so the tail states a floor and the row grows.
		min-height: u(18);
	}

	// 3 units, matching the wires it continues.
	.plat__tail-line {
		flex: 1 1 auto;
		width: u(var(--plat-wire-w));
		border-radius: u(var(--plat-wire-r));
		background: var(--plat-wire);
	}

	// Rides the tail's card end, so the point meets the card rather than the row boundary.
	.plat__tail-head {
		flex: none;
		// Over the line whatever the DOM order is, so no rounded cap shows past the point.
		position: relative;
		z-index: 1;
		width: u(14);
		height: u(var(--plat-head-h));
		max-width: none;
		// 12, not 6: the chevron's ink is 6 deep, so 6 more runs the line to the apex and the arms sit on it.
		margin-top: u(-12);
		fill: none;
		stroke: var(--plat-wire);
		stroke-width: var(--plat-wire-w);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.plat__tail-head--up {
		margin: 0 0 u(-12);
		transform: scaleY(-1);
	}

	.plat__zone {
		display: flex;
		flex-direction: column;
		// The edge the platform runs over carries the overlap as padding, so the item hairlines stop short of it.
		padding: u(16) u(14);
		padding-inline-end: calc(#{u(14)} + #{u(var(--plat-overlap))});
		border: max(1px, #{u(1)}) solid var(--plat-line);
		border-radius: u(10);
		background: var(--plat-paper);
	}

	// No border or radius on the edge the platform covers: a hairline running on under a white,
	// outline-less platform read as the zone crossing in front of it. The squared corner hides there too.
	.plat__zone--equipment {
		--zone: var(--plat-equipment);
		border-right: 0;
		border-top-right-radius: 0;
		border-bottom-right-radius: 0;
	}

	.plat__zone--people {
		--zone: var(--plat-people);
		border-left: 0;
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
		// Mirrored: the platform overlaps this card's LEFT edge.
		padding-inline: calc(#{u(14)} + #{u(var(--plat-overlap))}) u(14);
	}

	// Fixed, or the wrapping right-hand title makes a taller head and every item row falls out of step.
	.plat__zone-head {
		display: flex;
		align-items: center;
		justify-content: center;
		// 32, not 52: the 52 was sized around an emblem that is no longer there.
		min-height: u(32);
		gap: u(10);
		padding-bottom: u(10);
		border-bottom: max(1px, #{u(1)}) solid var(--plat-line);
	}

	.plat__zone-title {
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: 1.2;
		letter-spacing: -0.005em;
		color: var(--zone);
	}

	.plat__items {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// 10, not 14: the padding is the only thing between the rows and the card's height.
	.plat__item {
		display: flex;
		flex: 1 1 0;
		align-items: center;
		gap: u(10);
		padding: u(10) 0;

		& + & {
			border-top: max(1px, #{u(1)}) solid var(--plat-line);
		}
	}

	.plat__item-icon {
		flex: none;
		width: u(25);
		height: u(25);
		color: var(--zone);
	}

	.plat__item-name {
		margin: 0;
		font-size: u(16);
		font-weight: $font-weight-bold;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--plat-ink);
	}

	// The composition's floor, and so the number the stacking threshold comes from. 14, not 13.5: the
	// longest note sets 177 units in a 180 column at 14, and 14.5 would wrap two of the six.
	.plat__item-note {
		margin: u(3) 0 0;
		font-size: u(14);
		line-height: 1.35;
		color: var(--plat-muted);
	}

	// --- the platform, raised ------------------------------------------------------------------

	// No border: a hairline as well as a shadow reads as a card with an outline drawn on it.
	.plat__core {
		position: relative;
		// Over the side columns, not between them; `z-index` so its shadow falls across their inner edge.
		z-index: 1;
		margin-inline: calc(-1 * #{u(var(--plat-overlap))});
		grid-column: 3;
		grid-row: 3;
		// Top padding is the badge's lower half plus the air under it: BADGE / 2 + 12.
		padding: calc(u(var(--plat-badge)) / 2 + #{u(12)}) u(20) u(24);
		border-radius: u(12);
		background: var(--plat-paper);
		// Overridable through `--flow-shadow`, as the other visuals in this family are.
		box-shadow: var(
			--flow-shadow,
			0 1px 2px rgba(16, 24, 40, 0.04),
			0 #{u(12)} #{u(28)} #{u(-8)} rgba(16, 24, 40, 0.12)
		);
	}

	// Centred on the card's top edge, half above it — the placement the ecosystem cards give a product
	// mark. The shadow is unit-scaled, this being a drawing built on a design unit.
	.plat__core-badge {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translate(-50%, -50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: u(var(--plat-badge));
		height: u(var(--plat-badge));
		padding: u(var(--plat-badge-pad));
		border-radius: 32%;
		// Same tile and ink as `.hub__badge` (ConnectHub) and `.norm__badge` (NormalizeSeries).
		color: #111318;
		background: linear-gradient(155deg, #fff 35%, color-mix(in srgb, var(--color-primary, #3d50f5) 5%, #fff) 100%);
		box-shadow: var(
			--flow-shadow-badge,
			0 1px 2px rgba(16, 24, 40, 0.06),
			0 #{u(7)} #{u(16)} #{u(-5)} rgba(16, 24, 40, 0.22)
		);
	}

	// Ink, not the brand: the stages are coded to the page's sections, and the badge holds the brand.
	.plat__core-title {
		// 22 above the rule against the 16 below it: the rule belongs to the stage row, so it sits nearer.
		margin: 0 0 u(22);
		text-align: center;
		font-size: u(22);
		font-weight: $font-weight-bold;
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--plat-ink);
	}

	// Four across at every width the wide cut is used at: two by two buys 2.6px of floor and costs the
	// left-to-right run the drawing is about. The stacked cut goes two by two, having no run left.
	.plat__stages {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: u(12);
		margin: 0;
		// The rule keys the stage row under it: the four accents left to right, at the icon tiles' own
		// wash. A background, not a border — a border cannot take a gradient, and 3 units gives it room.
		padding: u(16) 0 0;
