---
/** A centred band opener: the heading, and the one sentence that says what the band is for. */
interface Props {
	title: string;
	/** Its own line above `title`, inside the same heading — a lockup, not a separate eyebrow. */
	titleLead?: string;
	subtitle: string;
}

const { title, titleLead, subtitle } = Astro.props;
---

<h2 class="section-header__title">
	{titleLead && <span class="section-header__title-lead">{titleLead}</span>}
	{title}
</h2>
<p class="section-header__subtitle">{subtitle}</p>

<style lang="scss">
	@use '../../styles/variables' as *;

	.section-header__title {
		@include section-title;
		max-width: 720px;
		margin: 0 auto $spacing-5;
		font-weight: $font-weight-bold;
		// The page body's inherited colour is lighter than heading ink.
		color: var(--color-text);
		text-align: center;
		text-wrap: balance;
	}

	// Breaks the heading where the copy wants it, without leaving the h2.
	.section-header__title-lead {
		display: block;
	}

	.section-header__subtitle {
		@include text-m;
		max-width: 65ch;
		margin: 0 auto $spacing-10;
		text-align: center;
		line-height: 1.5;
		text-wrap: pretty;
	}
</style>
