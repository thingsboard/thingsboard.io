---
import { Icon } from 'astro-icon/components';
import { ALARM_FIRED_AT, FILTER_CHART, FREEZER_ALARM } from '@data/automate-visual';

/** The Freezer Door Open alarm card, sized in its caller's `--u`. */
---

<div class="alarm-entry">
	<span class="alarm-entry__head">
		<Icon name="tabler:alert-triangle-filled" class="alarm-entry__icon" aria-hidden="true" />
		<span class="alarm-entry__sev">{FREEZER_ALARM.severity}</span>
		<span class="alarm-entry__time">{ALARM_FIRED_AT}</span>
	</span>
	<span class="alarm-entry__name">{FREEZER_ALARM.name}</span>
	<span class="alarm-entry__row">
		<span class="alarm-entry__key">Originator</span>
		{FREEZER_ALARM.source}
	</span>
	<span class="alarm-entry__row">
		<span class="alarm-entry__dot"></span>
		{FILTER_CHART.status}
	</span>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.alarm-entry {
		--alarm-red: #b23c33;

		display: flex;
		flex-direction: column;
		gap: u(6);
		padding: u(12) u(14);
		border-radius: u(8);
		color: var(--color-text);
		background: var(--color-bg-surface, #fff);
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.08),
			0 #{u(8)} #{u(20)} #{u(-8)} rgba(16, 24, 40, 0.3);
	}

	.alarm-entry__head {
		display: flex;
		align-items: center;
		gap: u(6);
	}

	.alarm-entry__icon {
		flex: none;
		width: u(20);
		height: u(20);
		color: var(--alarm-red);
	}

	.alarm-entry__sev {
		padding: u(1) u(7);
		border-radius: u(5);
		font-family: $font-family-mono;
		font-size: u(15);
		font-weight: $font-weight-bold;
		line-height: u(20);
		letter-spacing: 0.04em;
		color: #fff;
		background: var(--alarm-red);
	}

	.alarm-entry__time {
		margin-left: auto;
		font-family: $font-family-mono;
		font-size: u(15);
		line-height: u(20);
		color: var(--color-text-secondary, #5b616e);
	}

	.alarm-entry__name {
		font-size: u(17);
		font-weight: $font-weight-medium;
		line-height: u(22);
	}

	.alarm-entry__row {
		display: flex;
		align-items: center;
		gap: u(8);
		font-size: u(15);
		line-height: u(20);
	}

	.alarm-entry__key {
		color: var(--color-text-secondary, #5b616e);
	}

	.alarm-entry__dot {
		flex: none;
		width: u(8);
		height: u(8);
		border-radius: 50%;
		background: var(--alarm-red);
	}
</style>
