---
import { Icon } from 'astro-icon/components';
import TrustVisualStages from '@components/Landing/TrustVisualStages.astro';
import { TRUST_HEADING, TRUST_POINTS } from '@data/home-trust';

/** "Safe to build on": three cards, each a drawing over its claim and a link to the proof. */
---

<section id="trust" class="trust" aria-labelledby="trust-title">
	<div class="main-div">
		<h2 id="trust-title" class="trust__title">
			{TRUST_HEADING.title}
		</h2>
		<p class="trust__lede">{TRUST_HEADING.subtitle}</p>

		<ul class="trust__list" role="list">
			{TRUST_POINTS.map((p) => (
				<li class="trust__item">
					<TrustVisualStages kind={p.kind} />
					<h3 class="trust__name">{p.title}</h3>
					<p class="trust__text">{p.body}</p>
					<a class="trust__link print:hidden" href={p.link.href}>
						{p.link.text}
						<Icon name="tabler:chevron-right" class="link-chevron" aria-hidden="true" />
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.trust {
		scroll-margin-top: calc(#{$header-height} + var(--promo-h, 0px));
		padding-block: $spacing-16;
		background-image: linear-gradient(180deg, color-mix(in srgb, var(--color-brand) 14%, #fff) 0%, #fff 100%);

		.main-div {
			max-width: $home-measure;
		}

		@include media-down(md) {
			padding-block: $spacing-12;
		}
	}

	.trust__title {
		@include home-section-title;
		margin: 0 0 $spacing-5;
		text-align: center;
		color: var(--color-text);
	}

	.trust__lede {
		@include text-m;
		line-height: 24px;
		max-width: 65ch;
		margin: 0 auto $spacing-12;
		text-align: center;
	}

	.trust__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-5;
		margin: 0;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			gap: $spacing-4;
		}
	}

	// Subgrid, so the names, texts and links line up across the three cards.
	.trust__item {
		display: grid;
		grid-row: span 4;
		grid-template-rows: subgrid;
		row-gap: 0;
		justify-items: start;
		padding: $spacing-5;
		border-radius: $radius-lg;
		background: #fff;
		color: var(--color-text);
		box-shadow:
			0 1px 2px rgb(16 24 40 / 6%),
			0 10px 20px -8px rgb(16 24 40 / 10%);

		> :global(:first-child) {
			width: 100%;
			margin-bottom: $spacing-6;
		}
	}

	.trust__name {
		margin: 0 0 $spacing-3;
		font-size: $font-size-xl;
		font-weight: $font-weight-bold;
		line-height: 25px;
		color: var(--color-text);
		text-wrap: balance;
	}

	.trust__text {
		@include text-m;
		line-height: 24px;
		margin: 0;
	}

	.trust__link {
		display: inline-flex;
		align-self: end;
		align-items: center;
		margin-top: $spacing-4;
		font-size: $font-size-base;
		font-weight: $font-weight-medium;
		line-height: 24px;
		color: var(--color-primary);
		text-decoration: none;
		text-underline-offset: 3px;

		:global(.link-chevron) {
			@include link-chevron;
		}

		&:hover,
		&:focus-visible {
			text-decoration: underline;
		}
	}

	// A tablet: the drawing beside its text rather than over it.
	@media (min-width: $breakpoint-md) and (max-width: #{$breakpoint-lg - 1px}) {
		.trust__item {
			grid-row: auto;
			grid-template-columns: 300px minmax(0, 1fr);
			grid-template-rows: auto auto 1fr;
			column-gap: $spacing-8;
			align-items: start;

			> :global(:first-child) {
				grid-row: 1 / -1;
				align-self: center;
				margin-bottom: 0;
			}
		}

		.trust__name,
		.trust__text,
		.trust__link {
			grid-column: 2;
		}
	}

	@include media-down(md) {
		.trust__item {
			grid-row: auto;
			grid-template-rows: none;
		}
	}
</style>
