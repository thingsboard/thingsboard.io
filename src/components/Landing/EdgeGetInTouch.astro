---
import Button from '@components/ui/Button.astro';
---

<section id="get-in-touch" class="print:hidden">
	<div class="main-content">
		<div class="block">
			<h2 class="cta">Need offline-capable IoT solution?</h2>
			<Button
				href="/contact-us/?subject=ThingsBoard%20Products"
				size="lg"
				class="gtm_button"
				attrs={{ id: 'Lets-Talk-Edge' }}
			>
				Let's talk about Edge
			</Button>
		</div>
	</div>
</section>

<style lang="scss">
	#get-in-touch {
		padding: 60px 20px;
		position: relative;
		z-index: 2;
		background: transparent;
	}

	.main-content {
		max-width: 1400px;
		margin: 0 auto;
		opacity: 0;
		transform: translateY(50px);
		animation: slideUp 0.8s ease-out forwards;
	}

	.block {
		background: white;
		border: 2px solid #009688;
		border-radius: 24px;
		padding: 40px 60px;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 40px;
	}

	.cta {
		font-size: 32px;
		font-weight: 600;
		color: #212529;
		margin: 0;
	}

	@keyframes slideUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media screen and (max-width: 750px) {
		#get-in-touch {
			padding: 50px 16px;
		}

		.block {
			padding: 24px 20px;
			flex-direction: column;
			text-align: center;
			gap: 20px;
		}

		.cta {
			font-size: 22px;
		}
	}
</style>
