---
import { Icon } from 'astro-icon/components';
import { HOME_VOICES, VOICES_COPY, VOICES_STATS } from '@data/home-voices';

/** "Proven in production": the numbers, then six customer quotes; on a phone the quotes are a swipeable strip. */
---

<section id="voices" class="voices" aria-labelledby="voices-title">
	<div class="main-div">
		<h2 id="voices-title" class="voices__title">
			{VOICES_COPY.title}
		</h2>
		<p class="voices__lede">{VOICES_COPY.lede}</p>

		<dl class="voices__stats" aria-label="ThingsBoard in numbers">
			{VOICES_STATS.map((s) => (
				<div class="voices__stat">
					<dt>{s.label}</dt>
					<dd>{s.value}</dd>
				</div>
			))}
		</dl>

		<div class="voices__strip" data-scroll-region role="region" aria-label="Customer quotes" tabindex="0">
			<ul class="voices__list" role="list">
				{HOME_VOICES.map((v) => (
					<li class:list={['voices__card', v.accent && 'voices__card--accent']}>
						{/* The company is named in the card's text, so its mark is decoration. */}
						<img
							class="voices__logo"
							src={v.logo.src}
							alt=""
							width={v.logo.width}
							height={v.logo.height}
							style={v.logoHeight && `height: ${v.logoHeight}px`}
							loading="lazy"
							decoding="async"
						/>
						<blockquote class="voices__quote">“{v.quote}”</blockquote>
						<p class="voices__context">{v.context}</p>
						<p class="voices__who">
							{v.face ? (
								<img
									class="voices__face"
									src={v.face.src}
									alt=""
									width="36"
									height="36"
									style={v.facePosition && `object-position: ${v.facePosition}`}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<span class="voices__face" aria-hidden="true">
									{v.author.charAt(0)}
								</span>
							)}
							<span class="voices__name">
								<b>{v.author}</b>
								{[v.position, v.company].filter(Boolean).join(', ')}
							</span>
						</p>
						<a class="voices__link print:hidden" href={v.href}>
							Case study
							<span class="sr-only"> — {v.company}</span>
							<Icon name="tabler:chevron-right" class="link-chevron" aria-hidden="true" />
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<script>
	import { initScrollRegions } from '@util/scroll-regions';
	initScrollRegions();
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	$navy: #121425;

	// Runs down into the closing CTA's navy: white through the top third, then 10% of the brand.
	.voices {
		scroll-margin-top: calc(#{$header-height} + var(--promo-h, 0px));
		padding-block: $spacing-16 $spacing-20;
		background-image: linear-gradient(180deg, #fff 35%, color-mix(in srgb, var(--color-brand) 10%, #fff));

		.main-div {
			max-width: $home-measure;
		}

		@include media-down(md) {
			padding-block: $spacing-12;
		}
	}

	.voices__title {
		@include home-section-title;
		margin: 0 0 $spacing-5;
		text-align: center;
		color: var(--color-text);
	}

	.voices__lede {
		@include text-m;
		line-height: 24px;
		max-width: 65ch;
		margin: 0 auto $spacing-10;
		text-align: center;
	}

	.voices__stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin: 0 0 $spacing-10;

		@include media-down(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: $spacing-6;
		}
	}

	// The figure is the `dd`, second in the markup: `column-reverse` raises it, `flex-end` keeps it on top.
	.voices__stat {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		align-items: center;
		gap: $spacing-1;
		padding-inline: $spacing-4;
		text-align: center;

		& + & {
			border-left: 1px solid var(--color-border);
		}

		@include media-down(md) {
			&:nth-child(odd) {
				border-left: 0;
			}
		}

		dd {
			margin: 0;
			font-size: 2.5rem;
			font-weight: $font-weight-bold;
			line-height: 1.2;
			font-variant-numeric: tabular-nums;
			color: var(--color-text);
		}

		dt {
			font-size: $font-size-sm;
			line-height: 22px;
			color: var(--color-text-secondary);
		}
	}

	.voices__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-5;
		margin: 0;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	// A column with the person pushed to the foot, so a row's names line up. Positioned, so the links'
	// absolute `.sr-only` text stays inside the strip's scroll box instead of widening the page.
	.voices__card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: $spacing-5;
		border-radius: $radius-lg;
		background: #fff;
		box-shadow:
			0 1px 2px rgb(16 24 40 / 6%),
			0 10px 20px -8px rgb(16 24 40 / 10%);
	}

	.voices__logo {
		width: auto;
		max-width: 120px;
		height: 24px;
		margin-bottom: $spacing-4;
		object-fit: contain;
		object-position: left center;
		filter: grayscale(1);
		opacity: 0.72;
	}

	.voices__quote {
		margin: 0;
		padding: 0;
		border: 0;
		font-size: $font-size-base;
		font-weight: $font-weight-medium;
		line-height: 24px;
		color: var(--color-text);
		text-wrap: balance;
	}

	.voices__context,
	.voices__name {
		font-size: $font-size-sm;
		line-height: 22px;
		color: var(--color-text-secondary);
	}

	.voices__context {
		margin: $spacing-2 0 0;
	}

	.voices__who {
		display: grid;
		grid-template-columns: 36px minmax(0, 1fr);
		gap: $spacing-3;
		align-items: start;
		margin: auto 0 0;
		padding-top: $spacing-4;
	}

	.voices__face {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		object-fit: cover;
		background: #f5f6ff;
		font-size: $font-size-lg;
		font-weight: $font-weight-bold;
		color: var(--color-text-secondary);
	}

	// Held at three lines (a name and a two-line role), so every card's person sits on its row's line.
	.voices__name {
		display: flex;
		flex-direction: column;
		min-height: calc(3 * 22px);

		b {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}
	}

	.voices__link {
		display: inline-flex;
		align-self: start;
		align-items: center;
		margin-top: $spacing-3;
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		line-height: 22px;
		color: var(--color-primary);
		text-decoration: none;
		text-underline-offset: 3px;

		:global(.link-chevron) {
			@include link-chevron;
		}

		&:hover,
		&:focus-visible {
			text-decoration: underline;
		}
	}

	.voices__all {
		display: flex;
		width: fit-content;
		margin: $spacing-8 auto 0;
		font-size: 1.125rem;
		line-height: 27px;
	}

	.voices__card--accent {
		background: $navy;
		box-shadow: none;

		.voices__logo {
			filter: brightness(0) invert(1);
			opacity: 0.9;
		}

		.voices__quote {
			font-size: $font-size-2xl;
			font-weight: $font-weight-bold;
			line-height: 1.2;
			color: #fff;
		}

		.voices__context,
		.voices__name {
			color: rgb(255 255 255 / 78%);
		}

		.voices__name b {
			color: #fff;
		}

		.voices__face {
			background: #fff;
			color: $navy;
		}

		.voices__link {
			color: #b3c7ff;
		}
	}

	// On a phone: one card at 82% and the edge of the next, snapping; the strip runs to the screen's edges.
	@include media-down(md) {
		.voices__strip {
			margin-inline: -$spacing-5;
			padding-inline: $spacing-5;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: $spacing-5;
			scrollbar-width: none;
		}

		.voices__list {
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 82%;
			gap: $spacing-3;
			// Room for the cards' shadows inside the scroll box.
			padding-block: $spacing-2 $spacing-5;
		}

		.voices__card {
			scroll-snap-align: start;
		}
	}
</style>
