---
import { Icon } from 'astro-icon/components';
import { GATEWAY_RELAY } from '@data/gateway-visual';
import { homeEcosystem } from '@data/homeEcosystem';

/** The IoT Gateway card's visual: protocol chips fanning into the gateway, its MQTT uplink cut by the card's edge. */

const BLUE = '#0e7490';
const ROSE = '#be185d';
const BEIGE = '#b45309';
const GREEN = '#65a30d';
const GREY = '#5b616e';
// A hex: `tint()` below reads its channels.
const GATEWAY = homeEcosystem.find((item) => item.relay)?.accent ?? '';
if (!/^#[0-9a-f]{6}$/i.test(GATEWAY)) throw new Error(`GatewayRelay: the Gateway card's accent must be a 6-digit hex.`);
// $color-brand
const PRIMARY = '#3d50f5';

const rgb = (c: string) => {
	const n = parseInt(c.slice(1), 16);
	return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
};
const tint = (c: string, a = 0.16) => `rgba(${rgb(c).join(', ')}, ${a})`;

const HUES = [BEIGE, ROSE, GREEN, BLUE, PRIMARY];
const ARMS = [
	...GATEWAY_RELAY.protocols.map((name, i) => ({ name, accent: HUES[i % HUES.length], more: false })),
	{ name: GATEWAY_RELAY.more, accent: GREY, more: true },
];

// Geometry, in units of `--u`.
const STUB = 12;
const CHIP_H = 30;
const CHIP_FONT = 16;
const CHIP_PAD = 10;
// Chip widths are computed, not measured: every face in the mono stack advances 0.6em a character.
const ADVANCE = 0.6;
const chipW = (name: string) => name.length * CHIP_FONT * ADVANCE + 2 * CHIP_PAD;
// The remainder's chip is the widest, so the column is exactly its width.
const COL = chipW(GATEWAY_RELAY.more);
// Must stay above CHIP_H or the chips overlap.
const PITCH = 36;

const HEIGHT = ARMS.length * PITCH;
const MID_Y = HEIGHT / 2;

// Every chip's inner edge, where the curves leave from.
const CHIP_IN = STUB + COL;
const GUT = 50;
const GW = 64;
const GW_L = CHIP_IN + GUT;
const GW_R = GW_L + GW;
const GW_CX = GW_L + GW / 2;
// Out of the gateway: a lead, the MQTT chip, then a tail the card's edge cuts.
const UP_CHIP = chipW(GATEWAY_RELAY.uplink);
const UP_LEAD = 16;
const UP_TAIL = 20;
const NATIVE = GW_R + UP_LEAD + UP_CHIP + UP_TAIL;
const RUN_CX = GW_R + UP_LEAD + UP_CHIP / 2;

const cy = (i: number) => PITCH / 2 + i * PITCH;

// The arms land spread over the gateway's face, the outer two on its corners.
const FAN = 56;
const ay = (i: number) => MID_Y - FAN / 2 + (FAN / (ARMS.length - 1)) * i;

// How far the tile's rounded edge sits inside its box at y, so the outer arms meet the painted curve.
// Must match the tile's `border-radius: 32%`.
const RADIUS = GW * 0.32;
const inset = (y: number) => {
	const dy = Math.min(y - (MID_Y - GW / 2), MID_Y + GW / 2 - y);
	if (dy >= RADIUS) return 0;
	return RADIUS - Math.sqrt(Math.max(0, RADIUS * RADIUS - (RADIUS - dy) ** 2));
};

const EASE = 0.55;
const arm = (i: number) => {
	const y0 = cy(i);
	const y1 = ay(i);
	const x0 = CHIP_IN;
	const x1 = GW_L + inset(y1);
	const k = (x1 - x0) * EASE;
	return `M ${x0},${y0} C ${x0 + k},${y0} ${x1 - k},${y1} ${x1},${y1}`;
};
// Broken around the MQTT chip, whose tint would show a line through it. The tail overshoots NATIVE
// so `contain: paint` cuts it at the box edge.
const UPLINK = `M ${GW_R},${MID_Y} H ${RUN_CX - UP_CHIP / 2} M ${RUN_CX + UP_CHIP / 2},${MID_Y} H ${NATIVE + 4}`;

const vars = [
	`--u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	`--gwr-native: ${NATIVE}`,
	`--gwr-h: ${HEIGHT}`,
	`--gwr-mid-y: ${MID_Y}`,
	`--gwr-edge: ${CHIP_IN}`,
	`--gwr-chip-h: ${CHIP_H}`,
	`--gwr-chip-font: ${CHIP_FONT}`,
	`--gwr-chip-pad: ${CHIP_PAD}`,
	`--gwr-gw: ${GW}`,
	`--gwr-gw-cx: ${GW_CX}`,
	`--gwr-run-cx: ${RUN_CX}`,
	`--gwr-up-chip: ${UP_CHIP}`,
	`--gwr-gateway: ${GATEWAY}`,
].join('; ');
---

<div class="gwr-fit">
	<div class="gwr" style={vars} role="img" aria-label={GATEWAY_RELAY.label}>
		<svg
			class="gwr__wires"
			viewBox={`0 0 ${NATIVE} ${HEIGHT}`}
			preserveAspectRatio="none"
			aria-hidden="true"
			focusable="false"
		>
			{ARMS.map((a, i) => (
				<path class:list={['gwr__wire', a.more && 'gwr__wire--more']} d={arm(i)} stroke={a.accent} />
			))}
			<path class="gwr__wire gwr__wire--uplink" d={UPLINK} stroke={GATEWAY} />
		</svg>

		{ARMS.map((a, i) => (
			<span
				class:list={['gwr__chip', a.more && 'gwr__chip--more']}
				style={`--gwr-accent: ${a.accent}; --gwr-tint: ${tint(a.accent, a.more ? 0.1 : 0.16)}; --gwr-y: ${cy(i)}; --gwr-stub-w: ${CHIP_IN - chipW(a.name)}`}
			>
				{a.name}
			</span>
		))}

		<span class="gwr__chip gwr__chip--uplink" style={`--gwr-tint: ${tint(GATEWAY)}`} aria-hidden="true">
			{GATEWAY_RELAY.uplink}
		</span>

		<span class="gwr__tile" aria-hidden="true">
			<Icon name="tabler:router" />
		</span>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.gwr-fit {
		container-type: inline-size;
		// Bleeds over the card's right padding ($spacing-5), so the uplink's cut lands on the card's edge.
		width: calc(100% + #{$spacing-5});
		margin-right: -#{$spacing-5};
	}

	.gwr {
		--gwr-wire-w: max(1px, #{u(2)});

		contain: paint;
		position: relative;
		width: u(var(--gwr-native));
		max-width: 100%;
		height: u(var(--gwr-h));
		// Right-anchored: the box's right edge is where the uplink is cut.
		margin-inline: auto 0;
	}

	.gwr__wires {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.gwr__wire {
		fill: none;
		stroke-width: var(--gwr-wire-w);
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}

	.gwr__wire--more {
		opacity: 0.45;
	}

	// Flat ends, so the gap is exactly the chip.
	.gwr__wire--uplink {
		stroke-linecap: butt;
	}

	.gwr__chip {
		position: absolute;
		top: u(var(--gwr-y));
		right: u(calc(var(--gwr-native) - var(--gwr-edge)));
		display: flex;
		align-items: center;
		height: u(var(--gwr-chip-h));
		padding: 0 u(var(--gwr-chip-pad));
		transform: translateY(-50%);
		border-radius: u(9);
		background: var(--gwr-tint);
		font-family: $font-family-mono;
		font-size: u(var(--gwr-chip-font));
		font-weight: $font-weight-bold;
		line-height: 1;
		white-space: nowrap;

		// The stub into the chip, fading out at the drawing's left edge.
		&::after {
			content: '';
			position: absolute;
			top: 50%;
			right: 100%;
			width: u(var(--gwr-stub-w));
			height: var(--gwr-wire-w);
			transform: translateY(-50%);
			background: linear-gradient(to left, var(--gwr-accent), transparent);
		}
	}

	.gwr__chip--more {
		font-weight: $font-weight-normal;
		color: var(--color-text-secondary);

		&::after {
			display: none;
		}
	}

	// Fixed width rather than sized by its text: the gap in the uplink is drawn to this width, and a
	// fallback face during font swap would otherwise grow the chip past it.
	.gwr__chip--uplink {
		right: auto;
		left: u(var(--gwr-run-cx));
		top: u(var(--gwr-mid-y));
		justify-content: center;
		width: u(var(--gwr-up-chip));
		padding: 0;
		transform: translate(-50%, -50%);

		&::after {
			display: none;
		}
	}

	.gwr__tile {
		position: absolute;
		top: u(var(--gwr-mid-y));
		left: u(var(--gwr-gw-cx));
		display: flex;
		align-items: center;
		justify-content: center;
		width: u(var(--gwr-gw));
		height: u(var(--gwr-gw));
		transform: translate(-50%, -50%);
		border-radius: 32%;
		background: linear-gradient(155deg, #fff 40%, color-mix(in srgb, var(--gwr-gateway) 9%, #fff) 100%);
		color: var(--gwr-gateway);
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.06),
			0 #{u(7)} #{u(16)} #{u(-5)} rgba(0, 0, 0, 0.22);

		:global(svg) {
			width: u(36);
			height: u(36);
		}
	}
</style>
