---
import { Icon } from 'astro-icon/components';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import type { Benefit } from '@models/benefit';

/** A product page's "Why …" band: a section header over a grid of claims, three across. */
interface Props {
	title: string;
	subtitle: string;
	items: readonly Benefit[];
}

const { title, subtitle, items } = Astro.props;
---

<section id="benefits" class="benefits">
	<SectionHeader {title} {subtitle} />
	<div class="benefit-grid">
		{items.map((benefit) => (
			<div class="benefit-card">
				<Icon name={benefit.icon} class="benefit-card__icon" style={`color: ${benefit.color}`} aria-hidden="true" />
				<h3 class="benefit-card__title">{benefit.title}</h3>
				<p class="benefit-card__text">{benefit.description}</p>
			</div>
		))}
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.benefits {
		padding: $spacing-16 var(--band-gutter) $spacing-20;

		@include media-down(md) {
			padding-block: $spacing-10 $spacing-12;
		}
	}

	.benefit-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: $spacing-8 $spacing-6;

		@include media-down(lg) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.benefit-card {
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		padding-top: $spacing-5;
		border-top: 1px solid rgb(15 23 42 / 12%);

		&__icon {
			width: 36px;
			height: 36px;
		}

		&__title {
			font-size: $font-size-lg;
			font-weight: $font-weight-bold;
			line-height: 1.3;
			margin: $spacing-1 0 0;
			color: var(--color-text);
		}

		&__text {
			@include text-m;
			margin: 0;
			line-height: 1.5;
			color: var(--color-text-secondary);
			text-wrap: pretty;
		}
	}

	@media print {
		.benefits {
			padding-block: $spacing-6;
		}

		.benefit-grid {
			gap: $spacing-6;

			@include media-down(lg) {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		.benefit-card {
			break-inside: avoid;
		}
	}
</style>
