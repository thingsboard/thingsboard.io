---
import { Icon } from 'astro-icon/components';
import AiAssistant from '@components/Landing/AiAssistant.astro';
import AgentTerminal from '@components/Landing/AgentTerminal.astro';
import SegmentedToggle from '@components/Landing/SegmentedToggle.astro';
import AiHandoff from '@components/Landing/AiHandoff.astro';
import {
	AI_AGENT_SESSION,
	AI_AGENT_SESSION_WORDMARK,
	AI_BADGE_CYCLE,
	AI_COLUMNS,
	AI_COPY,
	AI_CTA,
} from '@data/ai-visual';

/**
 * The homepage AI section: a switch between the Assistant chat and the coding-agent terminal, each beside
 * its copy and call to action. Each window is rendered twice, whole and phone-cropped, one shown per width.
 */

const PANELS = { assistant: 'ai-assistant', cli: 'ai-cli' };

const panel = (id: string, shown: boolean) => ({
	id,
	role: 'tabpanel' as const,
	'aria-labelledby': `${id}-tab`,
	hidden: !shown,
});

const sectionStyle = [AI_COPY.badge.color, ...AI_BADGE_CYCLE].map((hue, i) => `--ai-hue-${i}: ${hue}`).join('; ');
---

<section id="ai" class="ai" style={sectionStyle}>
	<div class="main-div">
		<header class="ai__head">
			<span class="ai__badge" aria-hidden="true">
				<Icon name={AI_COPY.badge.icon} />
			</span>
			<h2 class="ai__title">{AI_COPY.title}</h2>
			<div class="ai__switch">
				<SegmentedToggle
					options={[
						{
							label: AI_COLUMNS.assistant.switchLabel,
							shortLabel: AI_COLUMNS.assistant.switchShort,
							icon: 'tabler:message-chatbot',
							panel: PANELS.assistant,
							color: AI_COLUMNS.assistant.accentText,
						},
						{
							label: AI_COLUMNS.cli.switchLabel,
							shortLabel: AI_COLUMNS.cli.switchShort,
							icon: 'tabler:terminal-2',
							panel: PANELS.cli,
							color: AI_COLUMNS.cli.accentText,
						},
					]}
				/>
			</div>
		</header>
	</div>

	<div class="ai__bands" style={`--ai-wash: ${AI_COLUMNS.assistant.accent}`}>
		<div class="ai__band" style={`--accent: ${AI_COLUMNS.assistant.accent}`} {...panel(PANELS.assistant, true)}>
			<div class="main-div">
				<div class="ai__row">
					<div class="ai__window">
						<div class="ai__chat ai__chat--whole">
							<AiAssistant titled />
							<span class="ai__mark" aria-hidden="true">
								<Icon name="tabler:message-chatbot" />
							</span>
						</div>
						<div class="ai__chat ai__chat--cut">
							<AiAssistant />
						</div>
					</div>

					<div class="ai__copy">
						<h3 class="ai__row-title">{AI_COLUMNS.assistant.title}</h3>
						<p class="ai__row-text">{AI_COLUMNS.assistant.body}</p>
						<div class="ai__cta">
							<a
								class="ai__cta-button"
								href={AI_CTA.assistant.href}
								data-cloud-auth="signup"
							>
								<Icon name={AI_CTA.assistant.icon} class="ai__cta-icon" aria-hidden="true" />
								{AI_CTA.assistant.text}
							</a>
							<p class="ai__cta-line">{AI_CTA.assistant.line}</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="ai__band" style={`--accent: ${AI_COLUMNS.cli.accent}`} {...panel(PANELS.cli, false)}>
			<div class="main-div">
				<div class="ai__row ai__row--flip">
					<div class="ai__window ai__window--cli">
						<div class="ai__cli ai__cli--wordmark">
							<AgentTerminal session={AI_AGENT_SESSION_WORDMARK} />
						</div>
						<div class="ai__cli ai__cli--mark">
							<AgentTerminal session={AI_AGENT_SESSION} />
						</div>
					</div>

					<div class="ai__copy">
						<h3 class="ai__row-title">{AI_COLUMNS.cli.title}</h3>
						<p class="ai__row-text">{AI_COLUMNS.cli.body}</p>
						<div class="ai__cta">
							<a class="ai__cta-button" href={AI_CTA.cli.href}>
								{AI_CTA.cli.text}
							</a>
							<p class="ai__cta-line">{AI_CTA.cli.line}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<AiHandoff />
</section>

<style lang="scss">
	@use 'sass:math';
	@use '../../styles/variables' as *;

	// `AI_BADGE_CYCLE`'s length: one keyframe stop each, after the mark's own colour at 0.
	$hue-count: 5;
	$cycle: 3s * ($hue-count + 1);

	$window: 600px;
	$window-cli: 560px;
	// The terminal's bar (38.2) and composer (34.6) plus eighteen 18.2px log lines at 14px on 1.3.
	$window-h: 418.6px;
	$gap: 56px;
	$chat-scale: 1.25;

	.ai {
		// Shared by the switch's thumb and the bands; `AiHandoff` reads these back.
		--ai-handoff-duration: 300ms;
		--ai-handoff-ease: cubic-bezier(0.2, 0.8, 0.2, 1);

		// Top only: the band's wash runs into the next section.
		padding: $spacing-16 0 0;

		.main-div {
			max-width: $home-measure;
		}

		:global(.seg) {
			--seg-duration: var(--ai-handoff-duration);
			--seg-ease: var(--ai-handoff-ease);
		}
	}

	.ai__head {
		text-align: center;
	}

	// Always applied and paused until in view, so scrolling past pauses the cycle rather than restarting it.
	.ai__badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		margin: 0 auto 14px;
		border-radius: 32%;
		background-color: var(--ai-hue-0);
		color: $color-white;
		@include mark-shade;
		animation: ai-badge-hues $cycle linear infinite;
		animation-play-state: paused;

		:global([data-icon]) {
			width: 40px;
			height: 40px;
		}
	}

	.ai__title {
		@include home-section-title;
		max-width: 720px;
		margin: 0 auto;
		color: var(--color-text);
		text-wrap: balance;
	}

	.ai__switch {
		display: flex;
		justify-content: center;
		margin-top: $spacing-8;
	}

	@media (min-width: 600px) {
		.ai :global(.seg__icon) {
			display: none;
		}
	}

	// Registered so the keyframes interpolate it.
	@property --ai-wash {
		syntax: '<color>';
		inherits: false;
		initial-value: transparent;
	}

	// Both bands share one grid cell, so during the hand-off the incoming one arrives over the outgoing.
	// `minmax(0, 1fr)`: a bare `1fr` floors at the pixel-wide window's min-content and overflows a phone.
	.ai__bands {
		display: grid;
		grid-template: minmax(0, 1fr) / minmax(0, 1fr);
		margin-top: $spacing-8;
		background-image: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--ai-wash) 20%, transparent) 100%);
		// The bands travel sideways, and a transform counts as scrollable overflow.
		overflow-x: clip;
		// Outranks the route hue `AiHandoff` sets inline, which only shows under reduced motion.
		animation: ai-wash-hues $cycle linear infinite;
		animation-play-state: paused;
	}

	.ai.is-cycling {
		.ai__badge,
		.ai__bands {
			animation-play-state: running;
		}
	}

	@mixin hue-stops($prop) {
		0%,
		100% {
			#{$prop}: var(--ai-hue-0);
		}
		@for $i from 1 through $hue-count {
			#{math.div($i * 100%, $hue-count + 1)} {
				#{$prop}: var(--ai-hue-#{$i});
			}
		}
	}

	@keyframes ai-badge-hues {
		@include hue-stops(background-color);
	}

	@keyframes ai-wash-hues {
		@include hue-stops(--ai-wash);
	}

	@media (prefers-reduced-motion: reduce) {
		.ai__badge,
		.ai__bands {
			animation: none;
		}
	}

	.ai__band {
		grid-area: 1 / 1;
		padding: $spacing-6 0 $spacing-16;

		// The band on its way out must not catch a click meant for the one arriving over it.
		&.is-leaving {
			pointer-events: none;
		}
	}

	// `row-reverse` rather than `order`, so the DOM keeps window before copy in both rows.
	.ai__row {
		display: flex;
		align-items: center;
		gap: $gap;
	}

	.ai__row--flip {
		flex-direction: row-reverse;
	}

	.ai__window {
		flex: none;
		width: min(#{$window}, 100%);
		height: $window-h;
	}

	.ai__window--cli {
		width: min(#{$window-cli}, 100%);
	}

	.ai__copy {
		flex: 1 1 auto;
		min-width: 0;
	}

	.ai__row-title {
		@include card-title;
		margin: 0 0 12px;
		font-weight: $font-weight-bold;
		color: var(--color-text);
		text-wrap: balance;
	}

	.ai__row-text {
		@include text-m;
		margin: 0;
		line-height: 1.5;
	}

	.ai__cta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: $spacing-2;
		margin-top: $spacing-6;
	}

	.ai__cta-line {
		@include text-s;
		margin: 0;
		line-height: 22px;
		color: var(--color-text-secondary);
	}

	.ai__cta-button {
		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		height: 44px;
		padding: 0 $spacing-4;
		border: 1px solid rgb(23 24 28 / 18%);
		border-radius: $radius-md;
		font-size: $font-size-base;
		font-weight: $font-weight-bold;
		line-height: 1.5;
		color: var(--color-text);

		&:hover {
			background-color: rgb(23 24 28 / 5%);
		}

		&:focus-visible {
			outline: 2px solid var(--color-text);
			outline-offset: 3px;
		}
	}

	.ai__cta-icon {
		width: 20px;
		height: 20px;
	}

	.ai__chat {
		position: relative;
	}

	.ai__chat,
	.ai__cli {
		height: 100%;
	}

	.ai__chat--cut,
	.ai__cli--mark {
		display: none;
	}

	// Positioned, because a transform does not shrink the layout box.
	.ai__chat :global(.assistant) {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		margin: 0 auto;
	}

	// The shadow is divided by the scale, so it renders at page size.
	.ai__chat--whole :global(.assistant) {
		--ui-scale: #{$chat-scale};

		width: calc(100% / #{$chat-scale});
		height: calc(#{$window-h} / #{$chat-scale});
		box-shadow: 0 calc(8px / #{$chat-scale}) calc(18px / #{$chat-scale}) rgb(23 24 28 / 16%);
	}

	.ai__mark {
		position: absolute;
		top: -14px;
		left: 50%;
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		transform: translateX(-50%);
		border-radius: 24%;
		background-color: $color-white;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 60%),
			0 1px 2px rgb(23 24 28 / 8%),
			0 10px 24px -10px rgb(23 24 28 / 18%),
			0 16px 36px -14px color-mix(in srgb, var(--accent) 35%, transparent);
		color: var(--accent);

		:global(svg) {
			width: 40px;
			height: 40px;
		}
	}

	.ai__window--cli :global(.agent) {
		height: 100%;
		border-radius: $radius-lg;
		font-size: 14px;
	}

	.ai__window--cli :global(.agent__path) {
		font-size: 12px;
	}

	// Nothing prints beside the wordmark, so its status lines start at the margin.
	.ai__cli--wordmark :global(.agent__banner-line) {
		padding-left: 0;
	}

	// Horizontal: each row of the art is its own box, so a vertical ramp would restart on every row.
	.ai__window--cli :global(.agent__art) {
		background-image: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 55%, #fff));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	@include media-down(lg) {
		.ai__row {
			flex-direction: column;
			align-items: center;
			gap: $spacing-8;
		}

		.ai__copy {
			width: 100%;
			max-width: $window;
		}
	}

	// 298: the terminal's bar (26.3) and composer (29.75) plus fourteen 16.1px lines at 11.5px on 1.4.
	@media (max-width: 599px) {
		.ai__window {
			height: 298px;
		}

		.ai__chat--whole,
		.ai__cli--wordmark {
			display: none;
		}

		.ai__cli--mark {
			display: block;
		}

		// Taller than the box, so the bar is cut off the top. The box runs 20 into the gutter each side so
		// the mask keeps the side shadows.
		.ai__chat--cut {
			display: block;
			margin-inline: -20px;
			overflow: hidden;
			-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 32px);
			mask-image: linear-gradient(to bottom, transparent 0, #000 32px);
		}

		.ai__chat--cut :global(.assistant) {
			bottom: 16px;
			width: calc(100% - 40px);
			height: 340px;
		}

		.ai__window--cli :global(.agent) {
			--agent-lead: 1.4;
			--agent-chrome: 0.65;

			font-size: 11.5px;
		}

		.ai__window--cli :global(.agent__path) {
			font-size: 11.5px;
			line-height: 13.3px;
		}
	}

	@media (max-width: 374px) {
		.ai__window--cli :global(.agent) {
			font-size: 9.5px;
		}

		.ai__window--cli :global(.agent__path) {
			font-size: 8.5px;
		}
	}

	@include media-down(md) {
		.ai {
			padding-top: 60px;
		}
	}
</style>

<script>
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const section = document.querySelector<HTMLElement>('#ai');
	const badge = section?.querySelector<HTMLElement>('.ai__badge');

	// On the section, so the mark and the wash run on one clock.
	if (section && badge && !reduced) {
		new IntersectionObserver(
			(entries) => {
				for (const entry of entries) section.classList.toggle('is-cycling', entry.isIntersecting);
			},
			{ threshold: 0.5 }
		).observe(badge);
	}
</script>
