---
import { Icon } from 'astro-icon/components';
import CtaButton from '@components/Landing/CtaButton.astro';
import { externalLinkAttrs } from '@util/external-links';
import type { ProductChoice } from '@data/homeProducts';

/**
 * A deployment card in the Products section: a button in the product's colour over a link. Two actions, so
 * the card itself is not a click target.
 */
type Props = ProductChoice;

const { name, label, description, badgeFill, nameHighlight, action, href, link } = Astro.props;

const at = name.indexOf(nameHighlight);
if (at === -1) throw new Error(`ProductChoiceCard "${name}": no "${nameHighlight}" in the name to tint.`);
const before = name.slice(0, at);
---

<div class="choice" style={`--badge-fill: ${badgeFill}`}>
	<span class="choice__badge" aria-hidden="true">
		<Icon name="thingsboard-mark" class="choice__mark" />
	</span>

	<p class="choice__label">{label}</p>
	<h3 class="choice__title">
		{before}
		<span class="choice__accent">{nameHighlight}</span>
	</h3>
	{description.map((para) => (
		<p class="choice__description">{para}</p>
	))}

	<div class="choice__actions print:hidden">
		<CtaButton
			href={action.href}
			icon={action.icon}
			variant="brand"
			target={externalLinkAttrs(action.href).target}
			cloudAuth={action.cloudAuth}
		>
			{action.label}
		</CtaButton>
		<a class="choice__link" href={href}>
			{link}
			<span class="sr-only">— {name}</span>
			<Icon name="tabler:chevron-right" class="link-chevron" aria-hidden="true" />
		</a>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/home-card' as *;
	@use '../../styles/print-mixins' as *;

	$muted: #6e7481;

	.choice {
		@include home-card;
		@include home-card-glow(var(--badge-fill));
		// Recolours the CtaButton's brand variant.
		--page-accent: var(--badge-fill);

		@include media-up(md) {
			padding: calc($home-card-badge / 2 + #{$spacing-8}) $spacing-8 $spacing-8;
		}
	}

	.choice__badge {
		@include home-card-badge;
		background-color: var(--badge-fill);
		background-image: linear-gradient(150deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 62%);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
	}

	.choice__mark {
		width: 60%;
		height: auto;
		color: $color-white;
	}

	.choice__label {
		@include home-card-eyebrow;
		color: $muted;
	}

	.choice__title {
		@include home-card-title;
	}

	// Wraps whole: "On-premises" otherwise breaks at its hyphen on a phone.
	.choice__accent {
		white-space: nowrap;
		color: var(--badge-fill);
	}

	.choice__description {
		@include home-card-copy;

		&:not(:last-of-type) {
			margin-bottom: $spacing-1;
		}
	}

	.choice__actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: $spacing-3;
		margin-top: auto;

		// CtaButton's ring is white, for the dark bands; this card is white.
		:global(.cta-button:focus-visible) {
			outline-color: var(--badge-fill);
		}
	}

	.choice__link {
		@include home-card-link;
		font-size: $font-size-base;
		line-height: 1.5;
		color: var(--color-text);
	}

	.sr-only {
		@include visually-hidden;
	}

	@media print {
		.choice {
			@include home-card-print;
		}

		.choice__badge {
			@include print-exact;
			box-shadow: none;
		}

		.choice__description:last-of-type {
			margin-bottom: 0;
		}
	}
</style>
