---
import BaseLayout from '@layouts/BaseLayout.astro';
import WaveBackground from '@components/Landing/WaveBackground.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import Intro from '@components/TrustCenter/Intro.astro';
import { tc } from '@data/trust-center/nav';
import './trust-center.scss';

/** The Trust Center's form-page layout (contact, vulnerability report), after the site's Contact us page. */

export interface ElsewhereItem {
	icon: string;
	lead: string;
	label: string;
	href: string;
	external?: boolean;
	accent?: string;
}

interface Props {
	title: string;
	lede: string;
	description: string;
	/** The browser title. Default: the h1 and "· Trust Center". */
	metaTitle?: string;
	elsewhereTitle?: string;
	elsewhere: ElsewhereItem[];
	accent?: 'alert';
}

const {
	title,
	lede,
	description,
	metaTitle,
	elsewhereTitle = 'Looking for something else?',
	elsewhere,
	accent,
} = Astro.props;
---

<BaseLayout forceLightTheme noIndex title={metaTitle ?? `${title} · Trust Center`} description={description}>
	<WaveBackground />
	<div class="tc-form-page" data-accent={accent}>
		<header class="tc-form-page__intro">
			<Link href={tc()} dir="back" size="sm" class="tc-form-page__back">
				Trust Center
			</Link>
			<Intro title={title} lede={lede} ledeMeasure="narrow" />
			{/* Before the form on phones too, where the aside falls below it. */}
			<slot name="intro" />
		</header>
		<div class="tc-form-page__form">
			<slot />
		</div>
		<aside class="tc-form-page__aside" aria-labelledby="tc-form-page-aside-title">
			<h2 class="tc-form-page__aside-title" id="tc-form-page-aside-title">
				{elsewhereTitle}
			</h2>
			<ul class="tc-form-page__list">
				{elsewhere.map((item) => (
					<li class="tc-form-page__item" data-accent={item.accent}>
						<Mark size={48} icon={item.icon} fill="white" accent={item.accent ? undefined : 'neutral'} lift />
						<span class="tc-form-page__text">
							<span class="tc-form-page__lead">{item.lead}</span>
							<Link class="tc-form-page__link" href={item.href} tone="ink" dir="none" external={item.external} wrap>
								{item.label}
							</Link>
						</span>
					</li>
				))}
			</ul>
		</aside>
	</div>
</BaseLayout>

<style lang="scss" is:global>
	// Let the fixed wave field show through the body.
	body:has(.tc-form-page) {
		background-color: transparent;
	}

	body:has(.tc-form-page[data-accent='alert']) .wave-bg {
		--wave-bg-color: var(--color-accent-red);
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	.tc-form-page {
		display: grid;
		grid-template-columns: minmax(0, 344px) minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		grid-template-areas:
			'intro form'
			'aside form';
		gap: 0 $spacing-10;
		max-width: $home-measure;
		margin: 0 auto;
		padding: $spacing-12 $spacing-5 $spacing-24;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: none;
			grid-template-areas: 'intro' 'form' 'aside';
			padding-top: $spacing-8;
			padding-bottom: $spacing-16;
		}

		:where(p, h2, ul) {
			margin: 0;
		}
	}

	.tc-form-page__intro {
		grid-area: intro;
		padding-top: $spacing-6;

		@include media-down(lg) {
			padding-top: 0;
			margin-bottom: $spacing-8;
		}

		:global(.tc-form-page__back) {
			margin-bottom: $spacing-5;
		}

		// The 344px intro column takes the title at the section size.
		:global(.tc-intro__title) {
			@include media-up(lg) {
				font-size: $font-size-4xl;
			}
		}
	}

	.tc-form-page__form {
		grid-area: form;
		min-width: 0;
	}

	.tc-form-page__aside {
		display: grid;
		grid-area: aside;
		align-self: start;
		gap: $spacing-5;
		margin-top: $spacing-12;

		@include media-down(lg) {
			margin-top: $spacing-10;
		}
	}

	.tc-form-page__aside-title {
		@include type-tile;
		color: var(--color-text);
	}

	.tc-form-page__list {
		display: grid;
		gap: $spacing-5;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			@include media-up(md) {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: $spacing-5 $spacing-6;
			}
		}
	}

	.tc-form-page__item {
		display: flex;
		align-items: flex-start;
		gap: 14px;

		@include media-down(lg) {
			@include media-up(md) {
				flex-direction: column;
				gap: $spacing-3;
			}
		}
	}

	.tc-form-page__text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.tc-form-page__lead {
		@include type-small;
		color: var(--color-text-secondary);
	}

	.tc-form-page__item :global(.tc-form-page__link) {
		overflow-wrap: anywhere;
	}

	@media print {
		.tc-form-page__aside {
			break-inside: avoid;
		}
	}
</style>
