---
/** A document's owner: the IMS Manager by name and title; any other role as written. */
import { TC_OWNER } from '@data/trust-center/nav';

interface Props {
	/** Default: the IMS Manager, who maintains the Trust Center. */
	owner?: string;
	/** The title on its own line under the name. */
	stacked?: boolean;
}

const { owner = TC_OWNER.role, stacked = false } = Astro.props;
---

{owner === TC_OWNER.role
	? stacked
		? [TC_OWNER.name, <span class="tc-owner__role">{TC_OWNER.role}</span>]
		: `${TC_OWNER.name}, ${TC_OWNER.role}`
	: owner}

<style is:global>
	.tc-owner__role {
		display: block;
		color: var(--color-text-secondary);
	}
</style>
