---
/** A document's owner: the IMS Manager by name (linked) and title; any other role as written. */
import Link from '@components/ui/Link.astro';
import { TC_OWNER } from '@data/trust-center/nav';

interface Props {
	/** Default: the IMS Manager, who maintains the Trust Center. */
	owner?: string;
	tone?: 'accent' | 'muted';
	/** The title on its own line under the name. */
	stacked?: boolean;
}

const { owner = TC_OWNER.role, tone = 'accent', stacked = false } = Astro.props;
---

{owner === TC_OWNER.role
	? [
			<Link variant="inline" tone={tone} href={TC_OWNER.href} external class="tc-owner">
				{TC_OWNER.name}
			</Link>,
			stacked ? <span class="tc-owner__role">{TC_OWNER.role}</span> : `, ${TC_OWNER.role}`,
		]
	: owner}

<style is:global>
	/* Flex drops the line breaks Link keeps inside its anchor, which would show as a space before the comma. */
	.ui-link.tc-owner {
		display: inline-flex;
		align-items: center;
	}

	.tc-owner__role {
		display: block;
		color: var(--color-text-secondary);
	}
</style>
