---
import DocItem from '@components/TrustCenter/DocItem.astro';
import type { DocRow } from '@data/trust-center/deployment';

/** A deployment page's document list, at the main column's width. */

interface Props {
	caption: string;
	rows: DocRow[];
}

const { caption, rows } = Astro.props;
---

<ul class="tc-doclist tc-doclist--main" aria-label={caption}>
	{rows.map((row) => (
		<DocItem name={row.name} access={row.access} actions={row.actions} />
	))}
</ul>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-doclist--main {
		max-width: var(--tc-main);
	}
</style>
