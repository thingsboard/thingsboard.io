---
import Band from '@components/ui/Band.astro';
import Card from '@components/ui/Card.astro';
import Mark from '@components/ui/Mark.astro';
import { CLOSING } from '@data/trust-center/nav';

/** The contact band that closes every Trust Center page. */
---

<Band class="tc-closing" wave pad="xl" accent="brand" attrs={{ 'aria-labelledby': 'tc-closing-title' }}>
	<h2 class="tc-closing__title" id="tc-closing-title">
		{CLOSING.title}
	</h2>
	<p class="tc-closing__lead">{CLOSING.lead}</p>
	<ul class="tc-closing__cards">
		{CLOSING.cards.map((card) => (
			<Card as="li" href={card.href} title={card.title} class="tc-closing__card" attrs={{ 'data-accent': card.accent }}>
				<Mark slot="mark" size={48} icon={card.icon} fill="wash" />
				<p class="tc-closing__line">{card.line}</p>
			</Card>
		))}
	</ul>
</Band>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-closing {
		text-align: center;
	}

	.tc-closing__title {
		@include type-title;

		max-width: 28ch;
		margin: 0 auto $spacing-5;
		color: var(--color-text);
		text-wrap: balance;
	}

	.tc-closing__lead {
		@include type-body;

		max-width: 52ch;
		margin: 0 auto;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.tc-closing__cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-4;
		margin: $spacing-10 0 0;
		padding: 0;
		list-style: none;
		text-align: left;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.tc-closing__card .ui-mark {
		margin-bottom: $spacing-4;
	}

	.tc-closing__line {
		@include type-small;

		margin: $spacing-2 0 0;
		color: var(--color-text-secondary);
	}

	@media print {
		.tc-closing {
			display: none;
		}
	}
</style>
