---
import { Icon } from 'astro-icon/components';
import Link from '@components/ui/Link.astro';
import { ACCESS, type Access, type DocAction } from '@data/trust-center/documents';
import { externalLinkAttrs } from '@util/external-links';

/**
 * One document row: access icon, name, optional meta column and its actions. With `pick` (the
 * library), an NDA document gets an "Add" checkbox in place of Request.
 */

interface Props {
	name: string;
	href?: string;
	meta?: string;
	access: Access;
	actions: DocAction[];
	/** The "Add" checkbox's value. */
	pick?: string;
	attrs?: Record<string, string | undefined>;
}

const { name, href, meta, access, actions, pick, attrs = {} } = Astro.props;
const adds = pick !== undefined && access === 'nda';
---

<li class:list={['tc-doc', meta && 'tc-doc--meta']} {...attrs}>
	<div class="tc-doc__text">
		<span class:list={['tc-access', `tc-access--${access}`]}>
			<Icon name={ACCESS[access].icon} aria-hidden="true" />
			<span class="tc-access__tip">{ACCESS[access].hint}</span>
		</span>
		{href ? (
			<a class="tc-doc__name" href={href} {...externalLinkAttrs(href)}>
				{name}
			</a>
		) : (
			<span class="tc-doc__name">{name}</span>
		)}
	</div>
	{meta && <span class="tc-doc__meta">{meta}</span>}
	<div class="tc-doc__actions">
		{adds && (
			<label class="tc-doc__add">
				<input class="tc-doc__add-box" type="checkbox" value={pick} data-doc-pick />
				<Icon name="tabler:plus" class="tc-doc__add-icon tc-doc__add-off" aria-hidden="true" />
				<Icon name="tabler:check" class="tc-doc__add-icon tc-doc__add-on" aria-hidden="true" />
				<span class="tc-doc__add-off">Add</span>
				<span class="tc-doc__add-on">Added</span>
				<span class="ui-sr">{name}</span>
			</label>
		)}
		{!adds && actions.length === 0 && access === 'pending' && <span class="tc-doc__none">Planned</span>}
		{!adds &&
			actions.map((action) =>
				action.missing ? (
					<span class="tc-missing" title="The document's address is still to be added">
						Link needed
					</span>
				) : (
					<Link href={action.href} size="sm" external={action.external} srSuffix={name}>
						{action.label}
					</Link>
				)
			)}
	</div>
</li>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-doc__none {
		@include type-small;

		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.tc-missing {
		@include type-small;

		padding: 1px 8px;
		border: 1px dashed var(--color-border-light);
		border-radius: 999px;
		color: var(--color-text-muted);
		white-space: nowrap;
		cursor: help;
	}

	.tc-access {
		position: relative;
		display: inline-flex;
		color: var(--color-text);

		svg {
			width: 20px;
			height: 20px;
		}

		@media (hover: hover) {
			&:hover .tc-access__tip {
				opacity: 1;
				transform: none;
			}
		}
	}

	.tc-access--public {
		color: var(--color-success);
	}

	.tc-access__tip {
		@include type-small;

		position: absolute;
		bottom: calc(100% + 6px);
		left: -8px;
		z-index: 2;
		padding: 4px 8px;
		border-radius: $radius-sm;
		background: var(--color-text);
		color: var(--color-bg-surface);
		white-space: nowrap;
		opacity: 0;
		transform: translateY(2px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
		pointer-events: none;
	}

	.tc-doclist {
		padding: 0;
		list-style: none;
	}

	.tc-doc {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-4;
		padding: $spacing-3 0;
		border-bottom: 1px solid var(--color-border-light);

		&[hidden] {
			display: none;
		}

		// The first and last rows still shown while a filter hides others.
		&:nth-child(1 of :not([hidden])) {
			padding-top: 0;
		}

		&:nth-last-child(1 of :not([hidden])) {
			border-bottom: 0;
		}
	}

	.tc-doc__text {
		display: flex;
		align-items: flex-start;
		gap: $spacing-2;
		min-width: 0;

		.tc-access {
			flex: none;
			margin-top: 2px;
		}
	}

	.tc-doc__name {
		@include type-body;

		min-width: 0;
		color: var(--color-text);
		text-decoration: none;
	}

	a.tc-doc__name:hover {
		color: var(--accent-ink);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.tc-doc__meta {
		@include type-small;

		color: var(--color-text-secondary);
	}

	.tc-doc--meta {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'text actions'
			'meta actions';
		gap: 2px $spacing-4;

		.tc-doc__text {
			grid-area: text;
		}

		.tc-doc__meta {
			grid-area: meta;
			padding-left: 28px;
		}

		.tc-doc__actions {
			grid-area: actions;
		}

		@include media-up(md) {
			grid-template-columns: minmax(0, 1fr) 160px 88px;
			grid-template-areas: 'text meta actions';

			.tc-doc__meta {
				padding-left: 0;
			}
		}
	}

	// A visually hidden checkbox in a pill, in the type of the View links (`ui-link--sm`).
	.tc-doc__add {
		@include type-small-strong;

		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		height: 28px;
		// Taller than its line: pulled in, so an Add row is as tall as a View row.
		margin-block: -2px;
		margin-inline-end: -10px;
		padding: 0 10px 0 8px;
		border-radius: 999px;
		color: var(--accent-ink);
		cursor: pointer;
		white-space: nowrap;

		@media (hover: hover) {
			&:hover {
				background: color-mix(in srgb, var(--accent-fill) 8%, transparent);
			}
		}

		&:has(:focus-visible) {
			outline: 2px solid var(--accent-fill);
			outline-offset: 2px;
		}

		.tc-doc__add-on {
			display: none;
		}

		&:has(:checked) {
			background: color-mix(in srgb, var(--accent-fill) 12%, transparent);

			.tc-doc__add-on {
				display: inline;
			}

			.tc-doc__add-off {
				display: none;
			}
		}
	}

	.tc-doc__add-box {
		@include visually-hidden;
	}

	.tc-doc__add-icon {
		width: 16px;
		height: 16px;
	}

	.tc-doc__actions {
		display: inline-flex;
		flex: none;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: $spacing-2 $spacing-4;
	}

	@media print {
		.tc-doc {
			break-inside: avoid;
		}

		.tc-doc__add {
			display: none;
		}
	}
</style>
