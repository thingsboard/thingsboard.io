---
import { Icon } from 'astro-icon/components';
import Chip from '@components/ui/Chip.astro';
import Link from '@components/ui/Link.astro';
import type { CatalogRow } from '@data/trust-center/catalogs';
import { deploymentIcon } from '@data/trust-center/deployment-marks';

/**
 * Control rows: title, text or labelled lines, and a documentation link. Only "Configurable" shows a
 * chip. Where a line names a deployment model, its icon takes the bullet's place, and every line of
 * that list takes the icon's indent so the labels line up.
 */

interface Props {
	rows: CatalogRow[];
	label: string;
	heading?: 'h2' | 'h3';
}

const { rows, label, heading: Heading = 'h2' } = Astro.props;
---

<ul class="tc-catalog" aria-label={label}>
	{rows.map((row) => {
		const icons = row.lines?.map((line) => deploymentIcon(line.label)) ?? [];
		return (
			<li class="tc-catalog__row tc-split">
				<div>
					<div class="tc-catalog__head">
						<Heading class="tc-catalog__title">{row.title}</Heading>
						{row.configurable && <Chip>Configurable</Chip>}
					</div>
					{row.lines ? (
						<ul class:list={['tc-catalog__text tc-catalog__lines', icons.some(Boolean) && 'tc-catalog__lines--marked']}>
							{row.lines.map((line, i) => (
								<li>
									{icons[i] && <Icon name={icons[i]} class="tc-catalog__line-icon" aria-hidden="true" />}
									{line.label && <b>{line.label}:</b>} {line.text}
								</li>
							))}
						</ul>
					) : (
						<div class="tc-catalog__text" set:html={row.html} />
					)}
				</div>
				{row.docs && (
					<div class="tc-catalog__aside">
						<Link href={row.docs} size="sm">
							Documentation
						</Link>
					</div>
				)}
			</li>
		);
	})}
</ul>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-catalog__lines {
		display: grid;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tc-catalog__lines b {
		font-weight: $font-weight-medium;
		color: var(--color-text);
	}

	.tc-catalog__lines--marked > li {
		position: relative;
		padding-inline-start: calc(18px + #{$spacing-2});
	}

	.tc-catalog__line-icon {
		position: absolute;
		// Centred on the first line; `3px` where `lh` is unsupported.
		top: 3px;
		top: calc((1lh - 18px) / 2);
		inset-inline-start: 0;
		width: 18px;
		height: 18px;
		color: var(--color-text-secondary);
	}

	.tc-catalog {
		display: grid;
		padding: 0;
		list-style: none;
	}

	.tc-catalog__row {
		padding: $spacing-5 0;
		border-bottom: 1px solid var(--color-border-light);

		&:first-child {
			padding-top: 0;
		}

		&:last-child {
			border-bottom: 0;
		}
	}

	.tc-catalog__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2 $spacing-3;
		margin-bottom: $spacing-2;
	}

	.tc-catalog__title {
		@include type-tile-lg;

		color: var(--color-text);
		text-wrap: balance;
	}

	.tc-catalog__text {
		@include type-body;

		color: var(--color-text-secondary);

		b {
			color: var(--color-text);
		}
		text-wrap: pretty;
	}

	.tc-catalog__aside {
		display: grid;
		gap: $spacing-2;
		justify-items: start;
		align-content: start;

		@include media-up(md) {
			padding-top: 4px;
		}
	}
</style>
