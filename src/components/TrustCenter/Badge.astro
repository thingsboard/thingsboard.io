---
/** A status badge, the icon before the label (32 tall), with an optional line under it. */
import { Icon } from 'astro-icon/components';

interface Props {
	tone: 'ok' | 'nda' | 'flat';
	icon: string;
	label: string;
	note?: string;
}

const { tone, icon, label, note } = Astro.props;
---

<span class:list={['tc-badge', `tc-badge--${tone}`]}>
	<Icon name={icon} aria-hidden="true" />
	{label}
</span>
{note && <p class="tc-badge__note">{note}</p>}

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-badge {
		@include type-small-strong;

		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		padding: 0 $spacing-3;
		border-radius: $radius-full;

		svg {
			flex: none;
			width: 18px;
			height: 18px;
		}
	}

	.tc-badge--ok {
		background: color-mix(in srgb, var(--color-success) 10%, transparent);
		color: var(--color-success);
	}

	.tc-badge--nda {
		background: color-mix(in srgb, var(--color-accent-red) 10%, transparent);
		color: var(--color-accent-red);
	}

	.tc-badge--flat {
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
		color: var(--color-text);
	}

	.tc-badge__note {
		margin-top: $spacing-2;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}
</style>
