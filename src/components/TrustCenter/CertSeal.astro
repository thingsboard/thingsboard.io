---
// An ISO certificate's seal: a disc naming the standard, with a ribbon. ISO does not let its logo
// stand for a certification, so the seal names the standard only. The ribbon hangs a quarter of
// `size` below the box, so leave room under it.

interface Props {
	number: string;
	size?: number;
	class?: string;
}

const { number, size = 96, class: className } = Astro.props;
---

<span class:list={['tc-seal', className]} style={`--seal: ${size}px`} aria-hidden="true">
	<svg class="tc-seal__ribbon" viewBox="0 0 44 40">
		<path class="tc-seal__band" d="M0 0h44v40L22 31 0 40z"></path>
		<path class="tc-seal__fold" d="M22 0h22v40L22 31z"></path>
	</svg>
	<span class="tc-seal__disc">
		<span class="tc-seal__body">ISO</span>
		<span class="tc-seal__number">{number}</span>
	</span>
</span>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	// Proportions on a 72-unit disc.
	@function s($n) {
		@return calc(var(--seal) * #{$n} / 72);
	}

	.tc-seal {
		--_ink: var(--accent-ink);

		position: relative;
		display: block;
		flex: none;
		width: var(--seal);
		height: var(--seal);
	}

	.tc-seal__ribbon {
		position: absolute;
		top: s(50);
		left: 50%;
		display: block;
		width: s(44);
		max-width: none;
		height: s(40);
		transform: translateX(-50%);
		overflow: visible;
	}

	.tc-seal__band {
		fill: var(--_ink);
	}

	.tc-seal__fold {
		fill: color-mix(in srgb, var(--_ink) 82%, #000);
	}

	.tc-seal__disc {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--color-bg-surface);
		box-shadow:
			0 1px 2px rgba(var(--color-shadow-ui-rgb), 0.1),
			0 s(6) s(14) s(-6) rgba(var(--color-shadow-ui-rgb), 0.22);

		&::before {
			content: '';
			position: absolute;
			inset: s(4);
			border: max(1px, #{s(1.5)}) solid color-mix(in srgb, var(--color-text) 14%, transparent);
			border-radius: 50%;
		}
	}

	.tc-seal__body {
		margin-right: -0.14em;
		font-size: s(14);
		font-weight: $font-weight-bold;
		line-height: s(16);
		letter-spacing: 0.14em;
		color: var(--_ink);
	}

	.tc-seal__number {
		font-size: s(18);
		font-weight: $font-weight-medium;
		line-height: s(22);
		font-variant-numeric: tabular-nums;
		color: var(--color-text);
	}
</style>
