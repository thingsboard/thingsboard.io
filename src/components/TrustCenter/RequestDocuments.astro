---
import { REQUEST_GROUPS } from '@data/trust-center/documents';
import { NDA_NOTE } from '@data/trust-center/forms';

/**
 * The document request's NDA checklist. `ContactForm` validates it; this clears the error once a box is
 * ticked.
 */

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<fieldset class:list={['tc-request-docs', className]} data-request-docs aria-describedby="cf-docs-hint">
	<legend class="ui-field__label tc-request-docs__legend">Documents you need</legend>
	<p class="tc-request-docs__hint" id="cf-docs-hint">
		{NDA_NOTE}
	</p>
	<div class="tc-request-docs__groups">
		{REQUEST_GROUPS.map((group, g) => (
			<div class="tc-request-docs__group" role="group" aria-labelledby={`cf-docs-g${g}`}>
				<p class="tc-request-docs__group-title" id={`cf-docs-g${g}`}>
					{group.name}
				</p>
				<ul class="tc-checks">
					{group.docs.map((d) => (
						<li>
							<label class="tc-check">
								<input type="checkbox" name="documents" value={d.value} data-label={d.label} />
								<span>{d.label}</span>
							</label>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
	<p class="ui-field__error" hidden></p>
</fieldset>

<script>
	document.querySelectorAll<HTMLFieldSetElement>('[data-request-docs]').forEach((field) => {
		const boxes = [...field.querySelectorAll<HTMLInputElement>('input[name="documents"]')];
		const error = field.querySelector<HTMLElement>('.ui-field__error');

		const sync = () => {
			if (error && boxes.some((b) => b.checked)) {
				error.hidden = true;
				field.removeAttribute('aria-invalid');
			}
		};

		field.addEventListener('change', sync);
		// Dispatched by ContactForm after it ticks boxes from the URL or a resend.
		field.addEventListener('docs:sync', sync);
		sync();
	});
</script>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-checks {
		display: grid;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tc-check {
		@include type-body;

		display: flex;
		align-items: flex-start;
		gap: $spacing-2;
		color: var(--color-text);
		cursor: pointer;

		input {
			flex: none;
			width: 18px;
			height: 18px;
			margin: 3px 0 0;
			accent-color: var(--accent-fill);
		}
	}

	.tc-request-docs {
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;

		&[aria-invalid='true'] .tc-request-docs__groups {
			outline: 2px solid var(--color-danger);
			outline-offset: 8px;
			border-radius: $radius-sm;
		}

		.ui-field__error {
			margin-top: $spacing-3;
		}
	}

	.tc-request-docs__legend {
		padding: 0;
	}

	.tc-request-docs__hint {
		@include type-small;

		margin: 2px 0 $spacing-4;
		color: var(--color-text-secondary);
	}

	.tc-request-docs__groups {
		columns: 2;
		column-gap: $spacing-6;

		@include media-down(md) {
			columns: 1;
		}
	}

	.tc-request-docs__group {
		break-inside: avoid;
		margin-bottom: $spacing-5;

		.tc-check {
			@include type-small;

			input {
				margin-top: 1px;
			}
		}
	}

	.tc-request-docs__group-title {
		@include type-eyebrow;

		margin: 0 0 $spacing-2;
		color: var(--color-text-secondary);
	}
</style>
