---
import DataTable from '@components/DataTable.astro';
import DataTableValue from '@components/DataTableValue.astro';
import Mark from '@components/ui/Mark.astro';
import type { DataTableColumn } from '@models/data-table';
import type { ComparisonColumn, ComparisonGroup } from '@models/product-comparison';

/**
 * A grouped comparison table with a sticky header; below 880px each row stacks. Every cell carries its
 * column name as real text, since a reflowed table loses its table semantics.
 */
interface Props {
	caption: string;
	/** The row labels' column heading, for screen readers only. */
	firstLabel: string;
	columns: readonly ComparisonColumn[];
	groups: ComparisonGroup[];
}

const { caption, firstLabel, columns, groups } = Astro.props;

for (const group of groups) {
	for (const row of group.rows) {
		if (row.values.length !== columns.length) {
			throw new Error(
				`CompareTable "${caption}": row "${row.label}" has ${row.values.length} cell(s), expected ${columns.length}`
			);
		}
	}
}

const tableColumns: DataTableColumn[] = [
	{ srLabel: firstLabel, thClass: 'tc-compare__label-head' },
	...columns.map((column) => ({ label: column.name, icon: column.icon })),
];
---

<DataTable caption={caption} columns={tableColumns} colgroup={false} class="tc-compare">
	{groups.map((group) => (
		<>
			{group.label && (
				<tr class="tc-compare__group">
					{/* One tbody scopes nothing, so each row header repeats the group's name for screen readers. */}
					<th colspan={columns.length + 1}>
						<span class="tc-compare__group-title">
							{group.mark && <Mark size={36} icon={group.mark.icon} accent={group.mark.color} />}
							{group.label}
						</span>
					</th>
				</tr>
			)}
			{group.rows.map((row) => (
				<tr>
					<th scope="row">
						{row.label}
						{group.label && <span class="ui-sr">{`, ${group.label}`}</span>}
					</th>
					{row.values.map((cell, i) => (
						<td class:list={[cell.kind === 'no' && 'tc-compare__none']}>
							<span class="tc-compare__cell-label">{columns[i].name}</span>
							{cell.kind === 'no' ? (
								<>
									<DataTableValue value={false} noText="Not included" />
									<span aria-hidden="true">—</span>
								</>
							) : (
								<DataTableValue value={cell.value} />
							)}
						</td>
					))}
				</tr>
			))}
		</>
	))}
</DataTable>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// Global, nested under `.tc-compare`: scoped rules cannot match the shell DataTable renders.
	.tc-compare {
		width: 100%;
		// `separate`: a collapsed table ignores cell border-radius, which draws the header pill's ends.
		border-collapse: separate;
		border-spacing: 0;
		text-align: left;

		thead th {
			@include type-body;

			position: sticky;
			top: calc(var(--header-height) + #{$spacing-2});
			z-index: 1;
			padding: $spacing-3 $spacing-4;
			background-color: color-mix(in srgb, var(--accent-fill) 9%, #fff);
			box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
			font-weight: $font-weight-medium;
			color: var(--color-text);

			// Above its neighbour, whose shadow would otherwise draw a seam down this edge.
			&:nth-child(2) {
				z-index: 2;
				border-top-left-radius: $radius-full;
				border-bottom-left-radius: $radius-full;
			}

			&:last-child {
				border-top-right-radius: $radius-full;
				border-bottom-right-radius: $radius-full;
			}

			// Ink, not fill: the fill fails contrast as text here.
			&:not(:first-child) {
				color: var(--accent-ink);
			}
		}

		thead th.tc-compare__label-head {
			background: none;
			box-shadow: none;
		}

		.dt-col {
			display: inline-flex;
			align-items: center;
			gap: $spacing-2;
		}

		.dt-col__mark {
			flex: none;
			width: 24px;
			height: 24px;
		}

		tbody th[scope='row'] {
			@include type-body;

			width: 30%;
			padding: $spacing-3 $spacing-4;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary);
			vertical-align: top;
		}

		td {
			@include type-body;

			padding: $spacing-3 $spacing-4;
			color: var(--color-text-secondary);
			vertical-align: top;
			text-wrap: pretty;
		}

		// On the cells: a `separate` table draws no row borders.
		tbody tr:not(.tc-compare__group) > * {
			border-bottom: 1px solid var(--color-border);
		}

		.tc-compare__group th {
			@include type-tile-lg;

			padding: $spacing-8 $spacing-4 $spacing-3;
			color: var(--color-text);
		}

		.tc-compare__group-title {
			display: inline-flex;
			align-items: center;
			gap: $spacing-3;
			text-wrap: balance;
		}

		.tc-compare__cell-label {
			display: none;
		}

		.tc-compare__none {
			color: rgba(15, 23, 42, 0.4);
		}
	}

	@media (max-width: 879px) {
		.tc-compare {
			display: block;

			thead {
				display: none;
			}

			tbody,
			tr,
			th,
			td {
				display: block;
				width: auto;
			}

			tbody th[scope='row'] {
				width: auto;
				padding: 0 0 $spacing-2;
				font-weight: $font-weight-bold;
				color: var(--color-text);
			}

			tbody tr:not(.tc-compare__group) {
				padding: $spacing-4 0;
				border-bottom: 1px solid var(--color-border);

				> * {
					border-bottom: 0;
				}
			}

			// 7em fits the longest column name, "Private Cloud".
			// `anywhere`: a hostname such as status.eu.thingsboard.cloud is one word wider than the column at 320px.
			td {
				display: grid;
				grid-template-columns: 7em minmax(0, 1fr);
				gap: $spacing-3;
				padding: $spacing-1 0;
				overflow-wrap: anywhere;
			}

			.tc-compare__cell-label {
				display: block;
				font-weight: $font-weight-medium;
				color: var(--accent-ink);
			}

			.tc-compare__group th {
				padding: $spacing-8 0 $spacing-2;
			}
		}
	}

	// Overrides CompareTable: no rule under the last row, values in the body's ink.
	.tc-page .tc-compare tbody tr:last-child {
		border-bottom: 0;

		> * {
			border-bottom: 0;
		}
	}

	.tc-page .tc-compare td:not(.tc-compare__none) {
		color: var(--color-text);
	}

	@media print {
		.tc-compare tbody tr {
			break-inside: avoid;
		}

		.tc-compare__group {
			break-after: avoid;
		}
	}
</style>
