---
import { Icon } from 'astro-icon/components';
import Link from '@components/ui/Link.astro';
import DocItem from '@components/TrustCenter/DocItem.astro';
import DocSearch from '@components/TrustCenter/DocSearch.astro';
import { HUB_GROUPS, LIBRARY_DOCS, docActions, docHref } from '@data/trust-center/documents';
import { tc } from '@data/trust-center/nav';

/** The hub's documents by group, public ones first, with a search that opens the Documents page. */
---

<DocSearch />
<div class="tc-docgroups">
	{HUB_GROUPS.map((group) => (
		<section>
			<h3 class="tc-docgroup__title">
				<Icon name={group.icon} class="tc-docgroup__icon" aria-hidden="true" />
				{group.name}
			</h3>
			<ul class="tc-doclist">
				{group.docs.map((d) => (
					<DocItem name={d.name} href={docHref(d)} access={d.access} actions={docActions(d)} />
				))}
			</ul>
		</section>
	))}
</div>
<Link href={tc('documents')} class="tc-docgroups__all">
	All {LIBRARY_DOCS.length} documents
</Link>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-docgroups {
		display: grid;
		gap: $spacing-8 $spacing-10;

		@include media-up(md) {
			grid-template-columns: 1fr 1fr;
		}
	}

	.tc-docgroup__title {
		@include type-tile;

		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin-bottom: $spacing-4;
		color: var(--color-text);
		text-wrap: balance;
	}

	// A block of its own under the groups: the standalone link is inline-flex.
	.ui-link.tc-docgroups__all {
		display: flex;
		width: fit-content;
		margin-top: $spacing-5;
	}

	.tc-docgroup__icon {
		flex: none;
		width: 28px;
		height: 28px;
	}
</style>
