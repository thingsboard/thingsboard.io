---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';

/** A Copy button, run by `initCopyButtons` (`@util/copy-button`). */

interface Props {
	/** Screen-reader suffix: "the address" reads "Copy the address". */
	what: string;
	/** The text to copy, or the id of the element whose text to copy. */
	text?: string;
	from?: string;
	size?: 'xs' | 'sm';
}

const { what, text, from, size = 'sm' } = Astro.props;
---

<Button
	variant="tertiary"
	size={size}
	srSuffix={what}
	class="tc-copy"
	attrs={{ 'data-copy': text, 'data-copy-from': from }}
>
	<Icon name="tabler:copy" class="ui-btn__icon tc-copy__icon" aria-hidden="true" />
	<Icon name="tabler:circle-check-filled" class="ui-btn__icon tc-copy__done" aria-hidden="true" />
	<span data-copy-label>Copy</span>
</Button>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	// Wide enough for "Copied", so the row doesn't shift.
	.ui-btn.ui-btn--tertiary.tc-copy {
		--btn-label: var(--color-text);

		flex: none;
		min-width: 112px;

		@include media-down(md) {
			min-width: 100px;
		}

		.tc-copy__done {
			display: none;
		}

		&[data-copied] {
			--btn-label: var(--color-success);

			.tc-copy__icon {
				display: none;
			}

			.tc-copy__done {
				display: inline-block;
			}
		}
	}

	@media print {
		.ui-btn.ui-btn--tertiary.tc-copy {
			display: none;
		}
	}
</style>
