---
import DataTable from '@components/DataTable.astro';
import CopyButton from '@components/TrustCenter/CopyButton.astro';
import type { Fact } from '@data/trust-center/compliance';

/**
 * A two-column label/text table with a hidden header. Rows come from `rows`, after any `<tr>`s in
 * the slot (a value that needs markup); a row with `copy` gets a Copy button (run by `initCopyButtons`).
 */

interface Props {
	caption: string;
	rows?: Fact[];
}

const { caption, rows = [] } = Astro.props;
---

<DataTable
	caption={caption}
	columns={[{ srLabel: 'Topic' }, { srLabel: 'Details' }]}
	colgroup={false}
	headerHidden
	class="tc-facts"
>
	<slot />
	{rows.map((row) => (
		<tr>
			<th scope="row">{row.label}</th>
			{row.copy ? (
				<td>
					<span class="tc-facts__copy-row">
						<span class="tc-facts__copy-value" set:html={row.html} />
						<CopyButton what={`${row.label} ${row.copy}`} text={row.copy} size="xs" />
					</span>
				</td>
			) : (
				<td set:html={row.html} />
			)}
		</tr>
	))}
</DataTable>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-facts {
		@include type-body;

		width: 100%;
		border-collapse: collapse;
		text-align: left;

		@include media-up(lg) {
			width: min(100%, var(--tc-main));
		}

		tbody tr {
			border-bottom: 1px solid var(--color-border-light);
		}

		tbody tr:first-child > * {
			padding-top: 0;
		}

		tbody tr:last-child {
			border-bottom: 0;
		}

		// `width: 1%` with `nowrap`: the label column shrinks to its longest label.
		th[scope='row'] {
			width: 1%;
			padding: $spacing-3 $spacing-6 $spacing-3 0;
			white-space: nowrap;
			vertical-align: top;
			font-weight: $font-weight-bold;
			color: var(--color-text);
		}

		td {
			padding: $spacing-3 0;
			vertical-align: top;
			color: var(--color-text);
			text-wrap: pretty;
		}

		@include media-down(sm) {
			th[scope='row'],
			td {
				display: block;
				width: auto;
			}

			th[scope='row'] {
				padding-bottom: 2px;
				white-space: normal;
			}

			td {
				padding-top: 0;
			}
		}
	}

	// The label centred on the 32px badge: (32 - 24) / 2.
	.tc-facts tr:has(.tc-badge) th[scope='row'] {
		padding-top: calc(#{$spacing-3} + 4px);
	}

	.tc-facts tbody tr:first-child:has(.tc-badge) th[scope='row'] {
		padding-top: 4px;
	}

	.tc-facts__copy-row {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2 $spacing-3;
	}

	.tc-facts__copy-value {
		font-variant-numeric: tabular-nums;
	}

	@media print {
		.tc-facts tr {
			break-inside: avoid;
		}
	}
</style>
