---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Band from '@components/ui/Band.astro';
import Closing from '@components/TrustCenter/Closing.astro';
import Intro from '@components/TrustCenter/Intro.astro';
import ReadNext from '@components/TrustCenter/ReadNext.astro';
import { crumbsFor, keepReading, pageAt, type TcPage } from '@data/trust-center/pages';
import './trust-center.scss';

/**
 * Layout for every Trust Center page except the forms: hero, content, "Read next" and the closing band.
 * The h1 and the breadcrumb come from the page registry (`@data/trust-center/pages`), found by the
 * page's address; the hub, which isn't in it, passes its title and has no breadcrumb.
 * `noIndex` until the facts are signed off.
 */

interface Props {
	/** Default: the registry's title for this address. */
	title?: string;
	lede?: string;
	eyebrow?: string;
	description?: string;
	wave?: boolean;
	/** The hero's colour, a `tc-hero--<family>` class in `trust-center.scss`. */
	family?: 'security' | 'onprem' | 'deployment';
	/** Overrides the computed "Read next"; `[]` hides it. */
	next?: TcPage[];
}

const { lede, eyebrow, description, wave = false, family, next } = Astro.props;
const page = pageAt(Astro.url.pathname);
const title = Astro.props.title ?? page?.title;
if (!title) throw new Error(`TrustCenterLayout: no title for ${Astro.url.pathname}`);
const crumbs = page && crumbsFor(page);
const pageTitle = page ? `${title} · Trust Center` : title;
const hasVisual = Astro.slots.has('visual');

// Rendered first so "Read next" can skip pages the content already links to.
const body = await Astro.slots.render('default');
const linked = new Set([...body.matchAll(/href="(\/[^"#?]*)/g)].map((m) => m[1]));
const reading = next ?? keepReading(page, linked);
---

<BaseLayout forceLightTheme noIndex title={pageTitle} description={description}>
	<Band as="div" ground="fade" wave={wave} class:list={['tc-hero', family && `tc-hero--${family}`]}>
		<header class:list={['tc-hero__inner', hasVisual && 'tc-hero__inner--visual']}>
			<div class="tc-hero__text">
				{crumbs && <Breadcrumbs items={crumbs} wrap />}
				<Intro title={title} lede={lede} eyebrow={eyebrow} ledeMeasure="wide" />
				{Astro.slots.has('actions') && (
					<div class="tc-hero__actions">
						<slot name="actions" />
					</div>
				)}
			</div>
			{hasVisual && (
				<div class="tc-hero__visual">
					<slot name="visual" />
				</div>
			)}
		</header>
	</Band>
	<div class="tc-page">
		<Fragment set:html={body} />
		{reading.length > 0 && <ReadNext pages={reading} />}
	</div>
	<Closing />
</BaseLayout>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	// Clips the band's wave field to the band.
	.ui-band.tc-hero {
		overflow: hidden;
	}

	.tc-hero__inner {
		display: grid;
		gap: $spacing-8;
		align-items: center;

		@include media-up(md) {
			&--visual {
				grid-template-columns: minmax(0, 1fr) auto;
			}
		}

		@include media-up(lg) {
			&--visual {
				grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
				gap: $spacing-12;
			}
		}
	}

	.tc-hero__text {
		display: grid;
		min-width: 0;
	}

	// Element specificity, so the hero's parts (Intro's, a page's slot) set their own margins.
	:where(.tc-hero__text) :is(p, ul, ol, h1) {
		margin: 0;
	}

	.tc-hero .breadcrumbs {
		margin-bottom: $spacing-3;
	}

	.tc-hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-3;
		margin-top: $spacing-8;
	}

	.tc-hero__note {
		@include type-small;

		display: flex;
		flex-basis: 100%;
		align-items: center;
		gap: $spacing-2;
		margin-top: $spacing-3;
		color: var(--color-text-secondary);

		svg {
			flex: none;
			width: 18px;
			height: 18px;
		}
	}

	.tc-hero__visual {
		min-width: 0;
	}
</style>
