---
import { Icon } from 'astro-icon/components';
import type { TcPage } from '@data/trust-center/pages';

/** "Read next" at a page's foot: link rows to the next pages. */

interface Props {
	pages: TcPage[];
}

const { pages } = Astro.props;
// The chevron is kept with the title's last word so it never wraps onto a line alone.
const words = (title: string) => title.split(' ');
const head = (title: string) => words(title).slice(0, -1).join(' ');
const last = (title: string) => words(title).at(-1);
---

<section class="tc-section tc-read-next" aria-labelledby="tc-read-next-title">
	<h2 class="tc-read-next__heading" id="tc-read-next-title">
		Read next
	</h2>
	<ul class="tc-read-next__list" style={`--tc-next-count: ${pages.length}`}>
		{pages.map((p) => (
			<li>
				<a class="tc-read-next__link" href={p.href}>
					<Icon name={p.icon} class="tc-read-next__icon" aria-hidden="true" />
					<span class="tc-read-next__title">
						{head(p.title)}
						<span class="tc-read-next__last">
							{last(p.title)}
							<Icon name="tabler:chevron-right" class="tc-read-next__chevron" aria-hidden="true" />
						</span>
					</span>
					<span class="tc-read-next__line">{p.line}</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-read-next__heading {
		@include type-tile-lg;

		margin-bottom: $spacing-5;
		color: var(--color-text);
		text-wrap: balance;
	}

	.tc-read-next {
		padding-top: $spacing-8;
		border-top: 1px solid var(--color-border-light);
	}

	.tc-read-next__list {
		display: grid;
		padding: 0;
		list-style: none;

		> li + li {
			margin-top: $spacing-4;
			padding-top: $spacing-4;
			border-top: 1px solid var(--color-border-light);
		}

		@include media-up(md) {
			grid-template-columns: repeat(var(--tc-next-count, 2), minmax(0, 1fr));

			> li + li {
				margin-top: 0;
				padding-top: 0;
				padding-inline-start: $spacing-6;
				border-top: 0;
				border-inline-start: 1px solid var(--color-border-light);
			}

			> li:not(:last-child) {
				padding-inline-end: $spacing-6;
			}
		}
	}

	.tc-read-next__link {
		display: grid;
		grid-template-columns: 20px minmax(0, 1fr);
		column-gap: $spacing-3;
		align-items: start;
		color: var(--color-text);
		text-decoration: none;
		border-radius: $radius-md;

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 4px;
		}

		@media (hover: hover) {
			&:hover .tc-read-next__title {
				color: var(--accent-ink);
				text-decoration-line: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}
		}
	}

	// Centred on the title's first line (`type-action`: $font-size-lg at 1.5).
	.tc-read-next__icon {
		width: 20px;
		height: 20px;
		margin-top: calc((#{$font-size-lg} * 1.5 - 20px) / 2);
		color: var(--accent-ink);
	}

	.tc-read-next__title {
		@include type-action;

		text-wrap: balance;
		transition: color 0.15s ease;
	}

	.tc-read-next__last {
		white-space: nowrap;
	}

	.tc-read-next__chevron {
		width: 18px;
		height: 18px;
		margin-inline-start: -1px;
		vertical-align: middle;
	}

	.tc-read-next__line {
		@include type-small;

		grid-column: 2;
		margin-top: 2px;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	@media print {
		.tc-read-next {
			display: none;
		}
	}
</style>
