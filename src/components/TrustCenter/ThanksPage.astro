---
import BaseLayout from '@layouts/BaseLayout.astro';
import WaveBackground from '@components/Landing/WaveBackground.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import Intro from '@components/TrustCenter/Intro.astro';
import './trust-center.scss';

/**
 * The Trust Center forms' thank-you layout. The page's `script` slot rewrites the `data-thanks` parts from
 * what the form stored. Always `noIndex`: it only makes sense after a submit.
 */

interface Props {
	metaTitle: string;
	description: string;
	eyebrow: string;
	title: string;
	lede: string;
	back: { href: string; label: string };
}

const { metaTitle, description, eyebrow, title, lede, back } = Astro.props;
---

<BaseLayout forceLightTheme noIndex title={metaTitle} description={description}>
	<WaveBackground />
	<div class="tc-thanks">
		<Card as="section" role="panel" pad="xl" class="tc-thanks__card" attrs={{ 'aria-labelledby': 'tc-thanks-title' }}>
			<div class="tc-thanks__intro" data-accent="onprem">
				<Mark size={64} icon="tabler:check" lift class="tc-thanks__mark" />
				<Intro
					center
					eyebrow={eyebrow}
					title={title}
					lede={lede}
					ledeMeasure="narrow"
					titleId="tc-thanks-title"
					partAttrs={{
						eyebrow: { 'data-thanks': 'eyebrow' },
						title: { 'data-thanks': 'title' },
						lede: { 'data-thanks': 'lede' },
					}}
				/>
			</div>
			<slot />
			<p class="tc-thanks__fix" data-thanks="fix" hidden>
				Wrong address, or forgot something?{' '}
				<Link variant="inline" href="#" attrs={{ 'data-thanks': 'fix-link' }}>
					Edit and send again
				</Link>
			</p>
		</Card>

		<Link class="tc-thanks__back" href={back.href} dir="back" tone="muted">
			{back.label}
		</Link>
	</div>
	<slot name="script" />
</BaseLayout>

<style lang="scss" is:global>
	body:has(.tc-thanks) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	.tc-thanks {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: $home-measure;
		margin: 0 auto;
		padding: $spacing-12 $spacing-5 $spacing-20;

		@include media-down(md) {
			padding: $spacing-8 $spacing-4 $spacing-16;
		}

		:where(p, h2, ul, ol) {
			margin: 0;
		}
	}

	.tc-thanks__card {
		width: 100%;
		max-width: 620px;
		text-align: center;
	}

	.tc-thanks__intro :global(.tc-thanks__mark) {
		margin-bottom: $spacing-6;
		animation: tc-thanks-pop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes tc-thanks-pop {
		from {
			transform: scale(0.6);
			opacity: 0;
		}
	}

	.tc-thanks__intro {
		:global(.tc-intro__title) {
			margin-bottom: $spacing-4;
		}

		:global(.tc-intro__lede) {
			overflow-wrap: anywhere;
		}

		:global(.tc-intro__lede strong) {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}
	}

	.tc-thanks__fix {
		@include type-small;
		margin-top: $spacing-6;
		color: var(--color-text-secondary);
	}

	.tc-thanks :global(.tc-thanks__back) {
		margin-top: $spacing-10;
	}
</style>
