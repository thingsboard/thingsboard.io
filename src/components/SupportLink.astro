---
/**
 * SupportLink — a "contact support" link that carries the license error code with it.
 *
 * The contact form prefills its subject and message from the query string
 * (`ContactForm.astro` → `prefillFromURL`), so the ticket arrives already stating which
 * error the user hit. That removes the round-trip where support has to ask for the code,
 * which is the slowest part of a license ticket.
 *
 * `Technical Support` must stay one of the option values of the form's subject `<select>`,
 * otherwise the prefill silently leaves the field empty.
 *
 * Usage:
 *   <SupportLink code="SUBSCRIPTION_NOT_FOUND (102)" />                   → "contact support"
 *   <SupportLink code="SUBSCRIPTION_NOT_FOUND (102)">Contact support</SupportLink>
 */
interface Props {
	/** Error code exactly as it appears in the log, e.g. `SUBSCRIPTION_NOT_FOUND (102)`. */
	code: string;
}

const { code } = Astro.props;

const SUPPORT_SUBJECT = 'Technical Support';

const href =
	`/contact-us/?subject=${encodeURIComponent(SUPPORT_SUBJECT)}` +
	`&message=${encodeURIComponent(`License Error: ${code}`)}`;
---

<a href={href}><slot>contact support</slot></a>
