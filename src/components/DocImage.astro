---
import { getImage } from 'astro:assets';
import { prepareInteractiveSvg, rasterLoaders, svgRawLoaders, svgUrls } from '@util/asset-modules';
import { claimFirstContentImage } from '@util/first-content-image';
import { getDocsPrefix, Products } from '~/models/site.models';

interface Props {
	src: string;
	alt: string;
	width?: number | string;
	align?: 'left' | 'center' | 'right';
	/**
	 * Product context for inlined interactive SVGs. When provided, every
	 * `/docs/…` link inside the SVG is rewritten to `/docs/{prefix}…` so the
	 * same diagram works correctly across CE/PE/PaaS/Edge/etc. SVGs on disk
	 * carry CE paths as the source of truth (validated by lint-linkcheck).
	 */
	product?: Products;
}

const { src, alt, width, align = 'center', product } = Astro.props;

// First content image on the page is the likely LCP element — load it
// eagerly; everything after stays lazy. Deliberately no fetchpriority boost:
// on text-first pages the first image can sit far below the fold, where a
// high-priority fetch would compete with the resources painting the fold.
const isFirst = claimFirstContentImage(Astro.locals);
const loading = isFirst ? 'eager' : 'lazy';

const numericWidth = typeof width === 'number' ? width : undefined;
const styleWidth = typeof width === 'string' ? width : undefined;

const styles: string[] = [];
if (styleWidth) styles.push(`max-width: ${styleWidth}`);
if (align !== 'center') styles.push(`text-align: ${align}`);
if (styleWidth && align === 'right') styles.push('margin-inline: auto 0');
else if (styleWidth && align === 'center') styles.push('margin-inline: auto');
const figureStyle = styles.length ? styles.join('; ') : undefined;

const raster = await rasterLoaders[src]?.();
const assetUrl = raster?.src ?? svgUrls[src];
const isSvg = src.endsWith('.svg');
const isGif = src.endsWith('.gif');
let interactiveSvg = isSvg ? prepareInteractiveSvg(await svgRawLoaders[src]?.(), alt) : undefined;

// Rewrite hrefs for the current product so inline diagrams navigate within
// the same product context (CE → PE/PaaS/etc). SVG source stays CE-based.
if (interactiveSvg && product && product !== Products.CE) {
	const prefix = getDocsPrefix(product);
	interactiveSvg = interactiveSvg.replace(
		/((?:xlink:)?href=")\/docs\//g,
		`$1/docs/${prefix}`
	);
}

// GIFs bypass Sharp: it reads all frames (`pages: -1`) and trips
// `limitInputPixels` on large multi-frame GIFs.
const optimized =
	raster && !isGif
		? await getImage({
				src: raster,
				...(numericWidth ? { width: numericWidth } : {}),
				format: 'webp',
				quality: 85,
			})
		: null;
---

<figure
	class="doc-image"
	class:list={{ 'doc-image--inline-svg': !!interactiveSvg }}
	style={figureStyle}
>
	{
		interactiveSvg ? (
			<Fragment set:html={interactiveSvg} />
		) : optimized ? (
			<img
				src={optimized.src}
				alt={alt}
				width={optimized.attributes.width}
				height={optimized.attributes.height}
				loading={loading}
				decoding="async"
			/>
		) : assetUrl ? (
			<img src={assetUrl} alt={alt} width={numericWidth} loading={loading} decoding="async" />
		) : (
			<img src={src} alt={alt} width={numericWidth} loading={loading} decoding="async" />
		)
	}
</figure>

<style>
	.doc-image {
		margin: 1.5rem 0;
		text-align: center;
	}

	.doc-image img {
		max-width: 100%;
		height: auto;
		border-radius: 6px;
	}

	/* Inlined interactive SVGs (set:html content is not Astro-scoped). */
	.doc-image--inline-svg :global(svg) {
		max-width: 100%;
		height: auto;
		border-radius: 6px;
	}

	:global(.doc-image-row) {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		margin: 1.5rem 0;
	}

	:global(.doc-image-row) .doc-image {
		flex: 1;
		min-width: 0;
		margin: 0;
	}

	@media (max-width: 640px) {
		:global(.doc-image-row) {
			flex-direction: column;
		}

		:global(.doc-image-row) .doc-image {
			max-width: 100% !important;
		}
	}

	/* Print: keep a figure and its caption on one sheet. */
	@media print {
		.doc-image {
			break-inside: avoid;
		}
	}
</style>
