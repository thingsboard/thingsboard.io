---
/**
 * The kit's white card: a TILE sits in a grid, a PANEL stands alone. With `href` the title's link is
 * stretched over the whole card; controls inside sit above it. `--card-title-hover` sets the title's
 * hover colour on a link card.
 *
 * Its edge is a shadow on a tinted ground, a line on white.
 */
import '@styles/ui-kit.scss';

interface Props {
	role?: 'tile' | 'panel';
	/** Default by role: tile md, panel lg. */
	pad?: 'md' | 'lg' | 'xl';
	/** The whole card is the link. Needs `title`. */
	href?: string;
	title?: string;
	/** The title's heading level. */
	level?: 2 | 3 | 4;
	as?: 'div' | 'li' | 'section' | 'form';
	/** Default: shadow. */
	edge?: 'shadow' | 'line';
	class?: string;
	attrs?: Record<string, string | undefined>;
}

const {
	role = 'tile',
	href,
	title,
	level = 3,
	as: Tag = 'div',
	edge = 'shadow',
	class: className,
	attrs = {},
} = Astro.props;
const Heading = `h${level}` as const;
const pad = Astro.props.pad ?? (role === 'panel' ? 'lg' : 'md');
if (href && title === undefined) throw new Error('ui/Card: a link card needs a title, the link is on it.');
---

<Tag
	class:list={[
		'ui-card',
		`ui-card--${role}`,
		`ui-card--pad-${pad}`,
		edge === 'line' && 'ui-card--line',
		href && 'ui-card--link',
		className,
	]}
	{...attrs}
>
	<slot name="mark" />
	{title !== undefined && (
		<Heading class="ui-card__title">
			{href ? (
				<a class="ui-card__link" href={href}>
					{title}
				</a>
			) : (
				title
			)}
		</Heading>
	)}
	<slot />
	{Astro.slots.has('footer') && (
		<div class="ui-card__footer">
			<slot name="footer" />
		</div>
	)}
</Tag>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	.ui-card {
		position: relative;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		min-width: 0;
		background-color: var(--color-bg-surface);
		color: var(--color-text);

		&[hidden] {
			display: none;
		}

		// Forced colours drop shadows: a border keeps the card's edge.
		@media (forced-colors: active) {
			border: 1px solid CanvasText;
		}
	}

	.ui-card--tile {
		border-radius: $radius-lg;
		box-shadow: var(--elev-tile);
	}

	.ui-card--panel {
		border-radius: $radius-xl;
		box-shadow: var(--elev-panel);
	}

	.ui-card--pad-md {
		padding: $spacing-5;
	}

	.ui-card--pad-lg {
		padding: $spacing-8;

		@include media-down(md) {
			padding: $spacing-6 $spacing-5;
		}
	}

	.ui-card--pad-xl {
		padding: $spacing-12 $spacing-10;

		@include media-down(md) {
			padding: $spacing-8 $spacing-5;
		}
	}

	.ui-card__title {
		@include type-tile;
		margin: 0;
		color: inherit;
		text-wrap: balance;
	}

	.ui-card__footer {
		margin-top: auto;
	}

	.ui-card__link {
		color: inherit;
		text-decoration: none;
		text-underline-offset: 3px;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: inherit;
		}

		// Without `:has` the ring stays on the title; with it, it goes round the card (below).
		@include focus-ring(2px);

		@supports selector(:has(*)) {
			&:focus-visible {
				outline: none;
			}
		}
	}

	.ui-card--link {
		:where(a:not(.ui-card__link), button) {
			position: relative;
			z-index: 1;
		}

		@media (hover: hover) {
			&:hover .ui-card__title {
				color: var(--card-title-hover, var(--accent-ink));
			}
		}

		&:active {
			.ui-card__link {
				text-decoration-line: underline;
				text-decoration-thickness: 2px;
			}
		}

		&:has(.ui-card__link:focus-visible) {
			outline: 2px solid var(--focus-ring);
			outline-offset: 3px;
		}
	}

	.ui-card--link:not(.ui-card--panel) {
		transition: box-shadow 0.2s ease;

		@media (hover: hover) {
			&:hover {
				box-shadow: var(--elev-tile-hover);
			}
		}

		&:active {
			box-shadow: var(--elev-tile);
		}
	}

	// On white: a line instead of the shadow. A link tile trades the line for the lifted shadow on hover.
	.ui-card--line {
		border: 1px solid var(--ui-line);
		box-shadow: none;
	}

	.ui-card--line.ui-card--link:not(.ui-card--panel) {
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;

		@media (hover: hover) {
			&:hover {
				border-color: transparent;
				box-shadow: var(--elev-tile), var(--elev-tile-hover);
			}
		}

		&:active {
			border-color: var(--ui-line);
			box-shadow: none;
		}
	}

	@media print {
		.ui-card {
			break-inside: avoid;
		}
	}
</style>
