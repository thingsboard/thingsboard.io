---
/**
 * A full-width band: a ground (tint or fade), a padding step, and the content in the page measure.
 * `wave` lays the wave field over the ground, in `hue`.
 */
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import type { Scheme } from '@util/ui-kit';
import '@styles/ui-kit.scss';

type Pad = 'md' | 'xl';

interface Props {
	as?: 'section' | 'div';
	ground?: 'tint' | 'fade';
	/** The fade's and the wave's colour. Default: the accent fill. */
	hue?: string;
	wave?: boolean;
	pad?: Pad;
	accent?: Scheme;
	class?: string;
	attrs?: Record<string, string | undefined>;
}

const {
	as: Tag = 'section',
	ground = 'tint',
	hue,
	wave = false,
	pad = 'md',
	accent,
	class: className,
	attrs = {},
} = Astro.props;
---

<Tag
	class:list={['ui-band', `ui-band--${ground}`, `ui-band--pad-${pad}`, wave && 'ui-band--wave', className]}
	style={hue ? `--band-hue: ${hue}` : undefined}
	data-accent={accent}
	{...attrs}
>
	{wave && <PricingBackground contained hue="var(--band-hue, var(--accent-fill))" />}
	<div class="ui-band__inner">
		<slot />
	</div>
</Tag>

<style is:global lang="scss">
	@use 'sass:list';
	@use '../../styles/variables' as *;

	.ui-band {
		--_hue: var(--band-hue, var(--accent-fill));

		position: relative;
		box-sizing: border-box;
	}

	.ui-band--tint {
		background-color: var(--band-tint);
	}

	.ui-band--fade {
		background-color: #fff;
		background-image: linear-gradient(to bottom, #fff, color-mix(in srgb, var(--_hue) 10%, #fff));
	}

	// The wave stays in the band's own stacking context, over the ground and under the content.
	.ui-band--wave {
		overflow: hidden;
		isolation: isolate;
	}

	.ui-band__inner {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		width: 100%;
		max-width: $home-measure;
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	// Desktop, then below md.
	$band-pad: (
		md: 64px 48px,
		xl: 96px 64px,
	);

	@each $step, $values in $band-pad {
		.ui-band--pad-#{$step} {
			padding-block: list.nth($values, 1);

			@include media-down(md) {
				padding-block: list.nth($values, 2);
			}
		}
	}
</style>
