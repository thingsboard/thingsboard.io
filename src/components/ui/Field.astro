---
/**
 * A form field: a label, an optional hint, the control and an error line. The hint is `<id>-hint`, the
 * error `<id>-error` and the counter `<id>-count`; `@util/form-validate` finds the last two by id.
 * Required unless `optional`. A kit `Button` of the same size in the `end` slot joins the control.
 */
import '@styles/ui-kit.scss';
import '@styles/ui-field.scss';

interface Props {
	name: string;
	label: string;
	/** Default: the name. */
	id?: string;
	type?: 'text' | 'email' | 'tel' | 'url' | 'textarea';
	/** 44 or 48 tall. */
	size?: 'md' | 'lg';
	optional?: boolean;
	/** A line under the label; the control's `aria-describedby` points at it. */
	hint?: string;
	maxLength?: number;
	/** Shows `n / max` once the text nears `maxLength`. */
	counter?: boolean;
	/** Visually hidden, never absent. */
	labelHidden?: boolean;
	placeholder?: string;
	autocomplete?: string;
	inputmode?: 'text' | 'email' | 'tel' | 'url' | 'numeric' | 'search';
	class?: string;
	/** Extra attributes for the control itself. A `class` here is added to the control's own. */
	attrs?: Record<string, string | undefined>;
}

const {
	name,
	label,
	type = 'text',
	size = 'lg',
	optional = false,
	hint,
	maxLength,
	counter = false,
	labelHidden = false,
	placeholder,
	autocomplete,
	inputmode,
	class: className,
	attrs = {},
} = Astro.props;
const id = Astro.props.id ?? name;
const counted = counter && maxLength !== undefined;
const { class: controlClass, ...controlAttrs } = attrs;

const control = {
	id,
	name,
	class: controlClass ? `ui-field__control ${controlClass}` : 'ui-field__control',
	required: !optional || undefined,
	maxlength: maxLength,
	placeholder,
	autocomplete,
	inputmode,
	'aria-invalid': 'false' as const,
	'aria-describedby': hint ? `${id}-hint` : undefined,
	'data-ui-counter': counted ? '' : undefined,
	...controlAttrs,
};
---

<div class:list={['ui-field', `ui-field--${size}`, className]}>
	<label class:list={['ui-field__label', labelHidden && 'ui-sr']} for={id}>
		{label}
		{optional && <span class="ui-field__optional">(optional)</span>}
	</label>
	{hint && (
		<p class="ui-field__hint" id={`${id}-hint`}>
			{hint}
		</p>
	)}
	<div class="ui-field__row">
		<slot name="start" />
		{type === 'textarea' ? <textarea {...control} rows={4}></textarea> : <input {...control} type={type} />}
		<slot name="end" />
	</div>
	<div class="ui-field__foot">
		<p class="ui-field__error" id={`${id}-error`} hidden />
		{counted && <p class="ui-field__count" id={`${id}-count`} hidden />}
	</div>
</div>

<script>
	import { wireCounter, type FieldControl } from '@util/form-validate';

	document.querySelectorAll<FieldControl>('[data-ui-counter]').forEach(wireCounter);
</script>
