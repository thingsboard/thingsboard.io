---
/** A decorative squircle tile holding a tabler icon. */
import { Icon } from 'astro-icon/components';
import { isScheme, type Accent } from '@util/ui-kit';
import '@styles/ui-kit.scss';

interface Props {
	size: 36 | 40 | 48 | 64;
	fill?: 'solid' | 'white' | 'wash';
	/** A scheme or a CSS colour. Default: the nearest `data-accent`. */
	accent?: Accent;
	icon: string;
	lift?: boolean;
	class?: string;
}

const { size, fill = 'solid', accent, icon, lift = false, class: className } = Astro.props;
// A scheme becomes `data-accent`; a one-off colour sets this mark's own fill and ink.
const accentAttrs = !accent
	? {}
	: isScheme(accent)
		? { 'data-accent': accent }
		: { style: `--mark-fill: ${accent}; --mark-ink: ${accent}` };
---

<span
	class:list={['ui-mark', `ui-mark--${fill}`, `ui-mark--${size}`, lift && 'ui-mark--lift', className]}
	{...accentAttrs}
	aria-hidden="true"
>
	<Icon name={icon} class="ui-mark__glyph" aria-hidden="true" />
</span>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	// Tile size: icon size.
	$mark-ladder: (
		36: 24px,
		40: 24px,
		48: 28px,
		64: 40px,
	);

	.ui-mark {
		--_fill: var(--mark-fill, var(--accent-fill));
		--_ink: var(--mark-ink, var(--accent-ink));

		display: inline-grid;
		flex: none;
		place-items: center;
		box-sizing: border-box;
		width: var(--mark-size);
		height: var(--mark-size);
		border-radius: 32%;
		vertical-align: middle;

		&[hidden] {
			display: none;
		}

		@media (forced-colors: active) {
			outline: 1px solid CanvasText;
			color: CanvasText;
		}
	}

	@each $s, $icon in $mark-ladder {
		.ui-mark--#{$s} {
			--mark-size: #{$s}px;
			--mark-icon: #{$icon};
		}
	}

	.ui-mark__glyph {
		display: block;
		width: var(--mark-icon);
		height: var(--mark-icon);
	}

	// The highlight above the section mark's shade; the glyph fades with a mask, since a currentColor
	// stroke cannot take a gradient.
	.ui-mark--solid {
		background-color: var(--_fill);
		background-image: linear-gradient(
			155deg,
			rgba(255, 255, 255, 0.22) 0%,
			rgba(255, 255, 255, 0) 55%,
			rgba(0, 0, 0, 0.06) 100%
		);
		color: #fff;

		.ui-mark__glyph {
			@include mark-glyph-fade;
		}
	}

	.ui-mark--white {
		background-color: var(--color-bg-surface);
		background-image: linear-gradient(
			155deg,
			var(--color-bg-surface) 35%,
			color-mix(in srgb, var(--_fill) 5%, var(--color-bg-surface)) 100%
		);
		color: var(--_ink);
	}

	.ui-mark--wash {
		background-color: color-mix(in srgb, var(--_fill) 12%, var(--color-bg-surface));
		color: var(--_ink);
	}

	.ui-mark--lift {
		box-shadow: var(--elev-mark);
	}
</style>
