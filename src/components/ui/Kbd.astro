---
/** Key hint. `aria-hidden`, because the control's `aria-keyshortcuts` announces the shortcut. */

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<kbd class:list={['ui-kbd', className]} aria-hidden="true">
	<slot />
</kbd>

<style is:global lang="scss">
	@use '../../styles/kbd' as *;

	.ui-kbd {
		@include ui-kbd;
	}
</style>
