---
/**
 * The kit's link: STANDALONE (a label and a chevron, underlined on hover) or INLINE (in running
 * text, always underlined). An `external` link gets the up-right arrow and opens in a new tab.
 * `wrap` lets a standalone label wrap as text, its trailing glyph held to the last word.
 */
import { Icon } from 'astro-icon/components';
import { newTabAttrs, NEW_TAB_NOTE } from '@util/external-links';
import '@styles/ui-kit.scss';

interface Props {
	href: string;
	variant?: 'standalone' | 'inline';
	/** Standalone only; an inline link takes the text's size. */
	size?: 'sm' | 'md';
	/** accent: the scheme's ink · ink: near-black, accent on hover · muted: grey, ink on hover. */
	tone?: 'accent' | 'ink' | 'muted';
	/** The chevron's direction, or none. */
	dir?: 'forward' | 'back' | 'none';
	external?: boolean;
	/** Standalone only: the label wraps as text; the glyph stays with the last word (plain text only). */
	wrap?: boolean;
	/** Visually hidden text after the label. */
	srSuffix?: string;
	class?: string;
	attrs?: Record<string, string | undefined>;
}

const {
	href,
	variant = 'standalone',
	size = 'md',
	tone = 'accent',
	dir = 'forward',
	external = false,
	wrap = false,
	srSuffix,
	class: className,
	attrs = {},
} = Astro.props;

const standalone = variant === 'standalone';
const wraps = standalone && wrap;
// Inline and wrapping, the words are trimmed: Prettier puts a link's children on their own lines, and
// in running text that line break renders as an underlined space.
const text = (!standalone || wraps) && Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : null;
// Wrapping, the last word goes with the glyph; markup in the label is left whole.
const split = wraps && text && !text.includes('<') ? text.lastIndexOf(' ') : -1;
const chevron = standalone && dir === 'forward' && !external;
// The last word and the glyph, unbreakable when wrapping; otherwise no element at all.
const Tail = split > 0 ? 'span' : Fragment;
const tailAttrs = split > 0 ? { class: 'ui-link__nowrap' } : {};
const newTab = external || attrs.target === '_blank';
---

<a
	href={href}
	class:list={[
		'ui-link',
		`ui-link--${variant}`,
		standalone && `ui-link--${size}`,
		`ui-link--${tone}`,
		standalone && dir === 'back' && 'ui-link--back',
		wraps && 'ui-link--wrap',
		className,
	]}
	{...newTabAttrs(external)}
	{...attrs}
>
	{
		// One expression, so no template whitespace falls between the words and the glyph.
		[
			standalone && dir === 'back' && <Icon name="tabler:chevron-left" class="ui-link__glyph" aria-hidden="true" />,
			text === null ? <slot /> : split > 0 && <Fragment set:html={text.slice(0, split + 1)} />,
			<Tail {...tailAttrs}>
				{[
					text !== null && <Fragment set:html={split > 0 ? text.slice(split + 1) : text} />,
					chevron && <Icon name="tabler:chevron-right" class="ui-link__glyph" aria-hidden="true" />,
					external && (
						<Icon name="tabler:arrow-up-right" class="ui-link__glyph ui-link__glyph--out" aria-hidden="true" />
					),
				]}
			</Tail>,
			srSuffix && <span class="ui-sr">{` ${srSuffix}`}</span>,
			newTab && <span class="ui-sr">{NEW_TAB_NOTE}</span>,
		]
	}
</a>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	.ui-link {
		--_color: var(--accent-ink);
		--_color-hover: var(--accent-ink);

		color: var(--_color);
		text-decoration-line: none;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		border-radius: 2px;
		-webkit-tap-highlight-color: transparent;

		@include focus-ring(2px);

		@media (hover: hover) {
			&:hover {
				color: var(--_color-hover);
			}
		}

		@media (forced-colors: active) {
			color: LinkText;
			text-decoration-line: underline;
		}
	}

	.ui-link--ink {
		--_color: var(--color-text);
	}

	.ui-link--muted {
		--_color: var(--color-text-secondary);
		--_color-hover: var(--color-text);
	}

	.ui-link--standalone {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;

		&[hidden] {
			display: none;
		}

		@media (hover: hover) {
			&:hover {
				text-decoration-line: underline;
			}
		}

		&:focus-visible {
			text-decoration-line: underline;
		}

		&:active {
			text-decoration-line: underline;
			text-decoration-thickness: 2px;
			opacity: 0.75;
		}
	}

	.ui-link--sm {
		@include type-small-strong;
	}

	.ui-link--md {
		@include type-link;
	}

	// The glyph's own side bearing is the gap.
	.ui-link__glyph {
		@include link-chevron;
	}

	.ui-link--back .ui-link__glyph {
		margin-inline: 0 -1px;
	}

	.ui-link__glyph--out {
		width: 1em;
		height: 1em;
		margin-inline-start: 4px;
	}

	// Inline, the arrow sits on the baseline: smaller and lowered to centre on the x-height.
	.ui-link--inline .ui-link__glyph--out {
		width: 0.875em;
		height: 0.875em;
		margin-inline-start: 2px;
		vertical-align: -0.1em;
	}

	// Wrapping: text, not a flex row, so the label wraps; the glyph rides on the last word's baseline.
	.ui-link--standalone.ui-link--wrap {
		display: inline;
		white-space: normal;

		.ui-link__glyph {
			display: inline-block;
			vertical-align: -0.25em;
		}

		.ui-link__glyph--out {
			vertical-align: -0.125em;
		}
	}

	.ui-link__nowrap {
		white-space: nowrap;
	}

	.ui-link--inline {
		text-decoration-line: underline;

		@media (hover: hover) {
			&:hover {
				text-decoration-thickness: 2px;
			}
		}

		&:active {
			text-decoration-thickness: 3px;
			opacity: 0.75;
		}
	}
</style>
