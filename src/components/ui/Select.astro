---
/**
 * A native select in the field's look: the label, the control and a chevron. An option marked
 * `placeholder` shows muted while it is the chosen one. The slot follows the control.
 */
import { Icon } from 'astro-icon/components';
import '@styles/ui-kit.scss';
import '@styles/ui-field.scss';

export interface SelectOption {
	value: string;
	label: string;
	selected?: boolean;
	/** Stands for "nothing chosen yet". */
	placeholder?: boolean;
	/** Data attributes a script reads off the chosen option. */
	attrs?: Record<string, string | undefined>;
}

export interface SelectGroup {
	group: string;
	options: SelectOption[];
}

interface Props {
	name: string;
	label: string;
	/** Default: the name. */
	id?: string;
	options: (SelectOption | SelectGroup)[];
	optional?: boolean;
	/** 44 or 48 tall. */
	size?: 'md' | 'lg';
	/** Visually hidden, never absent. */
	labelHidden?: boolean;
	class?: string;
	/** Extra attributes for the `<select>` itself. */
	attrs?: Record<string, string | undefined>;
}

const {
	name,
	label,
	options,
	optional = false,
	size = 'lg',
	labelHidden = false,
	class: className,
	attrs = {},
} = Astro.props;
const id = Astro.props.id ?? name;
---

<div class:list={['ui-field', `ui-field--${size}`, className]}>
	<label class:list={['ui-field__label', labelHidden && 'ui-sr']} for={id}>
		{label}
		{optional && <span class="ui-field__optional">(optional)</span>}
	</label>
	<div class="ui-field__row ui-select">
		<select class="ui-field__control ui-select__control" id={id} name={name} {...attrs}>
			{/* Used by the in-page list only; ignored elsewhere. */}
			<button><selectedcontent></selectedcontent></button>
			{options.map((item) =>
				'group' in item ? (
					<optgroup label={item.group}>
						{item.options.map((option) => (
							<option value={option.value} selected={option.selected} {...option.attrs}>
								{option.label}
							</option>
						))}
					</optgroup>
				) : (
					<option
						value={item.value}
						selected={item.selected}
						data-placeholder={item.placeholder ? '' : undefined}
						{...item.attrs}
					>
						{item.label}
					</option>
				)
			)}
		</select>
		<Icon name="tabler:chevron-down" class="ui-select__chevron" aria-hidden="true" />
	</div>
	<slot />
</div>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.ui-select {
		position: relative;
	}

	// Room for the chevron; 1px less where the field's 2px focus border takes it.
	.ui-field__control.ui-select__control {
		padding-right: 40px;
		// A label too long for the control ends in "…", not mid-letter.
		text-overflow: ellipsis;
		cursor: pointer;
		appearance: none;

		&:focus {
			padding-right: 39px;
		}

		&:has(option[data-placeholder]:checked) {
			color: var(--color-text-muted);
		}

		option,
		optgroup {
			color: var(--color-text);
			background: var(--color-bg-surface);
		}
	}

	// An in-page list, so it never opens over the control. Touch keeps the system picker.
	@supports (appearance: base-select) {
		@media (hover: hover) and (pointer: fine) {
			.ui-field__control.ui-select__control,
			.ui-select__control::picker(select) {
				appearance: base-select;
			}

			.ui-field__control.ui-select__control {
				display: block;
				align-content: center;

				selectedcontent {
					display: block;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}

				&::picker-icon {
					display: none;
				}

				&::picker(select) {
					box-sizing: border-box;
					max-block-size: min(22rem, 45vh);
					position-try-order: normal;
					max-inline-size: anchor-size(self-inline);
					margin-block: $spacing-1;
					padding: $spacing-1;
					border: 1px solid var(--color-border);
					border-radius: $radius-md;
					background: var(--color-bg-surface);
					box-shadow: 0 8px 24px rgba(var(--color-shadow-ui-rgb), 0.16);
					color: var(--color-text);
					scrollbar-width: thin;
				}

				optgroup {
					@include type-small;
					padding-top: $spacing-2;
					color: var(--color-text-secondary);
					font-weight: $font-weight-medium;
				}

				option {
					padding: $spacing-2 $spacing-3;
					border-radius: $radius-sm;
					font-size: $font-size-base;
					font-weight: $font-weight-normal;
					line-height: 1.5;
					white-space: normal;
					cursor: pointer;

					&:hover,
					&:focus-visible {
						outline: none;
						background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg-surface));
					}

					@media (forced-colors: active) {
						&:focus-visible {
							outline: 2px solid Highlight;
							outline-offset: -2px;
						}
					}

					&:checked {
						color: var(--accent-ink);
						font-weight: $font-weight-medium;
					}

					&::checkmark {
						order: 1;
						margin-inline-start: auto;
					}
				}
			}
		}
	}

	.ui-select__chevron {
		position: absolute;
		top: 50%;
		right: 14px;
		width: 20px;
		height: 20px;
		color: var(--color-text-secondary);
		transform: translateY(-50%);
		pointer-events: none;
	}
</style>
