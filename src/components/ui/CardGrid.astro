---
/** A responsive grid of cards: one column, then two from md, then `cols` from lg. */
import '@styles/ui-kit.scss';

interface Props {
	cols?: 2 | 3;
}

const { cols = 3 } = Astro.props;
---

<div class:list={['ui-card-grid', `ui-card-grid--cols-${cols}`]}>
	<slot />
</div>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.ui-card-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: $spacing-5;

		&[hidden] {
			display: none;
		}

		@include media-up(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.ui-card-grid--cols-3 {
		@include media-up(lg) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
