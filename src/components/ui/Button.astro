---
/**
 * The kit's button: an `<a>` with `href`, a `<button>` without. Colour comes from `data-accent` on
 * any ancestor; `attrs` passes ids, `gtm_button` and `data-*` through untouched.
 *
 * Custom properties a caller may set: `--btn-min-w`, `--btn-px`, `--btn-label` (tertiary's colour).
 */
import { Icon } from 'astro-icon/components';
import { newTabAttrs, NEW_TAB_NOTE } from '@util/external-links';
import '@styles/ui-kit.scss';

interface Props {
	variant?: 'primary' | 'secondary' | 'tertiary';
	size?: 'xs' | 'sm' | 'md' | 'lg';
	/** A tabler icon name, before the label. */
	icon?: string;
	href?: string;
	/** Opens in a new tab, with the up-right arrow and a screen-reader note. */
	external?: boolean;
	type?: 'button' | 'submit';
	weight?: 'bold' | 'regular';
	/** Visually hidden text after the label. */
	srSuffix?: string;
	class?: string;
	attrs?: Record<string, string | undefined>;
}

const {
	variant = 'primary',
	size = 'md',
	icon,
	href,
	external = false,
	type = 'button',
	weight = 'bold',
	srSuffix,
	class: className,
	attrs = {},
} = Astro.props;

const Tag = href === undefined ? 'button' : 'a';
const element = Tag === 'button' ? { type } : { href, ...newTabAttrs(external) };
---

<Tag
	class:list={['ui-btn', `ui-btn--${variant}`, `ui-btn--${size}`, weight === 'regular' && 'ui-btn--regular', className]}
	{...element}
	{...attrs}
>
	{icon && <Icon name={icon} class="ui-btn__icon" aria-hidden="true" />}
	<slot />
	{srSuffix && <span class="ui-sr"> {srSuffix}</span>}
	{external && <Icon name="tabler:arrow-up-right" class="ui-btn__icon" aria-hidden="true" />}
	{external && <span class="ui-sr">{NEW_TAB_NOTE}</span>}
</Tag>

<style is:global lang="scss">
	@use 'sass:list';
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	// Height, side padding, font size, icon size, gap.
	$sizes: (
		xs: 32px 12px $font-size-sm 16px 6px,
		sm: 40px 16px $font-size-sm 18px 8px,
		md: 44px 16px $font-size-base 20px 8px,
		lg: 48px 20px $font-size-base 20px 8px,
	);

	.ui-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--_gap);
		box-sizing: border-box;
		height: var(--_h);
		min-width: var(--btn-min-w, 0);
		margin: 0;
		padding: 0 var(--btn-px, var(--_px));
		border: 1px solid transparent;
		border-radius: $radius-md;
		background-color: transparent;
		font-family: inherit;
		font-size: var(--_font);
		font-weight: $font-weight-bold;
		line-height: 1.25;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;

		@include focus-ring;
		@include touch-target(var(--_h));

		&[hidden] {
			display: none;
		}

		// Forced colours drop backgrounds: the border keeps every variant outlined.
		@media (forced-colors: active) {
			border-color: ButtonText;
		}
	}

	.ui-btn :where(.ui-btn__icon) {
		flex: none;
		width: var(--_icon);
		height: var(--_icon);
	}

	@each $size, $v in $sizes {
		.ui-btn--#{$size} {
			--_h: #{list.nth($v, 1)};
			--_px: #{list.nth($v, 2)};
			--_font: #{list.nth($v, 3)};
			--_icon: #{list.nth($v, 4)};
			--_gap: #{list.nth($v, 5)};
		}
	}

	.ui-btn--primary {
		border-color: var(--accent-fill);
		background-color: var(--accent-fill);
		color: var(--accent-on-fill);

		@include press-shade;
	}

	.ui-btn--secondary {
		border-color: color-mix(in srgb, var(--color-text) 18%, transparent);
		color: var(--color-text);

		@media (hover: hover) {
			&:hover {
				background-color: color-mix(in srgb, var(--color-text) 5%, transparent);
			}
		}

		&:active {
			background-color: color-mix(in srgb, var(--color-text) 10%, transparent);
		}
	}

	.ui-btn--tertiary {
		color: var(--btn-label, var(--accent-ink));

		@media (hover: hover) {
			&:hover {
				background-color: color-mix(in srgb, currentColor 6%, transparent);
			}
		}

		&:active {
			background-color: color-mix(in srgb, currentColor 10%, transparent);
		}
	}

	.ui-btn--regular {
		font-weight: $font-weight-normal;
	}
</style>
