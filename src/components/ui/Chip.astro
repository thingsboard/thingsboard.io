---
/**
 * A small rounded label: a TOGGLE (a filter button with `aria-pressed`, filled with the accent when
 * on) or a static TAG on a tint of the accent.
 */
import { Icon } from 'astro-icon/components';
import '@styles/ui-kit.scss';

interface Props {
	kind?: 'toggle' | 'tag';
	/** Toggle only: a tabler icon name, before the label. */
	icon?: string;
	class?: string;
	attrs?: Record<string, string | undefined>;
}

const { kind = 'tag', icon, class: className, attrs = {} } = Astro.props;
const toggle = kind === 'toggle';
const Tag = toggle ? 'button' : 'span';
const element = toggle ? { type: 'button' as const, 'aria-pressed': 'false' as const } : {};
---

<Tag class:list={['ui-chip', `ui-chip--${kind}`, className]} {...element} {...attrs}>
	{toggle && icon && <Icon name={icon} class="ui-chip__icon" aria-hidden="true" />}
	<slot />
</Tag>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	.ui-chip {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;

		&[hidden] {
			display: none;
		}
	}

	// `--chip-h` sets a toggle's height (40 by default).
	.ui-chip--toggle {
		position: relative;
		gap: $spacing-2;
		height: var(--chip-h, 40px);
		margin: 0;
		padding: 0 $spacing-4;
		border: 1px solid var(--ui-line);
		border-radius: $radius-full;
		background: var(--color-bg-surface);
		color: var(--color-text);
		font-family: inherit;
		font-size: $font-size-base;
		font-weight: $font-weight-medium;
		line-height: 1.5;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;

		@media (hover: hover) {
			&:hover {
				border-color: color-mix(in srgb, var(--color-text) 30%, transparent);
				background: color-mix(in srgb, var(--color-text) 3%, transparent);
			}
		}

		&:active {
			border-color: color-mix(in srgb, var(--color-text) 30%, transparent);
			background: color-mix(in srgb, var(--color-text) 7%, transparent);
		}

		@include focus-ring;
		@include touch-target(var(--chip-h, 40px));

		@media (forced-colors: active) {
			border-color: ButtonText;
		}

		&[aria-pressed='true'] {
			border-color: var(--accent-fill);
			background-color: var(--accent-fill);
			color: var(--accent-on-fill);

			// Keeps the fill under the shade, over the toggle's own hover tint.
			@media (hover: hover) {
				&:hover {
					background-color: var(--accent-fill);
				}
			}

			@include press-shade;
		}
	}

	.ui-chip__icon {
		flex: none;
		width: 20px;
		height: 20px;
	}

	.ui-chip--tag {
		height: 22px;
		padding: 0 $spacing-2;
		border-radius: $radius-full;
		background: color-mix(in srgb, var(--accent-fill) 10%, transparent);
		color: var(--accent-ink);
		font-size: $font-size-xs;
		font-weight: $font-weight-medium;
		line-height: 1;
	}
</style>
