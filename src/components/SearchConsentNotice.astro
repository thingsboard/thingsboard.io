---
// Stands in for Google search until the visitor allows External media; `@util/site-search` decides when.
import NButton from '@components/Landing/NButton.astro';

interface Props {
	/** Unique per page: the button's aria-describedby, so a screen reader reads the text on focus. */
	descId: string;
}

const { descId } = Astro.props;
---

{/* Starts hidden; the script that owns the search shows it. */}
<div class="search-consent" data-search-consent hidden>
	<p id={descId} class="search-consent__text">
		Site search is provided by Google, which sets cookies and shows ads in the results.
	</p>
	<div class="search-consent__actions">
		<NButton size="sm" data-cc="accept-media" aria-describedby={descId}>
			Load Google search
		</NButton>
		<a
			class="search-consent__google"
			href="https://www.google.com/search?q=site%3Athingsboard.io"
			target="_blank"
			rel="noopener noreferrer"
		>
			Search on Google instead
		</a>
	</div>
	<p class="search-consent__note">
		This allows External media for the whole site. You can change it anytime in
		<button type="button" class="cookie-settings" data-cc="show-preferences">
			Cookie settings
		</button>
	</p>
</div>

<style lang="scss">
	.search-consent {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 0.25rem 0;

		&[hidden] {
			display: none;
		}
	}

	.search-consent__text,
	.search-consent__note {
		margin: 0;
	}

	.search-consent__note {
		color: var(--sl-color-gray-3);
		font-size: 0.875rem;
	}

	.search-consent__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}

	.search-consent__google {
		color: var(--sl-color-text-accent);
	}
</style>
