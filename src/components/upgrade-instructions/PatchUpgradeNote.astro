---
// Shown after the "DO NOT run the upgrade script" caution of a patch section. Within a release line, the startup
// patch applier (SystemPatchApplier) applies the database changes of every patch after the stored version, in the
// background, and retries on every start until it succeeds; a failure is only logged. Before 4.4.1, upgrade.sh
// rejects a same-line database as "not supported for upgrade"; from 4.4.1 it says no upgrade is needed itself.
// Hand-written aside (no icon) to match the sibling cautions in the upgrade step components.
import type { UpgradeVersion } from '@models/upgrade-instructions';
import { patchScriptLabel, versionAtLeast } from '@models/upgrade-shared';

interface Props {
	v: UpgradeVersion;
}

const { v } = Astro.props;
const title = `Upgrading from ${patchScriptLabel(v)}`;
const explainScriptError = !versionAtLeast(v.version, '4.4.1');
---

<aside aria-label={title} class="starlight-aside starlight-aside--note">
	<p class="starlight-aside__title" aria-hidden="true">
		{title}
	</p>
	<div class="starlight-aside__content">
		{explainScriptError && (
			<p>
				If you run the upgrade script anyway, it stops before it changes the database, with{' '}
				<code>Upgrade failed: database version '…' is not supported for upgrade</code>. If you run {patchScriptLabel(v)},
				this message means your version needs no upgrade script. It doesn't mean you need an intermediate upgrade.
			</p>
		)}
		<p>
			You don't need to install the patches in between. On its first start, ThingsBoard applies the database changes of
			every patch between your version and {v.displayVersion} in the background. When they are done, the ThingsBoard log
			shows <code>System data patch update completed successfully</code>. In a cluster, only one core node runs the update
			and writes this line, so check the log of each core node.
		</p>
		<p>
			If the log shows <code>Failed to apply system data patch updates</code> instead, ThingsBoard keeps running, but
			the update isn't complete. The exception logged with this message shows the cause. The update runs as the database
			user from your ThingsBoard configuration, and that user needs the same rights as the upgrade script: to create and
			change tables, indexes, views, and functions. After you fix the cause, restart ThingsBoard. It retries the update
			on every start until it succeeds.
		</p>
	</div>
</aside>

<style>
	.starlight-aside {
		border-inline-start: 0.25rem solid;
		padding: 0.75rem 1rem;
		margin: 1rem 0;
		border-radius: 0 4px 4px 0;
	}

	.starlight-aside--note {
		border-color: var(--sl-color-blue);
		background: var(--sl-color-blue-low);
	}

	.starlight-aside__title {
		font-weight: 700;
		margin: 0 0 0.25rem;
	}

	.starlight-aside__content {
		margin: 0;
	}

	.starlight-aside__content p {
		margin: 0.25rem 0;
	}
</style>
