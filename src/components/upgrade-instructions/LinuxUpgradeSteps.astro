---
import { Code } from '@astrojs/starlight/components';
import { UPGRADE_VERSIONS, getFamilySlug, getUpgradeStepVersions } from '~/models/upgrade-instructions';
import { getUpgradeHeading, isLegacyPe, patchFamilyLabel, patchScriptLabel, productName, versionAtLeast } from '~/models/upgrade-shared';
import type { Products } from '~/models/site.models';
import { getVersionPrefix } from '@util/path-utils';
import AlarmMigrationNote from '@components/upgrade-instructions/AlarmMigrationNote.astro';
import PrepareSection from './PrepareSection.astro';
import ConfigFileNote from './ConfigFileNote.astro';

interface Props {
	product: Products;
	platform: 'ubuntu' | 'centos';
	filterFamily?: string;
}

const { product, platform, filterFamily } = Astro.props;
const versions = getUpgradeStepVersions(product, filterFamily);

const isPE = product === 'PE';
const isUbuntu = platform === 'ubuntu';
const pkgExt = isUbuntu ? 'deb' : 'rpm';
const installCmd = isUbuntu ? 'dpkg -i' : 'rpm -Uvh';
const webReportLink = isUbuntu
	? '/docs/pe/installation/ubuntu/'
	: '/docs/pe/installation/rhel/';
// Follow the reader's own edition: this component renders on both the CE and PE
// upgrade routes, so a hardcoded prefix sends half the readers to the other
// edition's install guide. (`webReportLink` above is deliberately always PE.)
// The prefix comes from the product model rather than a local ternary, so a new
// edition is a model change instead of a grep through these components.
const docsPrefix = `/docs/${getVersionPrefix(product)}`;
const installPrefix = `${docsPrefix}installation`;
const installPage = isUbuntu ? 'ubuntu' : 'rhel';
// "Install Java" is step 1 and "Configure Database" is step 3 in both editions.
const javaGuideLink = `${installPrefix}/${installPage}/#step-1-install-java-openjdk`;
const cassandraGuideLink = `${installPrefix}/${installPage}/#step-3-configure-database`;
const tbelDateFormattingLink = `${docsPrefix}user-guide/tbel/#date-formatting-changes-in-thingsboard-44`;

function pkgName(ver: string): string {
	return isLegacyPe(isPE, ver) ? `thingsboard-${ver}pe.${pkgExt}` : `thingsboard-${ver}.${pkgExt}`;
}

function downloadUrl(ver: string): string {
	if (isLegacyPe(isPE, ver)) {
		return `https://dist.thingsboard.io/${pkgName(ver)}`;
	}
	return `https://github.com/thingsboard/thingsboard/releases/download/v${ver}/${pkgName(ver)}`;
}

function isNewerVersionScheme(version: string): boolean {
	return versionAtLeast(version, '4.2');
}

function needsCompatibilityCheck(version: string): boolean {
	return versionAtLeast(version, '4.3');
}
---

{isPE && <PrepareSection platform={platform} />}

{versions.map((v) => {
	const newer = isNewerVersionScheme(v.version);
	const needsCompat = needsCompatibilityCheck(v.version);
	const heading = getUpgradeHeading(v, productName(isPE, v.version));
	const prevDisplayLabel = isLegacyPe(isPE, v.upgradableFrom) ? `${v.upgradableFrom} PE` : v.upgradableFrom;
	const prevVersionEntry = v.prevVersionAnchor
		? UPGRADE_VERSIONS.find((v2) => v2.anchor === v.prevVersionAnchor)
		: undefined;
	const prevHref = v.prevVersionAnchor
		? filterFamily && prevVersionEntry && prevVersionEntry.family !== v.family
			? `../${getFamilySlug(prevVersionEntry.family)}/#${v.prevVersionAnchor}`
			: `#${v.prevVersionAnchor}`
		: undefined;
	const fromVersion = v.manualVersionUpgradeLabel ?? v.upgradableFrom;
	const upgradeFlag = v.manualVersionUpgrade ? ` --fromVersion=${fromVersion}` : '';
	// dist.thingsboard.io and GitHub releases name downloads with the short
	// `displayVersion` (e.g. `4.1`, `4.2`), not the raw `version` (`4.1.0`,
	// `4.2.0`). Using v.version yields 403/404 on prod.
	const pkg = pkgName(v.displayVersion);
	const dlUrl = downloadUrl(v.displayVersion);

	return (
		<section>
			<h2 id={v.anchor}>{heading}</h2>

			{(v.baseVersion === '4.3.1' || v.baseVersion === '4.2.2') && (
				<aside class="starlight-aside starlight-aside--caution">
					<p class="starlight-aside__title" aria-hidden="true">Important note before upgrading to ThingsBoard {v.baseVersion}</p>
					<div class="starlight-aside__content">
						<p>Starting with version {v.baseVersion}, the platform uses Angular 20 (upgraded from Angular 18). The core platform remains fully backward compatible and no upgrade scripts are required. However, custom UI code (widgets or custom CSS) that relies on internal component structure or CSS variable names may break. This can affect up to ~1% of users with heavy customizations. We recommend testing custom UI in a staging environment before upgrading.</p>
					</div>
				</aside>
			)}

			{isPE && v.baseVersion === '4.3.1' && versionAtLeast(v.version, '4.3.1.4') && <AlarmMigrationNote />}

			{needsCompat && (
				<aside class="starlight-aside starlight-aside--caution">
					<p class="starlight-aside__title" aria-hidden="true">Compatibility check before upgrading</p>
					<div class="starlight-aside__content">
						{isPE ? (
							<p>If you are using Edge PE or Trendz Analytics together with ThingsBoard, verify that your target ThingsBoard version is compatible with the currently installed versions of these components. Upgrade them if required to ensure compatibility.</p>
						) : (
							<p>If you are using Edge together with ThingsBoard, verify that your target ThingsBoard version is compatible with the currently installed Edge version. Upgrade it if required to ensure compatibility.</p>
						)}
						{isPE ? (
							<ul>
								<li><strong>Edge PE:</strong> <a href="/docs/edge/pe/releases/releases-table/">Releases table</a></li>
								<li><strong>Trendz Analytics:</strong> <a href="/docs/trendz/releases/releases-table/">Releases table</a></li>
							</ul>
						) : (
							<ul>
								<li><strong>Edge:</strong> <a href="/docs/edge/releases/releases-table/">Releases table</a></li>
							</ul>
						)}
					</div>
				</aside>
			)}

			{(!newer || v.patch) && (
				<aside class="starlight-aside starlight-aside--note">
					<p class="starlight-aside__title" aria-hidden="true">Note</p>
					<div class="starlight-aside__content">
						<p>
							These upgrade steps are applicable for ThingsBoard version{' '}
							{prevHref ? (
								<a href={prevHref}>{prevDisplayLabel}</a>
							) : (
								prevDisplayLabel
							)}{v.patch ? <>{' '}or any {patchFamilyLabel(v)} patch</> : ''}.{' '}
							In order to upgrade to <strong>{isLegacyPe(isPE, v.version) ? `${v.displayVersion}PE` : v.displayVersion}</strong> you need to{' '}
							{prevHref ? (
								<><a href={prevHref}><strong>upgrade to {prevDisplayLabel} first</strong></a>.</>
							) : (
								<>upgrade to {prevDisplayLabel} first.</>
							)}
						</p>
						{isPE && (
							<p><a href="#prepare-for-upgrading-thingsboard"><strong>Prepare</strong></a> for upgrading ThingsBoard.</p>
						)}
					</div>
				</aside>
			)}

			{v.version === '4.4.0' && (
				<>
					<aside class="starlight-aside starlight-aside--caution">
						<p class="starlight-aside__title" aria-hidden="true">Important note before upgrading to ThingsBoard 4.4</p>
						<div class="starlight-aside__content">
							<p>ThingsBoard backend was migrated to <strong>Java 25</strong>. Install JDK 25 and make it the system's default Java version <strong>before</strong> upgrading.</p>
							<p>Please refer to Step 1 of the corresponding installation guide for detailed instructions: <a href={javaGuideLink}>{isUbuntu ? 'Ubuntu' : 'CentOS/RHEL'}</a></p>
						</div>
					</aside>

					<aside class="starlight-aside starlight-aside--note">
						<p class="starlight-aside__title" aria-hidden="true">TBEL date formatting changes</p>
						<div class="starlight-aside__content">
							<p>ThingsBoard 4.4 runs on Java 25, whose updated Unicode CLDR data changes the locale-formatted strings produced by <code>TbDate</code> methods: <code>toLocaleString()</code>, <code>toLocaleDateString()</code>, <code>toLocaleTimeString()</code>, <code>toString()</code>, <code>toDateString()</code>, <code>toTimeString()</code> and <code>toUTCString()</code>. Scripts that string-match or split formatted dates may behave differently after the upgrade. <code>toISOString()</code>, <code>toJSON()</code>, <code>getTime()</code> and the numeric getters are unaffected.</p>
							<p>See <a href={tbelDateFormattingLink}>Date formatting changes in ThingsBoard 4.4+</a> for examples and recommendations.</p>
						</div>
					</aside>
				</>
			)}

			{v.version === '3.7.0' && (
				<aside class="starlight-aside starlight-aside--caution">
					<p class="starlight-aside__title" aria-hidden="true">Important note before upgrading to ThingsBoard 3.7</p>
					<div class="starlight-aside__content">
						<p>ThingsBoard backend was migrated to Java 17. Install JDK 17 and ensure that the system's default Java version is set to 17.</p>
						<Code code={isUbuntu ? 'sudo apt update && sudo apt install openjdk-17-jdk-headless' : 'sudo dnf install java-17-openjdk-headless'} lang="bash" />
						<p>Then select Java 17 as the system default:</p>
						<Code code="sudo update-alternatives --config java" lang="bash" />
					</div>
				</aside>
			)}

			{v.version === '3.5.0' && (
				<aside class="starlight-aside starlight-aside--caution">
					<p class="starlight-aside__title" aria-hidden="true">Important note before upgrading to ThingsBoard 3.5</p>
					<div class="starlight-aside__content">
						<p>ThingsBoard UI was migrated to Angular 15. You need to re-build your custom widgets and rule nodes (which use UI) on Angular 15.</p>
						<p>We suggest consulting <a href="https://v15.material.angular.dev/guide/mdc-migration">this guide</a>.</p>
					</div>
				</aside>
			)}

			{!isUbuntu && v.version === '3.8.0' && !isPE && (
				<>
					<h4>Install PostgreSQL contrib package (CentOS only)</h4>
					<Code code="sudo dnf install -y postgresql16-contrib" lang="bash" />
				</>
			)}

			<h4>ThingsBoard{isLegacyPe(isPE, v.version) ? ' PE' : ''} package download</h4>
			<Code code={`wget ${dlUrl}`} lang="bash" />

			<h4>{productName(isPE, v.version)} service upgrade</h4>

			<ul>
				<li>Stop ThingsBoard service if it is running.</li>
			</ul>
			<Code code="sudo service thingsboard stop" lang="bash" />

			{isPE && (
				<ul>
					<li>Install <a href={webReportLink}>ThingsBoard Web Report component</a> as described in the installation guide. Do not forget to change the version according to your ThingsBoard version.</li>
				</ul>
			)}

			<Code code={`sudo ${installCmd} ${pkg}`} lang="bash" />

			<ConfigFileNote platform={platform} />

			{v.upgrade && (
				<>
					{newer && (
						<aside class="starlight-aside starlight-aside--caution">
							<p class="starlight-aside__title" aria-hidden="true">Caution</p>
							<div class="starlight-aside__content">
								{v.patch ? (
									<p>If you are upgrading from {v.upgradableFrom}, you <strong>must</strong> run the script below. However, if you are upgrading from version {patchScriptLabel(v)}, <strong>DO NOT</strong> run the upgrade script; proceed directly to starting the service.</p>
								) : (
									<p>If you are upgrading from version {v.upgradableFrom}, you must run the script below.</p>
								)}
							</div>
						</aside>
					)}
					<Code code={`sudo /usr/share/thingsboard/bin/install/upgrade.sh${upgradeFlag}`} lang="bash" />
				</>
			)}

			{!v.upgrade && (
				<p><em>No database schema upgrade is required for this version. Proceed to starting the service.</em></p>
			)}

			<h4>Start the service</h4>

			{v.version === '3.7.0' && (
				<aside class="starlight-aside starlight-aside--note">
					<p class="starlight-aside__title" aria-hidden="true">Note</p>
					<div class="starlight-aside__content">
						<p><strong>In case Cassandra is installed</strong>, ensure that a proper <strong>JAVA_HOME</strong> parameter is set for <em>cassandra.in.sh</em> include file. As of 3.7.0 release, latest stable Cassandra version does not support Java 17 yet.</p>
						<p>In case action is required, refer to the <strong>Hybrid (PostgreSQL + Cassandra)</strong> tab of <a href={cassandraGuideLink}>Step 3 of the installation guide</a>.</p>
					</div>
				</aside>
			)}

			<Code code="sudo service thingsboard start" lang="bash" />

			{v.version === '3.4.2' && (
				<aside class="starlight-aside starlight-aside--note">
					<p class="starlight-aside__title" aria-hidden="true">Note</p>
					<div class="starlight-aside__content">
						<p>Update the JWT signing key if you use the default one "thingsboardDefaultSigningKey" on production environments. See <a href={`${docsPrefix}user-guide/security/#jwt-security-settings`}>JWT security settings</a> for details.</p>
					</div>
				</aside>
			)}
		</section>
	);
})}

<style>
	section {
		margin-bottom: 3rem;
	}

	.starlight-aside {
		border-inline-start: 0.25rem solid;
		padding: 0.75rem 1rem;
		margin: 1rem 0;
		border-radius: 0 4px 4px 0;
	}

	.starlight-aside--note {
		border-color: var(--sl-color-blue);
		background: var(--sl-color-blue-low);
	}

	.starlight-aside--caution {
		border-color: var(--sl-color-orange);
		background: var(--sl-color-orange-low);
	}

	.starlight-aside__title {
		font-weight: 700;
		margin: 0 0 0.25rem;
	}

	.starlight-aside__content {
		margin: 0;
	}

	.starlight-aside__content p {
		margin: 0.25rem 0;
	}
</style>
