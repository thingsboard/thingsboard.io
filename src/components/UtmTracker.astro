---
// Appends campaign and partner-referral attribution to Cloud / License Portal sign-up links.
---

<script>
	import { attributionQuery } from '@util/attribution';
	import { CLOUD_REGIONS } from '@util/cloud-regions';
	import { onConsentChange } from '@util/consent';

	const SIGN_UP_ORIGINS: string[] = [
		...CLOUD_REGIONS.map((r) => `https://${r.host}`),
		'https://license.thingsboard.io',
	];
	// The ways into an account. Other links to the same hosts (public demo dashboards, API reference) stay as written.
	const SIGN_UP_PATHS = ['/', '/signup', '/login'];

	const isSignUpLink = (link: HTMLAnchorElement | HTMLAreaElement) =>
		SIGN_UP_ORIGINS.includes(link.origin) && SIGN_UP_PATHS.includes(link.pathname.replace(/(.)\/$/, '$1'));

	// Sign-up links in the page markup with their unpatched href, so a consent change re-patches from scratch.
	// Links rendered later (the pricing calculator's CTA) add attribution themselves.
	const originals = new Map<HTMLAnchorElement | HTMLAreaElement, string>();

	function patchLinks() {
		const search = attributionQuery();
		originals.forEach((href, link) => {
			const separator = href.includes('?') ? '&' : '?';
			link.setAttribute('href', search ? href + separator + search : href);
		});
	}

	function collectAndPatch() {
		Array.from(document.links).forEach((link) => {
			const href = link.getAttribute('href');
			if (href && isSignUpLink(link)) originals.set(link, href);
		});
		patchLinks();
	}

	// At idle, bounded so a fast click can't beat the rewrite; the links are parsed by the time a module runs.
	if ('requestIdleCallback' in window) requestIdleCallback(collectAndPatch, { timeout: 1000 });
	else setTimeout(collectAndPatch, 200);
	onConsentChange(patchLinks);
</script>
