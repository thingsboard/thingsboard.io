---
// The active-filter chip strip that sits in a filter bar's second row, next to
// the result count. Rendered empty; `iot-hub-filter-chips.ts` fills it from the
// FilterPanel's `iot-hub-filter:change` snapshot.
//
// Markup, styles and wiring live together here so any bar can opt in with a
// single `<FilterChips />` — the chip styles only ship on pages that render it.
---

<div class="iot-hub-filter-bar__chips" data-filter-chips></div>

<style lang="scss">
	@use '../../styles/_variables.scss' as *;

	// Active-filter chips + the trailing "Clear all" button. Stretches to
	// fill the row's middle so IotHubSort stays right-aligned; wraps to
	// multiple lines when the user picks many filters at once.
	.iot-hub-filter-bar__chips {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;

		&:empty {
			// Collapse the gap when there are no chips so the row keeps the
			// pre-chips spacing between count and sort.
			display: none;
		}
	}

	// Chip styles target the JS-built nodes — selectors are :global because
	// the children are created by `document.createElement` in
	// `iot-hub-filter-chips.ts` and don't carry Astro's scope hash.
	:global(.iot-hub-filter-bar__chip) {
		display: inline-flex;
		align-items: center;
		padding: 4px 4px 4px 8px;
		border-radius: 16px;
		background: var(--sl-color-gray-6);
		font-size: 14px;
		line-height: 24px;
		color: var(--color-text);
	}

	:global(.iot-hub-filter-bar__chip-label) {
		padding: 0 4px;
	}

	:global(.iot-hub-filter-bar__chip-remove) {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		padding: 4px;
		margin: 0;
		border: none;
		background: transparent;
		color: var(--color-text-secondary);
		cursor: pointer;
		border-radius: 50%;
		font-family: inherit;
		transition: color $transition-fast, background-color $transition-fast;

		&:hover,
		&:focus-visible {
			color: var(--color-text);
		}

		svg {
			display: block;
		}
	}

	:global(.iot-hub-filter-bar__clear-all) {
		display: inline-flex;
		align-items: center;
		padding: 4px 12px;
		font-family: inherit;
		font-size: 14px;
		font-weight: $font-weight-normal;
		line-height: 24px;
		color: var(--sl-color-gray-3);
		background: transparent;
		border: none;
		border-radius: 16px;
		cursor: pointer;
		transition: color $transition-fast;

		&:hover,
		&:focus-visible {
			color: var(--color-text);
			text-decoration: underline;
		}
	}
</style>

<script>
	import { initFilterChips } from './iot-hub-filter-chips';
	initFilterChips();
</script>
