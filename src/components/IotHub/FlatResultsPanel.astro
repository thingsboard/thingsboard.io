---
import type { GridEntry } from '@models/iot-hub';
import FlatListingGrid from './FlatListingGrid.astro';
import IotHubFetchError from './IotHubFetchError.astro';
import IotHubNoResults from './IotHubNoResults.astro';
import IotHubSearchLoading from './IotHubSearchLoading.astro';
import ListingCardTemplate from './ListingCardTemplate.astro';
import PaginationBar from '@components/Pagination/PaginationBar.astro';

// The results region for a page whose cards are re-rendered from the API:
// the grid, the three state panels, bottom pagination, and the clone templates
// that iot-hub-dynamic-search.ts fills.
//
// The templates live here rather than on the page so they stay next to the grid
// that needs them — a mixed grid clones `preview` + `tile`, which is exactly
// what the init guard requires, and lint:dualrender checks.

interface Props {
	items: GridEntry[];
	currentPage: number;
	totalPages: number;
	basePath: string;
	perPage: number;
	/** Card heading level. Depends on what supplies the page's h1. */
	titleAs?: 'h2' | 'h3';
	/** When false, hide the creator row entirely. */
	showCreator?: boolean;
	/** "Clear filters" target on the empty state, when the page has one. */
	clearHref?: string;
}

const {
	items,
	currentPage,
	totalPages,
	basePath,
	perPage,
	titleAs = 'h3',
	showCreator = true,
	clearHref,
} = Astro.props;
---

<div class="iot-hub-results">
	<div data-search-results>
		<FlatListingGrid items={items} titleAs={titleAs} showCreator={showCreator} />
	</div>
	<IotHubNoResults clearHref={clearHref} />
	<IotHubFetchError />
	<IotHubSearchLoading />
</div>
{
	totalPages > 1 && (
		<PaginationBar
			currentPage={currentPage}
			totalPages={totalPages}
			basePath={basePath}
			perPage={perPage}
			idBase={basePath}
		/>
	)
}
<ListingCardTemplate variant="preview" titleAs={titleAs} />
<ListingCardTemplate variant="tile" titleAs={titleAs} />

<style>
	/* Positioned ancestor for the absolute loading overlay. */
	.iot-hub-results {
		position: relative;
	}
</style>
