---
import Chevron from '@components/Chevron.astro';

// Shared "Explore all …" control for the IoT Hub home sections. The component
// owns only the link itself — its label, colour and the chevron that nudges
// right on hover. Each section owns the header row that positions it, so a
// section with a flush indicator bar and one without can both use this
// without inheriting the other's alignment.
//
// Styles are `is:global`, nested under the component's own class: the chevron
// is rendered by Chevron.astro, and a scoped rule can't reach an element a
// child component emits.

interface Props {
	/** Destination list, query string included when it pre-sets list state. */
	href: string;
	/** Full visible label, e.g. "Explore all widgets". */
	label: string;
	/** Accessible name, for a visible label too terse to stand on its own in
	 *  a screen reader's list of links. Must contain `label` (WCAG 2.5.3). */
	ariaLabel?: string;
}

const { href, label, ariaLabel } = Astro.props;
---

<a class="iot-hub-explore-all" href={href} aria-label={ariaLabel}>
	{label}
	<Chevron direction="right" class="iot-hub-explore-all__chevron" />
</a>

<style is:global lang="scss">
	@use '../../styles/_variables.scss' as *;

	.iot-hub-explore-all {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		flex-shrink: 0;
		white-space: nowrap;
		font-size: 16px;
		font-weight: $font-weight-medium;
		line-height: 24px;
		color: var(--color-primary);
		text-decoration: none;

		&:hover,
		&:focus-visible {
			text-decoration: none;

			.iot-hub-explore-all__chevron {
				transform: translateX(2px);
			}
		}
	}

	.iot-hub-explore-all__chevron {
		transition: transform $transition-fast;
	}
</style>
