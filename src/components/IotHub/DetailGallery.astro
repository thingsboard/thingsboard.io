---
import PhotoSwipeStyles from '@components/PhotoSwipeStyles.astro';
import { PSWP_PLACEHOLDER_HEIGHT, PSWP_PLACEHOLDER_WIDTH } from '@util/lightbox-images';

// Interactive image carousel for a listing's images, whatever its item type.
// Drop-in for the detail hero's preview slot whenever a listing ships
// screenshots; a listing without them keeps the still `detail.image` that
// DetailHero renders directly. A dumb renderer — the caller resolves the URLs
// and decides the order (preview image first, then screenshots). Prev/next and
// the dots only appear from the second image on. Scoped Astro markup + a small
// is:inline script for prev/next + dot navigation and gentle auto-advance; no
// carousel library. Each slide is also a `.gallery-thumb` inside an
// `.image-gallery` root, the markup contract the site-wide PhotoSwipe loader
// looks for — clicking an image opens the whole set full screen, starting on
// that slide.

interface Props {
	images: Array<{ src: string; alt: string }>;
	listingName: string;
}

const { images, listingName } = Astro.props;
---

{
	images.length > 0 && (
		<div
			class="iot-hub-gallery image-gallery"
			role="region"
			aria-roledescription="carousel"
			aria-label={`${listingName} images`}
			data-iot-hub-gallery
		>
			<div class="iot-hub-gallery__viewport">
				<ul class="iot-hub-gallery__track" data-track>
					{images.map((image, i) => (
						<li
							class="iot-hub-gallery__slide"
							role="group"
							aria-roledescription="slide"
							aria-label={`${i + 1} of ${images.length}`}
						>
							{/* `data-pswp-cdn` marks the declared size as a placeholder —
							    see PSWP_PLACEHOLDER_WIDTH. */}
							<a
								class="gallery-thumb"
								href={image.src}
								data-pswp-width={PSWP_PLACEHOLDER_WIDTH}
								data-pswp-height={PSWP_PLACEHOLDER_HEIGHT}
								data-pswp-cdn="true"
								aria-label={`View full size: ${image.alt}`}
							>
								<img
									src={image.src}
									alt={image.alt}
									loading={i === 0 ? 'eager' : 'lazy'}
									decoding="async"
								/>
							</a>
						</li>
					))}
				</ul>
			</div>
			{images.length > 1 && (
				<div class="iot-hub-gallery__controls">
					<button
						type="button"
						class="iot-hub-gallery__nav iot-hub-gallery__nav--prev"
						aria-label="Previous slide"
						data-prev
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="m15 6-6 6 6 6"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</button>
					<div class="iot-hub-gallery__dots" role="group" aria-label="Select slide">
						{images.map((_, i) => (
							<button
								type="button"
								class="iot-hub-gallery__dot"
								aria-current={i === 0 ? 'true' : undefined}
								aria-label={`Slide ${i + 1}`}
								data-dot
								data-index={i}
							/>
						))}
					</div>
					<button
						type="button"
						class="iot-hub-gallery__nav iot-hub-gallery__nav--next"
						aria-label="Next slide"
						data-next
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="m9 6 6 6-6 6"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</button>
				</div>
			)}
		</div>
	)
}

<PhotoSwipeStyles />

<style lang="scss">
	@use '../../styles/_variables.scss' as *;

	// Single framed surface — background + border + rounded corners wrap the
	// slides AND the controls row, so the whole gallery reads as one panel
	// (the controls share the same backdrop as the slides above them).
	.iot-hub-gallery {
		position: relative;
		display: flex;
		flex-direction: column;
		width: 100%;
		background: var(--color-bg-light);
		border-radius: 12px;
		border: 1px solid var(--iot-hub-hairline, #edeef3);
		overflow: hidden;
	}

	.iot-hub-gallery__viewport {
		position: relative;
		overflow: hidden;
		// Pointer-drag swipe: let the browser keep vertical scrolling
		// (pan-y) but reserve horizontal gesture for our handler. Combined
		// with user-select:none / -webkit-user-drag:none on images so the
		// browser doesn't start its own text-select or image-drag mid-swipe.
		touch-action: pan-y;
		user-select: none;
		cursor: grab;

		&:active {
			cursor: grabbing;
		}

		img {
			user-select: none;
			-webkit-user-drag: none;
		}
	}

	// Sliding track — width is set to total*100% so slides line up side by side
	// and translateX moves between them. `--idx` is updated by the inline
	// script; defaults to 0 so the first slide is visible without JS.
	.iot-hub-gallery__track {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		transition: transform 0.4s ease;
		will-change: transform;
		transform: translateX(calc(var(--idx, 0) * -100%));
	}

	.iot-hub-gallery__slide {
		flex: 0 0 100%;
		min-width: 0;
		aspect-ratio: 16 / 9;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;

		// The lightbox trigger fills the slide box so the whole frame is
		// clickable, not just the letterboxed picture inside it.
		.gallery-thumb {
			display: block;
			width: 100%;
			height: 100%;
			cursor: zoom-in;
			-webkit-user-drag: none;

			&:focus-visible {
				outline: 2px solid var(--color-primary);
				outline-offset: -2px;
			}
		}

		img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			display: block;
		}
	}

	// Bottom controls row: [prev] [dots, centred + flex:1] [next] — chevrons
	// sit at the row edges, dots float in the centre so the layout reads
	// symmetrically regardless of dot count.
	.iot-hub-gallery__controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 12px 16px;
	}

	.iot-hub-gallery__nav {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: #fff;
		border: 1px solid var(--iot-hub-hairline, #edeef3);
		color: rgba(0, 0, 0, 0.76);
		cursor: pointer;
		padding: 0;
		transition: background 0.15s ease, color 0.15s ease;

		&:hover {
			background: #f5f5f5;
			color: #000;
		}

		&:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}

		:global([data-theme='dark']) & {
			background: rgba(255, 255, 255, 0.06);
			color: rgba(255, 255, 255, 0.85);
			border-color: rgba(255, 255, 255, 0.16);

			&:hover {
				background: rgba(255, 255, 255, 0.12);
				color: #fff;
			}
		}
	}

	// Pagination dots — 6px, transparent inactive, opaque active, with a
	// soft scale-up on the active dot so it reads clearly without changing
	// layout. `flex: 1` centres the strip within the controls row.
	.iot-hub-gallery__dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		flex: 1;
	}

	.iot-hub-gallery__dot {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		border: 0;
		padding: 0;
		background: rgba(0, 0, 0, 0.38);
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;

		&[aria-current='true'] {
			background: rgba(0, 0, 0, 0.76);
			transform: scale(1.25);
		}

		&:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}

		:global([data-theme='dark']) & {
			background: rgba(255, 255, 255, 0.38);

			&[aria-current='true'] {
				background: rgba(255, 255, 255, 0.85);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.iot-hub-gallery__track {
			transition: none;
		}

		.iot-hub-gallery__dot {
			transition: none;
		}
	}
</style>

<script is:inline>
	// Wires up every `[data-iot-hub-gallery]` instance on the page. Drives the
	// active slide index by toggling a `--idx` custom property on the track
	// (CSS handles the translateX) and an `aria-current` attribute on the
	// dots. Auto-advance runs every 5s, pauses on hover / keyboard focus
	// (so users reading a long screenshot aren't yanked away mid-glance) and
	// is suppressed entirely when prefers-reduced-motion is on.
	(function () {
		const AUTOPLAY_MS = 5000;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		document.querySelectorAll('[data-iot-hub-gallery]').forEach((gallery) => {
			const viewport = gallery.querySelector('.iot-hub-gallery__viewport');
			const track = gallery.querySelector('[data-track]');
			const slides = track ? track.querySelectorAll('.iot-hub-gallery__slide') : [];
			const total = slides.length;
			if (!track || total <= 1) return;

			const dots = gallery.querySelectorAll('[data-dot]');
			const thumbs = track.querySelectorAll('.gallery-thumb');
			const prevBtn = gallery.querySelector('[data-prev]');
			const nextBtn = gallery.querySelector('[data-next]');

			let idx = 0;
			let paused = false;
			let timer = null;

			function render() {
				track.style.setProperty('--idx', String(idx));
				for (let i = 0; i < dots.length; i++) {
					if (i === idx) dots[i].setAttribute('aria-current', 'true');
					else dots[i].removeAttribute('aria-current');
				}
				// Only the visible screenshot is a tab stop. Off-screen slides stay
				// in the DOM (PhotoSwipe reads the whole set from there), but
				// focusing one would make the browser scroll the viewport sideways
				// and fight the track's translateX.
				for (let i = 0; i < thumbs.length; i++) {
					thumbs[i].tabIndex = i === idx ? 0 : -1;
				}
			}

			function go(n) {
				idx = ((n % total) + total) % total;
				render();
			}

			function startAutoplay() {
				// `timer` is never cleared (pausing uses the `paused` flag), so it
				// doubles as the one-shot guard for both start triggers below.
				if (reduceMotion || timer) return;
				timer = window.setInterval(function () {
					// Hold while the lightbox is up: focus has left the gallery, so the
					// focusout pause no longer applies, and advancing underneath would
					// leave a different slide behind the overlay than the one focus
					// returns to on close.
					if (!paused && !document.querySelector('.pswp--open')) go(idx + 1);
				}, AUTOPLAY_MS);
			}

			if (prevBtn) prevBtn.addEventListener('click', function () { go(idx - 1); });
			if (nextBtn) nextBtn.addEventListener('click', function () { go(idx + 1); });
			dots.forEach(function (d, i) {
				d.addEventListener('click', function () { go(i); });
			});

			// The lightbox shows this same set; follow whichever slide it moves to, so
			// closing it lands back on the image that was on screen — and so its
			// zoom-out animates towards a thumbnail that is actually in view.
			gallery.addEventListener('tb-lightbox-slide-change', function (e) {
				if (typeof e.detail === 'number') go(e.detail);
			});

			gallery.addEventListener('mouseenter', function () { paused = true; });
			gallery.addEventListener('mouseleave', function () { paused = false; });
			gallery.addEventListener('focusin', function () { paused = true; });
			gallery.addEventListener('focusout', function () { paused = false; });

			// Keyboard navigation when the carousel (or any of its controls)
			// has focus — arrow keys advance, Home/End jump to the ends.
			gallery.addEventListener('keydown', function (e) {
				switch (e.key) {
					case 'ArrowLeft':
						e.preventDefault(); go(idx - 1); break;
					case 'ArrowRight':
						e.preventDefault(); go(idx + 1); break;
					case 'Home':
						e.preventDefault(); go(0); break;
					case 'End':
						e.preventDefault(); go(total - 1); break;
				}
			});

			// ----- Pointer drag / swipe ----------------------------------
			// One handler covers mouse, touch, and pen via the Pointer Events
			// API. During a drag we set `--idx` to a fractional value so the
			// translateX in CSS follows the finger directly. On release we
			// snap to the nearest integer slide (or advance one when the
			// horizontal delta passes a sensible threshold).
			if (viewport) {
				let dragging = false;
				let dragRecognized = false;
				let dragStartX = 0;
				let dragDelta = 0;
				let viewportWidth = 0;
				let dragPointerId = -1;
				// Swallows the click the browser fires after a drag, so a swipe
				// never opens the lightbox. Capture phase, so the swallowed click
				// never reaches PhotoSwipe's own listener on the gallery root.
				let suppressClick = false;
				let suppressClickAt = 0;
				const DRAG_THRESHOLD_PX = 10;
				// The compatibility click follows its pointerup immediately; a flag
				// older than this belongs to a gesture that never produced one, and
				// must not be spent on an unrelated later click.
				const SUPPRESS_CLICK_MS = 500;

				// On `window`, not on the viewport: capture is only taken once the
				// gesture passes the drag threshold, so a drag released over the
				// controls row can have its click dispatched at the common ancestor
				// of press and release — the gallery root, above the viewport. A
				// listener there would never see it, leaving the flag armed to eat
				// the next keyboard activation of a thumbnail.
				window.addEventListener('click', function (e) {
					if (!suppressClick) return;
					suppressClick = false;
					if (Date.now() - suppressClickAt > SUPPRESS_CLICK_MS) return;
					e.preventDefault();
					e.stopPropagation();
				}, true);

				viewport.addEventListener('pointerdown', function (e) {
					// Only react to the primary pointer (left mouse / first
					// finger). Skip when the click started on a child button
					// so its native click still fires.
					if (e.button !== 0 && e.pointerType === 'mouse') return;
					if (e.target && e.target.closest && e.target.closest('button')) return;

					dragging = true;
					dragRecognized = false;
					// A swipe that ends without a click (touch) would otherwise leave
					// the flag armed and eat the next real tap.
					suppressClick = false;
					dragStartX = e.clientX;
					dragDelta = 0;
					viewportWidth = viewport.offsetWidth;
					dragPointerId = e.pointerId;
					// Snap to the integer slot before the drag begins —
					// otherwise a drag that starts mid-transition would jump.
					track.style.transition = 'none';
					track.style.setProperty('--idx', String(idx));
					// Pointer capture is deliberately NOT taken here. Chrome
					// retargets the compatibility `click` to the capture element,
					// so capturing on every press would turn a plain click on a
					// screenshot into a click on the viewport <div> — and the
					// lightbox, which maps the click target back to a slide,
					// would never open. It is taken in pointermove instead, once
					// the gesture is actually a drag.
				});

				viewport.addEventListener('pointermove', function (e) {
					if (!dragging || e.pointerId !== dragPointerId) return;
					dragDelta = e.clientX - dragStartX;
					if (!dragRecognized && Math.abs(dragDelta) > DRAG_THRESHOLD_PX) {
						dragRecognized = true;
						// Now that it is a drag, keep receiving moves and the
						// release even if the pointer leaves the viewport. From
						// here the click is ours to swallow anyway, so the
						// retargeting capture causes no longer matters.
						try { viewport.setPointerCapture(e.pointerId); } catch { /* pointer capture unsupported */ }
					}
					if (!dragRecognized || viewportWidth === 0) return;
					// Fractional --idx: dragging right (positive delta) reveals
					// the previous slide, so we subtract delta/width from idx.
					const fractional = idx - dragDelta / viewportWidth;
					track.style.setProperty('--idx', String(fractional));
				});

				function endDrag(e) {
					if (!dragging || e.pointerId !== dragPointerId) return;
					dragging = false;
					try { viewport.releasePointerCapture(e.pointerId); } catch { /* capture may already be lost */ }
					// Restore the smooth transition so the snap animates.
					track.style.transition = '';
					if (dragRecognized) {
						// The press moved far enough to drag the track, so the
						// click that follows is part of that gesture, not a click
						// on the screenshot. A cancelled pointer is the exception:
						// it produces no compatibility click, so arming the flag
						// would leave it to be spent on somebody else's — and the
						// reset in pointerdown sits below the early return for
						// controls, so a tap on a dot never clears it either.
						if (e.type !== 'pointercancel') {
							suppressClick = true;
							suppressClickAt = Date.now();
						}
						const threshold = Math.max(50, viewportWidth * 0.15);
						if (dragDelta < -threshold) idx = (idx + 1) % total;
						else if (dragDelta > threshold) idx = ((idx - 1) % total + total) % total;
					}
					render();
				}
				viewport.addEventListener('pointerup', endDrag);
				viewport.addEventListener('pointercancel', endDrag);
				// Also on window, because capture is only taken once the gesture
				// passes the drag threshold: a press released outside the viewport
				// before that never delivers pointerup here, and `dragging` would
				// stay set — the track would then follow the pointer with no button
				// held. With capture active the viewport handler runs first and
				// these find the drag already ended.
				window.addEventListener('pointerup', endDrag);
				window.addEventListener('pointercancel', endDrag);
			}

			render();

			// Start autoplay only when the gallery scrolls into view (or on first
			// pointer interaction), so the 5s timer never runs below the fold.
			// Same run-once-on-first-visibility shape as IotHubHero's highlight
			// cycle — keep the two in sync.
			const ioAuto = new IntersectionObserver(function (entries) {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						startAutoplay();
						ioAuto.disconnect();
					}
				}
			}, { threshold: 0 });
			ioAuto.observe(gallery);
			if (viewport) {
				viewport.addEventListener('pointerdown', function () { startAutoplay(); }, { once: true });
			}
		});
	})();
</script>
