---
import type { GridEntry } from '@models/iot-hub';
import ListingCard from './ListingCard.astro';
import ListingGrid from './ListingGrid.astro';

interface Props {
	items: GridEntry[];
	/** Forwarded to ListingCard — false hides the creator row. */
	showCreator?: boolean;
	/** Card heading level. Depends on what supplies the page's h1. */
	titleAs?: 'h2' | 'h3';
}

const { items, showCreator = true, titleAs = 'h3' } = Astro.props;
---

{/* One continuous grid across every category, so a page reads as a single
    canvas. Every card is forced to one layout because the grid is mixed:
    letting item type choose would interleave full-size and compact cards. */}
{
	items.length > 0 && (
		<ListingGrid variant="big">
			{items.map(({ item, categorySlug }) => (
				<ListingCard
					item={item}
					categorySlug={categorySlug}
					variant="generic"
					showCreator={showCreator}
					titleAs={titleAs}
				/>
			))}
		</ListingGrid>
	)
}
