---
import Button from '@components/ui/Button.astro';
import { getInstallVerb, type IotHubItemType } from '@models/iot-hub';

interface Props {
	slug: string;
	itemType: IotHubItemType;
	name: string;
	affiliateId?: string | null;
	variant?: 'card' | 'hero';
	/**
	 * Content that ships with ThingsBoard. The dialog is the same, but it
	 * opens the item in the chosen instance instead of installing a copy —
	 * `data-built-in` is what tells the dialog which wording to use.
	 */
	builtIn?: boolean;
}

const { slug, itemType, name, affiliateId = null, variant = 'card', builtIn = false } = Astro.props;
// "Open" for built-in content, "Connect" for devices, "Install" otherwise —
// same wording in both variants.
const label = getInstallVerb(itemType, variant, builtIn);
---

{/* The label stays in a <span>: the listing card binder rewrites it there on cloned cards. */}
<Button
	variant={variant === 'hero' ? 'primary' : 'secondary'}
	size={variant === 'hero' ? 'lg' : 'xs'}
	class={`iot-hub-install-btn--${variant} print:hidden`}
	attrs={{
		'data-iot-hub-install-trigger': '',
		'data-slug': slug,
		'data-item-type': itemType,
		'data-affiliate-id': affiliateId ?? undefined,
		'data-built-in': builtIn ? 'true' : undefined,
		'aria-label': `${label} ${name}`,
	}}
>
	<span>{label}</span>
</Button>

<script>
	import '@components/IotHub/install-dialog-boot';
</script>

<style lang="scss">
	.iot-hub-install-btn--card {
		flex-shrink: 0;
		margin-left: auto;
	}

	.iot-hub-install-btn--hero {
		align-self: flex-start;
	}
</style>
