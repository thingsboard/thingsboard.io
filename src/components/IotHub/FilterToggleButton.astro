---
import { IOT_HUB_STRINGS } from '@models/iot-hub';

// Opens the FilterPanel. Above `lg` the panel is always visible and this
// button toggles it away; below it, the button opens the overlay drawer.
// `iot-hub-filter-drawer.ts` owns the behaviour and keeps `aria-expanded`
// in step, so the button only has to declare itself.
//
// Markup and styles live together here so both filter bars (category and
// catalogue) render the same control.

const T = IOT_HUB_STRINGS.listingsBar;
---

<button
	class="iot-hub-filter-bar__filter-btn"
	type="button"
	data-iot-hub-filter-toggle
	aria-expanded="false"
	aria-controls="iot-hub-filter-panel"
>
	<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<path
			d="M3 4h18l-7 8v6l-4 2v-8L3 4Z"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
	<span>{T.filter}</span>
</button>

<style lang="scss">
	@use '../../styles/_variables.scss' as *;

	.iot-hub-filter-bar__filter-btn {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 14px 16px;
		font-family: inherit;
		font-size: 16px;
		font-weight: $font-weight-semibold;
		line-height: 28px;
		color: var(--color-primary);
		background: transparent;
		border: 1px solid var(--color-primary);
		border-radius: 8px;
		min-height: 56px;
		cursor: pointer;
		flex-shrink: 0;
		transition: background $transition-fast, color $transition-fast;

		svg {
			display: block;
		}

		// `var(--color-primary)` already theme-shifts via Starlight's
		// accent token; only the inverted text on the active state needs
		// a per-theme override.
		&[aria-expanded='true'] {
			background: var(--color-primary);
			color: #ffffff;

			:global([data-theme='dark']) & {
				color: var(--neutral---sl-color-black, #17181c);
			}
		}

		@include media-down(sm) {
			padding: 16px;

			span {
				display: none;
			}
		}
	}
</style>
