---
import { IOT_HUB_STRINGS } from '@models/iot-hub';

// Status marker for listings/items the API flags `builtIn: true` — content
// that already ships inside ThingsBoard, so installing it would only create a
// duplicate.
//
//   * `card` — takes the Install button's slot on a listing card. Rendered
//     even when `hidden` is true so the Pattern C clone source
//     (ListingCardTemplate) keeps a DOM shape identical to a build-time card
//     and the runtime binder only has to flip the attribute.
//   * `meta` — an <li> for the detail hero's meta row, sitting with the
//     CE / PE badges. The matching explanatory note is rendered by DetailHero
//     in the slot the Install CTA would occupy.

interface Props {
	variant?: 'card' | 'meta';
	hidden?: boolean;
}

const { variant = 'card', hidden } = Astro.props;
const label = IOT_HUB_STRINGS.builtIn.label;
---

{
	variant === 'meta' ? (
		<li class="iot-hub-builtin iot-hub-builtin--meta">{label}</li>
	) : (
		<span class="iot-hub-builtin iot-hub-builtin--card" data-iot-hub-builtin hidden={hidden}>
			{label}
		</span>
	)
}

<style lang="scss">
	@use '../../styles/_variables.scss' as *;

	// Outlined chip: muted text on a neutral border, no fill. A filled box
	// reads as a button, and nothing here is clickable — this is a status
	// marker, not a call to action.
	.iot-hub-builtin {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: $font-weight-semibold;
		color: var(--color-text-secondary);
		background: transparent;
		border: 1px solid var(--color-border);
		white-space: nowrap;
		cursor: default;
	}

	// `[hidden]` (0,2,0) has to out-specify the `display: inline-flex` above,
	// which would otherwise win over the UA's `[hidden] { display: none }`.
	.iot-hub-builtin[hidden] {
		display: none;
	}

	// --- card variant: sits where the Install button would ------------------
	// Label only — an icon here would sit right next to the creator's
	// `verified` check and read as a second status marker on the same row.
	.iot-hub-builtin--card {
		margin-left: auto;
		padding: 4px 12px;
		font-size: 14px;
		line-height: 24px;
		border-radius: 8px;
		flex-shrink: 0;
	}

	// --- meta variant: last chip in the detail hero's meta row --------------
	// Sized like the CE / PE badges it sits beside, outlined rather than
	// filled so it doesn't compete with them for attention.
	.iot-hub-builtin--meta {
		padding: 2px 8px;
		font-size: 12px;
		line-height: 16px;
		letter-spacing: 0.4px;
		border-radius: 4px;
	}
</style>
