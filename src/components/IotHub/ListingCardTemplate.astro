---
import { type IotHubItemType, type ListingView } from '@models/iot-hub';
import type { CardShape } from './listing-card-hooks';
import ListingCard from './ListingCard.astro';

// Pattern C clone source for runtime listing-card rendering.
//
// Drop one per card shape the page can render:
//     preview  full-size card showing the listing's preview image
//     tile     full-size card showing a colour tile + glyph (no preview)
//     compact  short two-column row
//
// A page pinned to one item type clones per item via getCardVariant, so it
// needs `preview` + `compact`. A mixed grid (search / creator) forces one
// layout on every card and clones by image presence, so it needs
// `preview` + `tile`.
//
// Whichever set a page emits must match what the init guard in
// iot-hub-dynamic-search.ts requires, or dynamic search bails after the
// "already initialised" flag is set and never retries. lint:dualrender
// checks this.
//
// Usage:
//     <ListingCardTemplate variant="preview" />
//     <ListingCardTemplate variant="tile" />
//
//     const tmpl = document.querySelector<HTMLTemplateElement>(
//         '[data-listing-card-tmpl][data-variant="preview"]'
//     );
//     const clone = tmpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
//     bindListingCard(clone, item, categorySlug, { shape: 'preview' });
//
// The template renders a ListingCard with a placeholder item that has the
// same field types the binder will overwrite — that way the cloned DOM
// shape (number of children, class list, attribute presence) is identical
// to a build-time card, and Astro's scoped style hashes apply uniformly.

interface Props {
	/** Named for the shape it bakes, which is what the clone selection keys on. */
	variant: CardShape;
	titleAs?: 'h2' | 'h3';
}

const { variant, titleAs = 'h3' } = Astro.props;

// Per-variant placeholder item. Item-type drives the variant inside
// ListingCard (via getCardVariant), so pick a representative item-type
// for each. Other fields are filled by the binder.
// 'tile' passes the variant explicitly, so its item-type is irrelevant
// to the layout — but `image: null` below is load-bearing: it makes
// ListingCard bake the tile branch, which is what this clone source is for.
const placeholderItemType: IotHubItemType =
	variant === 'compact' ? 'CALCULATED_FIELD' : 'WIDGET';
const placeholderItem = {
	slug: '',
	itemType: placeholderItemType,
	name: '',
	creatorId: null,
	description: null,
	image: null,
	icon: null,
	color: null,
	seoTitle: null,
	seoMetaDescription: null,
	ogImage: null,
	categories: [],
	useCases: [],
	cfType: null,
	widgetType: null,
	ruleChainType: null,
	hardwareType: null,
	vendor: null,
	connectivity: [],
	tags: [],
	installCount: 0,
	builtIn: false,
	createdTime: null,
	updatedTime: null,
	publishedTime: null,
	creatorDisplayName: null,
	creatorAvatarUrl: null,
	creatorVerified: false,
	creatorAffiliateId: null,
	screenshots: [],
} satisfies ListingView;
---

<template data-listing-card-tmpl data-variant={variant}>
	<ListingCard
		item={placeholderItem}
		categorySlug=""
		showCreator={true}
		titleAs={titleAs}
		variant={variant === 'tile' ? 'generic' : 'auto'}
	/>
</template>
