---
// One checkbox row in the FilterPanel. Shared by the facet sections and by
// the standalone control above them, so the check mark, the hidden input and
// the classes the panel's scripts query can only ever change in one place.
interface Props {
	/** Checkbox `name` — a panel section key, or the standalone control's own. */
	name: string;
	value: string;
	label: string;
	/** `li` inside a section's list, `div` for a control that stands alone. */
	as?: 'li' | 'div';
	/** Standalone controls carry the same bottom rule a section does. */
	standalone?: boolean;
}

const { name, value, label, as: Tag = 'li', standalone = false } = Astro.props;
---

<Tag
	class:list={[
		'iot-hub-filter-option',
		{ 'iot-hub-filter-option--standalone': standalone },
	]}
>
	<label class="iot-hub-filter-option__label">
		<span class="iot-hub-filter-option__check-wrap">
			<input class="iot-hub-filter-option__input" type="checkbox" name={name} value={value} />
			<span class="iot-hub-filter-option__check" aria-hidden="true">
				<svg width="18" height="18" viewBox="0 0 18 18" fill="none">
					<path
						d="M3 9l4 4 8-8"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</span>
		</span>
		<span class="iot-hub-filter-option__text">{label}</span>
	</label>
</Tag>

<style lang="scss">
	@use '../../styles/_variables.scss' as *;

	// `--iot-hub-panel-*` are defined on `.iot-hub-filter-panel` and inherit
	// down, so they still resolve from inside this component.

	.iot-hub-filter-option--standalone {
		border-bottom: 1px solid var(--iot-hub-panel-section-border);
	}

	.iot-hub-filter-option__label {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		font-size: 14px;
		font-weight: $font-weight-normal;
		line-height: 24px;
		color: var(--color-text);
		cursor: pointer;
		transition: background $transition-fast;

		&:hover {
			background: var(--iot-hub-panel-hover-bg);
		}
	}

	.iot-hub-filter-option__check-wrap {
		position: relative;
		display: inline-flex;
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
	}

	.iot-hub-filter-option__input {
		position: absolute;
		inset: 0;
		opacity: 0;
		margin: 0;
		cursor: inherit;
	}

	.iot-hub-filter-option__check {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		border-radius: 4px;
		border: 2px solid var(--iot-hub-panel-check-border);
		background: transparent;
		color: transparent;
		transition: background $transition-fast, border-color $transition-fast,
			color $transition-fast;

		svg {
			display: block;
		}
	}

	// `var(--color-primary)` already theme-shifts via Starlight's accent
	// token (~`#b3c7ff` in dark); only the inverted text needs an override.
	.iot-hub-filter-option__input:checked + .iot-hub-filter-option__check {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #ffffff;

		:global([data-theme='dark']) & {
			color: var(--neutral---sl-color-black, #17181c);
		}
	}

	.iot-hub-filter-option__text {
		flex: 1;
		min-width: 0;
		word-break: break-word;
	}
</style>
