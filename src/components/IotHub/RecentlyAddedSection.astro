---
import { getCategoryForItemType, IOT_HUB_STRINGS, type ListingView } from '@models/iot-hub';
import ListingCard from './ListingCard.astro';

interface Props {
	/** Newest-first items across every category (already sorted + sliced). */
	items: ListingView[];
	title?: string;
	intro?: string;
}

const {
	items,
	title = 'Recently added in IoT Hub',
	intro = 'The newest reusable IoT resources published by the ThingsBoard community.',
} = Astro.props;

// Card links into its own category route; resolve the slug from itemType.
// Every public itemType maps to a category, so the '' → '#' fallback is inert.
const slugFor = (item: ListingView): string =>
	getCategoryForItemType(item.itemType)?.slug ?? '';
---

<section class="iot-hub-recent">
	<h2 class="iot-hub-recent__heading">{title}</h2>
	<p class="iot-hub-recent__intro">{intro}</p>
	{
		items.length > 0 ? (
			<div class="iot-hub-recent__grid">
				{items.map((item) => (
					<ListingCard item={item} categorySlug={slugFor(item)} variant="generic" />
				))}
			</div>
		) : (
			<p class="iot-hub-recent__empty">{IOT_HUB_STRINGS.emptyState}</p>
		)
	}
</section>

<style lang="scss">
	@use '../../styles/_variables.scss' as *;
	@use '../../styles/_iot-hub.scss' as *;

	.iot-hub-recent__heading {
		@include iot-hub-home-heading;
		margin: 0 1rem;

		@include media-down(sm) {
			margin: 0 0.75rem;
		}
	}

	.iot-hub-recent__intro {
		@include iot-hub-section-intro;
		margin: 12px 1rem 0;

		@include media-down(sm) {
			margin: 12px 0.75rem 0;
		}
	}

	.iot-hub-recent__grid {
		display: grid;
		// Generic cards keep uniform heights across this mixed-itemType strip
		// while still showing previews (see ListingCard variant="generic").
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		// 16px gutter aligns cards with the "Most popular" grids below.
		padding: 0 1rem;
		margin-top: 2rem;

		@include media-down(lg) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			// Hide the last two → two full rows of 3, not a ragged 3+3+2.
			// nth-last-child, not nth-child: in dev Astro injects ListingCard's
			// <script> as a grid child, which would offset a front count.
			:global(.iot-hub-card:nth-last-child(-n + 2)) {
				display: none;
			}
		}

		@include media-down(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			// 2 columns tile 8 into full rows — restore the hidden pair.
			:global(.iot-hub-card:nth-last-child(-n + 2)) {
				display: flex;
			}
		}

		@include media-down(sm) {
			grid-template-columns: 1fr;
			padding: 0 0.75rem;
		}
	}

	.iot-hub-recent__empty {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		margin: 1rem;
	}
</style>
