---
import { getCategoryForItemType, type ListingView } from '@models/iot-hub';
import ListingCard from './ListingCard.astro';

interface Props {
	/** Newest-first items across every category (already sorted + sliced). */
	items: ListingView[];
	title?: string;
	intro?: string;
}

const {
	items,
	title = 'Recently added in IoT Hub',
	intro = 'The newest reusable IoT resources published by the ThingsBoard community.',
} = Astro.props;

// Cross-category strip: an item's card links into its own category route, so
// resolve each slug from the itemType. Every public itemType maps to a
// category, so the '' fallback (→ inert '#' href) never fires in practice.
const slugFor = (item: ListingView): string =>
	getCategoryForItemType(item.itemType)?.slug ?? '';
---

<section class="iot-hub-recent">
	<div class="iot-hub-recent__heading">{title}</div>
	<p class="iot-hub-recent__intro">{intro}</p>
	{
		items.length > 0 ? (
			<div class="iot-hub-recent__grid">
				{items.map((item) => (
					<ListingCard item={item} categorySlug={slugFor(item)} variant="generic" />
				))}
			</div>
		) : (
			<p class="iot-hub-recent__empty">No items available yet.</p>
		)
	}
</section>

<style lang="scss">
	@use '../../styles/_variables.scss' as *;
	@use '../../styles/_iot-hub.scss' as *;

	.iot-hub-recent__heading {
		font-size: 32px;
		font-weight: $font-weight-semibold;
		line-height: 40px;
		margin: 0 1rem;
		color: var(--color-text);

		@include media-down(md) {
			font-size: 24px;
			line-height: 32px;
		}

		@include media-down(sm) {
			margin: 0 0.75rem;
		}
	}

	.iot-hub-recent__intro {
		@include iot-hub-section-intro;
		margin: 12px 1rem 0;

		@include media-down(sm) {
			margin: 12px 0.75rem 0;
		}
	}

	.iot-hub-recent__grid {
		display: grid;
		// Generic cards forced across every itemType so this cross-category strip
		// keeps uniform card heights while still showing previews where they
		// exist (see ListingCard `variant="generic"`).
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		// 16px gutter aligns the first card with the container's x=16 inset,
		// matching the "Most popular" grids below.
		padding: 0 1rem;
		margin-top: 2rem;

		@include media-down(lg) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		@include media-down(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@include media-down(sm) {
			grid-template-columns: 1fr;
			padding: 0 0.75rem;
		}
	}

	.iot-hub-recent__empty {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		margin: 1rem;
	}
</style>
