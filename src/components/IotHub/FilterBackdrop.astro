---
// Dimmer behind the FilterPanel while it is an overlay drawer (below `lg`).
// `iot-hub-filter-drawer.ts` closes the panel when it is clicked.
//
// It styles itself off the `data-filter-open` state its wrap ancestor carries,
// which is the same attribute the drawer script sets — so any page can drop it
// in beside a `<FilterPanel />` without repeating the media query.
---

<div class="iot-hub-filter-backdrop" data-iot-hub-filter-backdrop aria-hidden="true"></div>

<style lang="scss">
	@use '../../styles/_variables.scss' as *;

	.iot-hub-filter-backdrop {
		display: none;

		@include media-down(lg) {
			:global([data-iot-hub-listings-wrap][data-filter-open='true']) & {
				display: block;
				position: fixed;
				// Start below the FULL chrome (header + promo banner), tracking the
				// live banner offset, so it aligns with the panel (FilterPanel.astro
				// uses the same `var(--sl-nav-height)`).
				inset: var(--sl-nav-height) 0 0 0;
				background: rgba(0, 0, 0, 0.4);
				// Just below the panel (z-index 100) so click-outside works.
				z-index: 95;
			}
		}
	}
</style>
