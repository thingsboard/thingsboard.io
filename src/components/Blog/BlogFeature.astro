---
/**
 * BlogFeature — one feature in a `BlogGrid`: a heading, a sentence or two of Markdown and a visual
 * below it; `wide` spans the row. The h3 is rendered here, not in Markdown, to keep it out of the TOC.
 * Keep the text to one paragraph: the feature is three subgrid rows (title, text, panel).
 */
interface Props {
	title: string;
	wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<div class:list={['feature', { wide }]}>
	<h3 class="title">{title}</h3>
	<slot />
</div>

<style lang="scss">
	@use './blog-kit' as kit;

	/* title, text and panel share the row's tracks, so side-by-side panels start at the same height */
	.feature {
		display: grid;
		grid-row: span 3;
		grid-template-rows: subgrid;
		row-gap: 6px;
	}

	.wide {
		grid-column: 1 / -1;
	}

	/* outrank the article's .blog-content h3 / p */
	:global(.blog-content) .title {
		@include kit.card-title;
	}

	:global(.blog-content) .feature :global(p) {
		@include kit.card-text;
	}

	.feature > :global(.blog-panel) {
		margin-top: 10px;
	}
</style>
