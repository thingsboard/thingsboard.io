---
/**
 * BlogNote — an accented annotation panel for blog posts. Starlight's `<Aside>`
 * can't be used here: its CSS ships only with the Starlight route pipeline.
 *
 * Slotted markdown keeps the parent's scope hash, so the styles must be
 * `is:global`; `!important` beats the more specific `.blog-content p` rules.
 */
---

<aside class="blog-note" aria-label="Note">
	<slot />
</aside>

<style is:global>
	.blog-note {
		margin: 0 0 var(--spacing-6);
		padding: var(--spacing-4) var(--spacing-5);
		border-left: 3px solid var(--color-primary);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		background: color-mix(in srgb, var(--color-primary) 6%, transparent);
	}

	.blog-note p,
	.blog-note li {
		color: var(--color-text) !important;
	}

	.blog-note > :last-child {
		margin-bottom: 0 !important;
	}
</style>
