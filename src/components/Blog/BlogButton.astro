---
import Button from '@components/ui/Button.astro';
import { isExternalHref } from '@util/external-links';

interface Props {
	text: string;
	href: string;
}

const { text, href } = Astro.props;
---

{/* A div, so the article's paragraph margin does not apply. Padding, not margin: a margin would collapse into the paragraph above. */}
<div class="blog-button print:hidden">
	<Button href={href} external={isExternalHref(href)}>
		{text}
	</Button>
</div>

<style>
	.blog-button {
		padding: 16px 0;
	}
</style>
