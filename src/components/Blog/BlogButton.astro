---
import Button from '@components/ui/Button.astro';
import { isExternalHref } from '@util/external-links';

interface Props {
	text: string;
	href: string;
}

const { text, href } = Astro.props;
---

<p class="blog-button print:hidden">
	<Button href={href} external={isExternalHref(href)}>
		{text}
	</Button>
</p>

<style>
	.blog-button {
		margin: 16px 0;
	}
</style>
