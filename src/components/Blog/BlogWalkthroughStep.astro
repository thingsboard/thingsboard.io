---
/**
 * BlogWalkthroughStep — the content of one `BlogWalkthrough` step: a `BlogShot` with a sentence of
 * Markdown as the caption, or a `BlogGrid` of `BlogFeature`s.
 *
 * Slotted Markdown keeps the post's scope, so the styles are `is:global`.
 */
---

<div class="blog-walkthrough-step">
	<slot />
</div>

<style lang="scss" is:global>
	@use './blog-kit' as kit;

	/* Until the script takes over, only the first step takes space, so the page does not jump when
	   the script hides the rest. */
	.blog-walkthrough:not([data-ready]) .blog-walkthrough-step ~ .blog-walkthrough-step {
		display: none;
	}

	.blog-content .blog-walkthrough-step > .blog-grid {
		gap: 20px;
		margin: 0;
	}

	.blog-content .blog-walkthrough-step > p {
		@include kit.card-text;
		margin-top: 16px;
	}

	/* without scripting and in print every step is shown, one under another */
	@mixin all-steps {
		.blog-walkthrough .blog-walkthrough-step {
			display: block;
			content-visibility: visible;
		}

		.blog-walkthrough-step + .blog-walkthrough-step {
			margin-top: 32px;
		}
	}

	@media (scripting: none) {
		@include all-steps;
	}

	@media print {
		@include all-steps;
	}
</style>
