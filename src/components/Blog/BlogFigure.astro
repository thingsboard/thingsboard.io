---
/**
 * BlogFigure — a standalone visual (`BlogShot`, `BlogPanel`, `BlogCompare`, `BlogVideo`) with an
 * optional caption. The blog template already styles `figure` and `figcaption` inside
 * `.blog-content`. Leave the caption out when the text beside the visual already says it
 * (a `BlogBlock` has its own heading); a caption is a short sentence with no bold lead-in.
 */
interface Props {
	caption?: string;
}

const { caption } = Astro.props;
---

<figure class="blog-figure">
	<slot />
	{caption && <figcaption>{caption}</figcaption>}
</figure>
