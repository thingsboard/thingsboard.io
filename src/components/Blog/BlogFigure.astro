---
/**
 * BlogFigure — a standalone visual with its caption. A visual inside a `BlogFeature` has a heading
 * instead and goes without one.
 */
interface Props {
	caption: string;
}

const { caption } = Astro.props;
---

<figure class="blog-figure">
	<slot />
	<figcaption class="caption">{caption}</figcaption>
</figure>
