---
/**
 * BlogCallout — bordered panel for a blog post, with an optional uppercase
 * eyebrow label above the content and an optional muted footnote below it.
 *
 * Groups a block (a summary list, a comparison table, a one-line statement)
 * into a deliberate panel instead of leaving it as running prose. Unlike a
 * blockquote — which the blog styles with an accent bar and reads as a
 * quotation — this reads as a figure.
 *
 * Styling follows the sibling blog components (`BlogCTA`, `BlogButton`):
 * inline `style` attributes on the chrome, so the markup carries its own
 * appearance and nothing has to be scoped. The one `is:global` block exists
 * because slotted content keeps the *parent's* scope hash, so a scoped
 * selector here could never match the markdown the caller passes in.
 */
interface Props {
	/** Eyebrow above the content. Rendered uppercase — pass it in sentence case. */
	label?: string;
	/** Muted footnote below the content, e.g. a table caption. */
	note?: string;
}

const { label, note } = Astro.props;
---

<div
	class="blog-callout"
	style="margin:32px 0;padding:20px 24px;border-radius:var(--radius-lg);background:var(--color-bg-light);border:1px solid var(--color-border);"
>
	{
		label && (
			<p
				class="blog-callout__label"
				style="font-size:0.75rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-text-muted);margin:0 0 12px;line-height:1.4;"
			>
				{label}
			</p>
		)
	}
	<div class="blog-callout__body">
		<slot />
	</div>
	{
		note && (
			<p
				class="blog-callout__note"
				style="font-size:0.875rem;color:var(--color-text-muted);margin:12px 0 0;line-height:1.6;"
			>
				{note}
			</p>
		)
	}
</div>

<style is:global>
	/* Trailing margin on the last block would double the panel's bottom padding.
	   The blog's content styles put a bottom margin on every p/ul/ol/table. */
	.blog-callout__body > :last-child {
		margin-bottom: 0 !important;
	}

	/* A list is the whole content of a table cell — its own margin just pushes
	   the cell's padding around. */
	.blog-callout td > :last-child,
	.blog-callout th > :last-child {
		margin-bottom: 0 !important;
	}

	/* Columns of a callout table hold lists of unequal length, so the default
	   middle alignment floats the shorter column against the taller one. */
	.blog-callout th,
	.blog-callout td {
		vertical-align: top;
		text-align: left;
	}

	/* The blog's default cell border is `--color-border`, which is a hair away
	   from this panel's own background — the grid all but disappears on it. Cells
	   get the page surface so the table reads as an object sitting on the panel,
	   and a border mixed from the text colour so it stays visible in both themes. */
	.blog-callout th,
	.blog-callout td {
		background: var(--color-bg-surface);
		border-color: color-mix(in srgb, var(--color-text) 20%, transparent);
	}

	.blog-callout th {
		background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg-surface));
	}

	/* The panel already supplies the outer spacing. */
	.blog-callout__body > table:first-child {
		margin-top: 0;
	}

	@media print {
		.blog-callout__label {
			break-after: avoid;
		}

		.blog-callout__note {
			break-before: avoid;
		}

		.blog-callout li a[href^='#']:last-child {
			display: none;
		}
	}
</style>
