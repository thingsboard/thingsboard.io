---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// 480 and 800 for phones at 1x–2x, 1200 for a desktop card at 2x.
const WIDTHS = [480, 800, 1200];

interface Props {
	src: ImageMetadata;
	alt: string;
	sizes: string;
	/** Widths on top of the default three. */
	extraWidths?: number[];
	/** `high` for the page's LCP image, `low` to hold an image back. */
	priority?: 'high' | 'low';
}

const { src, alt, sizes, extraWidths = [], priority } = Astro.props;
---

<Image
	src={src}
	alt={alt}
	sizes={sizes}
	width={WIDTHS.at(-1)}
	widths={[...WIDTHS, ...extraWidths]}
	loading={priority === 'high' ? 'eager' : 'lazy'}
	fetchpriority={priority}
	decoding="async"
/>
