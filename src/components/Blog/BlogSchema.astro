---
/**
 * BlogSchema — a one-row diagram in the visual language of the docs diagram SVGs: tinted boxes
 * with a 1px stroke, an icon tile in the family's dark shade, bold labels, and short arrows
 * coloured like the box they leave. Text stays selectable and themes with the page.
 *
 * Meant for the simple case a post needs: a linear path, or two rows shown as before and after.
 * Anything spatial or with many edges stays an exported light/dark SVG pair. `grid` adds the
 * dotted background the docs use on multilayer diagrams.
 *
 * Scrolls sideways when the row is wider than the column.
 */
import BlogIconTile from '@components/Blog/BlogIconTile.astro';
import type { BlogIconName, SchemaFamily } from '@components/Blog/blog-icons';

interface Node {
	label: string;
	icon: BlogIconName;
	family: SchemaFamily;
}

interface Props {
	nodes: Node[];
	grid?: boolean;
}

const { nodes, grid = false } = Astro.props;
const description = nodes.map((n) => n.label).join(' → ');
---

<div class:list={['blog-schema', { 'blog-schema--grid': grid }]}>
	<div class="blog-schema__row" role="img" aria-label={description}>
		{nodes.map((n, i) => (
			<>
				{i > 0 && (
					<svg
						class="blog-schema__arrow"
						style={`color:var(--schema-${nodes[i - 1].family}-stroke)`}
						viewBox="0 0 26 12"
						aria-hidden="true"
					>
						<path
							d="M1 6h23M19.5 1.5 24 6l-4.5 4.5"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				)}
				<div
					class="blog-schema__box"
					style={`--fill:var(--schema-${n.family}-fill);--stroke:var(--schema-${n.family}-stroke)`}
				>
					<BlogIconTile icon={n.icon} family={n.family} />
					{n.label}
				</div>
			</>
		))}
	</div>
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.blog-schema {
		overflow-x: auto;
		margin: 0 0 var(--spacing-4);
	}

	.blog-schema--grid {
		padding: 20px 20px 12px;
		border-radius: 6px;
		background-color: var(--color-bg-surface);
		background-image: radial-gradient(
			color-mix(in srgb, var(--color-text-light) 50%, transparent) 1.1px,
			transparent 1.3px
		);
		background-position: 4px 4px;
		background-size: 16px 16px;
	}

	.blog-schema__row {
		display: flex;
		align-items: center;
		gap: 3px;
		width: max-content;
		padding: 2px 0;
	}

	.blog-schema__box {
		@include text-s;
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 9px;
		padding: 7px 12px 7px 7px;
		border: 1px solid var(--stroke);
		border-radius: 7px;
		background: var(--fill);
		font-weight: $font-weight-bold;
		white-space: nowrap;
	}

	.blog-schema__arrow {
		display: block;
		flex: 0 0 auto;
		width: 26px;
		height: 12px;
	}
</style>
