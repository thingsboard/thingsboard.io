---
/**
 * BlogSchema — a one-row diagram of coloured boxes joined by arrows, styled like the docs diagram
 * SVGs; scrolls sideways when wider than the column. Anything with branches stays an exported SVG.
 */
import BlogIconTile from '@components/Blog/BlogIconTile.astro';
import type { SchemaFamily } from '@components/Blog/blog-kit';

interface Node {
	label: string;
	/** A Tabler icon name, as in `BlogIconTile`. */
	icon: string;
	family: SchemaFamily;
}

interface Props {
	nodes: Node[];
}

const { nodes } = Astro.props;
const description = nodes.map((n) => n.label).join(' → ');
---

<div class="schema" role="img" aria-label={description}>
	{nodes.map((n, i) => (
		<>
			{i > 0 && (
				<svg class="arrow" data-schema-family={nodes[i - 1].family} viewBox="0 0 26 12" aria-hidden="true">
					<path
						d="M1 6h23M19.5 1.5 24 6l-4.5 4.5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			)}
			<div class="box" data-schema-family={n.family}>
				<BlogIconTile icon={n.icon} family={n.family} />
				{n.label}
			</div>
		</>
	))}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	.schema {
		display: flex;
		align-items: center;
		gap: 3px;
		overflow-x: auto;
		margin: 0 0 var(--spacing-4);
		padding: 2px 0;
	}

	.box {
		@include text-s;
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 9px;
		padding: 7px 12px 7px 7px;
		border: 1px solid var(--family-stroke);
		border-radius: 7px;
		background: var(--family-fill);
		font-weight: $font-weight-bold;
		white-space: nowrap;
	}

	/* coloured like the box it leaves */
	.arrow {
		flex: 0 0 auto;
		width: 26px;
		height: 12px;
		color: var(--family-stroke);
	}
</style>
