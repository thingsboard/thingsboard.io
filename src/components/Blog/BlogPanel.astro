---
/**
 * BlogPanel — a gradient surface around a `BlogShot` or `BlogVideo`, at most 520px wide or nearly
 * full width with `size="wide"`. `tone="dark"` looks the same in both themes.
 */
interface Props {
	tone?: 'light' | 'dark';
	size?: 'default' | 'wide';
}

const { tone = 'light', size = 'default' } = Astro.props;
---

<div class:list={['blog-panel', { dark: tone === 'dark', wide: size === 'wide' }]}>
	<slot />
</div>

<style>
	.blog-panel {
		display: grid;
		place-items: center;
		padding: 24px;
		border-radius: var(--radius-md);
		background: linear-gradient(135deg, var(--blog-panel-from), var(--blog-panel-to));
	}

	.blog-panel > :global(:is(.blog-shot, .blog-video)) {
		width: 100%;
		max-width: 520px;
	}

	.wide > :global(:is(.blog-shot, .blog-video)) {
		max-width: 92%;
	}

	/* BlogShot and BlogVideo read their shadow from --blog-shot-shadow */
	.dark {
		--blog-shot-shadow: 0 2px 4px rgba(0, 0, 0, 0.25), 0 18px 40px -10px rgba(0, 0, 0, 0.55);
		background: linear-gradient(135deg, #00403a, #0b5a6c 55%, #0f5d8f);
	}
</style>
