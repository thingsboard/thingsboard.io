---
/**
 * BlogVideo — a short looped screen recording framed like a `BlogShot`; `GifVideo` loads and plays it.
 * `src` is a public path without an extension, next to `{src}.webm`, `{src}.mp4` and `{src}.jpg`.
 * `width`/`height` are the clip's pixel size, so the box is reserved before it loads.
 */
import GifVideo from '@components/GifVideo.astro';

interface Props {
	src: string;
	width: number;
	height: number;
	/** What the clip shows, for a reader who cannot see it. */
	label: string;
}

const { src, width, height, label } = Astro.props;
---

<div class="blog-video">
	<GifVideo
		srcWebm={`${src}.webm`}
		srcMp4={`${src}.mp4`}
		poster={`${src}.jpg`}
		width={width}
		height={height}
		alt={label}
		threshold={0.25}
	/>
</div>

<style lang="scss">
	@use './blog-kit' as kit;

	.blog-video {
		@include kit.media-frame;
	}

	/* the video is GifVideo's, outside this component's scope */
	.blog-video :global(video) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
	}
</style>
