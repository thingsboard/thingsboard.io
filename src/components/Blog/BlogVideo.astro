---
/**
 * BlogVideo — a short looped screen recording, the `BlogShot` of moving things: same rounding
 * and shadow, the same two placements (on its own at column width, or inside a `BlogPanel`).
 *
 * `src` is the public path without an extension; the folder holds `{src}.webm`, `{src}.mp4` and
 * the poster `{src}.{poster}`, as produced by the blog kit's prepare-video script (H.264 and VP9,
 * no audio, at most 1600px wide). `width`/`height` are the clip's pixel size, so the box is
 * reserved before anything loads.
 *
 * The clip pauses when it scrolls out of view. Under prefers-reduced-motion it does not
 * autoplay: the poster shows with a play button.
 */
interface Props {
	src: string;
	width: number;
	height: number;
	/** What the clip shows, for a reader who cannot see it. */
	label: string;
	poster?: 'webp' | 'jpg';
}

const { src, width, height, label, poster = 'jpg' } = Astro.props;
---

<div class="blog-video">
	<video
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster={`${src}.${poster}`}
		width={width}
		height={height}
		aria-label={label}
	>
		<source src={`${src}.webm`} type="video/webm" />
		<source src={`${src}.mp4`} type="video/mp4" />
	</video>
</div>

<script>
	const videos = document.querySelectorAll<HTMLVideoElement>('.blog-video video');
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (reduce) {
		for (const v of videos) {
			const box = v.parentElement!;
			v.removeAttribute('autoplay');
			v.pause();
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'blog-video__play';
			btn.setAttribute('aria-label', 'Play');
			btn.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
			box.append(btn);
			btn.addEventListener('click', () => {
				btn.remove();
				v.play();
			});
		}
	} else if (videos.length && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					const v = e.target as HTMLVideoElement;
					if (e.isIntersecting) v.play().catch(() => {});
					else v.pause();
				}
			},
			{ threshold: 0.25 }
		);
		for (const v of videos) io.observe(v);
	}
</script>

<style is:global>
	.blog-video {
		position: relative;
		border-radius: 6px;
		background: var(--color-bg-light);
		box-shadow: var(--blog-shot-shadow);
	}

	.blog-video video {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 6px;
	}

	.blog-video__play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		margin: auto;
		border: none;
		border-radius: 50%;
		background: rgba(23, 24, 28, 0.72);
		color: #fff;
		cursor: pointer;
	}

	.blog-video__play svg {
		width: 22px;
		height: 22px;
		margin-left: 3px;
	}
</style>
