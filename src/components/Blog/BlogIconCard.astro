---
/**
 * BlogIconCard — a bordered feature card for a `BlogGrid tight`: an icon tile, a short heading
 * and one or two sentences of Markdown. The border groups a repeated unit, which is the only
 * reason a blog item gets chrome. The tile uses the diagram palette, so cards and a
 * `BlogSchema` in the same post read as one set.
 */
import BlogIconTile from '@components/Blog/BlogIconTile.astro';
import type { BlogIconName, SchemaFamily } from '@components/Blog/blog-icons';

interface Props {
	title: string;
	icon: BlogIconName;
	family: SchemaFamily;
}

const { title, icon, family } = Astro.props;
---

<div class="blog-icon-card">
	<BlogIconTile icon={icon} family={family} size={48} />
	<h3 class="blog-icon-card__title">{title}</h3>
	<div class="blog-icon-card__body">
		<slot />
	</div>
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	/* rows keep their size, so a shorter card does not push its text down */
	.blog-icon-card {
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr);
		align-content: start;
		gap: 4px 16px;
		padding: 18px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg-surface);
	}

	.blog-icon-card > .blog-icon-tile {
		grid-row: 1 / 3;
	}

	.blog-content .blog-icon-card__title {
		@include text-m;
		margin: 0;
		font-weight: $font-weight-semibold;
		line-height: 48px;
	}

	.blog-content .blog-icon-card__body p {
		@include text-s;
		margin: 0;
		color: var(--color-text-secondary);
	}
</style>
