---
/**
 * BlogIconCard — a bordered card for a `BlogGrid tight`: an icon tile, a heading and a sentence or
 * two of Markdown.
 */
import BlogIconTile from '@components/Blog/BlogIconTile.astro';
import type { SchemaFamily } from '@components/Blog/blog-kit';

interface Props {
	title: string;
	/** A Tabler icon name, as in `BlogIconTile`. */
	icon: string;
	family: SchemaFamily;
}

const { title, icon, family } = Astro.props;
---

<div class="card">
	<BlogIconTile icon={icon} family={family} />
	<h3 class="title">{title}</h3>
	<div class="body">
		<slot />
	</div>
</div>

<style lang="scss">
	@use './blog-kit' as kit;

	/* rows keep their size, so a shorter card does not push its text down */
	.card {
		@include kit.card-shell;
		--blog-tile-size: 48px;
		--blog-tile-radius: var(--radius-md);
		display: grid;
		grid-template-columns: var(--blog-tile-size) minmax(0, 1fr);
		align-content: start;
		gap: 4px 16px;
		background: var(--color-bg-surface);
	}

	.card > :global(.blog-icon-tile) {
		grid-row: 1 / 3;
	}

	/* the title is centred on the tile beside it */
	:global(.blog-content) .title {
		@include kit.card-title;
		line-height: var(--blog-tile-size);
	}

	/* the body is one grid cell, however many paragraphs the slot holds */
	:global(.blog-content) .body :global(p) {
		@include kit.card-text;
	}
</style>
