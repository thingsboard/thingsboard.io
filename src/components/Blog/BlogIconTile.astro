---
/**
 * BlogIconTile — a square icon tile in a diagram family's dark shade, the same tile the docs
 * diagram SVGs draw beside a box label. `BlogSchema` uses it at 28px, `BlogIconCard` at 48px,
 * so diagrams and feature cards in a post share one palette.
 */
import { BLOG_ICONS, type BlogIconName, type SchemaFamily } from '@components/Blog/blog-icons';

interface Props {
	icon: BlogIconName;
	family: SchemaFamily;
	size?: 28 | 48;
}

const { icon, family, size = 28 } = Astro.props;
---

<span
	class:list={['blog-icon-tile', { 'blog-icon-tile--lg': size === 48 }]}
	style={`--tile:var(--schema-${family}-tile);--ico:var(--schema-${family}-ico)`}
	aria-hidden="true"
>
	<svg
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		set:html={BLOG_ICONS[icon]}
	/>
</span>

<style is:global>
	.blog-icon-tile {
		--size: 28px;
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: var(--size);
		height: var(--size);
		border-radius: 4px;
		background: var(--tile);
		color: var(--ico);
	}

	.blog-icon-tile svg {
		width: calc(var(--size) * 0.64);
		height: calc(var(--size) * 0.64);
	}

	.blog-icon-tile--lg {
		--size: 48px;
		border-radius: 6px;
	}
</style>
