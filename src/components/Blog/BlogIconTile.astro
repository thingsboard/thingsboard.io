---
/**
 * BlogIconTile — a Tabler icon on a square tile in a diagram family's colours. 28px; a parent
 * resizes it with `--blog-tile-size` and `--blog-tile-radius`.
 */
import { Icon } from 'astro-icon/components';
import type { SchemaFamily } from '@components/Blog/blog-kit';

interface Props {
	/** A Tabler icon name without the `tabler:` prefix, e.g. `cpu`. */
	icon: string;
	family: SchemaFamily;
}

const { icon, family } = Astro.props;
---

<span class="blog-icon-tile" data-schema-family={family} aria-hidden="true">
	<Icon name={`tabler:${icon}`} />
</span>

<style>
	.blog-icon-tile {
		--size: var(--blog-tile-size, 28px);
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: var(--size);
		height: var(--size);
		border-radius: var(--blog-tile-radius, var(--radius-sm));
		background: var(--family-tile);
		color: var(--family-ico);
	}

	.blog-icon-tile :global(svg) {
		width: calc(var(--size) * 0.64);
		height: calc(var(--size) * 0.64);
	}
</style>
