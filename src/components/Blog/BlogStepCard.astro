---
/**
 * BlogStepCard — one numbered step for a `BlogGrid columns={3}`: the number, a short heading and
 * a sentence of Markdown, usually with the link that does the step. Borderless background, so a
 * row of steps reads lighter than feature cards.
 */
interface Props {
	step: number;
	title: string;
}

const { step, title } = Astro.props;
---

<div class="blog-step-card">
	<span class="blog-step-card__num" aria-hidden="true">
		{step}
	</span>
	<h3 class="blog-step-card__title">
		<span class="sr-only">Step {step}: </span>
		{title}
	</h3>
	<div class="blog-step-card__body">
		<slot />
	</div>
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.blog-step-card {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 18px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.blog-step-card__num {
		@include text-xs;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--sl-color-black); /* as BlogCTA: --color-primary turns light in the dark theme */
		font-weight: $font-weight-bold;
	}

	.blog-content .blog-step-card__title {
		@include text-m;
		margin: 0;
		font-weight: $font-weight-semibold;
	}

	.blog-content .blog-step-card__body p {
		@include text-s;
		margin: 0;
		color: var(--color-text-secondary);
	}
</style>
