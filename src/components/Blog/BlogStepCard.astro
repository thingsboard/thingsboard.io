---
/**
 * BlogStepCard — one numbered step for a `BlogGrid columns={3}`: the number, a heading and a
 * sentence of Markdown, usually with the link that does the step.
 */
interface Props {
	step: number;
	title: string;
}

const { step, title } = Astro.props;
---

<div class="card">
	<span class="num" aria-hidden="true">
		{step}
	</span>
	<h3 class="title">
		<span class="sr-only">Step {step}: </span>
		{title}
	</h3>
	<slot />
</div>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use './blog-kit' as kit;

	.card {
		@include kit.card-shell;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.num {
		@include text-xs;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--sl-color-black); /* as BlogCTA: --color-primary turns light in the dark theme */
		font-weight: $font-weight-bold;
	}

	:global(.blog-content) .title {
		@include kit.card-title;
	}

	:global(.blog-content) .card :global(p) {
		@include kit.card-text;
	}
</style>
