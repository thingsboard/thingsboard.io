---
/**
 * BlogGrid — side-by-side `BlogFeature`s or cards, in one column below `md`. `tight` narrows the gap
 * for cards; three columns are always tight.
 */
interface Props {
	columns?: 2 | 3;
	tight?: boolean;
}

const { columns = 2, tight = false } = Astro.props;
---

<div class:list={['columns', { three: columns === 3, tight: tight || columns === 3 }]}>
	<slot />
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	.columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px 32px;
		margin: var(--spacing-4) 0 var(--spacing-6);

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.three {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.tight {
		gap: 12px;
	}

	/* consecutive grids keep the row gap; block margins would collapse */
	.columns + .columns {
		margin-top: 40px;
	}

	@include media-down(md) {
		.three {
			grid-template-columns: 1fr;
		}
	}
</style>
