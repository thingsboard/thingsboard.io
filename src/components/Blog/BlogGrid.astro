---
/**
 * BlogGrid — the one layout for side-by-side content in a post: `BlogBlock`s, `BlogIconCard`s
 * or `BlogStepCard`s. Two columns by default, three with `columns={3}`; `tight` narrows the gap
 * for cards. A single column below 750px.
 */
interface Props {
	columns?: 2 | 3;
	tight?: boolean;
}

const { columns = 2, tight = false } = Astro.props;
---

<div class:list={['blog-columns', { 'blog-columns--3': columns === 3, 'blog-columns--tight': tight || columns === 3 }]}>
	<slot />
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.blog-columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px 32px;
		margin: var(--spacing-4) 0 var(--spacing-6);

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.blog-columns--3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.blog-columns--tight {
		gap: 12px;
	}

	/* consecutive grids keep the row gap; block margins would collapse */
	.blog-columns + .blog-columns {
		margin-top: 40px;
	}

	@include media-down(md) {
		.blog-columns--3 {
			grid-template-columns: 1fr;
		}
	}
</style>
