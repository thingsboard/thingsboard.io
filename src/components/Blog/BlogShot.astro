---
/**
 * BlogShot — a product screenshot with optional `rings`: highlights placed in percent of the image
 * box, so they hold at any rendered size. `pill` rounds a ring fully, for a toggle.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { BLOG_IMAGE_SIZES, BLOG_IMAGE_WIDTHS } from '@components/Blog/blog-kit';

interface Ring {
	left: number;
	top: number;
	width: number;
	height: number;
	pill?: boolean;
}

interface Props {
	src: ImageMetadata;
	alt: string;
	rings?: Ring[];
	/** For the first screenshot, usually the post's largest paint. */
	eager?: boolean;
}

const { src, alt, rings = [], eager = false } = Astro.props;
---

<div class="blog-shot">
	<Image
		src={src}
		alt={alt}
		widths={BLOG_IMAGE_WIDTHS}
		sizes={BLOG_IMAGE_SIZES}
		loading={eager ? 'eager' : 'lazy'}
		decoding="async"
	/>
	{rings.map((r) => (
		<div
			class:list={['ring', { pill: r.pill }]}
			style={`left:${r.left}%;top:${r.top}%;width:${r.width}%;height:${r.height}%`}
		/>
	))}
</div>

<style lang="scss">
	@use './blog-kit' as kit;

	.blog-shot {
		@include kit.media-frame;
	}

	/* outrank the margin .blog-content img sets */
	:global(.blog-content) .blog-shot > :global(img) {
		width: 100%;
		margin: 0;
	}

	.ring {
		position: absolute;
		pointer-events: none;
	}

	.ring::before {
		content: '';
		position: absolute;
		inset: -8px;
		border: 2px solid var(--blog-ring);
		border-radius: 12px;
		box-shadow:
			0 0 0 6px color-mix(in srgb, var(--blog-ring) 18%, transparent),
			0 0 0 16px color-mix(in srgb, var(--blog-ring) 7%, transparent),
			0 0 24px 10px color-mix(in srgb, var(--blog-ring) 12%, transparent);
	}

	.pill::before {
		border-radius: 999px;
	}
</style>
