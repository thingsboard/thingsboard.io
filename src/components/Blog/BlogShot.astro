---
/**
 * BlogShot — a product screenshot: 6px rounding, a soft layered shadow, no border.
 *
 * The image is served at its natural size (Astro reads it from `src/assets`, writes width and
 * height, and converts it to WebP) and scaled down by CSS, so a 1x capture wider than the column
 * stays sharp on retina and the blog lightbox opens it at full size.
 *
 * `rings` are annotation overlays, placed in percent of the image box so they hold at any
 * rendered size. Each ring is drawn 8px outside the element it marks with a wide glow, so it can
 * not be mistaken for the product's own focus state. `pill` rounds it fully, for a toggle.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Ring {
	left: number;
	top: number;
	width: number;
	height: number;
	pill?: boolean;
}

interface Props {
	src: ImageMetadata;
	alt: string;
	rings?: Ring[];
	/** The first screenshot of a post is usually its largest paint; load it eagerly. */
	eager?: boolean;
}

const { src, alt, rings = [], eager = false } = Astro.props;
---

<div class="blog-shot">
	<Image src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
	{rings.map((r) => (
		<div
			class:list={['blog-shot__ring', { 'blog-shot__ring--pill': r.pill }]}
			style={`left:${r.left}%;top:${r.top}%;width:${r.width}%;height:${r.height}%`}
		/>
	))}
</div>

<style is:global>
	.blog-shot {
		position: relative;
		border-radius: 6px;
		background: var(--color-bg-light);
		box-shadow: var(--blog-shot-shadow);
	}

	/* .blog-content img sets its own margin and radius; this has to outrank it */
	.blog-content .blog-shot > img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: 6px;
	}

	.blog-shot__ring {
		position: absolute;
		pointer-events: none;
	}

	.blog-shot__ring::before {
		content: '';
		position: absolute;
		inset: -8px;
		border: 2px solid var(--blog-ring);
		border-radius: 12px;
		box-shadow:
			0 0 0 6px color-mix(in srgb, var(--blog-ring) 18%, transparent),
			0 0 0 16px color-mix(in srgb, var(--blog-ring) 7%, transparent),
			0 0 24px 10px color-mix(in srgb, var(--blog-ring) 12%, transparent);
	}

	.blog-shot__ring--pill::before {
		border-radius: 999px;
	}
</style>
