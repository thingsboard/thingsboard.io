---
/**
 * BlogBlock — one item of a `BlogGrid`: a small heading, a sentence or two of Markdown, and a
 * visual (usually a `BlogPanel`) below, with no chrome around it. `wide` spans the whole row,
 * for a whole-screen capture. The heading text is the caption, so the visual needs none.
 *
 * The heading is an h3 written by the component, not by Markdown, so it stays out of the
 * post's table of contents.
 */
interface Props {
	title: string;
	wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<div class:list={['blog-block', { 'blog-block--wide': wide }]}>
	<h3 class="blog-block__title">{title}</h3>
	<slot />
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.blog-block {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.blog-block--wide {
		grid-column: 1 / -1;
	}

	/* outrank the article's .blog-content h3 / p */
	.blog-content .blog-block__title {
		@include text-m;
		margin: 0;
		font-weight: $font-weight-semibold;
	}

	.blog-content .blog-block p {
		@include text-s;
		margin: 0;
		color: var(--color-text-secondary);
	}

	.blog-block > .blog-panel {
		flex: 1;
		margin-top: 10px;
	}

	.blog-block--wide > .blog-panel {
		flex: 0 0 auto;
	}
</style>
