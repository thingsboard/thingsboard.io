---
/**
 * LicenseResetSteps — the shared "How to fix" instructions for license errors that are
 * resolved by resetting the instance license data file.
 *
 * Renders Linux / Docker tabs for the same sequence: stop the service → delete the
 * instance license data file → (optionally deactivate the instance on the License Portal)
 * → start the service again.
 *
 * The file name comes from `TB_LICENSE_INSTANCE_DATA_FILE`. `instance-license.data` is only
 * the default when that variable is unset (the Linux package case); every PE Compose example
 * in `@includes/docs/installation/docker.mdx` sets it to `/data/license.data`, so the Docker
 * tab covers that path for both named-volume and bind-mount deployments.
 *
 * Used by ACTIVE_INSTANCES_CAPACITY_EXCEEDED (104), INSTANCE_NOT_FOUND (105),
 * INVALID_LICENSE_CHECK_SECRET (107) and INSTANCE_NOT_ACTIVE (108) in
 * @includes/docs/troubleshooting.mdx.
 *
 * Usage:
 *   <LicenseResetSteps />             delete the license data file and restart
 *   <LicenseResetSteps deactivate />  also deactivate the instance on the License Portal
 */
import { Tabs, TabItem, Steps, Code } from '@astrojs/starlight/components';

interface Props {
	/** Insert the License Portal deactivation step before the service is started again. */
	deactivate?: boolean;
}

const { deactivate = false } = Astro.props;

const LICENSE_PORTAL_URL = 'https://license.thingsboard.io';

const stopServiceCmd = 'sudo systemctl stop thingsboard';
const deleteLicenseCmd = 'sudo rm -f /usr/share/thingsboard/bin/instance-license.data';
const startServiceCmd = 'sudo systemctl start thingsboard';
const stopContainerCmd = 'docker stop [THINGSBOARD_CONTAINER_NAME]';
// Named volume: there is no host path to `cd` into, so the file is removed from inside a
// throwaway container that mounts the same volume.
const deleteLicenseNamedVolumeCmd = 'docker run --rm -v tb-pe-license-data:/data alpine rm -f /data/license.data';
const deleteLicenseBindMountCmd = 'sudo rm -f license.data';
const startContainerCmd = 'docker start [THINGSBOARD_CONTAINER_NAME]';

// Both tabs share this step. Astro frontmatter is TypeScript, not TSX, so the markup is
// kept as a string and injected with `set:html` instead of being duplicated per tab.
const deactivateStepHtml =
	`On the <a href="${LICENSE_PORTAL_URL}">ThingsBoard License Portal</a>, locate and deactivate ` +
	`the current active instance via <strong>MANAGE INSTANCES</strong>. Do <strong>not</strong> ` +
	`delete the license key and do <strong>not</strong> change the instance count.`;
---

<Tabs>
	<TabItem label="Linux">
		<Steps>
			<ol>
				<li>Stop the ThingsBoard service:<Code code={stopServiceCmd} lang="bash" /></li>
				<li>Delete the license data file:<Code code={deleteLicenseCmd} lang="bash" /></li>
				{deactivate && <li set:html={deactivateStepHtml} />}
				<li>Start the ThingsBoard service:<Code code={startServiceCmd} lang="bash" /></li>
			</ol>
		</Steps>
	</TabItem>
	<TabItem label="Docker">
		<Steps>
			<ol>
				<li>Stop the container:<Code code={stopContainerCmd} lang="bash" /></li>
				<li>
					Check your <code dir="auto">docker-compose.yml</code> for the license data file path (<code dir="auto"
						>TB_LICENSE_INSTANCE_DATA_FILE</code
					>, set to{' '}
					<code dir="auto">/data/license.data</code> in the ThingsBoard PE Docker guide) and for how{' '}
					<code dir="auto">/data</code> is mounted.
				</li>
				<li>
					Delete the license data file. If <code dir="auto">/data</code> is a <strong>named volume</strong>{' '}
					(the default in the ThingsBoard PE Docker guide, where it is named{' '}
					<code dir="auto">tb-pe-license-data</code>), remove the file from inside a temporary container:
					<Code code={deleteLicenseNamedVolumeCmd} lang="bash" />
					If <code dir="auto">/data</code> is a <strong>bind mount</strong> (e.g.{' '}
					<code dir="auto">./mytbpe-data:/data</code>), navigate into that host directory and delete the file there:
					<Code code={deleteLicenseBindMountCmd} lang="bash" />
				</li>
				{deactivate && <li set:html={deactivateStepHtml} />}
				<li>Start the container:<Code code={startContainerCmd} lang="bash" /></li>
			</ol>
		</Steps>
	</TabItem>
</Tabs>
