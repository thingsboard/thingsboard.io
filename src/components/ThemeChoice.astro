---
import { Icon } from 'astro-icon/components';

// The footer's Appearance control: System, Light or Dark. It saves the choice where `starlight/ThemeProvider`
// reads it before the page paints (localStorage `starlight-theme`, '' for System). One per page: its id is fixed.
const OPTIONS = [
	{ value: 'auto', label: 'System', icon: 'tabler:device-desktop' },
	{ value: 'light', label: 'Light', icon: 'tabler:sun' },
	{ value: 'dark', label: 'Dark', icon: 'tabler:moon' },
] as const;
---

<theme-choice>
	<span id="theme-choice-label">Appearance</span>
	<span class="theme-choice__options" role="radiogroup" aria-labelledby="theme-choice-label">
		{OPTIONS.map((o) => (
			<button
				type="button"
				class="theme-choice__option"
				role="radio"
				aria-checked={o.value === 'auto' ? 'true' : 'false'}
				tabindex={o.value === 'auto' ? 0 : -1}
				data-value={o.value}
			>
				<Icon name={o.icon} size={16} aria-hidden="true" />
				{o.label}
			</button>
		))}
	</span>
</theme-choice>

<script>
	type Theme = 'auto' | 'light' | 'dark';

	const STORAGE_KEY = 'starlight-theme';

	function savedTheme(): Theme {
		try {
			const value = localStorage.getItem(STORAGE_KEY);
			return value === 'light' || value === 'dark' ? value : 'auto';
		} catch {
			return 'auto';
		}
	}

	function applyTheme(theme: Theme) {
		const system = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
		document.documentElement.dataset.theme = theme === 'auto' ? system : theme;
		try {
			localStorage.setItem(STORAGE_KEY, theme === 'auto' ? '' : theme);
		} catch {
			// Site data is blocked: the choice holds on this page only, kept where `starlight/ThemeProvider`
			// looks when the system theme changes.
			document.documentElement.dataset.themeChoice = theme;
		}
	}

	class ThemeChoice extends HTMLElement {
		connectedCallback() {
			const options = [...this.querySelectorAll<HTMLButtonElement>('[role="radio"]')];

			const check = (theme: Theme) => {
				for (const option of options) {
					const checked = option.dataset.value === theme;
					option.setAttribute('aria-checked', String(checked));
					option.tabIndex = checked ? 0 : -1;
				}
			};

			const choose = (option: HTMLButtonElement) => {
				const theme = option.dataset.value as Theme;
				check(theme);
				applyTheme(theme);
			};

			check(savedTheme());

			for (const option of options) option.addEventListener('click', () => choose(option));

			// Keys pressed with Alt, Ctrl or Cmd stay with the browser: Alt+Left is Back.
			this.addEventListener('keydown', (e) => {
				if (e.altKey || e.ctrlKey || e.metaKey) return;
				const last = options.length - 1;
				const at = options.findIndex((o) => o.getAttribute('aria-checked') === 'true');
				let to: number;
				if (e.key === 'ArrowRight' || e.key === 'ArrowDown') to = at === last ? 0 : at + 1;
				else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') to = at === 0 ? last : at - 1;
				else if (e.key === 'Home') to = 0;
				else if (e.key === 'End') to = last;
				else return;
				e.preventDefault();
				choose(options[to]);
				options[to].focus();
			});
		}
	}

	customElements.define('theme-choice', ThemeChoice);
</script>

<style is:global lang="scss">
	@use '../styles/variables' as *;
	@use '../styles/surface' as *;
	@use '../styles/ui' as *;

	$option-height: 28px;

	theme-choice {
		--_text: var(--color-text-secondary);
		--_text-checked: var(--color-text);
		--_fill-checked: color-mix(in srgb, var(--color-brand) 14%, transparent);

		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2 $spacing-3;
		color: var(--_text);
		@include type-nav-note;

		@include in-dark-section {
			--_text: #{$on-dark-text-muted};
			--_text-checked: var(--color-white);
			--_fill-checked: rgba(255, 255, 255, 0.12);
		}

		// Hidden until the script runs, since the buttons do nothing without it; `visibility` keeps the space.
		&:not(:defined) {
			visibility: hidden;
		}
	}

	.theme-choice__options {
		display: flex;
		gap: 2px;
		padding: 2px;
		border: 1px solid color-mix(in srgb, var(--_text-checked) 18%, transparent);
		border-radius: $radius-md;
	}

	.theme-choice__option {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: $option-height;
		padding: 0 10px;
		border: 0;
		border-radius: $radius-sm;
		background: none;
		color: inherit;
		font: inherit;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color $transition-fast,
			color $transition-fast;

		@include touch-target($option-height);
		@include focus-ring(1px);

		@media (hover: hover) {
			&:hover {
				background-color: color-mix(in srgb, currentColor 10%, transparent);
			}
		}

		// The ring is what shows the checked option; the fill alone is too faint to see.
		&[aria-checked='true'] {
			background-color: var(--_fill-checked);
			box-shadow: inset 0 0 0 1px var(--_text-checked);
			color: var(--_text-checked);
			font-weight: $font-weight-medium;
		}

		// Forced colors remove the fill that marks the checked option. Without `forced-color-adjust: none`, Chrome
		// paints a page-colored box behind the label that hides it; with it, the focus ring needs a system color.
		@media (forced-colors: active) {
			&[aria-checked='true'] {
				forced-color-adjust: none;
				outline-color: CanvasText;
				background-color: Highlight;
				box-shadow: none;
				color: HighlightText;
			}
		}
	}
</style>
