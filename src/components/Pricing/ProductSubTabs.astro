---
import { Icon } from 'astro-icon/components';

interface SubTab {
	id: string;
	label: string;
	icon?: string;
	faqId?: string;
	faqTooltip?: string;
	/** Set by enrichTabs() when tooltip was auto-generated from FAQ answer */
	autoTooltip?: boolean;
	default?: boolean;
	gtmId?: string;
}

interface Props {
	tabs: SubTab[];
}

const { tabs } = Astro.props;
---

<div class="segment-tabs segment-tabs--sub">
	{tabs.map((tab) => (
		<button
			type="button"
			id={tab.gtmId}
			class={`sub-tab segment-tab ${tab.gtmId ? 'gtm_button ' : ''}${tab.default ? 'active' : ''}`}
			data-subtab={tab.id}
			data-faq-id={tab.faqId}
		>
			{tab.icon && <span class="segment-tab-icon segment-tab-icon--sub" set:html={tab.icon} />}
			{tab.label}
			{tab.faqId && (
				<span class="sub-tab-info print:hidden" data-faq-id={tab.faqId}>
					<Icon name="tabler:info-circle" class="sub-tab-info-icon" />
					{tab.faqTooltip && (
						<span class="sub-tab-tooltip">
							<span class="sub-tab-tooltip-arrow"></span>
							<span class="sub-tab-tooltip-body">
								<span set:html={tab.faqTooltip} />
								{tab.autoTooltip && tab.faqId && <span class="sub-tab-tooltip-readmore"> read more</span>}
							</span>
						</span>
					)}
				</span>
			)}
		</button>
	))}
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// ─── Shared segment control ───
	// Moved here from ProductTabs.astro when the ThingsBoard|TBMQ product selector
	// was removed (TBMQ left /pricing/, and a one-option selector is no selector).
	// These are the base rules the --sub variant below builds on.
	.segment-tabs {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0;
		padding: 4px;
		background: var(--color-bg-light);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: $radius-full;
		margin: 0 auto $spacing-6;
		width: fit-content;
	}

	// Active tab gets its own background + shadow. Previously a separate
	// .segment-highlight element slid between tabs, but that required JS
	// `getBoundingClientRect()` reads after class writes — a forced reflow
	// flagged by PageSpeed. Per-tab styling has no slide animation; the
	// active-state transition is a cross-fade instead.
	.segment-tab {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: $spacing-2 $spacing-6;
		font-size: $font-size-base;
		font-weight: $font-weight-semibold;
		color: var(--color-text-secondary);
		background: transparent;
		border: none;
		border-radius: $radius-full;
		cursor: pointer;
		transition: color 0.2s ease, background-color 0.25s ease, box-shadow 0.25s ease;
		white-space: nowrap;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
		outline: none;

		&:hover:not(.active) {
			color: var(--color-text);
		}

		&.active {
			color: var(--color-text);
			background: var(--color-bg-surface);
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(0, 0, 0, 0.04);

			[data-theme='dark'] & {
				box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.06);
			}
		}
	}

	// ─── Tab icons ───
	.segment-tab-icon {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		color: var(--color-text-secondary);
		opacity: 0.35;
		transition: color 0.2s ease, opacity 0.2s ease;

		svg {
			width: 100%;
			height: 100%;
		}

		.segment-tab:hover & {
			opacity: 0.6;
		}

		.segment-tab.active & {
			color: var(--color-primary);
			opacity: 1;
		}
	}

	.segment-tab-icon--sub {
		width: 24px;
		height: 24px;
		margin-right: 2px;
	}

	// ─── Sub-tab variant ───
	.segment-tabs--sub {
		margin-bottom: $spacing-8;

		.segment-tab {
			padding: $spacing-2 $spacing-5;
			font-size: $font-size-sm;
			font-weight: $font-weight-medium;
			gap: 0;
			display: inline-flex;
			align-items: center;
		}

		@include media-down(md) {
			display: flex;
			flex-direction: column;
			width: fit-content;
			border-radius: $radius-xl;

			.segment-tab {
				justify-content: flex-start;
				padding: $spacing-3 $spacing-5;
				align-self: stretch;
			}

			// Vertical layout uses a wider corner radius on the active tab.
			// The active background + shadow inherits from `.segment-tab.active`
			// (the shared segment-control rules above, applied at all viewports).
			.segment-tab.active {
				border-radius: $radius-lg;
			}
		}
	}

	.sub-tab:hover {
		z-index: 10;
	}

	// ─── Info icon ───
	.sub-tab-info {
		position: relative;
		display: inline-flex;
		align-items: center;
		margin-left: 2px;
		cursor: pointer;
	}

	.sub-tab-info-icon {
		width: 14px;
		height: 14px;
		color: var(--color-text-secondary);
		opacity: 0.5;
		position: relative;
		top: -4px;
		flex-shrink: 0;
		transition: color 0.2s ease, opacity 0.2s ease;
	}

	// Active segment → icon more visible
	.sub-tab.active .sub-tab-info-icon {
		color: var(--color-text);
		opacity: 0.8;
	}

	// Hovered icon → primary color (works on both active and inactive tabs)
	.sub-tab-info:hover .sub-tab-info-icon {
		color: var(--color-primary);
		opacity: 1;
	}

	// ─── Tooltip ───
	.sub-tab-tooltip {
		position: fixed;
		z-index: 99999;
		pointer-events: none;
		display: flex;
		align-items: center;

		// Hidden with delay
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s ease, visibility 0.15s ease;
		transition-delay: 0ms;

		// Invisible bridge from icon to tooltip body
		&::before {
			content: '';
			position: absolute;
			top: 0;
			left: -12px;
			width: 16px;
			height: 100%;
		}
	}

	.sub-tab-tooltip.pricing-tooltip--visible {
		opacity: 1;
		visibility: visible;
		pointer-events: none;
		&.pricing-tooltip--interactive { pointer-events: auto; }
	}

	.sub-tab-tooltip-arrow {
		flex-shrink: 0;
		width: 0;
		height: 0;
		border: 6px solid transparent;
		border-right-color: var(--sl-color-gray-5);
		position: relative;

		// Inner fill arrow to cover the border color
		&::after {
			content: '';
			position: absolute;
			top: -6px;
			left: -4px;
			width: 0;
			height: 0;
			border: 6px solid transparent;
			border-right-color: var(--color-bg-surface);
		}
	}

	.sub-tab-tooltip-body {
		display: block;
		padding: $spacing-4;
		background: var(--color-bg-surface);
		color: var(--color-text);
		font-size: $font-size-sm;
		font-weight: $font-weight-normal;
		line-height: 1.5;
		text-align: left;
		white-space: normal;
		width: 300px;
		border-radius: $radius-lg;
		border: 1px solid var(--sl-color-gray-5);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
	}

	.sub-tab-tooltip-readmore {
		color: var(--color-primary);
		cursor: pointer;

		&:hover {
			text-decoration: underline;
		}
	}

	@media print {
		.segment-tabs--sub {
			flex-direction: row;
			border-radius: $radius-full;
			margin-bottom: $spacing-5;

			.segment-tab {
				padding: $spacing-2 $spacing-5;
				align-self: auto;
			}

			.segment-tab.active {
				border-radius: $radius-full;
				box-shadow: 0 0 0 1px var(--sl-color-gray-5);
			}
		}
	}
</style>
