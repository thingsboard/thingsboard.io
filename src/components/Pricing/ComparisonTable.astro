---
import { Icon } from 'astro-icon/components';
import DataTable from '@components/DataTable.astro';
import DataTableValue from '@components/DataTableValue.astro';
import type { DataTableColumn } from '@models/data-table';
import type { ComparisonRow } from '@data/pricing/types.ts';

interface Props {
	title?: string;
	subtitle?: string;
	/** Table's accessible name. Defaults to `title`, which rarely names the product. */
	caption?: string;
	headers: string[];
	rows: ComparisonRow[];
}

const {
	title = 'Additional features',
	subtitle = 'Extra details and upgrade options for all subscription plans.',
	caption,
	headers,
	rows,
} = Astro.props;

// Widths are emitted inline on <col>, which `table-layout: fixed` honours in every
// browser; the per-class width rules below are a redundant fallback. Both sides read
// these constants — the stylesheet through the custom properties set on the section —
// so the pair cannot drift.
const FEATURE_COL_PCT = 30; // row-header column
const PLAN_COL_PCT = 17.5; // each plan column

const columns: DataTableColumn[] = [
	{ width: `${FEATURE_COL_PCT}%`, thClass: 'pc-comparison-feature-col' },
	...headers.map((h) => ({ label: h, width: `${PLAN_COL_PCT}%`, thClass: 'pc-comparison-plan-col' })),
];
---

<div
	class="pc-comparison-section"
	style={{
		'--pc-feature-col-w': `${FEATURE_COL_PCT}%`,
		'--pc-plan-col-w': `${PLAN_COL_PCT}%`,
	}}
>
	<h3 class="pc-comparison-title">{title}</h3>
	{subtitle && <p class="pc-comparison-subtitle">{subtitle}</p>}

	{/* Caption hidden: the <h3> above already shows this text. */}
	<DataTable
		caption={caption ?? title}
		columns={columns}
		class="pc-comparison-table"
		scrollable={true}
		scrollClass="pc-comparison-table-wrap"
	>
		{rows.map((row) => {
			// For rows with an (i) tooltip, bond the icon to the last
			// word of the label via a nowrap span so the icon never
			// orphans onto its own line at narrow viewports. Rows
			// without a tooltip render the label as-is so long ones
			// like "Dedicated customer success engineer" wrap freely.
			const hasTip = !!(row.faqId || row.faqTooltip);
			const lastSpace = hasTip ? row.feature.lastIndexOf(' ') : -1;
			const head = lastSpace !== -1 ? row.feature.slice(0, lastSpace + 1) : '';
			const tail = lastSpace !== -1 ? row.feature.slice(lastSpace + 1) : row.feature;
			return (
			<tr>
				<th scope="row" class="pc-comparison-feature-name">
					{hasTip ? (
						<>
							{head}<span class="pc-comparison-feature-tail">{tail}<span class="pc-comparison-tooltip-trigger" data-faq-id={row.faqId}>
								<Icon name="tabler:info-circle" class="pc-comparison-tooltip-icon" aria-hidden="true" />
								{row.faqTooltip && (
									<span class="pc-comparison-tooltip">
										<span class="pc-comparison-tooltip-arrow"></span>
										<span class="pc-comparison-tooltip-body">
											<span set:html={row.faqTooltip} />
											{row.autoTooltip && row.faqId && <span class="pc-comparison-tooltip-readmore"> read more</span>}
										</span>
									</span>
								)}
							</span></span>
						</>
					) : (
						row.feature
					)}
				</th>
				{row.values.map((val) => (
					<td class="pc-comparison-cell">
						{typeof val === 'boolean' ? (
							// `false` stays visually blank by design; the value is text-only.
							<DataTableValue value={val} yesClass="pc-comparison-check" />
						) : val.toLowerCase() === 'contact us' ? (
							<a href="/contact-us/" class="pc-comparison-link">Contact us</a>
						) : (
							<span class="pc-comparison-text">{val}</span>
						)}
					</td>
				))}
			</tr>
			);
		})}
	</DataTable>
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.pc-comparison-section {
		margin-bottom: $spacing-16;
	}

	.pc-comparison-title {
		@include subsection-title;
		color: var(--color-text);
		margin: 0 0 $spacing-2;
	}

	.pc-comparison-subtitle {
		@include text-m;
		color: var(--color-text-secondary);
		margin: 0 0 $spacing-6;
	}

	.pc-comparison-table-wrap {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.pc-comparison-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		min-width: 600px;

		@include media-down(md) {
			min-width: 500px;
		}
	}

	.pc-comparison-table thead th {
		padding: $spacing-4 $spacing-3;
		font-size: $font-size-lg;
		font-weight: $font-weight-bold;
		color: var(--color-text);
		text-align: center;
		border-bottom: 1px solid var(--sl-color-gray-5);

		@include media-down(md) {
			font-size: $font-size-base;
			padding: $spacing-3 $spacing-2;
		}
	}

	.pc-comparison-feature-col {
		text-align: left !important;
		width: var(--pc-feature-col-w);
	}

	.pc-comparison-plan-col {
		width: var(--pc-plan-col-w);
	}

	.pc-comparison-table tbody tr {
		border-bottom: 1px solid var(--sl-color-gray-5);
	}

	.pc-comparison-feature-name {
		padding: $spacing-3 $spacing-3 $spacing-3 0;
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		color: var(--color-text);
		// <th> would otherwise centre this column.
		text-align: left;
		white-space: nowrap;

		@include media-down(md) {
			font-size: $font-size-xs;
			white-space: normal;
		}
	}

	// Bonds the last word of the feature label to the (i) tooltip icon so
	// they wrap together — otherwise the icon orphans onto its own line when
	// the label wraps to two lines on narrow viewports.
	.pc-comparison-feature-tail {
		white-space: nowrap;
	}

	.pc-comparison-cell {
		padding: $spacing-3;
		text-align: center;
		vertical-align: middle;

		@include media-down(md) {
			padding: $spacing-2;
		}
	}

	.pc-comparison-check {
		width: 16px;
		height: 16px;
		color: var(--color-primary);
	}

	.pc-comparison-text {
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		color: var(--color-text);
	}

	.pc-comparison-link {
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		color: var(--color-primary);
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}

	// ─── Tooltip trigger + popup (same pattern as plan feature tooltips) ───
	.pc-comparison-tooltip-trigger {
		position: relative;
		display: inline;
		cursor: pointer;
		margin-left: 0;
	}

	.pc-comparison-tooltip-icon {
		width: 14px;
		height: 14px;
		color: var(--color-text);
		opacity: 0.8;
		vertical-align: text-top;
		margin-top: -1px;
		margin-left: -2px;
		transition: color 0.2s ease, opacity 0.2s ease;
	}

	.pc-comparison-tooltip-trigger:hover .pc-comparison-tooltip-icon {
		color: var(--color-primary);
		opacity: 1;
	}

	.pc-comparison-tooltip {
		position: fixed;
		z-index: 99999;
		pointer-events: none;
		left: -9999px;
		top: 0;
		display: flex;
		align-items: center;

		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s ease, visibility 0.15s ease;
		transition-delay: 0ms;

		&::before {
			content: '';
			position: absolute;
			top: 0;
			left: -12px;
			width: 16px;
			height: 100%;
		}
	}

	.pc-comparison-tooltip.pricing-tooltip--visible {
		opacity: 1;
		visibility: visible;
		pointer-events: none;
		&.pricing-tooltip--interactive { pointer-events: auto; }
	}

	.pc-comparison-tooltip-arrow {
		flex-shrink: 0;
		width: 0;
		height: 0;
		border: 6px solid transparent;
		border-right-color: var(--sl-color-gray-5);
		position: relative;

		&::after {
			content: '';
			position: absolute;
			top: -6px;
			left: -4px;
			width: 0;
			height: 0;
			border: 6px solid transparent;
			border-right-color: var(--color-bg-surface);
		}
	}

	.pc-comparison-tooltip-readmore {
		color: var(--color-primary);
		cursor: pointer;

		&:hover {
			text-decoration: underline;
		}
	}

	.pc-comparison-tooltip-body {
		display: block;
		padding: $spacing-3;
		background: var(--color-bg-surface);
		color: var(--color-text);
		font-size: $font-size-sm;
		font-weight: $font-weight-normal;
		line-height: 1.5;
		text-align: left;
		white-space: normal;
		width: 280px;
		border-radius: $radius-lg;
		border: 1px solid var(--sl-color-gray-5);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);

		a {
			color: var(--color-primary);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}
</style>
