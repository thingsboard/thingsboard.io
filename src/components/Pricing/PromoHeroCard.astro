---
import { Icon } from 'astro-icon/components';
import NButton from '../Landing/NButton.astro';
import type { PromoHeroData } from '@data/pricing/types.ts';

interface Props {
	data: PromoHeroData;
}

const { data } = Astro.props;
---

<div class="promo-hero-card">
	<div class="promo-hero-card-content">
		<h3 class="promo-hero-card-title">{data.title}</h3>
		{data.subtitle && <p class="promo-hero-card-subtitle">{data.subtitle}</p>}
		{data.priceLabel && <p class="promo-hero-card-price">{data.priceLabel}</p>}
		<p class="promo-hero-card-description">{data.description}</p>
		<ul class="promo-hero-card-features">
			{data.features.map((feature) => (
				<li>
					<Icon name="tabler:check" />
					<span>{feature}</span>
				</li>
			))}
		</ul>
		<div class="promo-hero-card-actions">
			<NButton href={data.ctaHref} variant="filled" size="sm" class="gtm_button">
				{data.ctaText}
			</NButton>
		</div>
	</div>
</div>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.promo-hero-card {
		display: flex;
		position: relative;
		overflow: hidden;
		background: var(--color-bg-surface);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: $radius-xl;
		padding: $spacing-10;
		margin-bottom: $spacing-8;

		&::after {
			content: '';
			position: absolute;
			right: -20px;
			bottom: -40px;
			width: 380px;
			height: 380px;
			background: url('/images/pricing/promo-watermark.svg') no-repeat center / contain;
			pointer-events: none;

			@include media-down(md) {
				display: none;
			}
		}

		@include media-down(md) {
			padding: $spacing-6;
		}
	}

	.promo-hero-card-content {
		position: relative;
		z-index: 1;
		max-width: 700px;
	}

	.promo-hero-card-title {
		@include subsection-title;
		color: var(--color-text);
		margin: 0 0 $spacing-3;
	}

	.promo-hero-card-subtitle {
		font-size: $font-size-base;
		color: var(--color-text-secondary);
		line-height: 1.6;
		margin: 0 0 $spacing-3;
	}

	.promo-hero-card-price {
		font-size: $font-size-2xl;
		font-weight: $font-weight-bold;
		color: var(--color-text);
		margin: 0 0 $spacing-3;
	}

	.promo-hero-card-description {
		font-size: $font-size-sm;
		color: var(--color-text-secondary);
		line-height: 1.6;
		margin: 0 0 $spacing-6;
	}

	.promo-hero-card-actions {
		display: flex;
		gap: $spacing-3;
		flex-wrap: wrap;
	}

	.promo-hero-card .n-button {
		min-width: 200px;
	}

	.promo-hero-card-features {
		list-style: none;
		padding: 0;
		margin: 0 0 $spacing-6;
		display: flex;
		flex-direction: column;
		gap: $spacing-3;

		li {
			display: flex;
			align-items: flex-start;
			gap: $spacing-3;
			font-size: $font-size-sm;
			color: var(--color-text);
			line-height: 1.5;

			[data-icon] {
				width: 16px;
				height: 16px;
				color: var(--color-primary);
				flex-shrink: 0;
				margin-top: 3px;
			}
		}
	}
</style>
