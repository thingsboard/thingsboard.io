---
import ScadaModeToggle from '@components/UseCase/ScadaModeToggle.astro';
import DashboardStructure from '@components/UseCase/DashboardStructure.astro';
import type { UseCaseData } from '@data/use-cases/types.ts';
import { SCADA_MODE_LABELS } from '@data/use-cases/_scada-shared';

interface Props {
	structure: NonNullable<UseCaseData['scadaDashboardStructure']>;
}

const { structure } = Astro.props;

// The toggle shows the blocks whose `data-mode-content` is this id.
const MODE_SECTION_ID = 'dashboard';

// Both modes share the panel texts; each panel carries one screenshot per mode.
const panels = structure.panels.map((panel) => ({
	...panel,
	modeImages: [
		{ mode: 'high-performance', label: SCADA_MODE_LABELS['high-performance'], image: panel.image },
		{ mode: 'traditional', label: SCADA_MODE_LABELS.traditional, image: panel.traditionalImage },
	],
}));
---

{/* Dashboard structure with high-performance / traditional mode toggle. */}
<section class="uc-section-padding">
	<div class="uc-header-selector">
		<h2>{structure.title}</h2>
		<ScadaModeToggle sectionId={MODE_SECTION_ID} />
	</div>

	<DashboardStructure
		title=""
		badge={structure.badge}
		panels={panels}
		modeSectionId={MODE_SECTION_ID}
		demoUrl={structure.demoUrl}
		demoButtonId={structure.demoButtonId}
		contactUsId={structure.contactUsId}
		instanceId="scada"
	/>
</section>
