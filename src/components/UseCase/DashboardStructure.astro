---
import NButton from '../Landing/NButton.astro';
import ImageGallery from '../ImageGallery.astro';
import SectionBadge from '../SectionBadge.astro';
import type { DashboardPanel } from '@data/use-cases/types.ts';

/** A panel whose screenshot depends on a mode toggle: one image per mode, the first shown by default. */
interface ModePanel extends DashboardPanel {
	modeImages?: { mode: string; label: string; image: string }[];
}

interface Props {
	title: string;
	badge?: string;
	subtitle?: string;
	panels: ModePanel[];
	/** Id of the mode toggle that switches `modeImages` (its `sectionId`). */
	modeSectionId?: string;
	demoUrl: string;
	demoButtonId: string;
	contactUsId: string;
	instanceId?: string;
}

const {
	title,
	badge,
	subtitle,
	panels,
	modeSectionId,
	demoUrl,
	demoButtonId,
	contactUsId,
	instanceId = 'default',
} = Astro.props;
---

<section
	class="uc-dashboard-structure uc-section-padding"
	data-dashboard-id={instanceId}
>
	{
		title && (
			<div class="uc-section-header">
				<SectionBadge
					text={badge || 'Interface insights'}
					color="var(--sl-color-orange-high)"
					borderColor="var(--sl-color-orange-high)"
				/>
				<h2>{title}</h2>
				{subtitle && <p>{subtitle}</p>}
			</div>
		)
	}

	{/* One list for every width: stacked panels when narrow or printed, tabs beside the active panel when wide. */}
	<div class="uc-dashboard-block" style={`--uc-panel-count:${panels.length}`}>
		{
			panels.map((panel, index) => (
				<div class="uc-dashboard-item">
					<div class:list={['uc-tab-item', { active: index === 0 }]} data-panel-index={index}>
						<h3>{panel.title}</h3>
					</div>
					<div class:list={['uc-dashboard-panel', { active: index === 0 }]} data-gallery-index={index}>
						<p class="uc-main-description">{panel.description}</p>
						{panel.modeImages ? (
							panel.modeImages.map((variant, variantIndex) => (
								<div
									class:list={['uc-scada-content', { active: variantIndex === 0 }]}
									data-mode-content={modeSectionId}
									data-mode={variant.mode}
									data-print-label={variant.label}
								>
									<ImageGallery
										images={[{ src: variant.image, alt: panel.imageAlt, caption: panel.imageTitle }]}
									/>
								</div>
							))
						) : (
							<ImageGallery
								images={[{ src: panel.image, alt: panel.imageAlt, caption: panel.imageTitle }]}
							/>
						)}
					</div>
				</div>
			))
		}

		<div class="uc-dashboard-buttons print:hidden">
			<NButton id={demoButtonId} href={demoUrl} target="_blank">
				View live demo
			</NButton>
			<NButton
				id={contactUsId}
				variant="outlined"
				href="/contact-us/?subject=Custom%20Development%20Service"
				target="_blank"
			>
				Contact us
			</NButton>
		</div>
	</div>
</section>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.uc-dashboard-structure {
		.uc-section-header {
			margin-bottom: $spacing-10;

			@include media-down(md) {
				margin-bottom: $spacing-8;
			}
		}
	}

	// ── Stacked panels: narrow screens and print ───
	.uc-dashboard-structure .uc-dashboard-block {
		display: flex;
		flex-direction: column;
		gap: $spacing-8;
	}

	.uc-tab-item h3 {
		@include text-tab;
		font-weight: $font-weight-semibold;
		color: var(--color-primary);
		margin: 0 0 $spacing-3;
	}

	.uc-main-description {
		@include text-s;
		margin: 0 0 $spacing-4;
	}

	// Reset ImageGallery margins inside dashboard context
	.uc-dashboard-structure .uc-dashboard-panel .image-gallery,
	.uc-dashboard-structure .uc-dashboard-panel .single-image {
		margin: 0;
	}

	// Stacked, the shot fills the column whatever its own size.
	.uc-dashboard-structure .uc-dashboard-panel .single-thumb {
		width: 100%;

		img {
			width: 100%;
			border-radius: $radius-md;
		}
	}

	// Stacked shots keep the image's own rounded corners; the gallery link would clip
	// them to its wider radius.
	@include media-down(xl) {
		.uc-dashboard-structure .uc-dashboard-panel .single-thumb {
			overflow: visible;
		}
	}

	// The buttons belong to the tab column, which only the wide layout has.
	.uc-dashboard-buttons {
		display: none;
	}

	// ── Wide screens: tabs on the left, the active panel on the right ──
	// One grid: a row per tab and one for the buttons in the left column, and a last
	// flexible row that takes whatever height the panel needs beyond them. The panels
	// all span every row of the right column; only the active one is shown.
	@media screen {
		@include media-up(xl) {
			.uc-dashboard-structure .uc-dashboard-block {
				display: grid;
				grid-template-columns: 30% 66%;
				grid-template-rows: repeat(var(--uc-panel-count), auto) auto 1fr;
				gap: 0 4%;
				position: relative;
			}

			.uc-dashboard-item {
				display: contents;
			}

			.uc-tab-item {
				grid-column: 1;
				position: relative;
				padding: $spacing-4 $spacing-5;
				cursor: pointer;
				border-left: 3px solid transparent;
				transition:
					border-color $transition-base,
					background $transition-base;

				h3 {
					font-weight: $font-weight-medium;
					color: var(--color-text-secondary);
					margin: 0;
					transition: color $transition-base;
				}

				&:hover {
					h3 {
						color: var(--color-text);
					}
				}

				&.active {
					border-left-color: var(--color-primary);
					background: color-mix(in srgb, var(--color-primary) 5%, transparent);

					h3 {
						color: var(--color-primary);
					}
				}
			}

			.uc-dashboard-panel {
				display: none;
				grid-column: 2;
				grid-row: 1 / -1;
				position: sticky;
				top: 100px;
				align-self: start;
				// Paint after the tabs: a tab that paints after a sticky panel shares its
				// compositing layer and loses subpixel text rendering.
				z-index: 1;

				&.active {
					display: block;
				}
			}

			.uc-main-description {
				margin-bottom: $spacing-5;
			}

			.uc-dashboard-structure .uc-dashboard-panel .single-thumb {
				width: auto;

				img {
					width: auto;
				}
			}

			.uc-dashboard-buttons {
				grid-column: 1;
				display: flex;
				gap: $spacing-4;
				margin-top: $spacing-8;
			}
		}
	}

	@media print {
		.uc-dashboard-item {
			break-inside: avoid;
		}

		// Paper shows every mode's shot. Inside a panel the mode name is a caption,
		// smaller than the panel title above it.
		.uc-dashboard-structure .uc-dashboard-panel .uc-scada-content[data-print-label]::before {
			@include text-s;
			font-weight: $font-weight-semibold;
			margin: $spacing-3 0 $spacing-2;
		}

		// The gallery spaces printed shots apart; here the list's own gap does that.
		.uc-dashboard-structure .uc-dashboard-panel .single-thumb {
			margin: 0;
		}

		.uc-dashboard-structure .uc-dashboard-panel .single-thumb img {
			display: block;
			width: auto;
			max-width: 100%;
			max-height: 24vh;
			margin-inline: auto;

			@media (max-width: 600px) {
				max-height: 18vh;
			}
		}
	}
</style>

<script>
	function setPanelIndex(section: HTMLElement, index: number) {
		section
			.querySelectorAll<HTMLElement>('.uc-tab-item')
			.forEach((tab, i) => tab.classList.toggle('active', i === index));
		section
			.querySelectorAll<HTMLElement>('.uc-dashboard-panel')
			.forEach((panel, i) => panel.classList.toggle('active', i === index));
	}

	function initDashboardStructures() {
		const sections = document.querySelectorAll<HTMLElement>('[data-dashboard-id]');

		sections.forEach((section) => {
			if (section.dataset.initialized) return;
			section.dataset.initialized = 'true';

			const tabItems = Array.from(section.querySelectorAll<HTMLElement>('.uc-tab-item'));

			tabItems.forEach((tab, index) => {
				tab.addEventListener('click', () => {
					if (tab.classList.contains('active')) return;
					setPanelIndex(section, index);
				});
			});
		});
	}

	// Astro inline `<script>` blocks load as deferred modules, which means
	// they execute *after* DOMContentLoaded has already fired on initial
	// page load — so `addEventListener('DOMContentLoaded', ...)` would
	// never run. Run init immediately if the document is already ready.
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initDashboardStructures);
	} else {
		initDashboardStructures();
	}
</script>
