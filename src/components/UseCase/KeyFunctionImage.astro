---
// One SCADA key-function symbol. A symbol with a `-dark.svg` sibling gets its dark copy
// stacked on top and swapped by visibility; the others keep the light plate set in
// KeyFunctionsSection.
import SmartImage from '@components/SmartImage.astro';

interface Props {
	src: string;
	alt: string;
}

const { src, alt } = Astro.props;

// Only the keys are read (SmartImage resolves the URL), so the glob stays lazy.
const darkVariants = import.meta.glob('/src/assets/images/usecases/**/*-dark.svg', {
	query: '?url',
	import: 'default',
});
const darkSrc = src.replace(/\.svg$/, '-dark.svg');
const hasDark = darkSrc in darkVariants;
---

{hasDark ? (
	<span class="uc-key-function-image">
		<SmartImage src={src} alt={alt} width={400} height={200} class="uc-key-function-image__light" />
		<SmartImage src={darkSrc} alt={alt} width={400} height={200} class="uc-key-function-image__dark print:hidden" />
	</span>
) : (
	<SmartImage src={src} alt={alt} width={400} height={200} />
)}
