---
import SmartImage from '@components/SmartImage.astro';
import SectionBadge from '@components/SectionBadge.astro';
import type { ApplicationItem } from '@data/use-cases/types.ts';
import { ICON_RING_GEOMETRY } from '@components/UseCase/icon-ring-geometry.ts';
import { darkTwinOf } from '@components/UseCase/dark-variant.ts';

interface Props {
	title: string;
	badge?: string;
	subtitle?: string;
	applications: ApplicationItem[];
}

const { title, badge, subtitle, applications } = Astro.props;

// Every icon needs a ring-geometry entry (the wide height and the narrow crop read it).
// Name any that lack one, rather than failing on an undefined entry.
const noGeometry = applications.filter((app) => !ICON_RING_GEOMETRY[app.desktopImage]);
if (noGeometry.length > 0) {
	throw new Error(
		`[use-cases] "${title}" application icons: no ring geometry — add an entry to ` +
			`src/components/UseCase/icon-ring-geometry.ts: ${noGeometry.map((app) => app.desktopImage).join(', ')}`
	);
}
// Each icon's `-dark.svg` twin (brand indigo → #b3c7ff, CE navy → #78b4f5). darkTwinOf
// fails the build when it is missing, instead of pointing at a CDN URL that does not exist.

// The icons are taller than wide; the real height keeps a not-yet-loaded copy
// (e.g. the other theme's, fetched on a switch) at its final size.
const ICON_W = 180;
const iconHeight = (src: string) => Math.round(ICON_W * ICON_RING_GEOMETRY[src].aspect);

// Narrow "just circles": the node SVG bakes in timeline connectors that extend
// outside the ring. The same icon is cropped to the ring via a circular viewport —
// scaled so the ring fills the viewport and translated so it centres (ring geometry
// differs per node because of the zigzag). The metrics travel as custom properties,
// so they only apply where the narrow layout reads them.
const CROP_D = 120; // circular viewport diameter (px)
const CROP_FILL = 0.94; // ring fills 94% of the viewport, leaving a small margin
const cropVars = (src: string) => {
	const g = ICON_RING_GEOMETRY[src];
	const imgW = (CROP_FILL * CROP_D) / (2 * g.r);
	const imgH = imgW * g.aspect;
	const x = (CROP_D / 2 - g.cx * imgW).toFixed(1);
	const y = (CROP_D / 2 - g.cy * imgH).toFixed(1);
	return `--uc-crop-w:${imgW.toFixed(1)}px;--uc-crop-h:${imgH.toFixed(1)}px;--uc-crop-shift:${x}px ${y}px`;
};

// Wide zigzag: the texts of items 0, 2, 4… sit in a row above the icons and the texts
// of items 1, 3… in a row below, so the markup keeps those three rows. Narrow screens
// flatten the rows and put every icon back in front of its own text by `order`.
const numbered = applications.map((app, index) => ({ app, index }));
const topApps = numbered.filter(({ index }) => index % 2 === 0);
const bottomApps = numbered.filter(({ index }) => index % 2 !== 0);
---

<section class="uc-applications uc-section-padding">
	<div class="uc-section-header">
		<SectionBadge
			text={badge || 'Versatile implementation'}
			color="var(--sl-color-red-high)"
			borderColor="var(--sl-color-red-high)"
		/>
		<h2>{title}</h2>
		{subtitle && <p>{subtitle}</p>}
	</div>

	{/* One markup for every width: a zigzag when wide, stacked icon + text blocks when narrow. */}
	<div class="uc-app-list" style={`--uc-crop-d:${CROP_D}px`}>
		<div class="uc-text-row uc-text-row-top">
			{
				topApps.map(({ app, index }) => (
					<div class="uc-text-block" style={`--uc-app-index:${index}`}>
						<h3>{app.title}</h3>
						<p>{app.description}</p>
					</div>
				))
			}
		</div>

		<div class="uc-images-row">
			{
				numbered.map(({ app, index }) => {
					const darkSrc = darkTwinOf(app.desktopImage);
					const height = iconHeight(app.desktopImage);
					return (
						<div class="uc-app-image" style={`--uc-app-index:${index}`}>
							<div class="uc-circle-crop" style={cropVars(app.desktopImage)}>
								<SmartImage
									src={app.desktopImage}
									alt={app.imageAlt}
									width={ICON_W}
									height={height}
									class="uc-ic uc-ic--light"
								/>
								<SmartImage
									src={darkSrc}
									alt={app.imageAlt}
									width={ICON_W}
									height={height}
									class="uc-ic uc-ic--dark"
								/>
							</div>
						</div>
					);
				})
			}
		</div>

		<div class="uc-text-row uc-text-row-bottom">
			{
				bottomApps.map(({ app, index }) => (
					<div class="uc-text-block" style={`--uc-app-index:${index}`}>
						<h3>{app.title}</h3>
						<p>{app.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.uc-applications {
		.uc-section-header {
			margin-bottom: $spacing-10;

			@include media-down(md) {
				margin-bottom: $spacing-8;
			}
		}
	}

	.uc-app-list {
		display: flex;
		flex-direction: column;
	}

	.uc-text-block {
		text-align: center;

		h3 {
			@include card-title;
			color: var(--color-text);
		}

		p {
			@include text-card;
			margin: 0;
		}
	}

	// ── Wide: zigzag ───────────────────────────────
	@include media-up(xl) {
		.uc-app-list {
			gap: 35px;
		}

		.uc-text-row {
			display: flex;
			flex-direction: row;
		}

		.uc-text-row-top {
			justify-content: space-between;
		}

		.uc-text-row-bottom {
			justify-content: space-evenly;
		}

		.uc-text-block {
			display: flex;
			flex-direction: column;
			max-width: 373px;
			gap: $spacing-3;

			h3 {
				margin: 0;
			}
		}

		// Icons row, staggered for the zigzag.
		.uc-images-row {
			display: flex;
			flex-direction: row;
			justify-content: space-evenly;
			align-self: center;
			max-height: 420px;
		}

		.uc-app-image {
			align-self: start;
			margin-top: 5%;

			img {
				max-width: 100%;
				height: auto;
			}

			// Even icons pushed further down for the stagger
			&:nth-child(even) {
				margin-top: 14%;
			}
		}

		.uc-circle-crop {
			display: contents;
		}
	}

	// ── Narrow: stacked icon + text blocks ─────────
	// The three rows dissolve, and every icon and text becomes an item of one column:
	// icon 0, text 0, icon 1, text 1…
	@include media-down(xl) {
		.uc-app-list {
			align-items: center;
		}

		.uc-text-row,
		.uc-images-row {
			display: contents;
		}

		.uc-app-image {
			order: calc(var(--uc-app-index) * 2);
			margin-top: $spacing-8;

			&:first-child {
				margin-top: 0;
			}
		}

		.uc-text-block {
			order: calc(var(--uc-app-index) * 2 + 1);
			max-width: 500px;
			margin-top: $spacing-3;

			h3 {
				margin: 0 0 $spacing-2;
			}
		}

		// Cropped "just circles": circular viewport over the icon.
		.uc-app-image,
		.uc-circle-crop {
			width: var(--uc-crop-d);
			height: var(--uc-crop-d);
		}

		.uc-circle-crop {
			position: relative;
			border-radius: 50%;
			overflow: hidden;

			img {
				position: absolute;
				top: 0;
				left: 0;
				max-width: none;
				width: var(--uc-crop-w);
				height: var(--uc-crop-h);
				translate: var(--uc-crop-shift);
			}
		}
	}

	// ── Dark mode ──────────────────────────────────
	// Swap each icon for its `-dark.svg` twin.
	.uc-ic--dark {
		display: none;
	}

	[data-theme='dark'] {
		.uc-ic--light {
			display: none;
		}
		// Inline like the light copy, so the row keeps its height.
		.uc-ic--dark {
			display: inline;
		}
	}

	@media print {
		.uc-applications .uc-section-header {
			break-after: avoid;
		}

		.uc-text-block {
			break-inside: avoid;
			break-before: avoid;
		}
	}
</style>
