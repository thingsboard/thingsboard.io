---
import KeyFunctionImage from '@components/UseCase/KeyFunctionImage.astro';
import ScadaModeToggle from './ScadaModeToggle.astro';
import type { ScadaKeyFunction } from '@data/use-cases/types.ts';
import { SCADA_MODE_LABELS } from '@data/use-cases/_scada-shared';

interface Props {
	highPerformance: ScadaKeyFunction[];
	traditional: ScadaKeyFunction[];
}

const { highPerformance, traditional } = Astro.props;
const hasBothModes = traditional.length > 0;
---

<section class="uc-key-functions uc-section-padding">
	<div class="uc-header-selector">
		<h2>Key functions of SCADA systems</h2>
		{hasBothModes && <ScadaModeToggle sectionId="key-functions" />}
	</div>

	<div
		class="uc-scada-content active"
		data-mode-content="key-functions"
		data-mode="high-performance"
		data-print-label={hasBothModes ? SCADA_MODE_LABELS['high-performance'] : undefined}
	>
		{
			highPerformance.map((fn) => (
				<div class="uc-key-function-block">
					<div class="uc-key-function-desc">
						<h3>{fn.title}</h3>
						<p set:html={fn.description} />
					</div>
					<KeyFunctionImage src={fn.image} alt={fn.imageAlt} />
				</div>
			))
		}
	</div>

	{hasBothModes && (
		<div
			class="uc-scada-content"
			data-mode-content="key-functions"
			data-mode="traditional"
			data-print-label={SCADA_MODE_LABELS.traditional}
		>
			{
				traditional.map((fn) => (
					<div class="uc-key-function-block">
						<div class="uc-key-function-desc">
							<h3>{fn.title}</h3>
							<p set:html={fn.description} />
						</div>
						<KeyFunctionImage src={fn.image} alt={fn.imageAlt} />
					</div>
				))
			}
		</div>
	)}
</section>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.uc-key-function-block {
		display: flex;
		align-items: center;
		gap: $spacing-8;
		padding: $spacing-8 0;
		border-bottom: 1px solid var(--color-border-light);

		@include media-down(md) {
			flex-direction: column;
			gap: $spacing-4;
		}

		.uc-key-function-desc {
			flex: 1;

			h3 {
				@include card-title-sm;
				color: var(--color-text);
				margin: 0 0 $spacing-3;
			}

			p {
				@include text-s;
				margin: 0;
			}
		}

		> img,
		> .uc-key-function-image {
			max-width: 240px;
			width: 100%;
			height: auto;
			flex-shrink: 0;

			@include media-down(md) {
				max-width: 200px;
			}
		}

		// A bare <img> is a symbol without a dark copy: the traditional set, colour 3D
		// equipment whose green/orange shows state, so recolouring it would change what
		// the states read as. Dark mode sits it on a fixed light plate instead.
		> img {
			// A spread shadow, not padding, so the symbol keeps its light-mode size.
			[data-theme='dark'] & {
				background: var(--color-white);
				border-radius: $radius-lg;
				box-shadow: 0 0 0 $spacing-3 var(--color-white);

				@include media-down(md) {
					box-shadow: 0 0 0 $spacing-2 var(--color-white);
				}
			}
		}
	}

	// High-performance symbols ship a -dark.svg; the copies are stacked and swapped by
	// visibility so both keep the same box.
	.uc-key-function-image {
		position: relative;
		display: block;

		img {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	// Sized by the wrapper, which the light copy sets, so the dark copy never spills out
	// while a CDN light copy is still loading.
	.uc-key-function-image .uc-key-function-image__dark {
		position: absolute;
		inset: 0;
		height: 100%;
		object-fit: contain;
		visibility: hidden;

		[data-theme='dark'] & {
			visibility: visible;
		}
	}

	.uc-key-function-image__light {
		[data-theme='dark'] & {
			visibility: hidden;
		}
	}

	@media print {
		.uc-key-function-block {
			flex-direction: row;
			gap: $spacing-6;
			padding: $spacing-4 0;
			break-inside: avoid;
		}
	}
</style>
