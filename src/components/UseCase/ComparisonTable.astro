---
import type { ComparisonRow } from '@data/use-cases/types.ts';

interface Props {
	title: string;
	rows: ComparisonRow[];
}

const { title, rows } = Astro.props;
---

<section class="uc-comparison uc-section-padding">
	<h2>{title}</h2>

	{/* One table for every width: screens narrower than `lg` restack it into cards. */}
	<table class="uc-comparison__table">
		{/* Hidden: the <h2> above already shows this text. */}
		<caption class="uc-comparison__caption">{title}: high-performance compared with traditional</caption>
		<thead>
			<tr>
				<th scope="col" class="uc-comparison__th-criteria">
					<span class="visually-hidden">Criteria</span>
				</th>
				<th scope="col">High-performance</th>
				<th scope="col">Traditional</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row, i) => (
					<tr class={i % 2 === 0 ? 'uc-comparison__row--alt' : ''}>
						<th scope="row" class="uc-comparison__row-criteria">{row.criteria}</th>
						<td>{row.highPerformance}</td>
						<td>{row.traditional}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</section>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	.uc-comparison {
		> h2 {
			@include section-title;
			color: var(--color-text);
			margin: 0 0 $spacing-10;
		}
	}

	.visually-hidden {
		@include visually-hidden;
	}

	.uc-comparison__caption {
		@include caption-hidden;
	}

	// ── Table ──
	.uc-comparison__table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		border: 1px solid var(--color-border-light);
		border-radius: 12px;
		overflow: hidden;
		table-layout: fixed;

		thead tr {
			background: $color-text-primary;

			// The dark page is this same #17181c, so the band would vanish; lift it
			// above both the page and the #262830 body cells instead.
			[data-theme='dark'] & {
				background: var(--sl-color-gray-5);
			}
		}

		// Scoped to thead: the white text belongs to the dark header row only, and
		// the row headers in tbody are <th> too.
		thead th {
			@include text-table-header;
			padding: 16px 24px;
			text-align: left;
			color: $color-white;
			border-left: 1px solid rgba(255, 255, 255, 0.15);

			&:first-child {
				border-left: none;
			}
		}

		.uc-comparison__th-criteria {
			width: 35%;
		}

		td,
		tbody th {
			@include text-table-cell;
			padding: 16px 24px;
			// <th> would otherwise centre; every cell in this table is left-aligned.
			text-align: left;
			color: var(--color-text-secondary);
			border-left: 1px solid var(--color-border-light);
			border-top: 1px solid var(--color-border-light);

			&:first-child {
				border-left: none;
			}
		}

		.uc-comparison__row-criteria {
			font-weight: $font-weight-semibold;
			color: var(--color-text);
		}

		.uc-comparison__row--alt {
			background: var(--color-bg-light);
		}
	}

	// ── Narrow screens: the same table, restacked ──
	// The two mode names become a pair of pills; every row becomes a card with its
	// criteria on top and the two values side by side. Screen only: paper keeps the table.
	@media screen {
		@include media-down(lg) {
			.uc-comparison__table {
				display: block;
				border: 0;
				border-radius: 0;
				overflow: visible;

				thead,
				tbody {
					display: block;
				}

				tr {
					display: flex;
					flex-wrap: wrap;
					column-gap: $spacing-4;
				}

				thead tr {
					margin-bottom: $spacing-4;

					// The dark band moves from the row to each pill.
					&,
					[data-theme='dark'] & {
						background: none;
					}
				}

				// The criteria column has no pill of its own.
				.uc-comparison__th-criteria {
					display: none;
				}

				thead th {
					flex: 1;
					font-size: $font-size-base;
					padding: 10px $spacing-4;
					text-align: center;
					background: $color-text-primary;
					border: 0;
					border-radius: $radius-lg;

					// Same lift as the wide header band.
					[data-theme='dark'] & {
						background: var(--sl-color-gray-5);
					}
				}

				tbody tr {
					margin-bottom: $spacing-3;
				}

				// Cards carry their own fill; the row stripe would show through the gaps.
				.uc-comparison__row--alt {
					background: none;
				}

				td,
				tbody th {
					@include text-s;
					border: 0;
				}

				tbody th {
					flex: 0 0 100%;
					padding: 0;
					margin-bottom: $spacing-2;
					font-weight: $font-weight-semibold;
				}

				td {
					flex: 1;
					padding: 10px $spacing-4;
					color: var(--color-text-secondary);
					background: var(--color-bg-light);
					border-radius: $radius-lg;
					text-align: center;
				}
			}
		}
	}

	@media print {
		.uc-comparison__table {
			thead tr {
				background: none;
			}

			thead th {
				color: var(--color-text);
				border-left-color: var(--color-border-light);
			}

			thead th,
			tbody th,
			td {
				padding: 10px 16px;
			}

			tr {
				break-inside: avoid;
			}
		}
	}
</style>
