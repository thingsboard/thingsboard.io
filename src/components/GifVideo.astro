---
interface Props {
	srcMp4: string;
	/** Lighter than MP4, so it is listed first for the browsers that play it. */
	srcWebm?: string;
	poster?: string;
	width?: string | number;
	height?: string | number;
	/** Share of the video that must be visible before it loads and plays. */
	threshold?: number;
	/** `false` leaves loading and playback to the caller, e.g. play on hover. */
	autoplay?: boolean;
	className?: string;
	/** Accessible name, set as `aria-label`. */
	alt?: string;
}

const {
	srcMp4,
	srcWebm,
	poster,
	width = '100%',
	height = 'auto',
	threshold = 0.5,
	autoplay = true,
	className = '',
	alt,
} = Astro.props;
---

<video
	class:list={['lazy-gif-video', className]}
	width={width}
	height={height}
	poster={poster}
	aria-label={alt}
	loop
	muted
	playsinline
	data-threshold={autoplay ? threshold : undefined}
	style="display: block;"
>
	{srcWebm && <source data-src={srcWebm} type="video/webm" />}
	<source data-src={srcMp4} type="video/mp4" />
</video>

<script>
	// Sets `src` from `data-src` the first time a video is visible, then plays it only while on screen.
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	// An observer's threshold is fixed at construction, so there is one per distinct value.
	const observers = new Map<number, IntersectionObserver>();

	const onChange = (entries: IntersectionObserverEntry[]) =>
		entries.forEach(({ target, isIntersecting }) => {
			const video = target as HTMLVideoElement;
			if (!isIntersecting) return video.pause();

			const pending = video.querySelectorAll<HTMLSourceElement>('source[data-src]');
			pending.forEach((source) => {
				source.src = source.dataset.src!;
				source.removeAttribute('data-src');
			});
			if (pending.length) video.load();
			if (!reduce) video.play().catch(() => {});
		});

	document.querySelectorAll<HTMLVideoElement>('video.lazy-gif-video[data-threshold]').forEach((video) => {
		const threshold = Number(video.dataset.threshold);
		let io = observers.get(threshold);
		if (!io) observers.set(threshold, (io = new IntersectionObserver(onChange, { threshold })));
		io.observe(video);
	});
</script>
